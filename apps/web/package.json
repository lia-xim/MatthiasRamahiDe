{
  "name": "@matthias-ramahi/web",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:assets": "node ../../tools/sync-public-assets.mjs",
    "predev": "node ../../tools/sync-public-assets.mjs",
    "dev": "astro dev --host 0.0.0.0 --port 4321",
    "tina:dev": "tinacms dev -c \"astro dev --host 0.0.0.0 --port 4321\"",
    "tina:build": "tinacms build --local --skip-cloud-checks --noTelemetry && node ../../tools/patch-tina-admin-static.mjs",
    "prebuild": "node ../../tools/sync-public-assets.mjs",
    "build": "node ../../tools/run-web-build.mjs",
    "prepreview": "node ../../tools/sync-public-assets.mjs",
    "preview": "astro preview --host 0.0.0.0 --port 4321",
    "email:dev": "email dev --dir src/emails --port 3030",
    "audit:tina-content": "node scripts/tina-content-audit.mjs",
    "audit:tina-seo": "node scripts/tina-seo-audit.mjs",
    "audit:tina-seo:live": "node scripts/tina-seo-audit.mjs --base-url=http://127.0.0.1:4321",
    "repair:seo-metadata": "node scripts/repair-seo-metadata.mjs --write --refresh-derived",
    "test:legacy-routes": "node scripts/legacy-route-audit.mjs",
    "test:cms-parity": "node scripts/cms-parity-audit.mjs",
    "test:site-quality": "node scripts/site-quality-audit.mjs",
    "test:visual": "node scripts/visual-regression.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^9.0.0",
    "@astrojs/react": "^4.4.2",
    "@astrojs/vercel": "10.0.2",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@tinacms/astro": "0.5.0",
    "astro": "^5.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tinacms": "3.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tinacms/cli": "2.4.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0",
    "react-email": "^6.5.0",
    "typescript": "^5.8.0"
  }
}
