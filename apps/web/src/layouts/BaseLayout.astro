---
import '../styles/tokens.css'
import SiteChromeFooter from '../components/SiteChromeFooter.astro'
import SiteChromeHeader from '../components/SiteChromeHeader.astro'
import { versionStaticAssetUrl } from '../lib/cache'
import {
  getSiteSettings,
  imageDimensions,
  imageUrl,
  liveCmsFetchOptions,
  toAbsoluteSiteUrl,
  type PayloadMedia,
} from '../lib/payload'
import { localBusinessJsonLd, personJsonLd, webSiteJsonLd, type JsonLd } from '../lib/seo'

type Props = {
  canonicalUrl?: string
  description?: string
  bodyClass?: string
  noIndex?: boolean
  ogImage?: PayloadMedia | string
  ogType?: string
  preloadImages?: string[]
  stylesheets?: string[]
  title?: string
  jsonLd?: JsonLd | JsonLd[]
  currentNav?: string
  liveCms?: boolean
}

const {
  canonicalUrl,
  description: providedDescription,
  bodyClass = 'has-mr-footer cms-page',
  noIndex = false,
  ogImage,
  ogType = 'website',
  preloadImages = [],
  stylesheets = [],
  title: providedTitle,
  jsonLd,
  currentNav,
  liveCms = false,
} = Astro.props as Props

const liveCmsOptions = liveCms ? liveCmsFetchOptions() : {}
const settings = await getSiteSettings(liveCmsOptions)
const description =
  providedDescription || settings?.defaultMetaDescription || 'Portfolio, Fotografie und visuelle Produktion in Duesseldorf / NRW.'
const title = providedTitle || settings?.defaultMetaTitle || 'Matthias Ramahi Fotografie'
const siteName = settings?.siteName || 'Matthias Ramahi Fotografie'
const pathname = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '')
const canonical = toAbsoluteSiteUrl(canonicalUrl || pathname)
const socialImage = typeof ogImage === 'string' ? toAbsoluteSiteUrl(versionStaticAssetUrl(ogImage)) : imageUrl(ogImage || settings?.defaultOgImage, 'hero')
const socialImageDimensions = typeof ogImage === 'string' ? {} : imageDimensions(ogImage || settings?.defaultOgImage, 'hero')
const jsonLdItems = [
  personJsonLd(settings),
  webSiteJsonLd(settings),
  localBusinessJsonLd(settings),
  ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
].filter(Boolean)

const inferredNav =
  pathname === '/'
    ? 'home'
    : pathname.startsWith('/portfolio')
      ? 'portfolio'
      : pathname.startsWith('/journal') || pathname.startsWith('/blog')
        ? 'blog'
        : pathname.startsWith('/services') || pathname.startsWith('/leistungen')
          ? 'leistungen'
          : pathname.includes('ueber-mich')
            ? 'ueber-mich'
            : pathname.includes('kontakt') || pathname.includes('contact')
              ? 'kontakt'
              : undefined

const activeNav = currentNav || inferredNav
const versionedPreloadImages = preloadImages.map(versionStaticAssetUrl)
const versionedStylesheets = stylesheets.map(versionStaticAssetUrl)
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={settings?.ownerName || 'Matthias Ramahi'} />
    <meta name="format-detection" content="telephone=no" />
    <meta name="google-site-verification" content="49CiKBCvZoaIIZSo-revYi09ZSb_0VDl9V8D1zrAK_o" />
    <link rel="preconnect" href="https://cms.matthiasramahi.de" crossorigin />
    <link rel="dns-prefetch" href="//cms.matthiasramahi.de" />
    <link rel="dns-prefetch" href="//analytics.contextter.com" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="de-DE" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    {noIndex ? <meta name="robots" content="noindex,nofollow" /> : <meta name="robots" content="index,follow,max-image-preview:large" />}
    <meta name="theme-color" content="#020306" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={settings?.locale || 'de_DE'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:secure_url" content={socialImage} />}
    {socialImage && <meta property="og:image:alt" content={title} />}
    {socialImage && socialImageDimensions.width && <meta property="og:image:width" content={String(socialImageDimensions.width)} />}
    {socialImage && socialImageDimensions.height && <meta property="og:image:height" content={String(socialImageDimensions.height)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {socialImage && <meta name="twitter:image:alt" content={title} />}
    {versionedPreloadImages.map((href) => <link rel="preload" as="image" href={href} fetchpriority="high" />)}
    <link rel="stylesheet" href={versionStaticAssetUrl('/assets/site-chrome.css')} />
    <link rel="stylesheet" href={versionStaticAssetUrl('/assets/load-more-gallery.css')} />
    {versionedStylesheets.map((href) => <link rel="stylesheet" href={href} />)}
    {jsonLdItems.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <script
      is:inline
      defer
      src="https://analytics.contextter.com/script.js"
      data-website-id="be66c314-29d1-4d96-8a3e-9c842d472210"
      data-domains="matthiasramahi.de,www.matthiasramahi.de"
    ></script>
  </head>
  <body class={bodyClass} data-cms-layout-source="base-layout">
    <div class="site-shell">
      <SiteChromeHeader current={activeNav} liveCms={liveCms} />
      <main class="site-main">
        <slot />
      </main>
      <SiteChromeFooter liveCms={liveCms} />
    </div>
    <script is:inline src={versionStaticAssetUrl('/assets/site-chrome.js')} defer></script>
    <script is:inline src={versionStaticAssetUrl('/assets/analytics.js')} defer></script>
  </body>
</html>
