---
import fs from 'node:fs/promises'
import path from 'node:path'

import SiteChromeFooter from '../components/SiteChromeFooter.astro'
import SiteChromeHeader from '../components/SiteChromeHeader.astro'
import { getAdoptedPageChrome, mergeAssetLists } from '../lib/adoptedPageChrome'
import { versionStaticAssetUrl } from '../lib/cache'
// Bundle the critical CSS as a string at build time. The home page is SSR
// (prerender=false), so reading public/ from the filesystem at request time
// fails on Vercel (public/ isn't in the function cwd) — which silently disabled
// the critical-CSS inline + stylesheet deferral and left the CSS render-blocking.
import criticalHomeCss from '../../../../assets/critical-home.css?raw'
import {
  imageDimensions,
  imageUrl,
  getSiteSettings,
  liveCmsFetchOptions,
  toAbsoluteSiteUrl,
  type PayloadDoc,
  type PayloadMedia,
} from '../lib/payload'
import { localBusinessJsonLd, personJsonLd, webSiteJsonLd, type JsonLd } from '../lib/seo'

type Props = {
  bodyClass?: string
  canonicalUrl?: string
  ctaHref?: string
  current?: string
  description?: string
  doc?: PayloadDoc | null
  headerTheme?: string
  jsonLd?: JsonLd | JsonLd[]
  legacyFile: string
  liveCms?: boolean
  noIndex?: boolean
  ogImage?: PayloadMedia | string
  ogType?: string
  preloadImages?: PreloadImage[]
  scripts?: string[]
  stylesheets?: string[]
  title?: string
}

type PreloadImage =
  | string
  | {
      crossorigin?: 'anonymous' | 'use-credentials'
      fetchpriority?: 'auto' | 'high' | 'low'
      href: string
      imagesizes?: string
      imagesrcset?: string
      media?: string
    }

const {
  bodyClass: providedBodyClass,
  canonicalUrl,
  ctaHref,
  current: providedCurrent,
  description: providedDescription,
  doc = null,
  headerTheme: providedHeaderTheme,
  jsonLd,
  legacyFile,
  liveCms = false,
  noIndex = false,
  ogImage,
  ogType = 'website',
  preloadImages = [],
  scripts = [],
  stylesheets = [],
  title: providedTitle,
} = Astro.props as Props

const liveCmsOptions = liveCms ? liveCmsFetchOptions() : {}
const settings = await getSiteSettings(liveCmsOptions)
const chrome = getAdoptedPageChrome(legacyFile)
const fallbackPath = legacyFile === 'index.html' ? '/' : `/${legacyFile.replace(/^\/+/, '')}`
const docCanonical = doc?.seo?.canonicalUrl || doc?.seo?.legacyUrl || doc?.legacy?.sourceUrl
const title = providedTitle || doc?.seo?.title || doc?.title || chrome.title || settings?.defaultMetaTitle || 'Matthias Ramahi Fotografie'
const description =
  providedDescription ||
  doc?.seo?.description ||
  doc?.excerpt ||
  doc?.intro ||
  chrome.description ||
  settings?.defaultMetaDescription ||
  'Portfolio, Fotografie und visuelle Produktion in Düsseldorf / NRW.'
const canonical = toAbsoluteSiteUrl(canonicalUrl || docCanonical || fallbackPath)
const socialImageSource = ogImage || doc?.seo?.ogImage || doc?.coverImage || doc?.heroImage || doc?.teaserImage || chrome.ogImage || settings?.defaultOgImage
const socialImage = typeof socialImageSource === 'string'
  ? toAbsoluteSiteUrl(versionStaticAssetUrl(socialImageSource))
  : imageUrl(socialImageSource as PayloadMedia | undefined, 'hero', { allowOriginal: true })
const socialImageDimensions = typeof socialImageSource === 'string' ? {} : imageDimensions(socialImageSource as PayloadMedia | undefined, 'hero')
const robots = noIndex || doc?.seo?.noIndex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1'
const bodyClass = providedBodyClass || doc?.legacy?.bodyClass || chrome.bodyClass || 'has-mr-footer'
const current = providedCurrent || doc?.legacy?.headerCurrent || chrome.current
const headerTheme = providedHeaderTheme || chrome.headerTheme
const allStylesheets = mergeAssetLists(chrome.stylesheets, stylesheets)
const allPreloadImages = normalizePreloadImages(preloadImages.length > 0 ? preloadImages : chrome.preloadImages || [])
const allScripts = mergeAssetLists(chrome.scripts, scripts)
const versionedStylesheets = allStylesheets.map(versionStaticAssetUrl)
const versionedPreloadImages = allPreloadImages.map((image) => ({
  ...image,
  href: versionStaticAssetUrl(image.href),
}))
const versionedScripts = allScripts.map(versionStaticAssetUrl)
const siteName = settings?.siteName || 'Matthias Ramahi Fotografie'
const jsonLdItems = [
  personJsonLd(settings),
  webSiteJsonLd(settings),
  localBusinessJsonLd(settings),
  ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
].filter(Boolean)
const criticalCssByHref: Record<string, string> = { 'assets/critical-home.css': criticalHomeCss }
const rawCriticalCss = chrome.inlineCriticalCss
  ? (criticalCssByHref[chrome.inlineCriticalCss.replace(/^\/+/, '')] ?? (await readPublicAsset(chrome.inlineCriticalCss)))
  : ''
const criticalCss = rawCriticalCss ? minifyCriticalCss(rawCriticalCss) : ''
const deferStylesheets = Boolean(criticalCss)
const deferredStylesheetLinks = versionedStylesheets.map((href) => {
  const safeHref = escapeHtmlAttribute(href)
  return `<link rel="preload" as="style" href="${safeHref}"><link rel="stylesheet" href="${safeHref}" media="print" onload="this.onload=null;this.media='all'">`
}).join('')
const noscriptStylesheetLinks = versionedStylesheets
  .map((href) => `<link rel="stylesheet" href="${escapeHtmlAttribute(href)}">`)
  .join('')

Astro.response.headers.set('x-cms-render-source', 'structured-astro')
Astro.response.headers.set('x-cms-migration-status', 'native-component')
Astro.response.headers.set('x-cms-layout-source', 'native-adopted-chrome')

function minifyCriticalCss(css: string) {
  return css
    .replace(/\/\*[\s\S]*?\*\//g, '')
    .replace(/\s+/g, ' ')
    .replace(/\s*([{}:;,>])\s*/g, '$1')
    .replace(/;}/g, '}')
    .trim()
}

function escapeHtmlAttribute(value: string) {
  return value.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;')
}

function normalizePreloadImageHref(href: string) {
  if (!href || /^(https?:|data:|mailto:|tel:|#)/i.test(href) || href.startsWith('/')) return href
  return `/${href.replace(/^\/+/, '')}`
}

function normalizePreloadImages(items: PreloadImage[]) {
  const seen = new Set<string>()
  return items
    .map((item) => (typeof item === 'string' ? { href: item } : item))
    .map((item) => ({
      ...item,
      fetchpriority: item.fetchpriority || 'high',
      href: normalizePreloadImageHref(item.href),
    }))
    .filter((item) => {
      const key = [item.href, item.media || '', item.imagesrcset || '', item.imagesizes || ''].join('|')
      if (!item.href || seen.has(key)) return false
      seen.add(key)
      return true
    })
}

async function readPublicAsset(href: string) {
  const cleanHref = href.replace(/^\/+/, '').split('?')[0]
  if (!cleanHref.startsWith('assets/') || !cleanHref.endsWith('.css')) return ''

  const publicPath = path.join(process.cwd(), 'public', cleanHref)
  const workspacePath = path.resolve(process.cwd(), '..', '..', cleanHref)
  try {
    return await fs.readFile(publicPath, 'utf8')
  } catch {
    try {
      return await fs.readFile(workspacePath, 'utf8')
    } catch {
      return ''
    }
  }
}
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={settings?.ownerName || 'Matthias Ramahi'} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#020306" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="preconnect" href="https://cms.matthiasramahi.de" crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={settings?.locale || 'de_DE'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:alt" content={title} />}
    {socialImage && socialImageDimensions.width && <meta property="og:image:width" content={String(socialImageDimensions.width)} />}
    {socialImage && socialImageDimensions.height && <meta property="og:image:height" content={String(socialImageDimensions.height)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {criticalCss && <style data-critical="home" set:html={criticalCss} />}
    {versionedPreloadImages.map((image) => (
      <link
        rel="preload"
        as="image"
        href={image.href}
        media={image.media}
        imagesizes={image.imagesizes}
        imagesrcset={image.imagesrcset}
        crossorigin={image.crossorigin}
        fetchpriority={image.fetchpriority}
      />
    ))}
    {deferStylesheets ? (
      <>
        <Fragment set:html={deferredStylesheetLinks} />
        <noscript><Fragment set:html={noscriptStylesheetLinks} /></noscript>
      </>
    ) : (
      versionedStylesheets.map((href) => <link rel="stylesheet" href={href} />)
    )}
    {jsonLdItems.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <script
      is:inline
      defer
      src="https://analytics.contextter.com/script.js"
      data-website-id="be66c314-29d1-4d96-8a3e-9c842d472210"
      data-domains="matthiasramahi.de,www.matthiasramahi.de"
    ></script>
  </head>
  <body class={bodyClass} data-cms-layout-source="native-adopted-chrome">
    <SiteChromeHeader current={current} ctaHref={ctaHref} headerTheme={headerTheme} liveCms={liveCms} />
    <div id="mr-content" tabindex="-1">
      <slot />
    </div>
    <SiteChromeFooter liveCms={liveCms} />
    {versionedScripts.map((src) => <script is:inline src={src} defer></script>)}
    <script is:inline src={versionStaticAssetUrl('/assets/analytics.js')} defer></script>
  </body>
</html>
