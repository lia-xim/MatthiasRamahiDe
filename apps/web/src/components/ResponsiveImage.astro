---
import { imageAlt, imageDimensions, imageDisplayUrl, imageObjectPosition, imageSrcset } from '../lib/payload'
import { tinaAttrs } from '../lib/tinaFieldAttrs'

const {
  media,
  size = 'hero',
  class: className = '',
  fallback = 'Bild folgt',
  sizes = '(max-width: 760px) 100vw, 50vw',
  loading = 'lazy',
  mapCachedAssets = true,
  tinaFieldSource,
  tinaFieldName,
  tinaFieldIndex,
} = Astro.props
const mediaOptions = { mapCachedAssets }
const src = imageDisplayUrl(media, size, mediaOptions)
const alt = imageAlt(media, fallback)
const dimensions = imageDimensions(media, size)
const rasterSrcset = imageSrcset(media, ['mobile', 'card', 'hero', 'wide'], 'raster', mediaOptions)
const avifSrcset = imageSrcset(media, ['mobile', 'card', 'hero', 'wide'], 'avif', mediaOptions)
const fallbackSrc = typeof media === 'object' && media ? imageDisplayUrl(media, 'wide', { allowOriginal: true, mapCachedAssets }) || src : src
const blurDataUrl = typeof media === 'object' && media ? media.blurDataUrl : ''
const dominantColor = typeof media === 'object' && media ? media.dominantColor : ''
const objectPosition = imageObjectPosition(media)
const imageStyle = [
  blurDataUrl ? `background-image: url('${blurDataUrl}')` : '',
  dominantColor ? `background-color: ${dominantColor}` : '',
  objectPosition ? `object-position: ${objectPosition}` : '',
]
  .filter(Boolean)
  .join('; ')
const editorAttrs = tinaAttrs(tinaFieldSource, tinaFieldName, tinaFieldIndex)
---
{src ? (
  <picture>
    {avifSrcset && <source type="image/avif" srcset={avifSrcset} sizes={sizes} />}
    {rasterSrcset && <source type="image/webp" srcset={rasterSrcset} sizes={sizes} />}
    <img
      class={className}
      src={src}
      srcset={rasterSrcset || undefined}
      sizes={sizes}
      data-img-fallback={fallbackSrc}
      alt={alt}
      width={dimensions.width}
      height={dimensions.height}
      loading={loading}
      decoding="async"
      fetchpriority={loading === 'eager' ? 'high' : undefined}
      style={imageStyle || undefined}
      {...editorAttrs}
    />
  </picture>
) : (
  <div class={`image-placeholder ${className}`} {...editorAttrs}>{fallback}</div>
)}
