---
import { localResponsiveImage } from '../data/localResponsiveThumbs'
import { imageAlt, imageDimensions, imageDisplayUrl, imageObjectPosition, imageSrcset } from '../lib/payload'
import { tinaAttrs } from '../lib/tinaFieldAttrs'

const {
  media,
  altText = '',
  size = 'hero',
  class: className = '',
  fallback = 'Bild folgt',
  sizes = '(max-width: 760px) 100vw, 50vw',
  loading = 'lazy',
  decoding = 'async',
  fetchpriority,
  mapCachedAssets = true,
  tinaFieldSource,
  tinaFieldName,
  tinaFieldIndex,
} = Astro.props
const mediaOptions = { mapCachedAssets }
const isCard = size === 'card'
const variantNames = isCard ? ['mobile', 'card'] : ['mobile', 'card', 'hero', 'wide']
const baseSrc = (isCard ? imageDisplayUrl(media, 'mobile', mediaOptions) : '') || imageDisplayUrl(media, size, mediaOptions)
const alt = typeof altText === 'string' && altText.trim() ? altText.trim() : imageAlt(media, fallback)
const dimensions = imageDimensions(media, size)
let width = dimensions.width
let height = dimensions.height
let src = baseSrc
let rasterSrcset = imageSrcset(media, variantNames, 'raster', mediaOptions)
const avifSrcset = imageSrcset(media, variantNames, 'avif', mediaOptions)
let fallbackSrc = typeof media === 'object' && media ? imageDisplayUrl(media, 'wide', { allowOriginal: true, mapCachedAssets }) || baseSrc : baseSrc
if (!rasterSrcset && baseSrc && !/^https?:\/\//i.test(baseSrc) && !baseSrc.startsWith('data:')) {
  const local = localResponsiveImage(baseSrc, width || 1200, height || 800)
  if (local.srcset) {
    src = isCard ? local.mobile : local.src
    rasterSrcset = local.srcset
    fallbackSrc = local.full
    width = width || local.width
    height = height || local.height
  }
}
const blurDataUrl = typeof media === 'object' && media ? media.blurDataUrl : ''
const dominantColor = typeof media === 'object' && media ? media.dominantColor : ''
const objectPosition = imageObjectPosition(media)
const imageStyle = [
  blurDataUrl ? `background-image: url('${blurDataUrl}')` : '',
  dominantColor ? `background-color: ${dominantColor}` : '',
  objectPosition ? `object-position: ${objectPosition}` : '',
]
  .filter(Boolean)
  .join('; ')
const editorAttrs = tinaAttrs(tinaFieldSource, tinaFieldName, tinaFieldIndex)
---
{src ? (
  <picture>
    {avifSrcset && <source type="image/avif" srcset={avifSrcset} sizes={sizes} />}
    {rasterSrcset && <source type="image/webp" srcset={rasterSrcset} sizes={sizes} />}
    <img
      class={className}
      src={src}
      srcset={rasterSrcset || undefined}
      sizes={sizes}
      data-img-fallback={fallbackSrc}
      data-full={fallbackSrc || undefined}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      decoding={decoding}
      fetchpriority={fetchpriority ?? (loading === 'eager' ? 'high' : undefined)}
      style={imageStyle || undefined}
      {...editorAttrs}
    />
  </picture>
) : (
  <div class={`image-placeholder ${className}`} {...editorAttrs}>{fallback}</div>
)}
