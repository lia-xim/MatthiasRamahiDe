---
import HeroMotion from './HeroMotion.astro'
import ContactSlot from '../ContactSlot.astro'
import NativeFamilyFaq from './NativeFamilyFaq.astro'
import AdoptedPageLayout from '../../layouts/AdoptedPageLayout.astro'
import { getLegacyBackedDoc, imageAlt, imageDimensions, imageDisplayUrl, type PayloadDoc, type PayloadMedia } from '../../lib/payload'
import { tinaAttrs } from '../../lib/tinaFieldAttrs'

const legacyFile = 'ueber-mich.html'
const providedDoc = Astro.props.doc as PayloadDoc | undefined
const doc = providedDoc || (await getLegacyBackedDoc(legacyFile, { depth: 2 }))

type AboutChapter = {
  href?: string
  image?: PayloadMedia | string
  alt?: string
  width?: number
  height?: number
  title?: string
  linkLabel?: string
}

const fallback = {
  hero: {
    kicker: 'Über mich · Düsseldorf · NRW',
    titleLine1: 'Hinter der',
    titleLine2: 'Kamera.',
    lead:
      'Matthias Ramahi — Fotograf aus Düsseldorf. Editorial geführte Bildserien für Automobile, Oldtimer, Sportwagen, Motorräder, Portraits und Landschaften. Ausgebildet im Handwerk, denkend wie ein Editor.',
    image: '/assets/optimized/matthias-ramahi-portrait-1440.webp',
    primaryLabel: 'Portfolio ansehen →',
    primaryHref: 'portfolio.html',
    secondaryLabel: 'Projekt anfragen',
    secondaryHref: '#anfrage',
  },
  statement: {
    headline: 'Bild vor Filter, Motiv vor',
    headlineEmphasis: 'Effekt',
    lead:
      'Was mich an Fotografie hält, ist nicht das eine spektakuläre Bild: es ist die ruhige Arbeit davor: das genaue Hinsehen, das Warten auf das richtige Licht, die kleine Verschiebung in der Komposition, die ein Motiv plötzlich tragen lässt.',
    body:
      'Mein Anspruch ist editorial: klare Linien, ehrliche Farben, keine Effektkette. Ob Portrait, Automobil oder Landschaft: am Ende geht es darum, dass das Bild den Charakter seines Motivs zeigt und nicht den meiner Software. Aus dieser Geduld entstehen Aufnahmen, die nach dem Shooting noch arbeiten: auf dem Inserat, im Pressekit, an der Wand.',
    primaryLabel: 'Portfolio ansehen',
    primaryHref: 'portfolio.html',
    secondaryLabel: 'Bereiche ansehen',
    secondaryHref: '#schwerpunkte',
  },
  chapters: {
    headline: 'Sechs Bereiche. Eine',
    headlineEmphasis: 'Hand',
    intro:
      'Ich arbeite nicht in Genre-Schubladen, aber jede Disziplin braucht ihr eigenes Vorgehen. Licht, Distanz, Material und Rhythmus passen sich an, der klare Stil bleibt durchgehend erkennbar.',
  },
  sister: {
    kicker: 'Bewegte Bilder · Empfehlung',
    headline: 'Wenn es',
    headlineEmphasis: 'bewegt',
    lead: 'Für bewegte Bilder empfehle ich meine Schwester Sophia Ramahi: Videografin aus dem Rheinland.',
    body:
      'Sophia produziert Musikvideos, Imagefilme und redaktionelles Bewegtbild. Aus einer Familie, mit derselben Handschrift: wir arbeiten regelmäßig parallel am Set, damit Foto und Video sauber zusammenpassen.',
    buttonLabel: 'Anfrage Foto + Video →',
    href: 'contact.html#anfrage',
    plate: {
      tag: 'Schwester · Location',
      nameLine1: 'Sophia',
      nameLine2: 'Ramahi',
      roles: [{ label: 'Videografin' }, { label: 'Musikvideos' }, { label: 'Imagefilm' }, { label: 'Editorial · Set' }],
      location: 'Düsseldorf · NRW',
    },
  },
  contact: {
    subject: 'Projektanfrage',
    headline: 'Projekt <em>anfragen.</em>',
    lead:
      'Schreiben Sie kurz, welche Leistung Sie interessiert, wo das Projekt stattfindet und welchen Zeitraum Sie planen. Ich melde mich mit Rückfragen oder einem nächsten Schritt per E-Mail.',
  },
}

const fallbackChapters: AboutChapter[] = [
  {
    href: 'automobil-fotografie-duesseldorf.html',
    image: 'assets/optimized/assets-photos-automobil-sunset-960.webp',
    alt: 'Automobilfotografie',
    width: 960,
    height: 640,
    title: 'Automobil',
  },
  {
    href: 'sportwagen-fotografie-duesseldorf.html',
    image: 'assets/optimized/assets-photos-automobil-neon-960.webp',
    alt: 'Sportwagenfotografie',
    width: 960,
    height: 640,
    title: 'Sportwagen',
  },
  {
    href: 'oldtimer-fotografie-duesseldorf.html',
    image: 'assets/optimized/assets-photos-oldtimer-stage-960.webp',
    alt: 'Oldtimerfotografie',
    width: 960,
    height: 640,
    title: 'Oldtimer',
  },
  {
    href: 'motorrad-fotografie-duesseldorf.html',
    image: 'assets/optimized/assets-photos-motorrad-720.webp',
    alt: 'Motorradfotografie',
    width: 720,
    height: 1080,
    title: 'Motorrad',
  },
  {
    href: 'portraitfotografie-duesseldorf.html',
    image: 'assets/optimized/assets-photos-portrait-blue-720.webp',
    alt: 'Portraitfotografie',
    width: 720,
    height: 900,
    title: 'Portrait',
  },
  {
    href: 'landschaftsfotografie-duesseldorf.html',
    image: 'assets/optimized/assets-photos-landschaft-720.webp',
    alt: 'Landschaftsfotografie',
    width: 720,
    height: 1080,
    title: 'Landschaft',
  },
]

const aboutHero = { ...fallback.hero, ...((doc?.aboutHero as Record<string, unknown> | undefined) || {}) }
const aboutStatement = { ...fallback.statement, ...((doc?.aboutStatement as Record<string, unknown> | undefined) || {}) }
const aboutChapters = { ...fallback.chapters, ...((doc?.aboutChapters as Record<string, unknown> | undefined) || {}) }
const aboutSister = { ...fallback.sister, ...((doc?.aboutSister as Record<string, unknown> | undefined) || {}) }
const aboutHeroSource = doc?.aboutHero
const aboutStatementSource = doc?.aboutStatement
const aboutChaptersSource = doc?.aboutChapters
const aboutSisterSource = doc?.aboutSister
const sisterPlateSource = doc?.aboutSister?.plate
const sisterPlate = {
  ...fallback.sister.plate,
  ...((aboutSister.plate as Record<string, unknown> | undefined) || {}),
}
const aboutContact = { ...fallback.contact, ...((doc?.aboutContact as Record<string, unknown> | undefined) || {}) }
const aboutChapterItems = (aboutChapters as { items?: AboutChapter[] }).items
const chapters = (aboutChapterItems?.length ? aboutChapterItems : fallbackChapters) as AboutChapter[]
const sisterRoles = ((sisterPlate.roles as Array<{ label?: string }> | undefined)?.length
  ? (sisterPlate.roles as Array<{ label?: string }>)
  : fallback.sister.plate.roles)
// Hero: Porträt von Matthias aus dem Original (4090×4825) neu gerechnet.
// Die alte CMS-Version (mpissxxj…, im Hero als 480er ausgeliefert) sah
// gestreckt verpixelt aus und wird deshalb übersprungen. Ein anderes im CMS
// gesetztes Bild ersetzt das Porträt. Pfade ausgeschrieben (sync-public-assets).
const portraitSlide = {
  src: '/assets/optimized/matthias-ramahi-portrait-1440.webp',
  srcset:
    '/assets/optimized/matthias-ramahi-portrait-720.webp 720w, /assets/optimized/matthias-ramahi-portrait-1080.webp 1080w, /assets/optimized/matthias-ramahi-portrait-1440.webp 1440w, /assets/optimized/matthias-ramahi-portrait-2048.webp 2048w',
}
const cmsHeroImage = imageDisplayUrl(aboutHero.image as PayloadMedia | string | undefined, 'hero')
const cmsHeroPath = cmsHeroImage.split('?')[0]
const heroSlides =
  cmsHeroPath && !/mpissxxj|portfolio_webp_full_063|matthias-ramahi-portrait/i.test(cmsHeroPath)
    ? [{ src: cmsHeroImage }]
    : [portraitSlide]
const aboutFaq = [
  {
    q: 'Wo hat Matthias Ramahi seinen Standort und in welcher Region finden Shootings statt?',
    a: 'Meine Basis liegt in Erkrath direkt neben Düsseldorf. Shootings für Fahrzeuge, Motorräder und Portraits finden im gesamten Rheinland, im Ruhrgebiet und in ganz NRW statt, für größere Kampagnen und Serien auch deutschlandweit.',
  },
  {
    q: 'Wie läuft eine Zusammenarbeit von der ersten Anfrage bis zur Bildlieferung ab?',
    a: 'Nach einer kurzen Nachricht klären wir Motiv, Einsatzbereich, Ort und Lichtfenster. Beim Termin entstehen strukturierte Serien ohne Zeitdruck, anschließend folgen eine kuratierte Vorauswahl, zurückhaltende Bearbeitung und Lieferung für Web und Print.',
  },
  {
    q: 'Was kostet ein Fotoshooting bei Matthias Ramahi?',
    a: 'Ein Shooting beginnt bei 250 € inkl. MwSt. Der genaue Umfang richtet sich nach Motiv, Dauer, Locationaufwand und gewünschten Nutzungsrechten und wird vorab transparent abgestimmt.',
  },
  {
    q: 'Können Foto und Video für ein Projekt gemeinsam gebucht werden?',
    a: 'Ja. Für Bewegtbild arbeite ich regelmäßig parallel am Set mit meiner Schwester Sophia Ramahi zusammen, damit Fotografie und Videografie nahtlos zusammenpassen.',
  },
]
---
<AdoptedPageLayout legacyFile={legacyFile} current="ueber-mich" doc={doc}>
  <main>
    <section class="ovh ovh--ueber" data-theme="dark" data-header-theme="dark" aria-label="Matthias Ramahi — Fotograf aus Düsseldorf" {...tinaAttrs(aboutHeroSource, 'image')}>
      <HeroMotion variant="pan" slides={heroSlides} />
      <div class="ovh__grid">
        <p class="ovh__kicker" {...tinaAttrs(aboutHeroSource, 'kicker')}>{aboutHero.kicker}</p>
        <h1 class="ovh__title">
          <span class="line" {...tinaAttrs(aboutHeroSource, 'titleLine1')}><span class="word">{aboutHero.titleLine1}</span></span>
          <span class="line" {...tinaAttrs(aboutHeroSource, 'titleLine2')}><span class="word">{aboutHero.titleLine2}</span></span>
        </h1>
        <p class="ovh__lead" {...tinaAttrs(aboutHeroSource, 'lead')}>{aboutHero.lead}</p>
        <div class="ovh__actions">
          <a class="ovh__btn" href={aboutHero.primaryHref as string} {...tinaAttrs(aboutHeroSource, 'primaryLabel')}>{aboutHero.primaryLabel}</a>
          <a class="ovh__btn ovh__btn--ghost" href={aboutHero.secondaryHref as string} {...tinaAttrs(aboutHeroSource, 'secondaryLabel')}>{aboutHero.secondaryLabel}</a>
        </div>
      </div>
    </section>

    <section class="statement sec-light" data-theme="light" data-header-theme="light" aria-label="Haltung">
      <div class="section-inner">
        <div>
          <h2 {...tinaAttrs(aboutStatementSource, 'headline')}>{aboutStatement.headline}<br /> <em {...tinaAttrs(aboutStatementSource, 'headlineEmphasis')}>{aboutStatement.headlineEmphasis}</em>.</h2>
        </div>
        <div class="body">
          <p class="lead" {...tinaAttrs(aboutStatementSource, 'lead')}>{aboutStatement.lead}</p>
          <p {...tinaAttrs(aboutStatementSource, 'body')}>{aboutStatement.body}</p>
          <div class="actions">
            <a class="btn dark" href={aboutStatement.primaryHref as string} {...tinaAttrs(aboutStatementSource, 'primaryLabel')}>{aboutStatement.primaryLabel}</a>
            <a class="btn" href={aboutStatement.secondaryHref as string} style="color:var(--ink);border-color:var(--ink)" {...tinaAttrs(aboutStatementSource, 'secondaryLabel')}>{aboutStatement.secondaryLabel}</a>
          </div>
        </div>
      </div>
    </section>

    <section class="chapters sec-dark" id="schwerpunkte" data-theme="dark" data-header-theme="dark" aria-label="Schwerpunkte">
      <div class="section-inner">
        <div class="chapters-head">
          <h2 {...tinaAttrs(aboutChaptersSource, 'headline')}>{aboutChapters.headline}<br /> <em {...tinaAttrs(aboutChaptersSource, 'headlineEmphasis')}>{aboutChapters.headlineEmphasis}</em>.</h2>
          <p class="lead" {...tinaAttrs(aboutChaptersSource, 'intro')}>{aboutChapters.intro}</p>
        </div>
        <div class="chapter-grid">
          {chapters.map((chapter, index) => {
            // CMS-Chapters pflegen keine eigenen Masse - dann die des Media-Objekts
            // oder Fallback-Masse nutzen, damit das Bild reservierten Platz bekommt (kein Layout-Shift).
            const chapterDimensions = imageDimensions(chapter.image, 'card')
            const fallbackChapter = fallbackChapters[index]
            return (
            <a class="chapter" href={chapter.href || '#'}>
              <div class="img">
                <img
                  src={imageDisplayUrl(chapter.image, 'card') || ''}
                  alt={imageAlt(chapter.image, chapter.alt || chapter.title || '')}
                  loading="lazy"
                  width={chapter.width || chapterDimensions.width || fallbackChapter?.width || 960}
                  height={chapter.height || chapterDimensions.height || fallbackChapter?.height || 640}
                  decoding="async"
                  {...tinaAttrs(chapter, 'image')}
                />
              </div>
              <div class="head"><h3 {...tinaAttrs(chapter, 'title')}>{chapter.title}</h3></div>
              <span class="meta"><span class="arr" {...tinaAttrs(chapter, 'linkLabel')}>{chapter.linkLabel || 'Bereich ansehen →'}</span></span>
            </a>
            )
          })}
        </div>
      </div>
    </section>

    <section class="sister sister--v2" data-theme="light" data-header-theme="light" aria-label="Sophia Ramahi — Videografie">
      <div class="section-inner sister-grid">
        <div class="sister-copy">
          <h2 {...tinaAttrs(aboutSisterSource, 'headline')}>{aboutSister.headline} <em {...tinaAttrs(aboutSisterSource, 'headlineEmphasis')}>{aboutSister.headlineEmphasis}</em> sein soll.</h2>
          <p class="lead" {...tinaAttrs(aboutSisterSource, 'lead')}>{aboutSister.lead}</p>
          <p {...tinaAttrs(aboutSisterSource, 'body')}>{aboutSister.body}</p>
          <div class="actions">
            <a class="btn" href={aboutSister.href as string} {...tinaAttrs(aboutSisterSource, 'buttonLabel')}>{aboutSister.buttonLabel}</a>
          </div>
        </div>
        <a class="sister-card" href="https://sophiaramahi.de/" target="_blank" rel="noopener">
          <span class="sister-card__label">sophiaramahi.de</span>
          <span class="sister-card__name" {...tinaAttrs(sisterPlateSource, 'nameLine1')}>{sisterPlate.nameLine1} <em {...tinaAttrs(sisterPlateSource, 'nameLine2')}>{sisterPlate.nameLine2}</em></span>
          <span class="sister-card__roles">{sisterRoles.map((role) => role.label).filter(Boolean).join(' · ')}</span>
          <span class="sister-card__go">Zur Website <span aria-hidden="true">↗</span></span>
        </a>
      </div>
    </section>

    <NativeFamilyFaq faq={aboutFaq} pageUrl="https://matthiasramahi.de/ueber-mich.html" theme="dark" />

    <ContactSlot
      id="anfrage"
      data-contact-section
      data-theme="light"
      data-header-theme="light"
      data-contact-subject={aboutContact.subject as string}
      data-contact-headline={aboutContact.headline as string}
      data-contact-lead={aboutContact.lead as string}
    />
  </main>

  <!-- Hero entrance: add .is-in so the OVH title/lead/actions animate in.
       site-chrome.js does not handle .ovh, so this mirrors the legacy inline
       script. Without it the copy stays at opacity:0 and the column reads blank. -->
  <script is:inline>
    (function () {
      var h = document.querySelector('.ovh')
      if (!h) return
      var t = h.querySelector('.ovh__title')
      function start() { h.classList.add('is-in'); if (t) t.classList.add('is-in') }
      if (matchMedia('(prefers-reduced-motion:reduce)').matches) { start(); return }
      requestAnimationFrame(function () { requestAnimationFrame(start) })
    })()
  </script>
</AdoptedPageLayout>
