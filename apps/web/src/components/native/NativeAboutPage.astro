---
import HeroMotion from './HeroMotion.astro'
import ContactSlot from '../ContactSlot.astro'
import NativeFamilyFaq from './NativeFamilyFaq.astro'
import AdoptedPageLayout from '../../layouts/AdoptedPageLayout.astro'
import { getLegacyBackedDoc, imageAlt, imageDimensions, imageDisplayUrl, type PayloadDoc, type PayloadMedia } from '../../lib/payload'
import { tinaAttrs } from '../../lib/tinaFieldAttrs'

const legacyFile = 'ueber-mich.html'
const providedDoc = Astro.props.doc as PayloadDoc | undefined
const doc = providedDoc || (await getLegacyBackedDoc(legacyFile, { depth: 2 }))

type AboutChapter = {
  href?: string
  image?: PayloadMedia | string
  alt?: string
  width?: number
  height?: number
  title?: string
  linkLabel?: string
}

const fallback = {
  hero: {
    kicker: 'Über mich · Erkrath · Düsseldorf · NRW',
    titleLine1: 'Hinter der',
    titleLine2: 'Kamera.',
    lead:
      'Matthias Ramahi, Fotograf mit Basis in Erkrath direkt neben Düsseldorf. Kuratierte Bildserien für Automobile, Sportwagen, Oldtimer und Motorräder sowie charakterstarke Portraits und Fine-Art-Landschaften in ganz NRW.',
    image: '/assets/optimized/matthias-ramahi-portrait-1440.webp',
    primaryLabel: 'Portfolio ansehen →',
    primaryHref: '/portfolio.html',
    secondaryLabel: 'Projekt anfragen',
    secondaryHref: '#anfrage',
  },
  statement: {
    headline: 'Bild vor Filter, Motiv vor',
    headlineEmphasis: 'Effekt',
    lead:
      'Ich fotografiere Fahrzeuge, Menschen und Landschaften. In allen Bereichen reizt mich dasselbe: ein Motiv so genau zu lesen, dass Licht, Perspektive und Hintergrund für sich sprechen.',
    body:
      'Am Set arbeite ich ruhig und ohne Hektik. Bei Fahrzeugen heißt das: störende Spiegelungen auf Lack und Chrom schon vor Ort kontrollieren, die passende Brennweite wählen und auf das richtige Lichtfenster warten. Bei Portraits heißt es: klare, entspannte Anleitung statt steifer Standard-Posen. In der Nachbearbeitung bleibe ich bewusst zurückhaltend: ehrliche Farben, saubere Kontraste und kein schwerer Effekt-Filter, damit die Bilder im Inserat, im Pressekit, auf LinkedIn oder großformatig an der Wand Bestand haben.',
    primaryLabel: 'Portfolio ansehen',
    primaryHref: '/portfolio.html',
    secondaryLabel: 'Schwerpunkte ansehen',
    secondaryHref: '#schwerpunkte',
  },
  chapters: {
    headline: 'Sechs Bereiche. Eine',
    headlineEmphasis: 'Hand',
    intro:
      'Jede Disziplin stellt eigene Anforderungen an Licht, Distanz, Location und Tempo. Die ruhige, ehrliche Bildsprache verbindet alle sechs Schwerpunkte.',
  },
  sister: {
    kicker: 'Bewegte Bilder · Zusammenarbeit',
    headline: 'Wenn es',
    headlineEmphasis: 'bewegt',
    lead: 'Für Bewegtbild arbeite ich mit meiner Schwester Sophia Ramahi zusammen, Videografin aus dem Rheinland.',
    body:
      'Sophia produziert Musikvideos, Imagefilme und redaktionelle Videostrecken. Weil wir am Set regelmäßig parallel arbeiten, passen Lichtstimmung, Bildausschnitt und Timing zwischen Foto und Film direkt zusammen, ohne doppelte Abstimmung.',
    buttonLabel: 'Foto + Video anfragen',
    href: '/contact.html#anfrage',
    plate: {
      tag: 'Schwester · Bewegtbild',
      nameLine1: 'Sophia',
      nameLine2: 'Ramahi',
      roles: [{ label: 'Videografin' }, { label: 'Musikvideos' }, { label: 'Imagefilm' }, { label: 'Editorial · Set' }],
      location: 'Düsseldorf · NRW',
    },
  },
  contact: {
    subject: 'Projektanfrage',
    headline: 'Projekt <em>anfragen.</em>',
    lead:
      'Schreib mir kurz, worum es geht, wo das Shooting stattfinden soll und welchen Zeitraum du planst. Du sprichst direkt mit mir. Ich melde mich persönlich per E-Mail oder Telefon mit Rückfragen und einem klaren Vorschlag.',
  },
}

const fallbackChapters: AboutChapter[] = [
  {
    href: '/autofotografie-duesseldorf.html',
    image: 'assets/optimized/assets-photos-automobil-sunset-960.webp',
    alt: 'Automobilfotografie in Düsseldorf und NRW von Matthias Ramahi',
    width: 960,
    height: 640,
    title: 'Automobil',
    linkLabel: 'Zur Autofotografie →',
  },
  {
    href: '/sportwagen-fotografie.html',
    image: 'assets/optimized/assets-photos-automobil-neon-960.webp',
    alt: 'Sportwagenfotografie im kontrollierten Licht von Matthias Ramahi',
    width: 960,
    height: 640,
    title: 'Sportwagen',
    linkLabel: 'Zur Sportwagenfotografie →',
  },
  {
    href: '/oldtimer-fotografie.html',
    image: 'assets/optimized/assets-photos-oldtimer-stage-960.webp',
    alt: 'Oldtimer- und Sammlerfahrzeugfotografie von Matthias Ramahi',
    width: 960,
    height: 640,
    title: 'Oldtimer',
    linkLabel: 'Zur Oldtimerfotografie →',
  },
  {
    href: '/motorrad-fotografie.html',
    image: 'assets/optimized/assets-photos-motorrad-720.webp',
    alt: 'Motorrad- und Custom-Bike-Fotografie in NRW von Matthias Ramahi',
    width: 720,
    height: 1080,
    title: 'Motorrad',
    linkLabel: 'Zur Motorradfotografie →',
  },
  {
    href: '/portraitfotografie-duesseldorf.html',
    image: 'assets/optimized/assets-photos-portrait-blue-720.webp',
    alt: 'Portrait- und Personal-Branding-Fotografie in Düsseldorf von Matthias Ramahi',
    width: 720,
    height: 900,
    title: 'Portrait',
    linkLabel: 'Zur Portraitfotografie →',
  },
  {
    href: '/landschaftsfotografie.html',
    image: 'assets/optimized/assets-photos-landschaft-720.webp',
    alt: 'Landschaftsfotografie und Fine-Art-Prints von Matthias Ramahi',
    width: 720,
    height: 1080,
    title: 'Landschaft',
    linkLabel: 'Zu Landschaft & Prints →',
  },
]

const aboutWorkflowSteps = [
  {
    title: 'Briefing & Ziel',
    text: 'Wir klären vorab Motiv, Einsatzbereich und Umfang: privates Shooting, Verkaufsinserat, Händlerbestand, Personal Branding oder Fine-Art-Print.',
  },
  {
    title: 'Location & Licht',
    text: 'Ich plane Ort, Sonnenstand und Lichtfenster passend zu Lackfarbe, Outfit oder gewünschter Stimmung, in Düsseldorf, Erkrath, im Rheinland oder im Ruhrgebiet.',
  },
  {
    title: 'Shooting vor Ort',
    text: 'Konzentriert und ohne Zeitdruck. Fahrzeuge fotografiere ich on-location, im Showroom oder am Stellplatz; Portraits entstehen mit ruhiger Führung statt steifer Posen.',
  },
  {
    title: 'Auswahl & Retusche',
    text: 'Du erhältst eine kuratierte Vorauswahl in einer Online-Galerie. Deine Favoriten bearbeite ich farbtreu, sauber und ohne künstliche Effekt-Filter.',
  },
  {
    title: 'Ausgabe & Print',
    text: 'Lieferung getrennt für Web, Social Media und Druck. Auf Wunsch entstehen aus denselben Dateien kalibrierte Fine-Art-Prints oder Großformate über das Partnerlabor.',
  },
]

const aboutCraftPrinciples = [
  {
    claim: 'Kontrolliertes Licht statt nachträglicher Effekte.',
    note: 'Spiegelungen auf Lack, Chrom und Glas löse ich über Standpunkt, Polfilter und Lichtfenster vor Ort und nicht erst mit schweren Presets am Rechner.',
  },
  {
    claim: 'Ehrliche Portraits ohne Standard-Posen.',
    note: 'Für Business, Personal Branding oder Dating führe ich Blick, Haltung und Distanz ruhig an, damit die Bilder professionell wirken und trotzdem nach dir aussehen.',
  },
  {
    claim: 'Regionale Basis in Erkrath bei Düsseldorf.',
    note: 'Mein Standort an der Kempener Straße 44 in 40699 Erkrath liegt direkt vor den Toren Düsseldorfs. Von hier sind es kurze Wege ins gesamte Rheinland, nach Köln und ins Ruhrgebiet.',
  },
  {
    claim: 'Ein Ansprechpartner vom Briefing bis zur Datei.',
    note: 'Keine Agentur-Zwischenstufe und keine durchgereichten Calls. Du planst, fotografierst und wählst deine Bilder direkt mit mir aus.',
  },
]

const aboutSpecialtyLinks = [
  { label: 'Personal Branding & Business', href: '/personal-branding-fotografie-duesseldorf.html' },
  { label: 'Dating-Fotoshooting Düsseldorf', href: '/dating-fotoshooting-duesseldorf.html' },
  { label: 'Fotolabor & Fine-Art-Druck', href: '/fotolabor-druck-duesseldorf.html' },
  { label: 'Weitere Leistungen', href: '/leistungen.html' },
  { label: 'Preise & Umfang', href: '/fotoshooting-preise-duesseldorf.html' },
  { label: 'Journal & Praxisartikel', href: '/blog.html' },
]

const aboutCanonicalHrefMap: Record<string, string> = {
  'automobil-fotografie-duesseldorf.html': '/autofotografie-duesseldorf.html',
  '/automobil-fotografie-duesseldorf.html': '/autofotografie-duesseldorf.html',
  'sportwagen-fotografie-duesseldorf.html': '/sportwagen-fotografie.html',
  '/sportwagen-fotografie-duesseldorf.html': '/sportwagen-fotografie.html',
  'oldtimer-fotografie-duesseldorf.html': '/oldtimer-fotografie.html',
  '/oldtimer-fotografie-duesseldorf.html': '/oldtimer-fotografie.html',
  'motorrad-fotografie-duesseldorf.html': '/motorrad-fotografie.html',
  '/motorrad-fotografie-duesseldorf.html': '/motorrad-fotografie.html',
  'landschaftsfotografie-duesseldorf.html': '/landschaftsfotografie.html',
  '/landschaftsfotografie-duesseldorf.html': '/landschaftsfotografie.html',
}
const normalizeChapterHref = (href?: string) => {
  if (!href) return '#'
  const trimmed = href.trim()
  return aboutCanonicalHrefMap[trimmed] || trimmed
}

const aboutHero = { ...fallback.hero, ...((doc?.aboutHero as Record<string, unknown> | undefined) || {}) }
const aboutStatement = { ...fallback.statement, ...((doc?.aboutStatement as Record<string, unknown> | undefined) || {}) }
const aboutChapters = { ...fallback.chapters, ...((doc?.aboutChapters as Record<string, unknown> | undefined) || {}) }
const aboutSister = { ...fallback.sister, ...((doc?.aboutSister as Record<string, unknown> | undefined) || {}) }
const aboutHeroSource = doc?.aboutHero
const aboutStatementSource = doc?.aboutStatement
const aboutChaptersSource = doc?.aboutChapters
const aboutSisterSource = doc?.aboutSister
const sisterPlateSource = doc?.aboutSister?.plate
const sisterPlate = {
  ...fallback.sister.plate,
  ...((aboutSister.plate as Record<string, unknown> | undefined) || {}),
}
const aboutContact = { ...fallback.contact, ...((doc?.aboutContact as Record<string, unknown> | undefined) || {}) }
const aboutChapterItems = (aboutChapters as { items?: AboutChapter[] }).items
const chapters = (aboutChapterItems?.length ? aboutChapterItems : fallbackChapters) as AboutChapter[]
const sisterRoles = ((sisterPlate.roles as Array<{ label?: string }> | undefined)?.length
  ? (sisterPlate.roles as Array<{ label?: string }>)
  : fallback.sister.plate.roles)
// Hero: Porträt von Matthias aus dem Original (4090×4825) neu gerechnet.
// Die alte CMS-Version (mpissxxj…, im Hero als 480er ausgeliefert) sah
// gestreckt verpixelt aus und wird deshalb übersprungen. Ein anderes im CMS
// gesetztes Bild ersetzt das Porträt. Pfade ausgeschrieben (sync-public-assets).
const portraitSlide = {
  src: '/assets/optimized/matthias-ramahi-portrait-1440.webp',
  srcset:
    '/assets/optimized/matthias-ramahi-portrait-720.webp 720w, /assets/optimized/matthias-ramahi-portrait-1080.webp 1080w, /assets/optimized/matthias-ramahi-portrait-1440.webp 1440w, /assets/optimized/matthias-ramahi-portrait-2048.webp 2048w',
}
const cmsHeroImage = imageDisplayUrl(aboutHero.image as PayloadMedia | string | undefined, 'hero')
const cmsHeroPath = cmsHeroImage.split('?')[0]
const heroSlides =
  cmsHeroPath && !/mpissxxj|portfolio_webp_full_063|matthias-ramahi-portrait/i.test(cmsHeroPath)
    ? [{ src: cmsHeroImage }]
    : [portraitSlide]
const aboutFaq = [
  {
    q: 'Wo hat Matthias Ramahi seinen Standort und in welcher Region finden Shootings statt?',
    a: 'Meine Basis liegt an der Kempener Straße 44 in 40699 Erkrath, direkt neben Düsseldorf. Shootings für Automobile, Motorräder und Portraits finden in Düsseldorf, im gesamten Rheinland, im Ruhrgebiet und in ganz NRW statt, für ausgewählte Produktionen und Printversand auch deutschlandweit.',
  },
  {
    q: 'Wie läuft eine Zusammenarbeit von der ersten Anfrage bis zur Bildlieferung ab?',
    a: 'Nach einer kurzen Nachricht klären wir direkt Motiv, Einsatzbereich, Location und Lichtfenster. Beim Termin entstehen strukturierte Serien ohne Zeitdruck, anschließend folgen eine kuratierte Vorauswahl in einer Online-Galerie, zurückhaltende farbtreue Bearbeitung und die Ausgabe für Web, Social und Print.',
  },
  {
    q: 'Was kostet ein Fotoshooting bei Matthias Ramahi?',
    a: 'Ein Shooting beginnt bei 250 € inkl. MwSt. Der genaue Umfang richtet sich nach Motiv, Dauer, Locationaufwand und gewünschten Nutzungsrechten und wird vor dem Termin transparent abgestimmt.',
  },
  {
    q: 'Können Foto und Video für ein Projekt gemeinsam gebucht werden?',
    a: 'Ja. Für Bewegtbild arbeite ich regelmäßig parallel am Set mit meiner Schwester Sophia Ramahi zusammen, damit Fotografie und Videografie in Lichtstimmung und Timing nahtlos zusammenpassen.',
  },
]
---
<AdoptedPageLayout legacyFile={legacyFile} current="ueber-mich" doc={doc}>
  <main>
    <section class="ovh ovh--ueber" data-theme="dark" data-header-theme="dark" aria-label="Matthias Ramahi — Fotograf aus Erkrath bei Düsseldorf" {...tinaAttrs(aboutHeroSource, 'image')}>
      <HeroMotion variant="pan" slides={heroSlides} />
      <div class="ovh__grid">
        <p class="ovh__kicker" {...tinaAttrs(aboutHeroSource, 'kicker')}>{aboutHero.kicker}</p>
        <h1 class="ovh__title">
          <span class="line" {...tinaAttrs(aboutHeroSource, 'titleLine1')}><span class="word">{aboutHero.titleLine1}</span></span>
          <span class="line" {...tinaAttrs(aboutHeroSource, 'titleLine2')}><span class="word">{aboutHero.titleLine2}</span></span>
        </h1>
        <p class="ovh__lead" {...tinaAttrs(aboutHeroSource, 'lead')}>{aboutHero.lead}</p>
        <div class="ovh__actions">
          <a class="ovh__btn" href={aboutHero.primaryHref as string} {...tinaAttrs(aboutHeroSource, 'primaryLabel')}>{aboutHero.primaryLabel}</a>
          <a class="ovh__btn ovh__btn--ghost" href={aboutHero.secondaryHref as string} {...tinaAttrs(aboutHeroSource, 'secondaryLabel')}>{aboutHero.secondaryLabel}</a>
        </div>
      </div>
    </section>

    <section class="statement sec-light" data-theme="light" data-header-theme="light" aria-label="Haltung und Standort">
      <div class="section-inner">
        <div>
          <h2 {...tinaAttrs(aboutStatementSource, 'headline')}>{aboutStatement.headline}{' '}<br /><em {...tinaAttrs(aboutStatementSource, 'headlineEmphasis')}>{aboutStatement.headlineEmphasis}</em>.</h2>
        </div>
        <div class="body">
          <p class="lead" {...tinaAttrs(aboutStatementSource, 'lead')}>{aboutStatement.lead}</p>
          <p {...tinaAttrs(aboutStatementSource, 'body')}>{aboutStatement.body}</p>
          <dl class="about-facts" aria-label="Standort und Eckdaten">
            <div>
              <dt>Standort</dt>
              <dd>Kempener Straße 44, 40699 Erkrath (direkt bei Düsseldorf)</dd>
            </div>
            <div>
              <dt>Einsatzgebiet</dt>
              <dd>Düsseldorf, Rheinland, Ruhrgebiet &amp; ganz NRW</dd>
            </div>
            <div>
              <dt>Einstieg</dt>
              <dd>Shootings ab 250 € inkl. MwSt. · <a href="/fotoshooting-preise-duesseldorf.html">Preise &amp; Umfang</a></dd>
            </div>
            <div>
              <dt>Kontakt</dt>
              <dd>Direkt mit Matthias Ramahi · <a href="tel:+4917642449858">+49 176 42 44 98 58</a></dd>
            </div>
          </dl>
          <div class="actions">
            <a class="btn dark" href={aboutStatement.primaryHref as string} {...tinaAttrs(aboutStatementSource, 'primaryLabel')}>{aboutStatement.primaryLabel}</a>
            <a class="btn" href={aboutStatement.secondaryHref as string} style="color:var(--ink);border-color:var(--ink)" {...tinaAttrs(aboutStatementSource, 'secondaryLabel')}>{aboutStatement.secondaryLabel}</a>
          </div>
        </div>
      </div>
    </section>

    <section class="um-sec um-sec--dark" data-theme="dark" data-header-theme="dark" aria-labelledby="um-ablauf-title">
      <div class="um-inner">
        <header class="um-head">
          <h2 id="um-ablauf-title">Vom Briefing <em>zum Bild.</em></h2>
          <p class="um-lead">Vom ersten Gespräch über die Location-Planung bis zu den fertigen Dateien oder dem gerahmten Print.</p>
        </header>
        <ol class="um-rows">
          {aboutWorkflowSteps.map((step) => (
            <li class="um-row">
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="um-sec um-sec--light" data-theme="light" data-header-theme="light" aria-labelledby="um-werte-title">
      <div class="um-inner">
        <header class="um-head">
          <h2 id="um-werte-title">Wofür meine Arbeit <em>steht.</em></h2>
          <p class="um-lead">Gute Bilder entstehen vor dem Auslöser, durch Vorbereitung, saubere Lichtführung und ruhige Zusammenarbeit vor Ort.</p>
        </header>
        <ul class="um-rows">
          {aboutCraftPrinciples.map((item) => (
            <li class="um-row">
              <h3>{item.claim}</h3>
              <p>{item.note}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="chapters sec-dark" id="schwerpunkte" data-theme="dark" data-header-theme="dark" aria-label="Schwerpunkte">
      <div class="section-inner">
        <div class="chapters-head">
          <h2 {...tinaAttrs(aboutChaptersSource, 'headline')}>{aboutChapters.headline}{' '}<br /><em {...tinaAttrs(aboutChaptersSource, 'headlineEmphasis')}>{aboutChapters.headlineEmphasis}</em>.</h2>
          <p class="lead" {...tinaAttrs(aboutChaptersSource, 'intro')}>{aboutChapters.intro}</p>
        </div>
        <div class="chapter-grid">
          {chapters.map((chapter, index) => {
            // CMS-Chapters pflegen keine eigenen Masse - dann die des Media-Objekts
            // oder Fallback-Masse nutzen, damit das Bild reservierten Platz bekommt (kein Layout-Shift).
            const chapterDimensions = imageDimensions(chapter.image, 'card')
            const fallbackChapter = fallbackChapters[index]
            return (
            <a class="chapter" href={normalizeChapterHref(chapter.href)}>
              <div class="img">
                <img
                  src={imageDisplayUrl(chapter.image, 'card') || ''}
                  alt={imageAlt(chapter.image, chapter.alt || chapter.title || '')}
                  loading="lazy"
                  width={chapter.width || chapterDimensions.width || fallbackChapter?.width || 960}
                  height={chapter.height || chapterDimensions.height || fallbackChapter?.height || 640}
                  decoding="async"
                  {...tinaAttrs(chapter, 'image')}
                />
              </div>
              <div class="head"><h3 {...tinaAttrs(chapter, 'title')}>{chapter.title}</h3></div>
              <span class="meta"><span class="arr" {...tinaAttrs(chapter, 'linkLabel')}>{(chapter.linkLabel || 'Bereich ansehen →').replace(/ (?=→$)/, String.fromCharCode(160))}</span></span>
            </a>
            )
          })}
        </div>
        <nav class="about-specialties" aria-label="Weitere Schwerpunkte und Direktlinks">
          <ul class="about-specialties__list">
            {aboutSpecialtyLinks.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </section>

    <section class="sister sister--v2" data-theme="light" data-header-theme="light" aria-label="Sophia Ramahi — Videografie">
      <div class="section-inner sister-grid">
        <div class="sister-copy">
          <h2 {...tinaAttrs(aboutSisterSource, 'headline')}>{aboutSister.headline} <em {...tinaAttrs(aboutSisterSource, 'headlineEmphasis')}>{aboutSister.headlineEmphasis}</em> sein soll.</h2>
          <p class="lead" {...tinaAttrs(aboutSisterSource, 'lead')}>{aboutSister.lead}</p>
          <p {...tinaAttrs(aboutSisterSource, 'body')}>{aboutSister.body}</p>
          <div class="actions">
            <a class="btn" href={aboutSister.href as string} {...tinaAttrs(aboutSisterSource, 'buttonLabel')}>{aboutSister.buttonLabel}</a>
            <a class="btn" href="/videografie-duesseldorf.html">Mehr zur Videografie</a>
          </div>
        </div>
        <a class="sister-card" href="https://sophiaramahi.de/" target="_blank" rel="noopener">
          <span class="sister-card__label">sophiaramahi.de</span>
          <span class="sister-card__name" {...tinaAttrs(sisterPlateSource, 'nameLine1')}>{sisterPlate.nameLine1} <em {...tinaAttrs(sisterPlateSource, 'nameLine2')}>{sisterPlate.nameLine2}</em></span>
          <span class="sister-card__roles">{sisterRoles.map((role) => role.label).filter(Boolean).join(' · ')}</span>
          <span class="sister-card__go">Zur Website <span aria-hidden="true">↗</span></span>
        </a>
      </div>
    </section>

    <NativeFamilyFaq faq={aboutFaq} pageUrl="https://matthiasramahi.de/ueber-mich.html" theme="dark" />

    <ContactSlot
      id="anfrage"
      data-contact-section
      data-theme="light"
      data-header-theme="light"
      data-contact-subject={aboutContact.subject as string}
      data-contact-headline={aboutContact.headline as string}
      data-contact-lead={aboutContact.lead as string}
    />
  </main>

  <style>
    .about-facts {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px 28px;
      margin: 28px 0 0;
      padding: 22px 0;
      border-top: 1px solid rgba(10, 12, 17, 0.14);
      border-bottom: 1px solid rgba(10, 12, 17, 0.14);
    }
    .about-facts dt {
      font-size: 13px;
      font-weight: 600;
      line-height: 1.3;
      color: color-mix(in oklch, var(--ink, #0a0c11) 58%, transparent);
      margin-bottom: 4px;
    }
    .about-facts dd {
      margin: 0;
      font-size: 14.5px;
      line-height: 1.5;
      color: var(--ink, #0a0c11);
    }
    .about-facts a {
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .about-specialties {
      margin-top: clamp(32px, 4vw, 52px);
      padding-top: clamp(22px, 2.6vw, 32px);
      border-top: 1px solid rgba(243, 245, 239, 0.14);
    }
    .about-specialties__list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 10px 24px;
    }
    .about-specialties__list a {
      color: #f3f5ef;
      text-decoration: none;
      font-size: 14px;
      line-height: 1.4;
      border-bottom: 1px solid rgba(243, 245, 239, 0.28);
      padding-bottom: 2px;
      transition: border-color 0.25s ease, color 0.25s ease;
    }
    .about-specialties__list a:hover {
      color: #c8ccc6;
