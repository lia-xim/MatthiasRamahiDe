---
type GuideItem = {
  title: string
  text: string
}

type GuideLink = {
  href: string
  label: string
}

type Props = {
  eyebrow: string
  intro: string
  items: GuideItem[]
  links: GuideLink[]
  title: string
}

const { eyebrow, intro, items, links, title } = Astro.props as Props
// Längere Ratgeber-Abschnitte trennen Absätze mit einer Leerzeile.
const paragraphsOf = (text: string) => text.split(/\n\s*\n/).map((paragraph) => paragraph.trim()).filter(Boolean)
---

<section class="mr-guide" data-header-theme="light" data-theme="light" aria-labelledby="mr-guide-title">
  <div class="mr-guide__inner">
    <div class="mr-guide__intro">
      <span>{eyebrow}</span>
      <h2 id="mr-guide-title">{title}</h2>
      {intro && <p>{intro}</p>}
      {links.length > 0 && (
        <nav aria-labelledby="mr-guide-links-label">
          <span class="mr-guide__links-label" id="mr-guide-links-label">Passende Vertiefungen</span>
          {links.map((link) => <a href={link.href}><span>{link.label}</span> <span aria-hidden="true">→</span></a>)}
        </nav>
      )}
    </div>
    <ol class="mr-guide__steps">
      {items.map((item, index) => (
        <li class={index >= 2 ? 'mr-guide__item is-collapsible' : 'mr-guide__item'}>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <div>
            {index >= 2 ? (
              <>
                <h3 class="mr-guide__step-heading">
                  <button type="button" class="mr-guide__toggle" aria-expanded="false">
                    <span>{item.title}</span>
                    <span class="mr-guide__plus" aria-hidden="true"></span>
                  </button>
                </h3>
                <div class="mr-guide__body">
                  {paragraphsOf(item.text).map((paragraph) => <p>{paragraph}</p>)}
                </div>
              </>
            ) : (
              <>
                <h3>{item.title}</h3>
                {paragraphsOf(item.text).map((paragraph) => <p>{paragraph}</p>)}
              </>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<script is:inline>
  if (!window.__mrGuideAccordionBound) {
    window.__mrGuideAccordionBound = true;
    document.addEventListener('click', function (event) {
      var target = event.target && event.target.closest ? event.target.closest('.mr-guide__toggle') : null;
      if (!target || window.innerWidth > 860) return;
      var item = target.closest('.mr-guide__item');
      if (!item) return;
      var isOpen = item.classList.toggle('is-open');
      target.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
  }
</script>

<style>
  /* Ratgeber-Abschnitt: links Titel + Vertiefungen (sticky), rechts nummerierte
     Schritte. Gleiche Satzbreite wie die übrigen Sektionen, Schrittitel als
     kleine Display-Zeile, Mono-Nummern als redaktionelle Marke. */
  .mr-guide {
    --mrg-ink: #0a0c11;
    --mrg-muted: rgb(10 12 17 / 70%);
    --mrg-line: rgb(10 12 17 / 14%);
    --mrg-mono: 'MR Mono', 'MR Mono Fallback', ui-monospace, Menlo, Consolas, monospace;
    background: #f3f0e9;
    color: var(--mrg-ink);
    padding: clamp(4.5rem, 8vw, 8.5rem) 0;
  }

  .mr-guide__inner {
    display: grid;
    gap: clamp(2.5rem, 6vw, 7rem);
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    margin: 0 auto;
    max-width: 1472px;
    padding: 0 clamp(1.25rem, 5vw, 5.25rem);
  }

  .mr-guide__intro {
    align-self: start;
    position: sticky;
    top: 7rem;
  }

  .mr-guide__intro > span {
    align-items: center;
    color: var(--mrg-muted);
    display: flex;
    font: 700 0.6875rem/1.2 var(--mrg-mono);
    gap: 0.75rem;
    letter-spacing: 0.22em;
    margin-bottom: 1.25rem;
    text-transform: uppercase;
  }

  .mr-guide__intro > span::before {
    background: #cf392e;
    content: '';
    display: inline-block;
    height: 1px;
    width: 1.75rem;
  }

  .mr-guide h2 {
    font-size: clamp(2.4rem, 4.4vw, 4.6rem);
    line-height: 0.94;
    margin: 0;
    max-width: 12ch;
  }

  .mr-guide__intro > p {
    color: var(--mrg-muted);
    font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.25rem);
    line-height: 1.6;
    margin: 1.5rem 0 2.25rem;
    max-width: 36ch;
  }

  .mr-guide nav {
    border-bottom: 1px solid var(--mrg-line);
    display: grid;
    max-width: 30rem;
  }

  .mr-guide__links-label {
    color: var(--mrg-muted);
    font: 700 0.6875rem/1.2 var(--mrg-mono);
    letter-spacing: 0.2em;
    padding-bottom: 0.85rem;
    text-transform: uppercase;
  }

  .mr-guide nav a {
    align-items: center;
    border-top: 1px solid var(--mrg-line);
    color: var(--mrg-ink);
    display: flex;
    font-size: clamp(1rem, 0.96rem + 0.15vw, 1.0625rem);
    font-weight: 600;
    gap: 1rem;
    justify-content: space-between;
    min-height: 48px;
    padding: 0.7rem 0;
    text-decoration: none;
    transition: color 0.25s cubic-bezier(0.23, 1, 0.32, 1), padding 0.35s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .mr-guide nav a > span[aria-hidden] {
    color: #7a8a86;
    font-family: var(--mrg-mono);
    transition: transform 0.35s cubic-bezier(0.23, 1, 0.32, 1), color 0.25s ease;
  }

  .mr-guide nav a:hover,
  .mr-guide nav a:focus-visible {
    padding-left: 0.35rem;
  }

  .mr-guide nav a:hover > span[aria-hidden],
  .mr-guide nav a:focus-visible > span[aria-hidden] {
    color: #cf392e;
    transform: translateX(3px);
  }

  .mr-guide__steps {
    border-bottom: 1px solid var(--mrg-line);
    counter-reset: none;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mr-guide__steps li {
    align-items: baseline;
    border-top: 1px solid var(--mrg-line);
    display: grid;
    gap: clamp(1rem, 2vw, 2rem);
    grid-template-columns: 3rem minmax(0, 1fr);
    padding: clamp(1.75rem, 2.6vw, 2.5rem) 0;
  }

  .mr-guide__steps > li > span {
    color: #7a8a86;
    font: 700 0.8125rem/1.4 var(--mrg-mono);
    letter-spacing: 0.12em;
  }

  .mr-guide__steps h3 {
    font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.9rem);
    line-height: 1.08;
    margin: 0 0 0.75rem;
    max-width: 28ch;
  }

  .mr-guide__toggle {
    appearance: none;
    background: none;
    border: 0;
    color: inherit;
    cursor: default;
    display: block;
    font: inherit;
    letter-spacing: inherit;
    line-height: inherit;
    margin: 0;
    padding: 0;
    pointer-events: none;
    text-align: left;
    width: 100%;
  }

  .mr-guide__plus {
    display: none;
  }

  .mr-guide__steps p {
    color: var(--mrg-muted);
    font-size: clamp(1rem, 0.95rem + 0.2vw, 1.125rem);
    line-height: 1.65;
    margin: 0;
    max-width: 64ch;
  }

  .mr-guide__steps p + p {
    margin-top: 0.85rem;
  }

  @media (max-width: 860px) {
    .mr-guide {
      padding: clamp(2.75rem, 7vw, 4rem) 0;
    }

    .mr-guide__inner {
      grid-template-columns: 1fr;
    }

    .mr-guide__intro {
      position: static;
    }

    .mr-guide nav {
      max-width: none;
    }

    .mr-guide__steps li {
      padding: 1.15rem 0;
    }

    .mr-guide__steps h3 {
      max-width: none;
    }

    .mr-guide__toggle {
      align-items: center;
      cursor: pointer;
      display: flex;
      gap: 0.9rem;
      justify-content: space-between;
      min-height: 44px;
      pointer-events: auto;
    }

    .mr-guide__toggle:focus-visible {
      outline: 2px solid #cf392e;
      outline-offset: 4px;
    }

    .mr-guide__plus {
      display: inline-block;
      flex: 0 0 auto;
      height: 14px;
      position: relative;
      width: 14px;
    }

    .mr-guide__plus::before,
    .mr-guide__plus::after {
      background: currentColor;
      content: '';
      height: 1.5px;
      left: 0;
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      transition: transform 0.2s ease, opacity 0.2s ease;
      width: 100%;
    }

    .mr-guide__plus::after {
      transform: translateY(-50%) rotate(90deg);
    }

    .mr-guide__item.is-open .mr-guide__plus::after {
      opacity: 0;
      transform: translateY(-50%) rotate(0deg);
    }

    :global(html.js) .mr-guide__item.is-collapsible:not(.is-open) .mr-guide__step-heading {
      margin-bottom: 0;
    }

    :global(html.js) .mr-guide__item.is-collapsible:not(.is-open) .mr-guide__body {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .mr-guide__steps li {
      gap: 0.6rem;
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mr-guide nav a,
    .mr-guide nav a > span[aria-hidden] {
      transition: none;
    }
  }
</style>
