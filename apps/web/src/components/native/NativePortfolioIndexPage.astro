---
import AdoptedPageLayout from '../../layouts/AdoptedPageLayout.astro'
import {
  portfolioArchivePhotos,
  portfolioContext,
  portfolioHeroSlidesFallback,
  portfolioSpreads,
  type PortfolioPhoto,
  type PortfolioSpread,
} from '../../lib/portfolioIndexContent'
import { homeHeroSlidesFor } from '../../lib/nativeContent'
import {
  getSitePageByType,
  imageAlt,
  imageDimensions,
  imageDisplayUrl,
  liveCmsFetchOptions,
  toRootRelativeHref,
  type PayloadDoc,
} from '../../lib/payload'
import { tinaAttrs } from '../../lib/tinaFieldAttrs'

const providedDoc = Astro.props.doc as PayloadDoc | undefined
const doc = providedDoc || (await getSitePageByType('portfolio-index', liveCmsFetchOptions({ depth: 2 })))
const heroSlides = (doc?.heroSlides || []).length > 0 ? homeHeroSlidesFor(doc) : portfolioHeroSlidesFallback
const firstHeroSlide = heroSlides[0]
const firstHeroSlideSource = doc?.heroSlides?.[0]
const heroImages = heroSlides.map((slide) => slide.image)
const heroSlidesJson = JSON.stringify(heroSlides)
const emptyImage =
  'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221%22 height=%221%22 viewBox=%220 0 1 1%22%3E%3C/svg%3E'

type CmsPortfolioPhoto = {
  image?: PayloadDoc['heroImage']
  fullImage?: PayloadDoc['heroImage']
  caption?: string
  href?: string
}

type EditablePortfolioPhoto = PortfolioPhoto & {
  source?: CmsPortfolioPhoto
}

type CmsPortfolioSlice = NonNullable<NonNullable<PayloadDoc['portfolioIndex']>['slices']>[number]

type EditablePortfolioSpread = PortfolioSpread & {
  source?: CmsPortfolioSlice
  photos: EditablePortfolioPhoto[]
}

const portfolioIndex = doc?.portfolioIndex
const cleanText = (value?: string) => (typeof value === 'string' ? value.trim() : '')
const filledTextRows = (rows?: Array<{ text?: string }>) => rows?.map((row) => cleanText(row.text)).filter(Boolean) || []
const isEditablePortfolioPhoto = (value: EditablePortfolioPhoto | undefined): value is EditablePortfolioPhoto => Boolean(value)
const isEditablePortfolioSpread = (value: EditablePortfolioSpread | undefined): value is EditablePortfolioSpread => Boolean(value)
const dimensionsFor = (media: CmsPortfolioPhoto['image'], fallbackWidth: number, fallbackHeight: number) => {
  const dims = imageDimensions(media, 'card')
  return {
    width: dims.width || fallbackWidth,
    height: dims.height || fallbackHeight,
  }
}
const portfolioPhotoFromCms = (item?: CmsPortfolioPhoto): EditablePortfolioPhoto | undefined => {
  if (!item) return undefined
  const displayMedia = item.image || item.fullImage
  const fullMedia = item.fullImage || item.image
  const src = imageDisplayUrl(displayMedia, 'card', { allowOriginal: true })
  if (!src) return undefined
  const href = toRootRelativeHref(item.href) || imageDisplayUrl(fullMedia, 'wide', { allowOriginal: true }) || src
  const dims = dimensionsFor(displayMedia, 720, 900)

  return {
    caption: cleanText(item.caption) || imageAlt(displayMedia, 'Portfolio-Bild'),
    height: dims.height,
    href,
    source: item,
    src,
    width: dims.width,
  }
}

const contextBody = filledTextRows(portfolioIndex?.contextBody)
const contextParagraphs = contextBody.length > 0 ? contextBody : portfolioContext
const contextKicker = cleanText(portfolioIndex?.contextKicker) || 'Einordnung'
const contextHeadline = cleanText(portfolioIndex?.contextHeadline) || 'Serien statt Sammelmappe.'

const cmsSpreads =
  portfolioIndex?.slices
    ?.map((slice, index) => {
      const photos = (slice.photos || []).map(portfolioPhotoFromCms).filter(isEditablePortfolioPhoto)
      if (photos.length === 0) return undefined

      return {
        id: cleanText(slice.anchor) || `portfolio-slice-${index + 1}`,
        label: cleanText(slice.label) || cleanText(slice.heading) || `Portfolio Slice ${index + 1}`,
        heading: cleanText(slice.heading) || cleanText(slice.label) || `Portfolio Slice ${index + 1}`,
        lead: cleanText(slice.lead),
        href: toRootRelativeHref(slice.href) || '#archive',
        linkLabel: cleanText(slice.linkLabel) || 'Zur Seite ->',
        source: slice,
        theme: slice.theme === 'dark' ? 'dark' : 'light',
        photos,
      } satisfies EditablePortfolioSpread
    })
    .filter(isEditablePortfolioSpread) || []
const displaySpreads = (cmsSpreads.length > 0 ? cmsSpreads : portfolioSpreads) as EditablePortfolioSpread[]
const portfolioSelectionByKey: Record<string, { href: string; label: string }> = {
  auto: { href: '/portfolio/portfolio-auswahl-automobil', label: 'Automobil-Auswahl ansehen ->' },
  automobil: { href: '/portfolio/portfolio-auswahl-automobil', label: 'Automobil-Auswahl ansehen ->' },
  classic: { href: '/portfolio/portfolio-auswahl-oldtimer', label: 'Oldtimer-Auswahl ansehen ->' },
  land: { href: '/portfolio/portfolio-auswahl-landschaft', label: 'Landschaft-Auswahl ansehen ->' },
  landschaft: { href: '/portfolio/portfolio-auswahl-landschaft', label: 'Landschaft-Auswahl ansehen ->' },
  moto: { href: '/portfolio/portfolio-auswahl-motorrad', label: 'Motorrad-Auswahl ansehen ->' },
  motorrad: { href: '/portfolio/portfolio-auswahl-motorrad', label: 'Motorrad-Auswahl ansehen ->' },
  oldtimer: { href: '/portfolio/portfolio-auswahl-oldtimer', label: 'Oldtimer-Auswahl ansehen ->' },
  portrait: { href: '/portfolio/portfolio-auswahl-portrait', label: 'Portrait-Auswahl ansehen ->' },
  sport: { href: '/portfolio/portfolio-auswahl-sportwagen', label: 'Sportwagen-Auswahl ansehen ->' },
  sportwagen: { href: '/portfolio/portfolio-auswahl-sportwagen', label: 'Sportwagen-Auswahl ansehen ->' },
}
const normalizedPortfolioKey = (value?: string) =>
  cleanText(value)
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '')
const portfolioSelectionFor = (spread: EditablePortfolioSpread) =>
  spread.portfolioHref
    ? { href: toRootRelativeHref(spread.portfolioHref), label: cleanText(spread.portfolioLinkLabel) || 'Portfolio-Auswahl ansehen ->' }
    : portfolioSelectionByKey[normalizedPortfolioKey(spread.id)] || portfolioSelectionByKey[normalizedPortfolioKey(spread.label)]

const cmsArchivePhotos = (portfolioIndex?.archive?.items || []).map(portfolioPhotoFromCms).filter(isEditablePortfolioPhoto)
const archivePhotos = (cmsArchivePhotos.length > 0 ? cmsArchivePhotos : portfolioArchivePhotos) as EditablePortfolioPhoto[]
const archiveBatchSize = Math.max(1, Math.min(Number(portfolioIndex?.archive?.batchSize) || 12, archivePhotos.length || 12))
const archiveHeadline = cleanText(portfolioIndex?.archive?.headline) || 'Bildarchiv'
const contactSubject = cleanText(portfolioIndex?.contact?.subject) || 'Shooting Anfrage'
const contactHeadline = cleanText(portfolioIndex?.contact?.headline) || 'Shooting <em>anfragen.</em>'
const contactLead =
  cleanText(portfolioIndex?.contact?.lead) ||
  'Schreiben Sie kurz, welche Bildsprache Sie interessiert, wofuer die Aufnahmen genutzt werden und welchen Zeitraum Sie planen. Dann klaeren wir Motiv, Umfang, Rechte und Ausgabe sauber gemeinsam.'
---
<AdoptedPageLayout
  legacyFile="portfolio.html"
  current="portfolio"
  doc={doc}
  ctaHref="#anfrage"
  preloadImages={[firstHeroSlide.image]}
  liveCms
>
  <main>
    <section class="hero" data-theme="dark" data-header-theme="dark" aria-label="Portfolio" style={`background-image:url('${firstHeroSlide.image}')`} {...tinaAttrs(firstHeroSlideSource, 'image')}>
      <canvas id="hero-shader" aria-hidden="true" data-imgs={heroImages.join(',')} data-slides={heroSlidesJson} {...tinaAttrs(firstHeroSlideSource, 'image')}></canvas>
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-aperture" aria-hidden="true"></div>
      <div class="hero-grid">
        <div class="hero-stage">
          <h1 class="hero-title" id="hero-title" data-text-idx="0">
            {firstHeroSlide.titleLines.map((line, index) => (
              <>
                {index > 0 && ' '}
                <span class="line" {...tinaAttrs(firstHeroSlideSource, index === 0 ? 'headlineLine1' : 'headlineLine2')}><span class="word">{line}</span></span>
              </>
            ))}
          </h1>
          <p class="hero-lead" id="hero-lead" {...tinaAttrs(firstHeroSlideSource, 'lead')}>{firstHeroSlide.lead}</p>
          <div class="hero-actions" aria-label="Direkte Aktionen">
            <a class="btn dark" href={firstHeroSlide.primaryHref} data-hero-primary hidden={!firstHeroSlide.primaryHref || !firstHeroSlide.primaryLabel} {...tinaAttrs(firstHeroSlideSource, 'primaryLabel')}>{firstHeroSlide.primaryLabel}</a>
            <a class="btn" href={firstHeroSlide.secondaryHref} data-hero-secondary hidden={!firstHeroSlide.secondaryHref || !firstHeroSlide.secondaryLabel} {...tinaAttrs(firstHeroSlideSource, 'secondaryLabel')}>{firstHeroSlide.secondaryLabel}</a>
          </div>
        </div>
      </div>
      <div class="hero-cursor" id="hero-cursor" aria-hidden="true"><span class="ring"></span></div>
    </section>

    <section class="pf-context" data-header-theme="light" aria-label="Portfolio einordnen">
      <div class="pf-context__inner">
        <div>
          <div class="pf-context__kicker" {...tinaAttrs(portfolioIndex, 'contextKicker')}>{contextKicker}</div>
          <h2 {...tinaAttrs(portfolioIndex, 'contextHeadline')}>{contextHeadline}</h2>
        </div>
        <div>
          {contextParagraphs.map((paragraph, index) => <p {...tinaAttrs(portfolioIndex?.contextBody?.[index], 'text')}>{paragraph}</p>)}
        </div>
      </div>
    </section>

    {displaySpreads.map((spread) => (
      <section
        class={`pf-spread ${spread.theme === 'light' ? 'is-light' : ''}`.trim()}
        id={spread.id}
        data-header-theme={spread.theme}
        aria-label={spread.label}
      >
        <div class="pf-spread__head">
          <h2 {...tinaAttrs(spread.source, 'heading')}>{spread.heading}</h2>
          {spread.lead && <p class="pf-spread__lead" {...tinaAttrs(spread.source, 'lead')}>{spread.lead}</p>}
        </div>
        <div class="pf-spread__strip">
          {(spread.photos as EditablePortfolioPhoto[]).map((photo) => (
            <figure class="pf-photo">
              <img src={photo.src} alt={photo.caption || ''} loading="lazy" decoding="async" width={photo.width} height={photo.height} {...tinaAttrs(photo.source, 'image')} />
            </figure>
          ))}
        </div>
        <div class="pf-spread__links">
          <a class="pf-spread__cta" href={spread.href} {...tinaAttrs(spread.source, 'linkLabel')}>
            <span>{spread.linkLabel}</span>
          </a>
          {portfolioSelectionFor(spread) && (
            <a class="pf-spread__cta pf-spread__cta--portfolio" href={portfolioSelectionFor(spread)!.href}>
              <span>{portfolioSelectionFor(spread)!.label}</span>
            </a>
          )}
        </div>
      </section>
    ))}

    <section class="pf-archive" id="archive" data-header-theme="light" aria-label="Archiv">
      <div class="pf-archive__head">
        <h2 {...tinaAttrs(portfolioIndex?.archive, 'headline')}>{archiveHeadline}</h2>
      </div>
      <div class="pf-archive__grid" id="pfArchiveGrid" data-archive-batch={String(archiveBatchSize)}>
        {archivePhotos.map((photo, i) => (
          <a class="pf-photo" data-archive-item hidden={i >= archiveBatchSize} data-caption={photo.caption} href={photo.href} aria-label={photo.caption ? `${photo.caption} — Großansicht öffnen` : 'Bild im Großformat ansehen'}>
            <img
              src={photo.src}
              data-src={photo.src}
              alt={photo.caption || ''}
              loading="lazy"
              decoding="async"
              width={photo.width}
              height={photo.height}
              {...tinaAttrs(photo.source, 'image')}
            />
          </a>
        ))}
      </div>
    </section>

    <section
      id="anfrage"
      data-contact-section
      data-theme="light"
      data-contact-subject={contactSubject}
      data-contact-headline={contactHeadline}
      data-contact-lead={contactLead}
    />

    <div class="pf-viewer" id="pfViewer" aria-hidden="true" inert role="dialog" aria-label="Bildansicht">
      <button class="pf-viewer__close" type="button" id="pfClose">Schliessen</button>
      <button class="pf-viewer__prev" type="button" id="pfPrev" aria-label="Vorheriges Bild">&lsaquo;</button>
      <button class="pf-viewer__next" type="button" id="pfNext" aria-label="Naechstes Bild">&rsaquo;</button>
      <figure class="pf-viewer__figure">
        <img id="pfViewerImg" src={emptyImage} alt="" decoding="async" loading="lazy" width="1" height="1" />
      </figure>
      <span class="pf-viewer__cap" id="pfViewerCap"></span>
    </div>
  </main>
</AdoptedPageLayout>
