---
import NativeLocalSeoFamilyPage from '../cms/NativeLocalSeoFamilyPage.astro'
import NativeAboutPage from './NativeAboutPage.astro'
import NativeAutomobilPhotographyPage from './NativeAutomobilPhotographyPage.astro'
import NativeConceptArchivePage from './NativeConceptArchivePage.astro'
import NativeContactPage from './NativeContactPage.astro'
import NativeGrossformatdruckPage from './NativeGrossformatdruckPage.astro'
import NativeHomePage from './NativeHomePage.astro'
import NativeJournalIndexPage from './NativeJournalIndexPage.astro'
import NativeJournalArticleLegacyUrlPage from './NativeJournalArticleLegacyUrlPage.astro'
import NativeKeywordDatabasePage from './NativeKeywordDatabasePage.astro'
import NativeLandschaftPhotographyPage from './NativeLandschaftPhotographyPage.astro'
import NativeLegalPage from './NativeLegalPage.astro'
import NativeMotorradPhotographyPage from './NativeMotorradPhotographyPage.astro'
import NativeOldtimerPhotographyPage from './NativeOldtimerPhotographyPage.astro'
import NativePhotographyPage from './NativePhotographyPage.astro'
import NativePortfolioIndexPage from './NativePortfolioIndexPage.astro'
import NativePortraitPhotographyPage from './NativePortraitPhotographyPage.astro'
import NativePrintLabPage from './NativePrintLabPage.astro'
import NativeServiceDetailPage from './NativeServiceDetailPage.astro'
import NativeServicesIndexPage from './NativeServicesIndexPage.astro'
import NativeSportwagenPhotographyPage from './NativeSportwagenPhotographyPage.astro'
import NativeVideografiePage from './NativeVideografiePage.astro'
import NativeViolaMusikPage from './NativeViolaMusikPage.astro'
import NativeWebdesignSeoPage from './NativeWebdesignSeoPage.astro'
import NativeWerbetechnikPage from './NativeWerbetechnikPage.astro'
import { nativeAdoptedRouteKindForFile } from '../../lib/nativeAdoptedRouteRegistry'
import { getByLegacyUrlFromIndex, type PayloadDoc } from '../../lib/payload'

type Props = {
  doc?: PayloadDoc | null
  legacyFile: string
  localSeoDoc?: PayloadDoc | null
}

const { doc: providedDoc = null, legacyFile, localSeoDoc: providedLocalSeoDoc = undefined } = Astro.props as Props

const nativeRouteKind = nativeAdoptedRouteKindForFile(legacyFile)

if (!nativeRouteKind) {
  throw new Error(`No native Astro renderer is registered for adopted route "${legacyFile}".`)
}

const localSeoDoc =
  (nativeRouteKind === 'local-seo' || nativeRouteKind === 'photography-overview') && providedLocalSeoDoc === undefined
    ? await getByLegacyUrlFromIndex('local-seo-pages', legacyFile, { depth: 2, limit: 500 })
    : providedLocalSeoDoc
const serviceRouteKinds = new Set([
  'print-lab',
  'werbetechnik',
  'webdesign-seo',
  'videografie',
  'viola-musik',
  'grossformat',
  'keyword-database',
  'service-detail',
])
const serviceDoc =
  serviceRouteKinds.has(nativeRouteKind) && !providedDoc
    ? await getByLegacyUrlFromIndex('service-pages', legacyFile, { depth: 2, limit: 100 })
    : null
const routedDoc = providedDoc || localSeoDoc || serviceDoc || null
const routedDocProp = routedDoc || undefined

if (nativeRouteKind === 'legal') {
  Astro.response.headers.set('x-cms-render-source', 'structured-astro')
  Astro.response.headers.set('x-cms-page-kind', 'legal-native')
}

if (nativeRouteKind === 'journal-detail') {
  Astro.response.headers.set('x-cms-render-source', 'structured-astro')
  Astro.response.headers.set('x-cms-page-kind', 'journal-native-html-url')
}
---
{
  nativeRouteKind === 'home' ? (
    <NativeHomePage doc={routedDocProp} />
  ) : nativeRouteKind === 'photography' ? (
    <NativePhotographyPage doc={routedDocProp} />
  ) : nativeRouteKind === 'photography-overview' ? (
    <NativePhotographyPage doc={routedDocProp} legacyFile={legacyFile} />
  ) : nativeRouteKind === 'automobil' ? (
    <NativeAutomobilPhotographyPage doc={routedDoc} legacyFile={legacyFile} />
  ) : nativeRouteKind === 'sportscar' ? (
    <NativeSportwagenPhotographyPage doc={routedDoc} legacyFile={legacyFile} />
  ) : nativeRouteKind === 'oldtimer' ? (
    <NativeOldtimerPhotographyPage doc={routedDoc} legacyFile={legacyFile} />
  ) : nativeRouteKind === 'motorcycle' ? (
    <NativeMotorradPhotographyPage doc={routedDoc} legacyFile={legacyFile} />
  ) : nativeRouteKind === 'portrait' ? (
    <NativePortraitPhotographyPage doc={routedDoc} legacyFile={legacyFile} />
  ) : nativeRouteKind === 'landscape' ? (
    <NativeLandschaftPhotographyPage doc={routedDoc} legacyFile={legacyFile} />
  ) : nativeRouteKind === 'journal-index' ? (
    <NativeJournalIndexPage doc={routedDocProp} />
  ) : nativeRouteKind === 'journal-detail' ? (
    <NativeJournalArticleLegacyUrlPage legacyFile={legacyFile} />
  ) : nativeRouteKind === 'portfolio-index' ? (
    <NativePortfolioIndexPage doc={routedDocProp} />
  ) : nativeRouteKind === 'print-lab' ? (
    <NativePrintLabPage doc={routedDocProp} />
  ) : nativeRouteKind === 'werbetechnik' ? (
    <NativeWerbetechnikPage doc={routedDocProp} />
  ) : nativeRouteKind === 'webdesign-seo' ? (
    <NativeWebdesignSeoPage doc={routedDocProp} />
  ) : nativeRouteKind === 'keyword-database' ? (
    <NativeKeywordDatabasePage doc={routedDocProp} />
  ) : nativeRouteKind === 'videografie' ? (
    <NativeVideografiePage doc={routedDocProp} legacyFile={legacyFile} />
  ) : nativeRouteKind === 'viola-musik' ? (
    <NativeViolaMusikPage doc={routedDocProp} />
  ) : nativeRouteKind === 'grossformat' ? (
    <NativeGrossformatdruckPage doc={routedDocProp} />
  ) : nativeRouteKind === 'service-detail' ? (
    <NativeServiceDetailPage doc={routedDocProp} legacyFile={legacyFile} />
  ) : nativeRouteKind === 'services-index' ? (
    <NativeServicesIndexPage doc={routedDocProp} />
  ) : nativeRouteKind === 'contact' ? (
    <NativeContactPage />
  ) : nativeRouteKind === 'about' ? (
    <NativeAboutPage doc={routedDocProp} />
  ) : nativeRouteKind === 'legal' ? (
    <NativeLegalPage legacyFile={legacyFile as 'impressum.html' | 'datenschutz.html'} />
  ) : nativeRouteKind === 'concept' ? (
    <NativeConceptArchivePage legacyFile={legacyFile} />
  ) : nativeRouteKind === 'local-seo' ? (
    <NativeLocalSeoFamilyPage doc={localSeoDoc as PayloadDoc | null} legacyFile={legacyFile} />
  ) : null
}
