---
import AdoptedPageLayout from '../../layouts/AdoptedPageLayout.astro'
import { getBySlug, type PayloadDoc } from '../../lib/payload'
import { breadcrumbJsonLd, faqJsonLd, itemListJsonLd, type JsonLd } from '../../lib/seo'

type Props = {
  doc?: PayloadDoc
}

const legacyFile = 'keyword-datenbank-seo.html'
const providedDoc = (Astro.props as Props).doc
const doc = providedDoc || (await getBySlug('service-pages', 'keyword-datenbank-seo', { depth: 2 }))
const canonicalUrl = `https://matthiasramahi.de/${legacyFile}`
const crawlFoundryUrl = 'https://crawlfoundry.com/de/features/keyword-database'
const title = 'Crawl Foundry Keyword-Datenbank: Fallstudie | Matthias Ramahi'
const description =
  'Fallstudie zur Crawl Foundry Keyword-Datenbank: Wie aus verstreuter SEO-Recherche ein System für Suchintention, Themencluster, Wettbewerb und Priorisierung wurde.'

const heroShots = [
  {
    src: '/assets/contextter/keyword-database-hero-detail.webp',
    alt: 'Crawl Foundry Keyword-Datenbank mit Keyword-Liste und geöffnetem Detailpanel zu Suchvolumen, Intent und Trenddaten',
    label: 'Keyword-Details',
    width: 1920,
    height: 1081,
  },
  {
    src: '/assets/contextter/keyword-database-hero-list.webp',
    alt: 'Crawl Foundry Keyword-Datenbank in der Listenansicht mit Keywords, Suchintention, Volumen, CPC und Trendspalten',
    label: 'Listenansicht',
    width: 1920,
    height: 1080,
  },
  {
    src: '/assets/contextter/keyword-database-discovery.webp',
    alt: 'Crawl Foundry Discovery-Ansicht für neue Keyword-Ideen und semantische Erweiterungen',
    label: 'Discovery',
    width: 1800,
    height: 1013,
  },
  {
    src: '/assets/contextter/keyword-database-competition.webp',
    alt: 'Crawl Foundry Wettbewerber-Ansicht mit Domainvergleich, Keyword-Lücken und SERP-Positionen',
    label: 'Wettbewerb',
    width: 1800,
    height: 1012,
  },
]

const productSections = [
  {
    eyebrow: 'Produktentscheidung 01',
    title: 'Ein gemeinsamer Datenraum statt weiterer Einzelexporte.',
    body:
      'Die erste Entscheidung war, Keyword, Intent, Volumen, CPC, Entwicklung und Datenqualität nicht mehr in getrennten Tabellen zu bewerten. Die Listen- und Detailansicht hält diese Signale dort zusammen, wo eine Priorität festgelegt wird.',
    image: heroShots[0],
  },
  {
    eyebrow: 'Produktentscheidung 02',
    title: 'Discovery erweitert eine Recherche, ohne ihren Kontext zu verlieren.',
    body:
      'Neue Vorschläge sollten nicht als zweite, unverbundene Liste enden. Discovery erweitert Start-Keywords um verwandte Begriffe und führt geeignete Kandidaten direkt in die bestehende Themen- und Bewertungsstruktur zurück.',
    image: {
      src: '/assets/contextter/keyword-database-discovery.webp',
      alt: 'Crawl Foundry Discovery-Oberfläche mit semantischer Erweiterung und Google-Vorschlägen',
      width: 1800,
      height: 1013,
    },
  },
  {
    eyebrow: 'Produktentscheidung 03',
    title: 'SERP und Wettbewerb gehören zur Keyword-Bewertung.',
    body:
      'Suchvolumen allein sagt wenig darüber aus, welche Seite gebraucht wird und wie realistisch ein Thema ist. Deshalb zeigt die Wettbewerber-Ansicht Domains, Keyword-Lücken und SERP-Positionen im selben Recherchekontext.',
    image: {
      src: '/assets/contextter/keyword-database-competition.webp',
      alt: 'Crawl Foundry Wettbewerber-Ansicht mit Keyword-Lücken und Domainvergleich',
      width: 1800,
      height: 1012,
    },
  },
] as const

const workflow = [
  ['01', 'Problem abgrenzen', 'Verstreute Listen, fehlender Kontext und unklare Prioritäten als Kernproblem definieren.'],
  ['02', 'Datenmodell ordnen', 'Keywords, Intent, Kennzahlen, Themen und Zielseiten in einer Struktur zusammenführen.'],
  ['03', 'Entscheidungen sichtbar machen', 'Discovery, SERP, Wettbewerb und Matrix direkt an die Recherche anbinden.'],
  ['04', 'Weiterarbeit ermöglichen', 'Cluster, Exporte und nachvollziehbare Prioritäten für Content und Seiten nutzen.'],
] as const

const focusCards = [
  {
    title: 'Ausgangslage',
    text: 'Keyword-Ideen lagen in Tools, Tabellen und Notizen. Bei der späteren Content-Entscheidung fehlten Suchintention, SERP-Kontext und eine gemeinsame Priorität.',
  },
  {
    title: 'Produktziel',
    text: 'Aus der Recherche sollte ein dauerhaft nutzbares System werden, das Keywords, Themencluster, Zielseiten und Wettbewerbsdaten zusammen bewertet.',
  },
  {
    title: 'Bewusste Grenze',
    text: 'Crawl Foundry soll Entscheidungen besser vorbereiten. Das Produkt ersetzt weder fachliche SEO-Strategie noch gute Inhalte und verspricht keine Rankings.',
  },
] as const

const faqs = [
  {
    question: 'Was zeigt diese Fallstudie?',
    answer:
      'Sie dokumentiert die Ausgangslage, die wichtigsten Produktentscheidungen und den aktuellen Stand der Crawl Foundry Keyword-Datenbank. Die gezeigten Screenshots stammen aus der tatsächlichen Oberfläche.',
  },
  {
    question: 'Wie ist Matthias Ramahi mit Crawl Foundry verbunden?',
    answer:
      'Crawl Foundry ist ein Softwareprojekt, an dessen Produkt- und SEO-Struktur ich arbeite. Diese Seite ist deshalb keine unabhängige Bewertung, sondern eine persönliche Fallstudie aus der Produktentwicklung.',
  },
  {
    question: 'Ist die gezeigte Keyword-Datenbank nur ein Konzept?',
    answer:
      'Nein. Die Screenshots zeigen reale Produktbereiche wie Keyword-Liste, Detailpanel, Discovery, Wettbewerb, Matrix und Export. Den aktuellen Produktstand findest du direkt auf Crawl Foundry.',
  },
  {
    question: 'Garantiert Crawl Foundry bessere Rankings?',
    answer:
      'Nein. Rankings lassen sich nicht garantieren. Eine strukturierte Keyword-Datenbank kann aber helfen, bessere Prioritäten zu setzen und SEO-Arbeit nachvollziehbarer zu machen.',
  },
  {
    question: 'Wo kann ich die Keyword-Datenbank ansehen?',
    answer:
      'Die deutsche Produktseite auf Crawl Foundry zeigt die Keyword-Datenbank, ihren aktuellen Funktionsumfang und den Zugang zum Produkt.',
  },
]

const softwareApplication = {
  '@type': 'SoftwareApplication',
  name: 'Crawl Foundry Keyword-Datenbank',
  url: crawlFoundryUrl,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
}

const jsonLdItems: JsonLd[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${canonicalUrl}#webpage`,
    name: 'Crawl Foundry Keyword-Datenbank: Fallstudie',
    description,
    url: canonicalUrl,
    inLanguage: 'de-DE',
    isPartOf: { '@id': 'https://matthiasramahi.de/#website' },
    primaryImageOfPage: {
      '@type': 'ImageObject',
      url: `https://matthiasramahi.de${heroShots[0].src}`,
    },
    about: softwareApplication,
    keywords: 'Keyword-Datenbank, Keyword-Recherche, Suchintention, Themencluster, SERP-Analyse',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    '@id': `${canonicalUrl}#article`,
    headline: 'Crawl Foundry Keyword-Datenbank: Fallstudie',
    description,
    image: `https://matthiasramahi.de${heroShots[0].src}`,
    datePublished: '2026-06-25',
    dateModified: '2026-07-28',
    author: { '@id': 'https://matthiasramahi.de/#person' },
    publisher: { '@id': 'https://matthiasramahi.de/#local-business' },
    mainEntityOfPage: { '@id': `${canonicalUrl}#webpage` },
    about: softwareApplication,
  },
  breadcrumbJsonLd([
    { name: 'Startseite', url: '/' },
    { name: 'Weitere Dienstleistungen', url: '/leistungen.html' },
    { name: 'Crawl Foundry Fallstudie', url: canonicalUrl },
  ]),
  itemListJsonLd(
    workflow.map(([, name]) => ({ name, url: canonicalUrl })),
    { name: 'Produktentscheidungen der Crawl Foundry Keyword-Datenbank', url: canonicalUrl },
  ),
]

const faqSchema = faqJsonLd(faqs)
if (faqSchema) jsonLdItems.push(faqSchema)
---

<AdoptedPageLayout
  legacyFile={legacyFile}
  current="leistungen"
  doc={doc}
  title={title}
  description={doc?.seo?.description || description}
  canonicalUrl={canonicalUrl}
  ogImage={heroShots[0].src}
  preloadImages={[heroShots[0].src, heroShots[1].src]}
  jsonLd={jsonLdItems}
>
  <main class="kd-page">
    <section class="kd-hero" data-header-theme="dark" aria-label="Fallstudie zur Crawl Foundry Keyword-Datenbank">
      <div class="kd-hero__backdrop" aria-hidden="true">
        {heroShots.map((shot, index) => (
          <img
            class:list={['kd-hero-bg', { 'is-active': index === 0 }]}
            data-kd-hero-slide
            src={shot.src}
            alt=""
            width={shot.width}
            height={shot.height}
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
            fetchpriority={index === 0 ? 'high' : undefined}
          />
        ))}
      </div>
      <div class="kd-hero__field" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>

      <div class="kd-hero__inner">
        <div class="kd-hero__copy">
          <h1>Crawl Foundry Keyword-Datenbank.</h1>
          <p class="kd-hero__lead">
            Fallstudie: Wie ich aus verstreuter Keyword-Recherche ein nachvollziehbares System für
            Suchintention, Themencluster, SERP- und Wettbewerbsdaten sowie Content-Prioritäten entwickelt habe.
          </p>
          <div class="kd-actions" aria-label="Nächste Schritte">
            <a class="kd-btn kd-btn--primary" href={crawlFoundryUrl}>
              Auf Crawl Foundry ansehen
              <span aria-hidden="true">+</span>
            </a>
            <a class="kd-btn" href="#fallstudie">
              Fallstudie lesen
              <span aria-hidden="true">+</span>
            </a>
          </div>
        </div>

        <div class="kd-hero__bottom" aria-label="Aktiver Produktbereich">
          <p>Fallstudie · Produktentwicklung · SEO-Arbeitsprozess</p>
          <span data-kd-hero-label>{heroShots[0].label}</span>
        </div>
      </div>
    </section>

    <section id="fallstudie" class="kd-intro" data-header-theme="light" aria-labelledby="kd-intro-title">
      <div class="kd-section-head">
        <p>Ausgangslage</p>
        <h2 id="kd-intro-title">Warum aus SEO-Recherche ein eigenes System werden musste.</h2>
      </div>
      <div class="kd-intro__grid">
        <div class="kd-intro__copy">
          <p>
            Beim Ausbau von Websites wie dieser entsteht schnell dasselbe Problem: Keyword-Ideen kommen aus
            mehreren Quellen, Exporte altern und wichtige Entscheidungen verschwinden zwischen Tabellen,
            Tool-Tabs und Notizen. Später ist kaum noch nachvollziehbar, warum ein Thema priorisiert wurde.
          </p>
          <p>
            Für Crawl Foundry habe ich daraus ein klares Produktziel abgeleitet: Eine Keyword-Datenbank soll nicht
            möglichst viele Zahlen zeigen, sondern Recherche in eine belastbare Arbeitsgrundlage übersetzen.
            Suchintention, Themencluster, Zielseiten, SERP-Kontext und Prioritäten müssen zusammenbleiben.
          </p>
          <p>
            Genau dafür nutze ich Crawl Foundry auch bei dieser Website. Keyword-Recherche, Suchintentionen und der
            Aufbau der Themen- und Leistungsseiten werden dort gesammelt und priorisiert. Die Fallstudie zeigt
            damit keinen losgelösten Demo-Fall, sondern einen Arbeitsprozess, der in diesem Projekt tatsächlich
            verwendet wird.
          </p>
        </div>
        <div class="kd-focus">
          {focusCards.map((card) => (
            <article>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="kd-showcase" data-header-theme="dark" aria-labelledby="kd-showcase-title">
      <div class="kd-showcase__inner">
        <div class="kd-showcase__copy">
          <p>Beleg statt Behauptung</p>
          <h2 id="kd-showcase-title">Die Fallstudie zeigt den tatsächlich gebauten Stand.</h2>
          <p>
            Die Screenshots zeigen reale Bereiche der Crawl Foundry Keyword-Datenbank: Listenansicht, Detailpanel,
            Discovery, Matrix, Wettbewerber und Export. Dadurch bleibt nachvollziehbar, welche Entscheidungen
            bereits im Produkt umgesetzt sind und worüber diese Fallstudie konkret spricht.
          </p>
        </div>
        <figure class="kd-wide-shot">
          <img
            src="/assets/contextter/keyword-database-hero-detail.webp"
            alt="Crawl Foundry Keyword-Datenbank mit Keyword-Liste und Detailpanel"
            width="1920"
            height="1081"
            loading="lazy"
            decoding="async"
          />
          <figcaption>Keyword-Liste mit Detailpanel: Intent, Volumen, Trends und Wettbewerbsdaten bleiben zusammen.</figcaption>
        </figure>
      </div>
    </section>

    <section class="kd-product" data-header-theme="light" aria-labelledby="kd-product-title">
      <div class="kd-section-head">
        <p>Produktentscheidungen</p>
        <h2 id="kd-product-title">Drei Entscheidungen prägen die Keyword-Datenbank.</h2>
      </div>
      <div class="kd-product__list">
        {productSections.map((section, index) => (
          <article class:list={['kd-product-row', { 'is-reversed': index % 2 === 1 }]}>
            <figure>
              <img
                src={section.image.src}
                alt={section.image.alt}
                width={section.image.width}
                height={section.image.height}
                loading="lazy"
                decoding="async"
              />
            </figure>
            <div>
              <p>{section.eyebrow}</p>
              <h3>{section.title}</h3>
              <p>{section.body}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="kd-matrix-section" data-header-theme="light" aria-labelledby="kd-matrix-title">
      <div class="kd-matrix-section__inner">
        <div class="kd-matrix-copy">
          <p>Produktentscheidung 04</p>
          <h2 id="kd-matrix-title">Priorisieren, bevor Content produziert wird.</h2>
          <p>
            Die Matrix trennt rohe Ideen von belastbaren Themenchancen. Suchvolumen, Schwierigkeit,
            Suchintention und Content-Potenzial werden gegeneinander gehalten. Das Ergebnis ist keine automatische
            Freigabe, sondern eine verständliche Grundlage für die nächste fachliche Entscheidung.
          </p>
        </div>
        <figure class="kd-media-card">
          <img
            src="/assets/contextter/keyword-database-matrix.webp"
            alt="Crawl Foundry Matrix-Ansicht für Keyword-Potenziale und Themenchancen"
            width="1800"
            height="1013"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <section class="kd-flow" data-header-theme="dark" aria-labelledby="kd-flow-title">
      <div class="kd-flow__intro">
        <p>Entwicklungsweg</p>
        <h2 id="kd-flow-title">So wurde aus der Recherche ein klarer Ablauf.</h2>
      </div>
      <div class="kd-flow__steps">
        {workflow.map(([number, stepTitle, body]) => (
          <article>
            <span>{number}</span>
            <h3>{stepTitle}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="kd-export" data-header-theme="light" aria-labelledby="kd-export-title">
      <figure class="kd-media-card">
        <img
          src="/assets/contextter/keyword-database-export.webp"
          alt="Crawl Foundry Export-Dialog für Keyword-Daten als Excel, CSV, JSON, Kopie oder SEO-Tool-Export"
          width="1400"
          height="1088"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div>
        <p>Produktentscheidung 05</p>
        <h2 id="kd-export-title">Daten müssen nutzbar bleiben.</h2>
        <p>
          Eine Datenbank darf nicht zum neuen Datensilo werden. Exporte und nachvollziehbare Listen machen die
          Recherche anschlussfähig für Briefings, Redaktionspläne, Abstimmung und technische SEO-Aufgaben.
        </p>
        <a class="kd-text-link" href={crawlFoundryUrl}>
          Aktuellen Produktstand auf Crawl Foundry ansehen
        </a>
      </div>
    </section>

    <section class="kd-seo" data-header-theme="dark" aria-labelledby="kd-seo-title">
      <div class="kd-seo__inner">
        <h2 id="kd-seo-title">Was diese Fallstudie nicht behauptet.</h2>
        <p>
          Eine Keyword-Datenbank garantiert keine Rankings und ersetzt weder Erfahrung noch originelle Inhalte.
          Sie kann aber den Weg von der Recherche zur Entscheidung nachvollziehbar machen. Genau diesen begrenzten,
          praktischen Nutzen soll Crawl Foundry liefern.
        </p>
        <a class="kd-btn kd-btn--light" href={crawlFoundryUrl}>
          Auf Crawl Foundry ansehen
          <span aria-hidden="true">+</span>
        </a>
      </div>
    </section>

    <section class="kd-faq" data-header-theme="light" aria-labelledby="kd-faq-title">
      <div class="kd-faq__head">
        <p>FAQ</p>
        <h2 id="kd-faq-title">Fragen zur Fallstudie und zu Crawl Foundry.</h2>
      </div>
      <div class="kd-faq__list">
        {faqs.map((item) => (
          <article>
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="kd-final" data-header-theme="light" aria-label="Crawl Foundry Keyword-Datenbank">
      <div>
        <h2>Die Keyword-Datenbank direkt bei Crawl Foundry ansehen.</h2>
        <p>
          Die Crawl-Foundry-Produktseite zeigt den aktuellen Funktionsumfang und den Zugang zur Keyword-Datenbank.
        </p>
      </div>
      <div class="kd-actions">
        <a class="kd-btn kd-btn--primary" href={crawlFoundryUrl}>
          Zu Crawl Foundry
          <span aria-hidden="true">+</span>
        </a>
      </div>
    </section>
  </main>
</AdoptedPageLayout>
