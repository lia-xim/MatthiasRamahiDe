---
import AdoptedPageLayout from '../../layouts/AdoptedPageLayout.astro'
import NativeShaderHero from './NativeShaderHero.astro'
import { type JournalPostCard, journalCards, journalFilters, journalHero, journalHeroSlides, journalTicker } from '../../lib/journalIndexContent'
import { homeHeroSlidesFor } from '../../lib/nativeContent'
import { tinaAttrs } from '../../lib/tinaFieldAttrs'
import {
  getSitePageByType,
  imageAlt,
  imageDimensions,
  imageDisplayUrl,
  listDocuments,
  liveCmsFetchOptions,
  routeForDoc,
  toRootRelativeHref,
  type PayloadDoc,
} from '../../lib/payload'

type EditableJournalPostCard = JournalPostCard & { source?: PayloadDoc }

const providedDoc = Astro.props.doc as PayloadDoc | undefined
const doc = providedDoc || (await getSitePageByType('journal-index', liveCmsFetchOptions({ depth: 2 })))
const cmsPosts = await listDocuments('journal-posts', liveCmsFetchOptions({ limit: 12, sort: '-publishedAt', depth: 2 }))
const legacyPostBySlug = new Map(journalCards.map((post) => [post.href.replace(/^\//, '').replace(/\.html$/i, ''), post]))
const categoryToFilter: Record<string, string> = {
  automotive: 'automotive',
  portrait: 'portrait',
  process: 'prozess',
  'behind-the-scenes': 'prozess',
  'landscape-print': 'print',
}
const cmsCards = cmsPosts
  .map((post, index): EditableJournalPostCard | null => {
    const slug = post.slug || ''
    if (!slug) return null

    const fallback = legacyPostBySlug.get(slug) || journalCards[index]
    const image = imageDisplayUrl(post.coverImage, 'card') || fallback?.image || journalHero.image
    const dimensions = imageDimensions(post.coverImage, 'card')
    const category = categoryToFilter[String(post.category || '')] || fallback?.category || 'prozess'
    const legacyHref = typeof post.seo?.legacyUrl === 'string' && post.seo.legacyUrl ? `/${post.seo.legacyUrl}` : ''

    return {
      category,
      dark: fallback?.dark ?? index % 3 === 0,
      eager: index < 3,
      height: dimensions.height || fallback?.height || 1280,
      href: legacyHref || routeForDoc('journal-posts', post),
      image,
      imageAlt: imageAlt(post.coverImage, post.title || fallback?.imageAlt || 'Journal-Bild'),
      readTime: typeof post.readingTime === 'number' ? `${post.readingTime} Min` : fallback?.readTime || '5 Min',
      source: post,
      text: post.excerpt || fallback?.text || '',
      title: post.title || fallback?.title || 'Journal-Beitrag',
      width: dimensions.width || fallback?.width || 1920,
    }
  })
  .filter(Boolean) as EditableJournalPostCard[]
const posts = cmsCards.length > 0 ? cmsCards : journalCards
const hasText = (value?: string): value is string => typeof value === 'string' && value.trim().length > 0
const journalIndex = doc?.journalIndex
const heroLead = doc?.intro || journalHero.lead
const cmsHeroSlides = (doc?.heroSlides || []).length > 0 ? homeHeroSlidesFor(doc) : []
const fallbackHeroSlides = journalHeroSlides.map((slide, index) => (index === 0 ? { ...slide, lead: heroLead } : slide))
const heroSlides = cmsHeroSlides.length ? cmsHeroSlides : fallbackHeroSlides
const firstHeroSlide = heroSlides[0]
const tickerItems = (journalIndex?.tickerItems || []).map((item) => item.text).filter(hasText)
const resolvedTicker = tickerItems.length ? tickerItems : journalTicker
const cmsFilters = (journalIndex?.filters || [])
  .filter((filter) => hasText(filter.label) && hasText(filter.value))
  .map((filter) => ({ label: filter.label!, value: filter.value! }))
const resolvedFilters = cmsFilters.length ? cmsFilters : journalFilters
const indexHeadline = hasText(journalIndex?.indexHeadline) ? journalIndex!.indexHeadline! : 'Journal Index.'
const initialVisiblePostCount = Math.max(1, Number(journalIndex?.initialVisiblePostCount) || 6)
const loadMoreLabel = hasText(journalIndex?.loadMoreLabel) ? journalIndex!.loadMoreLabel! : 'Mehr Beitraege laden'
const loadStatusTemplate = hasText(journalIndex?.loadStatusTemplate)
  ? journalIndex!.loadStatusTemplate!
  : '{visible} von {total} Beitraegen sichtbar'
const featured = posts[0]
const featuredSettings = journalIndex?.featured || {}
const featuredHref = toRootRelativeHref(featuredSettings.buttonHref) || featured?.href || '/blog-automotive-fotografie-duesseldorf.html'
const featuredImage = imageDisplayUrl(featuredSettings.image, 'wide', { allowOriginal: true }) || featured?.image || journalHero.image
const featuredImageDimensions = imageDimensions(featuredSettings.image, 'wide')
const featuredKicker = hasText(featuredSettings.kicker) ? featuredSettings.kicker! : 'Ausgewaehlter Beitrag'
const featuredHeadline = hasText(featuredSettings.headline) ? featuredSettings.headline! : featured?.title || 'Geplant, nicht zufaellig.'
const featuredText = hasText(featuredSettings.text)
  ? featuredSettings.text!
  : featured?.text || 'Ein starkes Foto entsteht nicht erst beim Ausloesen - sondern in der Entscheidung fuer Ort, Tageszeit, Bildschnitt und Stimmung.'
const featuredButtonLabel = hasText(featuredSettings.buttonLabel) ? featuredSettings.buttonLabel! : 'Beitrag lesen'
const gridPosts = posts.slice(1)
const loadStatus = loadStatusTemplate
  .replace('{visible}', String(Math.min(initialVisiblePostCount, gridPosts.length)))
  .replace('{total}', String(gridPosts.length))
const finalCta = journalIndex?.finalCta || {}
const finalKicker = hasText(finalCta.kicker) ? finalCta.kicker! : 'Naechster Schritt'
const finalHeadline = hasText(finalCta.headline) ? finalCta.headline! : 'Fotoauftrag planen.'
const finalText = hasText(finalCta.text)
  ? finalCta.text!
  : 'Wenn Sie Automotive-Aufnahmen, Portraits, eine Bildstrecke oder eine hochwertige visuelle Praesentation benoetigen, schicken Sie kurz Ort, Zeitraum und Ziel des Projekts.'
const finalPrimaryLabel = hasText(finalCta.primaryLabel) ? finalCta.primaryLabel! : 'Projekt anfragen'
const finalPrimaryHref = toRootRelativeHref(finalCta.primaryHref) || '/contact.html'
const finalSecondaryLabel = hasText(finalCta.secondaryLabel) ? finalCta.secondaryLabel! : 'Portfolio ansehen'
const finalSecondaryHref = toRootRelativeHref(finalCta.secondaryHref) || '/portfolio.html'
---
<AdoptedPageLayout legacyFile="blog.html" current="blog" doc={doc} preloadImages={[firstHeroSlide.image]}>
  <div class="light" aria-hidden="true"></div>
  <main>
    <NativeShaderHero id="top" label="Journal Intro" slides={heroSlides} sourceSlides={doc?.heroSlides || []} headerTheme="dark" />

    <section class="ticker" aria-label="Themenlaufband">
      <div class="ticker-track">
        {resolvedTicker.map((item, index) => <span set:html={item} {...tinaAttrs(journalIndex?.tickerItems?.[index], 'text')}></span>)}
      </div>
    </section>

    {featured && (
      <section class="featured" aria-label="Im Fokus">
        <a class="featured__link" href={featuredHref} aria-label={`Beitrag lesen: ${featuredHeadline}`}></a>
        <div class="featured__inner">
          <figure class="featured__media">
            <img
              src={featuredImage}
              alt={imageAlt(featuredSettings.image, featured.imageAlt || featuredHeadline)}
              width={featuredImageDimensions.width || featured.width}
              height={featuredImageDimensions.height || featured.height}
              decoding="async"
              loading="eager"
              {...tinaAttrs(featuredSettings, 'image')}
            />
          </figure>
          <div class="featured__copy">
            <p class="featured__meta"><span {...tinaAttrs(featuredSettings, 'kicker')}>{featuredKicker}</span></p>
            <h2 class="featured__title" {...tinaAttrs(featuredSettings, 'headline')}>{featuredHeadline}</h2>
            <p class="featured__excerpt" {...tinaAttrs(featuredSettings, 'text')}>{featuredText}</p>
            <span class="featured__go" {...tinaAttrs(featuredSettings, 'buttonLabel')}>{featuredButtonLabel}</span>
          </div>
        </div>
      </section>
    )}

    <section class="journal" id="journal" aria-label="Journal Artikel">
      <div class="journal-head">
        <h2 {...tinaAttrs(journalIndex, 'indexHeadline')}>{indexHeadline}</h2>
        <div class="filters" aria-label="Artikel filtern">
          {resolvedFilters.map((filter, index) => (
            <button class={`filter ${index === 0 ? 'active' : ''}`.trim()} type="button" data-filter={filter.value} {...tinaAttrs(journalIndex?.filters?.[index], 'label')}>{filter.label}</button>
          ))}
        </div>
      </div>
      <div class="post-grid">
        {gridPosts.map((post, index) => (
          <a
            class={`post ${post.dark ? 'dark' : ''} ${index >= initialVisiblePostCount ? 'not-loaded' : ''}`.trim()}
            href={post.href}
            data-category={post.category}
            style={index < initialVisiblePostCount ? 'grid-column:span 4' : undefined}
          >
            <div class="post-media">
              <img
                src={post.image}
                data-src={post.image}
                alt={post.imageAlt}
                width={post.width}
                height={post.height}
                decoding="async"
                loading="lazy"
                {...tinaAttrs((post as EditableJournalPostCard).source, 'coverImage')}
              />
            </div>
            <div class="post-body">
              <h3 {...tinaAttrs((post as EditableJournalPostCard).source, 'title')}>{post.title}</h3>
              <p {...tinaAttrs((post as EditableJournalPostCard).source, 'excerpt')}>{post.text}</p>
              <span class="post-go">Beitrag lesen</span>
            </div>
          </a>
        ))}
      </div>
      <div class="load-panel" id="loadPanel" aria-live="polite">
        <span class="load-status" id="loadStatus">{loadStatus}</span>
        <button class="load-more" id="loadMore" type="button" {...tinaAttrs(journalIndex, 'loadMoreLabel')}>{loadMoreLabel}</button>
      </div>
    </section>

    <section class="final" aria-label="Kontakt CTA">
      <p class="kicker" {...tinaAttrs(finalCta, 'kicker')}>{finalKicker}</p>
      <h2 set:html={finalHeadline} {...tinaAttrs(finalCta, 'headline')}></h2>
      <p {...tinaAttrs(finalCta, 'text')}>{finalText}</p>
      <div class="hero-actions">
        <a class="btn primary" href={finalPrimaryHref} {...tinaAttrs(finalCta, 'primaryLabel')}>{finalPrimaryLabel}</a>
        <a class="btn" href={finalSecondaryHref} {...tinaAttrs(finalCta, 'secondaryLabel')}>{finalSecondaryLabel}</a>
      </div>
    </section>
  </main>
</AdoptedPageLayout>
