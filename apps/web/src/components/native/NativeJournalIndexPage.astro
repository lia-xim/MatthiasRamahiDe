---
// Journal-Uebersicht mit crawlbarer Paginierung und Themen-Seiten.
// Rendert /blog.html (Seite 1), /journal/seite/N und /journal/thema/<thema>[/seite/N].
// Jede Seite zeigt JOURNAL_PAGE_SIZE Beiträge als echte Links und verlinkt alle
// Nachbarseiten, damit Google jeden Artikel ohne JavaScript erreicht.
import AdoptedPageLayout from '../../layouts/AdoptedPageLayout.astro'
import GooglePreferredSource from './GooglePreferredSource.astro'
import NativeRecentShoots from './NativeRecentShoots.astro'
import HeroMotion from './HeroMotion.astro'
import { lookupLocalThumb } from '../../data/localResponsiveThumbs'
import { tinaAttrs } from '../../lib/tinaFieldAttrs'
import { getSitePageByType, liveCmsFetchOptions, toAbsoluteSiteUrl, toRootRelativeHref, type PayloadDoc } from '../../lib/payload'
import { countJournalTopics, getJournalIndexPosts, sliceJournalPosts, type EditableJournalPostCard } from '../../lib/journalIndexPosts'
import { getLegacyRedirectTarget } from '../../lib/adoptedRoutes'
import { journalStageImage } from '../../lib/journalStageImage'
import {
  JOURNAL_PAGE_SIZE,
  formatJournalDate,
  journalIndexPath,
  journalPageWindow,
  journalTopicBySlug,
  journalTopics,
} from '../../lib/journalIndexRoutes'

type Props = { doc?: PayloadDoc | null; topicSlug?: string; page?: number }

const { topicSlug, page: requestedPage = 1 } = Astro.props as Props
const providedDoc = Astro.props.doc as PayloadDoc | undefined
const doc = providedDoc || (await getSitePageByType('journal-index', liveCmsFetchOptions({ depth: 2 })))
const topic = journalTopicBySlug(topicSlug) ?? null
const allPosts = await getJournalIndexPosts()
const slice = sliceJournalPosts(allPosts, topic, Math.max(1, requestedPage))
const { page, totalPages } = slice
const topicCounts = countJournalTopics(allPosts)
const hasText = (value?: string | null): value is string => typeof value === 'string' && value.trim().length > 0

const resolveCanonicalHref = (rawHref?: string | null) => {
  const rootHref = toRootRelativeHref(rawHref || undefined)
  if (!rootHref || rootHref === '/' || rootHref.startsWith('#') || /^(?:https?:|mailto:|tel:)/i.test(rootHref)) {
    return rootHref
  }
  const [pathAndQuery, hash = ''] = rootHref.split('#')
  const [rawPath, query = ''] = pathAndQuery.split('?')
  let current = rawPath.replace(/^\/+/, '').toLowerCase()
  let pathname = rawPath
  const seen = new Set<string>([current])
  for (let hop = 0; hop < 4; hop += 1) {
    if (!current || current.includes('/')) break
    const target = getLegacyRedirectTarget(current)
    if (target === null) break
    if (target === '') {
      pathname = '/'
      break
    }
    const next = target.replace(/^\/+/, '')
    pathname = `/${next}`
    const nextLower = next.toLowerCase()
    if (seen.has(nextLower)) break
    seen.add(nextLower)
    current = nextLower
  }
  return `${pathname}${query ? `?${query}` : ''}${hash ? `#${hash}` : ''}`
}

const topicPillarMap: Record<string, { href: string; label: string }> = {
  automotive: { href: resolveCanonicalHref('/automobil-fotografie.html') || '/autofotografie.html', label: 'Zur Automobilfotografie' },
  sportwagen: { href: resolveCanonicalHref('/sportwagen-fotografie.html') || '/sportwagen-fotografie.html', label: 'Zur Sportwagenfotografie' },
  oldtimer: { href: resolveCanonicalHref('/oldtimer-fotografie.html') || '/oldtimer-fotografie.html', label: 'Zur Oldtimerfotografie' },
  motorrad: { href: resolveCanonicalHref('/motorrad-fotografie.html') || '/motorrad-fotografie.html', label: 'Zur Motorradfotografie' },
  portrait: { href: resolveCanonicalHref('/portraitfotografie.html') || '/portraitfotografie.html', label: 'Zur Portraitfotografie' },
  prozess: { href: resolveCanonicalHref('/fotografie.html') || '/fotografie.html', label: 'Alle Fotografie-Bereiche' },
  print: { href: resolveCanonicalHref('/landschaftsfotografie.html') || '/landschaftsfotografie.html', label: 'Zu Landschaft & Fine-Art-Prints' },
}
const activeTopicPillar = topic ? topicPillarMap[topic.filter] : null

const journalIndex = doc?.journalIndex
const labelForCategory = (category: string) => journalTopics.find((entry) => entry.filter === category)?.label || 'Journal'

// ---------- Kopf ----------
// Bildgeführter Hero wie auf den anderen Hauptseiten: HeroMotion "pan" mit den
// Titelbildern der neuesten (bzw. kuratierten) Querformat-Beiträge.
const headline = topic ? topic.label : 'Journal'
const lead = topic
  ? topic.intro
  : 'Notizen aus echten Shootings über Licht, Orte, Bildauswahl und Druck, damit du dein nächstes Shooting besser planen kannst.'

const heroPool = topic ? allPosts.filter((post) => post.category === topic.filter) : allPosts
const curatedFeaturedHref = toRootRelativeHref(journalIndex?.featured?.buttonHref)
const curatedPost = !topic && curatedFeaturedHref ? heroPool.find((post) => post.href === curatedFeaturedHref) : undefined
// Der Link zeigt immer auf den neuesten Beitrag; ein kuratierter Beitrag
// (CMS "featured") liefert nur das zweite Bühnenbild.
const latestPost = heroPool[0]
const latestLabel = 'Neu im Journal'

type HeroSlide = { src: string; srcset?: string; width?: number; height?: number }
const maxSrcsetWidth = (srcset?: string) =>
  Math.max(0, ...(srcset || '').split(',').map((entry) => Number(entry.trim().match(/\s(\d+)w$/)?.[1] || 0)))
// Vollflächige Bühne: nur Querformate mit mindestens ~1600 px breiter Quelle,
// sonst wirkt das Bild auf grossen Bildschirmen weich.
const heroSlideFor = (post: EditableJournalPostCard, minWidth = 1600): HeroSlide | null => {
  const cover = post.source?.coverImage || post.image
  const stage = journalStageImage(cover)
  if (stage && stage.width && stage.height && maxSrcsetWidth(stage.srcset) >= minWidth) {
    return stage.width >= stage.height * 1.2 ? { src: stage.src, srcset: stage.srcset, width: stage.width, height: stage.height } : null
  }
  const raw = typeof cover === 'string' ? cover : post.image
  const thumb = lookupLocalThumb(raw)
  // /thumbs/-Pfade sind Vorschaubilder, auch wenn das Manifest Originalmasse nennt.
  if (thumb && !/\/thumbs\//i.test(raw) && thumb.width >= minWidth && thumb.width >= thumb.height * 1.2) {
    const original = `/${raw.replace(/^\/+/, '').split(/[?#]/, 1)[0]}`
    return { src: original, srcset: `${thumb.w760} 760w, ${original} ${thumb.width}w`, width: thumb.width, height: thumb.height }
  }
  return null
}
const collectHeroSlides = (posts: EditableJournalPostCard[], minWidth: number) => {
  const slides: HeroSlide[] = []
  for (const post of posts) {
    if (slides.length >= 5) break
    const slide = heroSlideFor(post, minWidth)
    if (slide && !slides.some((entry) => entry.src === slide.src)) slides.push(slide)
  }
  return slides
}
// Themen mit wenigen grossen Querformaten: erst kleinere Quellen des Themas,
// dann die neuesten Bilder des ganzen Journals.
const heroOrder = [...(latestPost ? [latestPost] : []), ...(curatedPost ? [curatedPost] : []), ...heroPool]
let heroSlides = collectHeroSlides(heroOrder, 1600)
if (heroSlides.length === 0) heroSlides = collectHeroSlides(heroOrder, 1100)
if (heroSlides.length === 0) heroSlides = collectHeroSlides(allPosts, 1600)
const heroSizes = '100vw'
const heroPreload = heroSlides[0]
  ? { href: heroSlides[0].src, imagesrcset: heroSlides[0].srcset, imagesizes: heroSlides[0].srcset ? heroSizes : undefined, fetchpriority: 'high' as const }
  : null

// Alle Beiträge der Seite im Raster, damit Seite 2 nahtlos anschliesst.
const gridPosts = slice.posts
const gridStartIndex = (page - 1) * JOURNAL_PAGE_SIZE + 1
const gridSizes = '(max-width: 720px) calc(100vw - 32px), (max-width: 1080px) 46vw, 31vw'

// ---------- SEO ----------
const pageSuffix = page > 1 ? ` – Seite ${page}` : ''
const seoTitle = topic
  ? page > 1
    ? `${topic.label} Journal${pageSuffix} | Matthias Ramahi`
    : `${topic.title} – Journal | Matthias Ramahi`
  : page > 1
    ? `Journal${pageSuffix} | Matthias Ramahi`
    : undefined
const seoDescription = topic
  ? `${topic.intro} ${slice.total} Artikel im Journal von Matthias Ramahi${page > 1 ? `, Seite ${page} von ${totalPages}` : ''}.`
  : page > 1
    ? `Alle Artikel im Journal von Matthias Ramahi, Seite ${page} von ${totalPages}: Fotografie, Licht, Orte, Bildauswahl und Druck.`
    : undefined
const canonicalPath = journalIndexPath(topic, page)
const breadcrumb = [
  { name: 'Startseite', url: '/' },
  { name: 'Journal', url: '/blog.html' },
  ...(topic ? [{ name: topic.label, url: journalIndexPath(topic) }] : []),
  ...(page > 1 ? [{ name: `Seite ${page}`, url: canonicalPath }] : []),
]
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: seoTitle || 'Journal | Matthias Ramahi',
    url: toAbsoluteSiteUrl(canonicalPath),
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: slice.posts.map((post, index) => ({
        '@type': 'ListItem',
        position: (page - 1) * JOURNAL_PAGE_SIZE + index + 1,
        url: toAbsoluteSiteUrl(post.href),
        name: post.title,
      })),
    },
  },
  ...(breadcrumb.length > 2
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'BreadcrumbList',
          itemListElement: breadcrumb.map((item, index) => ({
            '@type': 'ListItem',
            position: index + 1,
            name: item.name,
            item: toAbsoluteSiteUrl(item.url),
          })),
        },
      ]
    : []),
]

// ---------- Paginierung ----------
const pageWindow = journalPageWindow(page, totalPages)
const prevHref = page > 1 ? journalIndexPath(topic, page - 1) : null
const nextHref = page < totalPages ? journalIndexPath(topic, page + 1) : null

// ---------- Abschluss ----------
const finalCta = journalIndex?.finalCta || {}
const finalHeadline = hasText(finalCta.headline) ? finalCta.headline : 'Fotoauftrag <em>planen.</em>'
const finalText = hasText(finalCta.text)
  ? finalCta.text
  : 'Schick mir kurz Ort, Zeitraum und Ziel des Projekts. Du bekommst eine ehrliche Einschätzung, was sinnvoll ist.'
const finalPrimaryLabel = hasText(finalCta.primaryLabel) ? finalCta.primaryLabel : 'Projekt anfragen'
const finalPrimaryHref = toRootRelativeHref(finalCta.primaryHref) || '/contact.html'
const finalSecondaryLabel = hasText(finalCta.secondaryLabel) ? finalCta.secondaryLabel : 'Portfolio ansehen'
const finalSecondaryHref = toRootRelativeHref(finalCta.secondaryHref) || '/portfolio.html'
---
<AdoptedPageLayout
  legacyFile="blog.html"
  current="blog"
  doc={doc}
  title={seoTitle}
  description={seoDescription}
  canonicalUrl={canonicalPath}
  noIndex={Boolean(topic)}
  jsonLd={jsonLd}
  preloadImages={heroPreload ? [heroPreload] : []}
>
  <main class="jx">
    <section class:list={['jhero', { 'is-compact': Boolean(topic) || page > 1, 'is-bare': heroSlides.length === 0 }]} data-theme="dark" data-header-theme="dark" aria-labelledby="jhero-title">
      {heroSlides.length > 0 && <HeroMotion variant="pan" slides={heroSlides} seconds={6} />}
      <div class="jhero__veil" aria-hidden="true"></div>
      <div class="jx-wrap jhero__inner">
        <h1 class="jhero__h1" id="jhero-title">{headline}</h1>
        <p class="jhero__lead">
          {lead}
          {page > 1 && <span class="jhero__page"> Seite {page} von {totalPages}.</span>}
        </p>
        {latestPost && (
          <a class="jhero__latest" href={latestPost.href}>
            <span class="jhero__latest-label">{latestLabel}</span>
            <span class="jhero__latest-title">{latestPost.title}</span>
          </a>
        )}
      </div>
    </section>

    <nav class="jtopics" id="themen" data-header-theme="dark" aria-label="Themen im Journal">
      <div class="jx-wrap jtopics__inner">
        <ul class="jtopics__list">
          <li><a href="/blog.html#themen" aria-current={!topic ? 'page' : undefined}>Alle Beiträge</a></li>
          {journalTopics
            .filter((entry) => (topicCounts[entry.filter] || 0) > 0)
            .map((entry) => (
              <li>
                <a href={`${journalIndexPath(entry)}#themen`} aria-current={topic?.slug === entry.slug ? 'page' : undefined}>{entry.label}</a>
              </li>
            ))}
        </ul>
        {activeTopicPillar && <a class="jtopics__pillar" href={activeTopicPillar.href}>{activeTopicPillar.label}</a>}
      </div>
    </nav>

    <section class="jx-list" id="journal" data-header-theme="light" aria-labelledby="jx-list-title">
        <div class="jx-wrap">
          <div class="jx-list__head">
            <h2 id="jx-list-title">{topic ? `Alle Artikel: ${topic.label}` : page > 1 ? 'Ältere Artikel' : 'Neueste Artikel'}</h2>
            <p>{slice.total} Artikel{totalPages > 1 && ` · Seite ${page} von ${totalPages}`}</p>
          </div>

          {gridPosts.length > 0 ? (
            <ol class="jx-grid" start={gridStartIndex}>
              {gridPosts.map((post) => (
                <li class="jx-card">
                  <a href={post.href}>
                    <figure class="jx-card__media">
                      {post.avifSrcset ? (
                        <picture>
                          <source type="image/avif" srcset={post.avifSrcset} sizes={gridSizes} />
                          <img
                            src={post.image}
                            srcset={post.srcset}
                            sizes={post.srcset ? gridSizes : undefined}
                            alt={post.imageAlt}
                            width={post.width}
                            height={post.height}
                            decoding="async"
                            loading="lazy"
                            {...tinaAttrs(post.source, 'coverImage')}
                          />
                        </picture>
                      ) : (
                        <img
                          src={post.image}
                          srcset={post.srcset}
                          sizes={post.srcset ? gridSizes : undefined}
                          alt={post.imageAlt}
                          width={post.width}
                          height={post.height}
                          decoding="async"
                          loading="lazy"
                          {...tinaAttrs(post.source, 'coverImage')}
                        />
                      )}
                    </figure>
                    <p class="jx-meta">
                      <span>{labelForCategory(post.category)}</span>
                      {post.dateTime && <time datetime={post.dateTime}>{formatJournalDate(post.dateTime)}</time>}
                      <span>{post.readTime}</span>
                    </p>
                    <h3 {...tinaAttrs(post.source, 'title')}>{post.title}</h3>
                    {post.text && <p class="jx-card__text" {...tinaAttrs(post.source, 'excerpt')}>{post.text}</p>}
                  </a>
                </li>
              ))}
            </ol>
          ) : (
            <div class="jx-empty">
              <p>In diesem Thema sind aktuell noch keine Artikel veröffentlicht.</p>
              <a class="jx-empty__link" href="/blog.html">Alle Journal-Artikel ansehen</a>
            </div>
          )}

          {totalPages > 1 && (
            <nav class="jx-pager" aria-label="Seiten">
              {prevHref ? <a class="jx-pager__step" href={`${prevHref}#themen`} rel="prev">Neuere Beiträge</a> : <span class="jx-pager__step is-off" aria-hidden="true">Neuere Beiträge</span>}
              <ol class="jx-pager__pages">
                {pageWindow.map((entry) =>
                  entry === 'gap' ? (
                    <li class="jx-pager__gap" aria-hidden="true">…</li>
                  ) : (
                    <li>
                      <a href={`${journalIndexPath(topic, entry)}#themen`} aria-current={entry === page ? 'page' : undefined} aria-label={`Seite ${entry}`}>{entry}</a>
                    </li>
                  ),
                )}
              </ol>
              {nextHref ? <a class="jx-pager__step" href={`${nextHref}#themen`} rel="next">Ältere Beiträge</a> : <span class="jx-pager__step is-off" aria-hidden="true">Ältere Beiträge</span>}
            </nav>
          )}
        </div>
      </section>

    {!topic && page === 1 && <NativeRecentShoots />}

    <div class="jx-gps" data-header-theme="light"><GooglePreferredSource theme="light" /></div>

    <section class="jx-final" data-header-theme="dark" aria-label="Projekt anfragen">
      <div class="jx-wrap">
        <h2 set:html={finalHeadline} {...tinaAttrs(finalCta, 'headline')}></h2>
        <div>
          <p {...tinaAttrs(finalCta, 'text')}>{finalText}</p>
          <div class="jx-actions">
            <a class="jx-btn is-primary" href={finalPrimaryHref} {...tinaAttrs(finalCta, 'primaryLabel')}>{finalPrimaryLabel}</a>
            <a class="jx-btn" href={finalSecondaryHref} {...tinaAttrs(finalCta, 'secondaryLabel')}>{finalSecondaryLabel}</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</AdoptedPageLayout>
