---
/**
 * Ein gemeinsamer Bereich für die internen Links am Seitenende:
 * Regionen, Anliegen und andere Fotografie-Bereiche als ruhige Spalten
 * statt mehrerer gestapelter Link-Streifen.
 */
type LinkInput = { href: string; label: string } | readonly [string, string]
type Group = { title: string; links: LinkInput[] }

type Props = {
  groups: Group[]
  heading?: string
  label: string
}

const { groups, heading = 'Mehr zum Thema.', label } = Astro.props as Props

const normalizeHref = (href: string) => (/^(https?:|\/|#)/.test(href) ? href : `/${href}`)
const visibleGroups = groups
  .map((group) => ({
    title: group.title,
    links: group.links
      .map((link) => ('href' in link ? link : { href: link[0], label: link[1] }))
      .filter((link) => link.href && link.label)
      .map((link) => ({ ...link, href: normalizeHref(link.href) })),
  }))
  .filter((group) => group.links.length > 0)
---

{visibleGroups.length > 0 && (
  <section class="mr-index" data-header-theme="light" data-theme="light" aria-label={label}>
    <div class="mr-index__inner">
      <h2>{heading}</h2>
      <div class="mr-index__groups">
        {visibleGroups.map((group) => (
          <nav class="mr-index__group" aria-label={group.title}>
            <h3>{group.title}</h3>
            <ul>
              {group.links.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .mr-index {
    background: #f3f5ef;
    color: #0a0c11;
    padding: clamp(72px, 8vw, 128px) 0;
  }

  .mr-index__inner {
    display: grid;
    gap: 40px clamp(40px, 6vw, 120px);
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr);
    margin: 0 auto;
    max-width: 1640px;
    padding: 0 clamp(20px, 4vw, 84px);
  }

  .mr-index h2 {
    color: #0a0c11;
    font-size: clamp(40px, 4.6vw, 76px);
    margin: 0;
    max-width: 8ch;
  }

  .mr-index__groups {
    display: grid;
    gap: 40px clamp(28px, 3vw, 56px);
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }

  .mr-index__group h3 {
    color: rgb(10 12 17 / 55%);
    font-size: 15px;
    font-stretch: 100%;
    font-weight: 600;
    letter-spacing: 0 !important;
    margin: 0 0 16px;
  }

  .mr-index__group ul {
    display: grid;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mr-index__group a,
  .mr-index__group a:visited {
    color: #0a0c11;
    display: inline-block;
    font-size: clamp(17px, 1.2vw, 20px);
    font-weight: 550;
    line-height: 1.3;
    padding: 6px 0;
    text-decoration: none;
  }

  .mr-index__group a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .mr-index__group a:focus-visible {
    outline: 2px solid #0a0c11;
    outline-offset: 3px;
  }

  @media (max-width: 900px) {
    .mr-index__inner {
      grid-template-columns: 1fr;
    }

    .mr-index h2 {
      max-width: none;
    }
  }

  @media (max-width: 520px) {
    .mr-index__groups {
      grid-template-columns: 1fr 1fr;
      gap: 32px 20px;
    }

    .mr-index__group a {
      padding: 8px 0;
    }
  }
</style>
