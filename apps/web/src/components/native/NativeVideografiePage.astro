---
import HeroMotion from './HeroMotion.astro'
import ContactSlot from '../ContactSlot.astro'
import NativeFamilyFaq from './NativeFamilyFaq.astro'
import AdoptedPageLayout from '../../layouts/AdoptedPageLayout.astro'
import { nativeServiceDetailPages } from '../../lib/serviceDetailContent'
import type { PayloadDoc } from '../../lib/payload'

type Props = { doc?: PayloadDoc; legacyFile?: string }
const legacyFile = (Astro.props as Props).legacyFile || 'videografie-duesseldorf.html'
const doc = (Astro.props as Props).doc
const page = nativeServiceDetailPages[legacyFile]
const { hero, overview, feature, contact } = page
const videoFaq = [
  {
    q: 'Lassen sich Foto und Video am selben Set kombinieren?',
    a: 'Ja. Sophia Ramahi übernimmt das Bewegtbild und ich die Fotografie. Wir planen Shotlist, Licht und Zeitfenster gemeinsam, sodass Foto und Video gestalterisch direkt zusammenpassen.',
  },
  {
    q: 'Welche Filmformate werden in Düsseldorf und NRW umgesetzt?',
    a: 'Imagefilme, Musikvideos, Event- und Konzertbegleitung, Fahrzeug-Clips sowie redaktionelles Bewegtbild in Quer- und Hochformat für Website, Presse und Social Media.',
  },
  {
    q: 'Wie lange dauert die Fertigstellung nach dem Dreh?',
    a: 'Je nach Umfang und Schnittaufwand liegen die finalen Schnittfassungen meist innerhalb von ein bis drei Wochen vor. Eilige Teaser oder Social-Cuts lassen sich vorab abstimmen.',
  },
  {
    q: 'Wie weit im Voraus sollte ein Videodreh angefragt werden?',
    a: 'Für größere Produktionen oder kombinierte Foto- und Videotage empfehlen sich zwei bis vier Wochen Vorlauf. Kurzfristige Termine im Rheinland sind nach Verfügbarkeit ebenfalls möglich.',
  },
]
---
<AdoptedPageLayout
  legacyFile={legacyFile}
  current="leistungen"
  doc={doc}
  ctaHref="#anfrage"
  preloadImages={[hero.image]}
>
  <main>
    {/* ===== HERO (dark) — Ken-Burns static, image-led ===== */}
    <section class="vg-hero" data-theme="dark" data-header-theme="dark" aria-label="Videografie Düsseldorf">
      <HeroMotion variant="pan" slides={[{ src: hero.image }]} />
      <div class="vg-hero__veil" aria-hidden="true"></div>
      <div class="vg-hero__inner">
        <h1 class="vg-hero__title">
          <span class="line">Bewegtes</span>
          <span class="line"><em>Bild.</em></span>
        </h1>
        <p class="vg-hero__lead">{hero.lead}</p>
        <div class="vg-hero__actions">
          <a class="vg-btn vg-btn--solid" href="#anfrage">{hero.primary}</a>
          <a class="vg-btn vg-btn--ghost" href="#leistungen">{hero.secondary}</a>
        </div>
      </div>
    </section>

    {/* ===== STATEMENT (light) — editorial pause ===== */}
    <section class="vg-statement" data-theme="light" data-header-theme="light" aria-label="Foto und Video aus einem Guss">
      <div class="vg-inner vg-statement__grid">
        <div>
          <h2>Eine Familie,{' '}<br /><em>ein abgestimmter Look.</em></h2>
        </div>
        <div class="vg-statement__body">
          <p class="vg-lead">Für bewegtes Bild arbeite ich mit meiner Schwester Sophia Ramahi, Videografin aus dem Rheinland. Wir planen Sets gemeinsam: derselbe Look, derselbe ruhige editoriale Standard.</p>
          <p>Imagefilm, Musikvideo, Eventfilm und redaktionelles Bewegtbild, geplant mit echtem Bildmaterial statt Stock. Wenn Foto und Video parallel laufen, gibt es weniger Termine, weniger Doppelarbeit und ein Ergebnis, das zusammengehört, ob bei einer <a href="/autofotografie-duesseldorf.html">Autofotografie in Düsseldorf</a>, einer <a href="/musikerfotografie.html">Musikerfotografie</a> oder einem redaktionellen Set. Visuelle Eindrücke aus der Fotografie findest du im <a href="/portfolio.html">Portfolio</a>, Hintergründe zur Zusammenarbeit auf <a href="/ueber-mich.html">Über mich</a> und weitere Leistungen in der <a href="/leistungen.html">Leistungsübersicht</a>.</p>
          <div class="vg-actions">
            <a class="vg-btn vg-btn--ink" href="#leistungen">Leistungen ansehen</a>
            <a class="vg-btn vg-btn--ghost-ink" href="#anfrage">Projekt anfragen</a>
          </div>
        </div>
      </div>
    </section>

    {/* ===== LEISTUNGEN (dark) — editorial grid, no card chrome ===== */}
    <section class="vg-services" id="leistungen" data-theme="dark" data-header-theme="dark" aria-label="Bewegtbild-Leistungen">
      <div class="vg-inner">
        <div class="vg-services__head">
          <h2>Bewegtbild<br /><em>leistungen.</em></h2>
          <p class="vg-lead">{overview.lead}</p>
        </div>
        <div class="vg-services__grid">
          {overview.cards.map((card) => (
            <article class="vg-service">
              <p class="vg-service__cat">{card.kicker.split('/')[1]?.trim() || card.kicker}</p>
              <h3 class="vg-service__title">{card.title}</h3>
              <p class="vg-service__body">{card.body}</p>
              <p class="vg-service__meta">{card.items.slice(0, 2).join('  ·  ')}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* ===== FOTO + VIDEO (light) — process / aus einem Guss ===== */}
    <section class="vg-feature" data-theme="light" data-header-theme="light" aria-label={feature.aria}>
      <div class="vg-inner vg-feature__grid">
        <div class="vg-feature__copy">
          <p class="vg-eyebrow vg-eyebrow--ink">{feature.eyebrow}</p>
          <h2>Bewegung und{' '}<br /><em>Bild gleichzeitig.</em></h2>
          <p class="vg-lead">{feature.lead}</p>
        </div>
        <dl class="vg-feature__list">
          {feature.items.map((item) => (
            <div class="vg-feature__item">
              <dt>{item.tag}</dt>
              <dd>{item.line}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <NativeFamilyFaq faq={videoFaq} pageUrl={`https://matthiasramahi.de/${legacyFile}`} theme="dark" />

    {/* ===== CONTACT (dark) ===== */}
    <ContactSlot
      id="anfrage"
      data-contact-section
      data-theme="dark"
      data-header-theme="dark"
      data-contact-subject={contact.subject}
      data-contact-headline={contact.headline}
      data-contact-lead={contact.lead}
      aria-label="Anfrage"
    />
  </main>
</AdoptedPageLayout>
