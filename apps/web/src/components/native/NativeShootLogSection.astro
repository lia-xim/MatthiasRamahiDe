---
import {
  getVerifiedShootLogsForHub,
  regionalPowerHubs,
  type RegionalHubKey,
} from '../../data/shootLogs'
import { localResponsiveImage } from '../../data/localResponsiveThumbs'
import { versionStaticAssetUrl } from '../../lib/cache'

type Props = {
  hub: RegionalHubKey
}

const { hub } = Astro.props as Props
const region = regionalPowerHubs[hub]
const log = getVerifiedShootLogsForHub(hub)[0]
const sectionId = `region-${hub}`

const lead = log?.images[0]
const leadVisual = lead ? localResponsiveImage(lead.src, lead.width, lead.height) : null
const leadFull = lead ? versionStaticAssetUrl(lead.src) : ''
const leadSrcset = lead && leadVisual?.srcset ? `${leadVisual.srcset}, ${leadFull} ${lead.width}w` : ''
const details = (log?.images.slice(1, 3) ?? []).map((image) => ({
  ...image,
  visual: localResponsiveImage(image.src, image.width, image.height),
}))
---

<section class="region" id={sectionId} data-header-theme="dark" data-theme="dark" aria-labelledby={`${sectionId}-title`}>
  <div class="region__inner">
    <header class="region__head">
      <h2 id={`${sectionId}-title`}>{region.title}</h2>
      <div class="region__intro">
        <p>{region.lead}</p>
        <p class="region__coverage">{region.coverageSentence}</p>
      </div>
    </header>

    {log && lead && (
      <article class="region__shoot" aria-labelledby={`${sectionId}-shoot`}>
        <figure class="region__lead">
          <img
            src={leadFull}
            srcset={leadSrcset || undefined}
            sizes="(max-width: 900px) 100vw, 64vw"
            alt={lead.alt}
            width={lead.width}
            height={lead.height}
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="region__story">
          <h3 id={`${sectionId}-shoot`}>{log.title}</h3>
          <p>{log.locationContext}</p>
          <p>{log.challengeAndApproach}</p>
          <p class="region__links">
            {log.projectHref && <a href={log.projectHref}>Ganze Serie ansehen</a>}
            <a href={log.ctaHref}>Ähnliches Shooting anfragen</a>
          </p>
          {details.length > 0 && (
            <div class="region__details">
              {details.map((image) => (
                <img
                  src={image.visual.mobile}
                  srcset={image.visual.srcset || undefined}
                  sizes="(max-width: 900px) 46vw, 15vw"
                  alt={image.alt}
                  width={image.width}
                  height={image.height}
                  loading="lazy"
                  decoding="async"
                />
              ))}
            </div>
          )}
        </div>
      </article>
    )}

    <div class="region__places">
      {region.settings.map((place) => (
        <div class="region__place">
          <h3>{place.title}</h3>
          <p>{place.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .region {
    --region-bg: #050608;
    --region-fg: #f1efe8;
    --region-muted: rgb(241 239 232 / 68%);
    --region-line: rgb(241 239 232 / 14%);
    --region-gutter: clamp(20px, 4vw, 84px);
    background: var(--region-bg);
    color: var(--region-fg);
    padding: clamp(72px, 9vw, 144px) 0;
  }

  .region__inner {
    margin: 0 auto;
    max-width: 1640px;
    padding: 0 var(--region-gutter);
  }

  .region__head {
    align-items: end;
    display: grid;
    gap: 24px clamp(32px, 6vw, 120px);
    grid-template-columns: minmax(0, 1fr) minmax(0, 32rem);
  }

  .region__head h2 {
    color: var(--region-fg);
    font-size: clamp(44px, 6.4vw, 108px);
    margin: 0;
    max-width: 11ch;
  }

  .region__intro p {
    color: var(--region-muted);
    font-size: clamp(16px, 1.15vw, 19px);
    line-height: 1.6;
    margin: 0;
    max-width: 52ch;
  }

  .region__intro .region__coverage {
    color: var(--region-fg);
    margin-top: 12px;
  }

  .region__shoot {
    align-items: start;
    display: grid;
    gap: clamp(28px, 4vw, 72px);
    grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr);
    margin-top: clamp(56px, 6vw, 104px);
  }

  .region__lead {
    margin: 0;
  }

  .region__lead img,
  .region__details img {
    background: #111;
    display: block;
    height: auto;
    object-fit: cover;
    width: 100%;
  }

  .region__lead img {
    aspect-ratio: 3 / 2;
  }

  .region__story h3 {
    color: var(--region-fg);
    font-size: clamp(24px, 2.1vw, 36px);
    line-height: 1.08;
    margin: 0 0 20px;
    max-width: 18ch;
  }

  .region__story p {
    color: var(--region-muted);
    font-size: clamp(15px, 1.05vw, 17px);
    line-height: 1.65;
    margin: 0 0 14px;
    max-width: 46ch;
  }

  .region__story .region__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    margin-top: 24px;
  }

  .region__links a {
    color: var(--region-fg);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgb(241 239 232 / 35%);
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    transition: text-decoration-color 0.2s ease;
  }

  .region__links a:hover {
    text-decoration-color: currentColor;
  }

  .region__links a:focus-visible {
    outline: 2px solid var(--region-fg);
    outline-offset: 4px;
  }

  .region__details {
    display: grid;
    gap: 12px;
    grid-template-columns: 1fr 1fr;
    margin-top: clamp(28px, 3vw, 44px);
  }

  .region__details img {
    aspect-ratio: 4 / 3;
  }

  .region__places {
    border-top: 1px solid var(--region-line);
    display: grid;
    gap: 32px clamp(32px, 4vw, 72px);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(56px, 6vw, 104px);
    padding-top: clamp(28px, 3vw, 44px);
  }

  .region__place h3 {
    color: var(--region-fg);
    font-size: clamp(19px, 1.4vw, 23px);
    line-height: 1.15;
    margin: 0 0 10px;
  }

  .region__place p {
    color: var(--region-muted);
    font-size: clamp(15px, 1vw, 16.5px);
    line-height: 1.6;
    margin: 0;
    max-width: 42ch;
  }

  @media (max-width: 900px) {
    .region__head,
    .region__shoot,
    .region__places {
      grid-template-columns: 1fr;
    }

    .region__head {
      align-items: start;
    }

    .region__lead {
      margin-inline: calc(var(--region-gutter) * -1);
    }

    .region__story h3 {
      max-width: none;
    }

    .region__places {
      gap: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .region__links a {
      transition: none;
    }
  }
</style>
