const statementEmphasisSource = (typeof doc?.statement?.emphasis === 'string' && doc.statement.emphasis.trim()) || keywordFocusCopy?.statementEmphasis || 'Druckqualität.'
const statementHeadline = firstSectionTarget || statementHeadlineSource
const statementEmphasis = firstSectionTarget ? '' : statementEmphasisSource
const statementTitle = splitTrailingEmphasis(statementHeadline, statementEmphasis)
const statementSourceTitle = splitTrailingEmphasis(statementHeadlineSource, statementEmphasisSource)
const statementSupportLine = firstSectionTarget ? [statementSourceTitle.headline, statementSourceTitle.emphasis].filter(Boolean).join(' ') : ''
const baseStatementBody = doc?.statement?.body?.length
