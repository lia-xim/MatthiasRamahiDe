const visualSlots = familyVisualSlots(visualDoc, [
  ...heroPanels.map(([, src, mobile]) => ({ alt: 'Sportwagen Hero', src, mobile })),
  ...shootingStyles.map(({ image, alt, width, height }) => ({ alt, height, src: image, width })),
  ...portfolioTiles.map(({ alt, full, height, src, width }) => ({ alt, full, height, src, width })),
  ...audiences.map(({ alt, height, image, width }) => ({ alt, height, src: image, width })),
])
const inheritedHeroPanels = heroPanels.map(([name], index) => {
  const visual = visualSlots[index]
  return [name, visual.full, visual.mobile, visual] as const
})
const inheritedShootingStyles = shootingStyles.map((style, index) => {
  const visual = visualSlots[index + heroPanels.length]
  return { ...style, alt: visual.alt, height: visual.height, image: visual.src, mobile: visual.mobile, srcset: visual.srcset, width: visual.width }
})
const keywordShootingStyles = keywordFocusCopy?.cards?.length
  ? inheritedShootingStyles.map((style, index) => {
      const card = keywordFocusCopy.cards?.[index]
      return card ? { ...style, title: card.title, text: card.text } : style
    })
  : inheritedShootingStyles
const inheritedPortfolioTiles = portfolioTiles.map((tile, index) => {
  const visual = visualSlots[index + heroPanels.length + shootingStyles.length]
  return { ...tile, alt: visual.alt, avifSrcset: visual.avifSrcset, full: visual.full, height: visual.height, mobile: visual.mobile, src: visual.src, srcset: visual.srcset, width: visual.width }
})
const statementImage = inheritedPortfolioTiles[0] || visualSlots[0]
const inheritedAudiences = audiences.map((audience, index) => {
  const visual = visualSlots[index + heroPanels.length + shootingStyles.length + portfolioTiles.length]
  return { ...audience, alt: visual.alt, height: visual.height, image: visual.src, mobile: visual.mobile, srcset: visual.srcset, width: visual.width }
})

// ===== CMS-Overrides der Themen-Sektionen =====
// Jede Sektion liest aus dem ServicePages-Doc (Tab „Themen-Sektionen"); ist sie leer,
// greift der bisherige Wert (inherited*/Hardcode) als Fallback. So bricht nichts,
// solange das CMS-Feld nicht gepflegt ist.
type SectionMedia = PayloadMedia | string | undefined
const resolveSectionImage = <T extends { src?: string; full?: string; image?: string; mobile?: string; srcset?: string; avifSrcset?: string; width?: number; height?: number; alt?: string }>(
  media: SectionMedia,
  fallback: T,
) => {
  if (!media) return fallback
  if (typeof media === 'string') {
    const responsive = localResponsiveImage(media, fallback.width || 1600, fallback.height || 1067)
    const resolvedFull = responsive.srcset ? responsive.full : imageDisplayUrl(media, 'wide', { allowOriginal: true })
    if (!resolvedFull) return fallback
    const resolvedSrc = responsive.srcset ? responsive.src : resolvedFull
    const resolvedMobile = responsive.srcset ? responsive.mobile : resolvedSrc
    return {
      ...fallback,
      avifSrcset: '',
      full: resolvedFull,
      height: responsive.height || fallback.height,
      image: resolvedSrc,
      mobile: resolvedMobile,
      src: resolvedSrc,
      srcset: responsive.srcset || fallback.srcset || '',
      width: responsive.width || fallback.width,
    }
  }
  const full = imageDisplayUrl(media, 'wide', { allowOriginal: true })
  if (!full) return fallback
  const src = imageDisplayUrl(media, 'card', { allowOriginal: true }) || full
  const mobile = imageDisplayUrl(media, 'mobile', { allowOriginal: true }) || src
  const dim = imageDimensions(media, 'card')
  return {
    ...fallback,
    avifSrcset: imageSrcset(media, ['mobile', 'card'], 'avif') || fallback.avifSrcset || '',
    src,
    full,
    image: src,
    mobile,
    srcset: imageSrcset(media, ['mobile', 'card']) || fallback.srcset || '',
    width: dim.width || fallback.width,
    height: dim.height || fallback.height,
    alt: imageAlt(media, fallback.alt || ''),
  }
}

const heroPanelsSource = doc?.heroPanels?.length ? doc.heroPanels : visualDoc?.heroPanels || []
const shootingStyleSource = doc?.shootingStyles?.length ? doc.shootingStyles : visualDoc?.shootingStyles || []
const portfolioTileSource = doc?.portfolioTiles?.length ? doc.portfolioTiles : visualDoc?.portfolioTiles || []
const audienceCardSource = doc?.audienceCards?.length ? doc.audienceCards : visualDoc?.audienceCards || []
const relatedItemSource = doc?.relatedSection?.items?.length ? doc.relatedSection.items : visualDoc?.relatedSection?.items || []

const finalHeroPanels = heroPanelsSource.length
  ? heroPanelsSource.map((panel, index) => {
      const fbTuple = inheritedHeroPanels[index % inheritedHeroPanels.length]
      const resolved = resolveSectionImage(panel.image, fbTuple[3])
      return [fbTuple[0], resolved.full, resolved.mobile, resolved] as const
    })
  : inheritedHeroPanels
// Der Kamerafahrt-Hero zeigt die Bilder randlos: größte Variante aus dem srcset.
const largestFromSrcset = (srcset?: string) =>
  (srcset || '')
    .split(',')
    .map((entry) => entry.trim().split(/\s+/))
    .filter(([url, size]) => url && /^\d+w$/.test(size || ''))
    .sort((left, right) => parseInt(right[1], 10) - parseInt(left[1], 10))[0]?.[0]
// Randloser Hero braucht grosse Dateien: bevorzugt die hochaufgelösten
// Bildslots (>= 1920 px), sonst die früheren Triptychon-Panels.
const isLargeVisual = (url?: string) => /-(19[2-9]\d|2\d{3})x\d+\.(webp|avif|jpe?g)/i.test(url || '')
const largeVisualSlides = visualSlots
  .filter((slot) => isLargeVisual(slot.full))
  .map((slot) => ({ src: slot.full, mobile: slot.mobile }))
const sportwagenExtraSlides: Array<{ src: string; mobile?: string }> = [
  { src: '/assets/optimized/assets-portfolio-dsc3879-1920.webp' },
  { src: '/assets/optimized/assets-portfolio-dsc3892-1920.webp' },
  { src: '/assets/optimized/assets-portfolio-dsc3982-1920.webp' },
  { src: '/assets/optimized/assets-portfolio-dsc3908-1920.webp' },
  { src: '/assets/portfolio/automobil-bmw-widebody.webp' },
  { src: '/assets/optimized/assets-portfolio-dsc3878-1920.webp' },
  { src: '/assets/optimized/assets-portfolio-dsc2345-1920.webp' },
  { src: '/assets/optimized/automobil-alpina-b8-medienhafen-1920.webp', mobile: '/assets/optimized/automobil-alpina-b8-medienhafen-960.webp' },
]
const basePanHeroSlides = largeVisualSlides.length >= 2
  ? largeVisualSlides.slice(0, 4)
  : [finalHeroPanels[1], finalHeroPanels[0], finalHeroPanels[2]].filter(Boolean).map((panel) => ({ src: largestFromSrcset(panel[3]?.srcset) || panel[1], mobile: panel[2] }))
const seenPanSrc = new Set<string>()
const panHeroSlides = [...basePanHeroSlides, ...sportwagenExtraSlides]
  .filter((slide) => {
    if (!slide?.src || seenPanSrc.has(slide.src)) return false
    seenPanSrc.add(slide.src)
    return true
  })
  .slice(0, 8)
const transparentHeroPixel = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=='
const mobileHeroPreload = finalHeroPanels[1]?.[2] || finalHeroPanels[0]?.[2] || ''
const desktopHeroPreload = finalHeroPanels[0]?.[3]?.full || ''

const finalShootingStyles = shootingStyleSource.length
  ? shootingStyleSource.map((style, index) => {
