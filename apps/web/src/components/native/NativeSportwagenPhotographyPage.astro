import { curateFamilyClusterLinks } from '../../lib/familyClusterLinks'
import { cmsHeroTitleFitStyle, splitCmsHeroTitleLines, splitHeroTitleLines } from '../../lib/heroTitleLines'
import { keywordFocusCopyForSlug } from '../../lib/localSeoFamilyContent'
import { familyHeroCopy, familyVisualSlots, getFamilyVisualSourceDoc } from '../../lib/localSeoFamilyVisuals'
import { getLegacyBackedDoc, imageAlt, imageDimensions, imageDisplayUrl, imageSrcset, type PayloadDoc, type PayloadMedia } from '../../lib/payload'
import { splitTrailingEmphasis } from '../../lib/splitTrailingEmphasis'
import { tinaAttrs } from '../../lib/tinaFieldAttrs'

type Props = {
  doc?: PayloadDoc | null
  legacyFile?: string
  preview?: NativeFamilyPreviewState
  visualDoc?: PayloadDoc | null
}

const defaultLegacyFile = 'sportwagen-fotografie.html'
const props = Astro.props as Props
const { doc: providedDoc = undefined, legacyFile: providedLegacyFile, preview, visualDoc: providedVisualDoc = undefined } = props
const legacyFile = providedLegacyFile || defaultLegacyFile
const fetchedDoc = providedDoc || (await getLegacyBackedDoc(legacyFile, { depth: 2 }))
const doc = preview ? fetchedDoc : mergeAuthoredLocalSeoContent(legacyFile, fetchedDoc)
const shouldUseCmsVisualDoc = import.meta.env.ASTRO_DISABLE_CMS_VISUAL_OVERRIDES !== 'true'
const visualDoc = Object.hasOwn(props, 'visualDoc')
  ? providedVisualDoc
  : shouldUseCmsVisualDoc
    ? await getFamilyVisualSourceDoc('sportwagen', doc, legacyFile, defaultLegacyFile)
    : null
const pageContext = nativeFamilyPageContext({
  defaultLegacyFile,
  doc,
  family: 'sportwagen',
  legacyFile,
  preview,
})
const { clusterHeading, clusterLinks, isKeywordPage, isParentPage, overviewHref, publishedHref, scope, serviceLabel } = pageContext
const keywordFocusCopy = keywordFocusCopyForSlug(legacyFile)
const cmsFaqSource = (doc?.localFaq?.length ? doc.localFaq : doc?.faq) || []
const cmsFaqItems = cmsFaqSource.map((entry) => ({ q: entry.question || '', a: entry.answer || '' })).filter((entry) => entry.q && entry.a)
const faqItems = cmsFaqItems.length ? cmsFaqItems : keywordFocusCopy?.faq
const cmsText = (value: unknown) => (typeof value === 'string' ? value.trim() : '')
const emphasizedHtml = (headline: string, emphasis: string) =>
  [headline, emphasis ? `<em>${emphasis}</em>` : ''].filter(Boolean).join(headline && emphasis ? ' ' : '')
const cmsHeroLine2 = typeof doc?.heroLine2 === 'string' ? doc.heroLine2.trim() : ''
const isLocalHeroPage = !isParentPage && !isKeywordPage
const shouldUseCmsHeroTitle = !isParentPage
const heroTitle = isParentPage ? 'Sportwagenfotografie' : serviceLabel
const heroSecondLine = isLocalHeroPage ? scope.label : ''
const fallbackHeroTitleLines = [...splitHeroTitleLines(heroTitle), ...splitHeroTitleLines(heroSecondLine)]
const heroTitleLines = shouldUseCmsHeroTitle
  ? splitCmsHeroTitleLines(doc?.title || doc?.targetKeyword || doc?.seo?.focusKeyword, fallbackHeroTitleLines)
  : fallbackHeroTitleLines
const heroLocalNote = isLocalHeroPage ? cmsHeroLine2 || keywordFocusCopy?.heroEmphasis || 'Performance. Linie. Detail.' : isKeywordPage ? cmsHeroLine2 || keywordFocusCopy?.heroEmphasis || '' : ''
const heroLabel = isParentPage ? 'Sportwagenfotografie' : isKeywordPage ? serviceLabel : `Sportwagenfotografie ${scope.label}`
const defaultHeroLead = isParentPage
  ? 'Sportwagenfotografie: Performance, Form, Innenraum und Details werden mit kontrollierten Reflexen und ruhiger Dramaturgie sichtbar — für Sammler, Händler, Marke, Verkauf und Druck. Produktionen werden über Motiv, Nutzung, Reise, Lichtfenster und Output geplant — in ganz NRW.'
  : isKeywordPage
    ? `${serviceLabel}: eigenständiger Einstieg in die Sportwagenfotografie. Performance, Form, Innenraum und Details werden mit kontrollierten Reflexen und ruhiger Dramaturgie sichtbar - für Sammler, Händler, Marke, Verkauf und Druck. Die Seite bleibt bewusst im Layout der übergeordneten Kategorie, ist aber klar auf dieses Motiv und diese Nutzung formuliert.`
    : `Sportwagenfotografie in ${scope.label}: Performance, Form, Innenraum und Details werden mit kontrollierten Reflexen und ruhiger Dramaturgie sichtbar - für Sammler, Händler, Marke, Verkauf und Druck. ${localScopePhrase(scope)}`
