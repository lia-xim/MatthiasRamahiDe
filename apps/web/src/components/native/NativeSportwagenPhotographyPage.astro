  ['sportwagen-fotografie-wuppertal.html', 'Wuppertal'],
  ['sportwagen-fotografie-leverkusen.html', 'Leverkusen'],
  ['sportwagen-fotografie-oberhausen.html', 'Oberhausen'],
  ['sportwagen-fotografie-krefeld.html', 'Krefeld'],
  ['sportwagen-fotografie-moenchengladbach.html', 'Mönchengladbach'],
  ['sportwagen-fotografie-moers.html', 'Moers'],
  ['sportwagen-fotografie-gelsenkirchen.html', 'Gelsenkirchen'],
  ['sportwagen-fotografie-bergisch-gladbach.html', 'Bergisch Gladbach'],
  ['sportwagen-fotografie-solingen.html', 'Solingen'],
  ['sportwagen-fotografie-remscheid.html', 'Remscheid'],
  ['sportwagen-fotografie-mettmann.html', 'Mettmann'],
  ['sportwagen-fotografie-hilden.html', 'Hilden'],
  ['sportwagen-fotografie-dormagen.html', 'Dormagen'],
  ['sportwagen-fotografie-neuss.html', 'Neuss'],
  ['sportwagen-fotografie-nrw.html', 'NRW'],
  ['sportwagen-fotografie-deutschland.html', 'Deutschland'],
] as const
const intentLinks = [
  {
    key: 'motorsport-sportwagen',
    label: 'Motorsport & Sportwagen',
    genericHref: 'motorsport-sportwagen-fotografie.html',
    duesseldorfHref: 'motorsport-sportwagen-fotografie-duesseldorf.html',
  },
  {
    key: 'motorsport',
    label: 'Motorsport Fotografie',
    genericHref: 'motorsport-fotografie.html',
    duesseldorfHref: 'motorsport-fotografie-duesseldorf.html',
  },
  {
    key: 'sportwagen-shooting',
    label: 'Sportwagen Shooting',
    genericHref: 'sportwagen-shooting-duesseldorf.html',
    duesseldorfHref: 'sportwagen-shooting-duesseldorf.html',
  },
  {
    key: 'sportwagen-fotoshooting',
    label: 'Sportwagen Fotoshooting',
    genericHref: 'sportwagen-fotoshooting-duesseldorf.html',
    duesseldorfHref: 'sportwagen-fotoshooting-duesseldorf.html',
  },
  {
    key: 'performance-car',
    label: 'Performance Car Fotografie',
    genericHref: 'performance-car-fotografie.html',
    duesseldorfHref: 'performance-car-fotografie-duesseldorf.html',
  },
  {
    key: 'exotic-car',
    label: 'Exotic Car Fotografie',
    genericHref: 'exotic-car-fotografie.html',
    duesseldorfHref: 'exotic-car-fotografie-duesseldorf.html',
  },
  {
    key: 'supersportwagen',
    label: 'Supersportwagen Fotografie',
    genericHref: 'supersportwagen-fotografie.html',
    duesseldorfHref: 'supersportwagen-fotografie-duesseldorf.html',
  },
] as const
const clusterCuration = curateFamilyClusterLinks({
  allCityLinks,
  currentPage: legacyFile,
  defaultLegacyFile,
  familyLabel: 'Sportwagen Fotografie',
  intentLinks,
  intentNeighbors: {
    'motorsport-sportwagen': ['motorsport', 'sportwagen-shooting', 'performance-car'],
    motorsport: ['motorsport-sportwagen', 'sportwagen-shooting', 'sportwagen-fotoshooting'],
    'sportwagen-shooting': ['sportwagen-fotoshooting', 'performance-car', 'exotic-car'],
    'sportwagen-fotoshooting': ['sportwagen-shooting', 'supersportwagen', 'exotic-car'],
    'performance-car': ['exotic-car', 'supersportwagen', 'motorsport-sportwagen'],
    'exotic-car': ['performance-car', 'supersportwagen', 'sportwagen-fotoshooting'],
    supersportwagen: ['exotic-car', 'performance-car', 'motorsport-sportwagen'],
  },
  isParentPage,
  primaryIntentKeys: [
    'sportwagen-shooting',
    'motorsport-sportwagen',
    'performance-car',
    'exotic-car',
    'supersportwagen',
    'sportwagen-fotoshooting',
  ],
  scopeSlug: scope.slug,
})
const {
  cityHeading,
  cityLinks,
  intentHeading,
  searchLinks,
  showCrossFamilyCluster,
} = clusterCuration
const heroPanelSource = (index: number) =>
  doc?.heroPanels?.[index] || doc?.heroSlides?.[index] || visualDoc?.heroPanels?.[index] || visualDoc?.heroSlides?.[index]
const heroTextSource = doc?.heroSlides?.[0] || doc
const heroTitleField = (index: number) =>
  heroTextSource === doc?.heroSlides?.[0]
    ? index === 0
      ? 'headlineLine1'
      : 'headlineLine2'
    : shouldUseCmsHeroTitle
      ? 'title'
      : index === 0
      ? 'title'
      : 'heroLine2'
const heroLeadField = heroTextSource === doc?.heroSlides?.[0] ? 'lead' : 'intro'
---
<AdoptedPageLayout
  legacyFile={legacyFile}
  current="fotografie"
  doc={doc}
  noIndex={Boolean(preview)}
  title={metaTitle}
  description={metaDescription}
  ogImage={doc?.seo?.ogImage || visualSlots[1].full}
  preloadImages={[
    { href: mobileHeroPreload, media: '(max-width: 720px)' },
    { href: desktopHeroPreload, media: '(min-width: 721px)' },
  ]}
>
  {preview && (
    <PreviewToolbar
      collection={preview.collection}
      slug={preview.slug}
      status={preview.status}
      publishedHref={publishedHref}
    />
  )}
  <main>
    <section class="hero-tri" id="top" data-header-theme="dark" aria-label={heroLabel} {...tinaAttrs(heroPanelSource(0), 'image')}>
      <div class="tri-stage" aria-hidden="true">
        {finalHeroPanels.map(([name, image, mobileImage, visual], index) => (
          <div class="tri-col" data-tri={name}>
            <div class="tri-img">
              <picture>
                <source media="(max-width: 720px)" srcset={index === 1 ? mobileImage : transparentHeroPixel} />
                <img
                  src={image}
                  srcset={visual.srcset || undefined}
                  sizes="(max-width: 720px) 100vw, 34vw"
                  alt=""
                  loading="eager"
                  fetchpriority={index === 1 ? 'high' : 'auto'}
                  width={visual.width}
                  height={visual.height}
                  decoding="async"
                  {...tinaAttrs(heroPanelSource(index), 'image')}
                />
              </picture>
            </div>
          </div>
        ))}
      </div>

      <div class="tri-overlay">
        <h1 class="tri-title" style={heroTitleFitStyle} aria-label={heroLabel}>
          {heroCopy.titleLines.map((line, index) => (
            <>
              {index > 0 && ' '}
              <span class="line" {...tinaAttrs(heroTextSource, heroTitleField(index))}><span class="word">{line}</span></span>
            </>
          ))}
        </h1>
        {heroLocalNote && <p class="tri-local-note" {...tinaAttrs(doc, 'heroLine2')}>{heroLocalNote}</p>}
        <p class="tri-sub" {...tinaAttrs(heroTextSource, heroLeadField)}>{heroCopy.lead}</p>
        <div class="tri-actions">
          <a href={heroCopy.primaryHref} {...tinaAttrs(heroTextSource, 'primaryLabel')}>{heroCopy.primaryLabel}</a>
          <a class="ghost" href={heroCopy.secondaryHref} {...tinaAttrs(heroTextSource, 'secondaryLabel')}>{heroCopy.secondaryLabel}</a>
        </div>
      </div>
    </section>

    <section class="st" data-header-theme="light">
      <div class="section-inner">
        <div class="st-copy">
          <h2>
            <span {...tinaAttrs(doc?.statement, 'headline')}>{statementTitle.headline}</span>
            {statementTitle.headline && statementTitle.emphasis ? ' ' : ''}
            {statementTitle.emphasis && <em {...tinaAttrs(doc?.statement, 'emphasis')}>{statementTitle.emphasis}</em>}
          </h2>
          <div class="st-body">
            {statementBody.map((paragraph, index) => <p {...tinaAttrs(doc?.statement?.body?.[index], 'text')}>{paragraph}</p>)}
          </div>
        </div>
        <figure class="st-image">
          <img loading="lazy" src={finalStatementImage.src} alt={finalStatementImage.alt} width={finalStatementImage.width} height={finalStatementImage.height} decoding="async" {...tinaAttrs(doc?.statement, 'image')} />
        </figure>
      </div>
    </section>

    <section class="sh" data-header-theme="dark">
      <div class="section-inner">
        <div class="sh-head">
          <h2><span {...tinaAttrs(doc?.focusSection, 'headline')}>{focusSectionHeadline}</span> <em {...tinaAttrs(doc?.focusSection, 'emphasis')}>{focusSectionEmphasis}</em></h2>
          <p {...tinaAttrs(doc?.focusSection, 'lead')}>{focusSectionLead}</p>
        </div>
        <div class="sh-grid">
          {finalShootingStyles.map((style, index) => (
            <article class="sh-card">
              <figure class="sh-img"><img loading="lazy" src={style.image} alt={style.alt} width={style.width} height={style.height} decoding="async" {...tinaAttrs(doc?.shootingStyles?.[index], 'image')} /></figure>
              <div class="sh-text">
                <h3 {...tinaAttrs(doc?.shootingStyles?.[index], 'title')}>{style.title}</h3>
                <p {...tinaAttrs(doc?.shootingStyles?.[index], 'text')}>{style.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="po" data-header-theme="dark" aria-label="Ausgewählte Sportwagen-Arbeiten">
      <div class="po-grid" id="poGrid">
        <header class="po-head">
            <h2 {...tinaAttrs(doc?.gallerySection, 'headline')}>{focusGalleryHeadline}</h2>
            <div class="head-foot">
            <p {...tinaAttrs(doc?.gallerySection, 'lead')}>{focusGalleryLead}</p>
          </div>
        </header>

        {finalPortfolioTiles.map((tile, index) => (
          <button type="button" class={`po-tile ${tile.className}`} data-i={index} data-full={tile.full} aria-label={`Bild ${index + 1} vergrößern`}>
            <img
              src={tile.src}
              data-full={tile.full}
              loading="lazy"
              alt={tile.alt}
              width={tile.width}
              height={tile.height}
              decoding="async"
              {...tinaAttrs(doc?.portfolioTiles?.[index], 'image')}
            />
            <span class="corner tl" aria-hidden="true"></span>
            <span class="corner tr" aria-hidden="true"></span>
            <span class="corner bl" aria-hidden="true"></span>
            <span class="corner br" aria-hidden="true"></span>
            <span class="zoom">Zoom</span>
            <span class="lbl" {...tinaAttrs(doc?.portfolioTiles?.[index], 'label')}>{tile.label}</span>
          </button>
        ))}
      </div>
    </section>

    <section class="fw" data-header-theme="light">
      <div class="section-inner">
        <div class="fw-head">
          <h2 {...tinaAttrs(doc?.audienceSection, 'headline')}>{focusAudienceHeadline}</h2>
          <p {...tinaAttrs(doc?.audienceSection, 'lead')}>{focusAudienceLead}</p>
        </div>
        <div class="fw-grid">
          {finalAudiences.map((audience, index) => (
            <article class="fw-card">
              <img loading="lazy" src={audience.image} alt={audience.alt} width={audience.width} height={audience.height} decoding="async" {...tinaAttrs(doc?.audienceCards?.[index], 'image')} />
              <div class="overlay"></div>
              <div class="content">
                <strong {...tinaAttrs(doc?.audienceCards?.[index], 'title')}>{audience.title}</strong>
                <p {...tinaAttrs(doc?.audienceCards?.[index], 'text')}>{audience.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="rl" data-header-theme="dark">
      <div class="section-inner">
        <div class="rl-head">
          <h2><span {...tinaAttrs(doc?.relatedSection, 'headline')}>{relatedSectionTitle.headline}</span> <em {...tinaAttrs(doc?.relatedSection, 'emphasis')}>{relatedSectionTitle.emphasis}</em></h2>
          <p {...tinaAttrs(doc?.relatedSection, 'lead')}>{focusRelatedLead}</p>
        </div>
        <div class="rl-grid">
          {finalRelatedAreas.map((area, index) => (
            <a class="rl-card" href={area.href}>
              <img data-src={area.dataSrc} src={area.src || area.dataSrc} loading="lazy" alt={area.alt} width={area.width} height={area.height} decoding="async" {...tinaAttrs(doc?.relatedSection?.items?.[index], 'image')} />
              <div class="overlay"></div>
              <div class="content"><div><strong {...tinaAttrs(doc?.relatedSection?.items?.[index], 'title')}>{area.title}</strong></div><span class="arrow">→</span></div>
            </a>
          ))}
        </div>
      </div>
    </section>

    {showCrossFamilyCluster && (
      <NativeFamilyClusterLinks
        clusterHeading={clusterHeading}
        clusterLinks={clusterLinks}
        overviewHref={overviewHref}
        scopeLabel={scope.label}
      />
    )}

    <section class="mr-cities" data-header-theme="light" data-theme="light" aria-label="Sportwagen Fotografie in NRW">
      <div class="mr-cities__inner">
        <div class="mr-cities__head">
          <h2 set:html={cityHeading}></h2>
        </div>
        <nav class="mr-cities__grid" aria-label="Städte">
          {cityLinks.map(([href, label]) => <a class="mr-cities__cell" href={href}>{label}</a>)}
        </nav>
      </div>
    </section>

    <section class="mr-cities" data-header-theme="light" data-theme="light" aria-label="Sportwagen Fotografie Suchbegriffe">
      <div class="mr-cities__inner">
        <div class="mr-cities__head">
          <h2 set:html={intentHeading}></h2>
        </div>
        <nav class="mr-cities__grid" aria-label="Suchvarianten">
          {searchLinks.map(([href, label]) => <a class="mr-cities__cell" href={href}>{label}</a>)}
        </nav>
      </div>
    </section>

    <NativeFamilyFaq faq={faqItems} pageUrl={`https://matthiasramahi.de/${legacyFile}`} theme="dark" />

    <NativeReviews theme="light" />

    <section
      id="anfrage"
      data-contact-section
      data-header-theme="light"
      data-contact-subject={contactSubject}
      data-contact-headline={contactHeadline}
      data-contact-lead={contactLead}
    />
  </main>
</AdoptedPageLayout>
