const finalStatementImage = resolveSectionImage(doc?.statement?.image || visualDoc?.statement?.image, finalPortfolioTiles[0] || statementImage)
const firstSectionTarget = ''
const statementHeadlineSource = (typeof doc?.statement?.headline === 'string' && doc.statement.headline.trim()) || keywordFocusCopy?.statementHeadline || 'Bilder mit'
const statementEmphasisSource = (typeof doc?.statement?.emphasis === 'string' && doc.statement.emphasis.trim()) || keywordFocusCopy?.statementEmphasis || 'Druckqualität.'
