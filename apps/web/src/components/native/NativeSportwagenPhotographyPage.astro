const focusGalleryHeadline = isLocalHeroPage || isKeywordPage ? 'Aktuelle Arbeiten.' : cmsText(doc?.gallerySection?.headline) || keywordFocusCopy?.galleryHeadline || 'Aktuelle Arbeiten.'
const focusGalleryLead = cmsText(doc?.gallerySection?.lead) || keywordFocusCopy?.galleryLead || 'Sechs kuratierte Sportwagen-Bilder aus jüngeren Serien. Klicken zum Vergrößern.'
const focusAudienceHeadline = isLocalHeroPage ? 'Für wen ich arbeite.' : isKeywordPage ? 'Für wen ich arbeite.' : cmsText(doc?.audienceSection?.headline) || keywordFocusCopy?.audienceHeadline || 'Für wen ich arbeite.'
const focusAudienceLead =
