      'Ob Verkauf, Branding, Redaktion oder persönliches Geschenk: ich kombiniere klares Licht, saubere Komposition und einen Blick für Details. Du bekommst Dateien für Web, Social Media und Druck: aufbereitet und sofort einsatzbereit.',
    ]
const statementBody = statementSupportLine ? [statementSupportLine, ...baseStatementBody] : baseStatementBody

const focusSectionHeadline = cmsText(doc?.focusSection?.headline) || keywordFocusCopy?.sectionHeadline || 'Das Auto,'
const focusSectionEmphasis = cmsText(doc?.focusSection?.emphasis) || keywordFocusCopy?.sectionEmphasis || 'aus jedem Winkel.'
