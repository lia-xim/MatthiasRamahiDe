---
import AdoptedPageLayout from '../../layouts/AdoptedPageLayout.astro'
import NativeFamilyClusterLinks from './NativeFamilyClusterLinks.astro'
import NativeFamilyFaq from './NativeFamilyFaq.astro'
import NativeReviews from './NativeReviews.astro'
import PreviewToolbar from '../PreviewToolbar.astro'
import {
  localScopePhrase,
  nativeFamilyPageContext,
  type NativeFamilyPreviewState,
} from '../../lib/nativeFamilyPageContext'
import { mergeAuthoredLocalSeoContent } from '../../lib/authoredSeoContent'
import { curateFamilyClusterLinks } from '../../lib/familyClusterLinks'
import { cmsHeroTitleFitStyle, splitCmsHeroTitleLines, splitHeroTitleLines } from '../../lib/heroTitleLines'
import { keywordFocusCopyForSlug } from '../../lib/localSeoFamilyContent'
import { familyHeroCopy, familyVisualSlots, getFamilyVisualSourceDoc } from '../../lib/localSeoFamilyVisuals'
import { getLegacyBackedDoc, type PayloadDoc } from '../../lib/payload'
import { splitTrailingEmphasis } from '../../lib/splitTrailingEmphasis'
import { tinaAttrs } from '../../lib/tinaFieldAttrs'

type Props = {
  doc?: PayloadDoc | null
  legacyFile?: string
  preview?: NativeFamilyPreviewState
  visualDoc?: PayloadDoc | null
}

const defaultLegacyFile = 'landschaftsfotografie.html'
const props = Astro.props as Props
const { doc: providedDoc = undefined, legacyFile: providedLegacyFile, preview, visualDoc: providedVisualDoc = undefined } = props
const legacyFile = providedLegacyFile || defaultLegacyFile
const fetchedDoc = providedDoc || (await getLegacyBackedDoc(legacyFile, { depth: 2 }))
const doc = preview ? fetchedDoc : mergeAuthoredLocalSeoContent(legacyFile, fetchedDoc)
const shouldUseCmsVisualDoc = import.meta.env.ASTRO_DISABLE_CMS_VISUAL_OVERRIDES !== 'true'
const visualDoc = Object.hasOwn(props, 'visualDoc')
  ? providedVisualDoc
  : shouldUseCmsVisualDoc
    ? await getFamilyVisualSourceDoc('landschaft', doc, legacyFile, defaultLegacyFile)
    : null
const pageContext = nativeFamilyPageContext({
  defaultLegacyFile,
  doc,
  family: 'landschaft',
  legacyFile,
  preview,
})
const { clusterHeading, clusterLinks, isKeywordPage, isParentPage, overviewHref, publishedHref, scope, serviceLabel } = pageContext
const keywordFocusCopy = keywordFocusCopyForSlug(legacyFile)
const cmsFaqSource = (doc?.localFaq?.length ? doc.localFaq : doc?.faq) || []
const cmsFaqItems = cmsFaqSource.map((entry) => ({ q: entry.question || '', a: entry.answer || '' })).filter((entry) => entry.q && entry.a)
const faqItems = cmsFaqItems.length ? cmsFaqItems : keywordFocusCopy?.faq
const cmsText = (value: unknown) => (typeof value === 'string' ? value.trim() : '')
const cmsHeroLine2 = cmsText(doc?.heroLine2)
const cmsStatementBody = doc?.statement?.body?.map((entry) => cmsText(entry.text)).filter(Boolean) || []
const heroLabel = isParentPage ? 'Landschaftsfotografie' : isKeywordPage ? serviceLabel : `Landschaftsfotografie ${scope.label}`
const isLocalHeroPage = !isParentPage && !isKeywordPage
const priorityLocalScopeSlugs = new Set(['duesseldorf', 'erkrath', 'ratingen', 'mettmann', 'koeln', 'essen', 'dortmund'])
const isPriorityLocalPage = isLocalHeroPage && priorityLocalScopeSlugs.has(scope.slug)
const shouldUseCmsHeroTitle = !isParentPage
const heroTitle = isParentPage ? 'Landschaftsfotografie' : serviceLabel
const heroSecondLine = isLocalHeroPage ? scope.label : ''
const fallbackHeroTitleLines = [...splitHeroTitleLines(heroTitle), ...splitHeroTitleLines(heroSecondLine)]
const heroTitleLines = shouldUseCmsHeroTitle
  ? splitCmsHeroTitleLines(doc?.title || doc?.targetKeyword || doc?.seo?.focusKeyword, fallbackHeroTitleLines)
  : fallbackHeroTitleLines
const heroLocalNote = isLocalHeroPage ? cmsHeroLine2 || keywordFocusCopy?.heroEmphasis || 'Licht. Raum. Print.' : isKeywordPage ? cmsHeroLine2 || keywordFocusCopy?.heroEmphasis || '' : ''
const defaultHeroLead = isParentPage
  ? 'Landschaftsfotografie: Licht, Weite, Material und Raumwirkung werden kuratiert — als Fine-Art-Print, Wandbild, Edition oder großformatige Arbeit für Räume mit Ruhe. Bundesweit zählt vor allem die passende Motivwahl, Druckqualität, Materialität und Wirkung im Raum.'
  : isKeywordPage
    ? `${serviceLabel} in ${scope.label}: Landschaftsfotografie für ${scope.label}: Bildräume aus Geduld, Licht und Atmosphäre - als Fine-Art-Print, Wandbild, Edition oder Großformat für Räume, die Ruhe statt Spektakel brauchen. Düsseldorf wird als lokaler Suchraum mit klarer Planung, Lichtfenster und passender Nutzung der Bildserie verstanden.`
    : `Landschaftsfotografie für ${scope.label}: Licht, Weite, Material und Raumwirkung werden kuratiert - als Fine-Art-Print, Wandbild, Edition oder großformatige Arbeit für Räume mit Ruhe. ${localScopePhrase(scope)}`
const fallbackMetaTitle = isParentPage
  ? 'Landschaftsfotografie - Matthias Ramahi'
  : isKeywordPage
    ? `${serviceLabel} | Matthias Ramahi`
    : `${serviceLabel} ${scope.label} | Matthias Ramahi`
const metaTitle = doc?.seo?.title || fallbackMetaTitle
const heroLead = keywordFocusCopy?.heroLead
  ? `${keywordFocusCopy.heroLead}${!isParentPage && !isKeywordPage ? ` ${localScopePhrase(scope)}` : ''}`
  : defaultHeroLead
const heroCopy = familyHeroCopy(doc, visualDoc, {
  lead: heroLead,
  primaryHref: '#anfrage',
  primaryLabel: 'Landschafts-Serie anfragen \u2192',
  secondaryHref: '/portfolio/portfolio-auswahl-landschaft',
  secondaryLabel: 'Landschaft-Auswahl',
  titleLines: heroTitleLines,
})
const heroTitleFitStyle = cmsHeroTitleFitStyle(heroCopy.titleLines, shouldUseCmsHeroTitle)
const defaultMetaDescription = isParentPage
  ? 'Landschaftsfotografie: Fine-Art-Prints, Wandbilder, Editionen und großformatige Arbeiten für private Räume, Praxen, Hotels und Sammlungen.'
  : isKeywordPage
    ? `${serviceLabel}: Fine-Art-Prints, Wandbilder, Editionen und großformatige Arbeiten.`
    : `${serviceLabel} ${scope.label}: Fine-Art-Prints, Wandbilder, Editionen und großformatige Arbeiten.`
const metaDescription = doc?.seo?.description || keywordFocusCopy?.metaDescription || defaultMetaDescription
const contactSubject = isParentPage ? 'Landschaftsfotografie Anfrage' : `${serviceLabel}${isKeywordPage ? ' Düsseldorf' : ` ${scope.label}`} Anfrage`
const contactHeadline = isParentPage
  ? 'Landschaft <em>anfragen.</em>'
  : isKeywordPage
    ? `${serviceLabel} Düsseldorf <em>anfragen.</em>`
    : `Landschaft ${scope.label} <em>anfragen.</em>`
const defaultContactLead = isParentPage
  ? 'Schreibe kurz, wofür die Landschaftsbilder eingesetzt werden — Fine-Art-Print, Innenraum, Editorial, Website oder Markenbild. Wichtig sind gewünschte Atmosphäre, Format, Material und Zeitraum.'
  : isKeywordPage
    ? `Schreibe kurz, wofür ${serviceLabel} gebraucht wird, welches Motiv oder welcher Raum im Mittelpunkt steht und welche Nutzung geplant ist. Wir klären Ort, Licht, Umfang und Ausgabe gemeinsam.`
    : `Schreibe kurz, wofür die Landschaftsbilder in ${scope.label} eingesetzt werden - Fine-Art-Print, Innenraum, Editorial, Website oder Markenbild. Wichtig sind gewünschte Atmosphäre, Format, Material und Zeitraum.`

const contactLead = keywordFocusCopy?.contactLead || defaultContactLead

// CMS-Bild-Overrides pro Sektion (Tab „Themen-Sektionen"): 4 Ausführungs-Karten
// (Fine-Art/Aluminium/Acrylglas/Edition) lesen Text aus audienceCards → Bild ebenso
// aus audienceCards[i].image (Slots 5–8). Galerie aus portfolioTiles[i].image (9–17).
const sectionImageOverrides = [
  ...Array.from({ length: 5 }, (_, index) => doc?.heroPanels?.[index]?.image || visualDoc?.heroPanels?.[index]?.image),
  ...Array.from({ length: 4 }, (_, index) => {
    const card = doc?.shootingStyles?.[index] || doc?.audienceCards?.[index] || visualDoc?.shootingStyles?.[index] || visualDoc?.audienceCards?.[index]
    return index === 0 ? doc?.statement?.image || visualDoc?.statement?.image || card?.image : card?.image
  }),
  ...Array.from({ length: 9 }, (_, index) => doc?.portfolioTiles?.[index]?.image || visualDoc?.portfolioTiles?.[index]?.image),
  ...Array.from({ length: 4 }, (_, index) => doc?.processSteps?.[index]?.image || visualDoc?.processSteps?.[index]?.image),
  ...Array.from({ length: 4 }, (_, index) => doc?.relatedSection?.items?.[index]?.image || visualDoc?.relatedSection?.items?.[index]?.image),
]
const visualSlots = familyVisualSlots(visualDoc, [
  { alt: 'Landschaft Wasser', full: 'assets/optimized/assets-portfolio-wettberwerb-foto5-wunder-der-natur2-1920.webp', src: 'assets/portfolio/thumbs/Wettberwerb_Foto5_Wunder_der_Natur2.webp', width: 1920, height: 1280 },
  { alt: 'Landschaft Wald', full: 'assets/optimized/assets-portfolio-20250605-dsc04020-1920.webp', src: 'assets/portfolio/thumbs/20250605-DSC04020.webp', width: 1707, height: 2560 },
  { alt: 'Landschaft Licht', full: 'assets/optimized/assets-portfolio-wettberwerb-foto10-wunder-der-natur-1920.webp', src: 'assets/portfolio/thumbs/Wettberwerb_Foto10_Wunder_der_natur.webp', width: 1920, height: 1194 },
  { alt: 'Landschaft Detail', full: 'assets/optimized/assets-portfolio-dsc8032-1920.webp', src: 'assets/portfolio/thumbs/_DSC8032.webp', width: 1920, height: 2400 },
  { alt: 'Landschaft Print', full: 'assets/optimized/assets-portfolio-20250605-dsc03978-1920.webp', src: 'assets/portfolio/thumbs/20250605-DSC03978.webp', width: 1707, height: 2560 },
  { alt: 'Fine-Art Landschaft', full: 'assets/optimized/assets-portfolio-wettberwerb-foto6-wunder-der-natur-1920.webp', src: 'assets/portfolio/thumbs/Wettberwerb_Foto6_Wunder_der_Natur.webp', width: 720, height: 520 },
  { alt: 'Aluminium Landschaft', full: 'assets/optimized/assets-portfolio-wettberwerb-foto10-wunder-der-natur-1920.webp', src: 'assets/portfolio/thumbs/Wettberwerb_Foto10_Wunder_der_natur.webp', width: 720, height: 448 },
  { alt: 'Acrylglas Landschaft', full: 'assets/optimized/assets-portfolio-20250414-dsc00341-1920.webp', src: 'assets/portfolio/thumbs/20250414-DSC00341.webp', width: 720, height: 1080 },
  { alt: 'Landschaft Edition', full: 'assets/optimized/assets-portfolio-20250327-dsc01550-1920.webp', src: 'assets/portfolio/thumbs/20250327-DSC01550.webp', width: 720, height: 1090 },
  { alt: 'Landschaft Hauptmotiv', full: 'assets/optimized/assets-portfolio-wettberwerb-foto5-wunder-der-natur2-1920.webp', src: 'assets/portfolio/thumbs/Wettberwerb_Foto5_Wunder_der_Natur2.webp', width: 720, height: 471 },
  { alt: 'Landschaft', full: 'assets/optimized/assets-portfolio-wettberwerb-foto6-wunder-der-natur-1920.webp', src: 'assets/portfolio/thumbs/Wettberwerb_Foto6_Wunder_der_Natur.webp', width: 720, height: 520 },
  { alt: 'Landschaft Atmosphaere', full: 'assets/optimized/assets-portfolio-wettberwerb-foto10-wunder-der-natur-1920.webp', src: 'assets/portfolio/thumbs/Wettberwerb_Foto10_Wunder_der_natur.webp', width: 720, height: 448 },
  { alt: 'Landschaft Cinema', full: 'assets/optimized/assets-portfolio-20250605-dsc04020-1920.webp', src: 'assets/portfolio/thumbs/20250605-DSC04020.webp', width: 720, height: 1080 },
  { alt: 'Landschaft', full: 'assets/optimized/assets-portfolio-20250605-dsc03978-1920.webp', src: 'assets/portfolio/thumbs/20250605-DSC03978.webp', width: 720, height: 960 },
  { alt: 'Landschaft', full: 'assets/optimized/assets-portfolio-20250605-dsc03816-1920.webp', src: 'assets/portfolio/thumbs/20250605-DSC03816.webp', width: 720, height: 960 },
  { alt: 'Landschaft', full: 'assets/optimized/assets-portfolio-20250605-dsc03793-1920.webp', src: 'assets/portfolio/thumbs/20250605-DSC03793.webp', width: 720, height: 960 },
  { alt: 'Landschaft', full: 'assets/optimized/assets-portfolio-20250605-dsc03756-1920.webp', src: 'assets/portfolio/thumbs/20250605-DSC03756.webp', width: 720, height: 1080 },
  { alt: 'Landschaft Detail', full: 'assets/optimized/assets-portfolio-20250414-dsc00341-1920.webp', src: 'assets/portfolio/thumbs/20250414-DSC00341.webp', width: 720, height: 1080 },
  { alt: 'Anfrage', full: 'assets/optimized/assets-portfolio-wettberwerb-foto5-wunder-der-natur2-1920.webp', src: 'assets/portfolio/thumbs/Wettberwerb_Foto5_Wunder_der_Natur2.webp', width: 720, height: 471 },
  { alt: 'Beratung', full: 'assets/optimized/assets-portfolio-20250605-dsc03978-1920.webp', src: 'assets/portfolio/thumbs/20250605-DSC03978.webp', width: 720, height: 960 },
  { alt: 'Produktion', full: 'assets/optimized/assets-portfolio-wettberwerb-foto10-wunder-der-natur-1920.webp', src: 'assets/portfolio/thumbs/Wettberwerb_Foto10_Wunder_der_natur.webp', width: 720, height: 448 },
  { alt: 'Lieferung', full: 'assets/optimized/assets-portfolio-20250414-dsc00341-1920.webp', src: 'assets/portfolio/thumbs/20250414-DSC00341.webp', width: 720, height: 1080 },
  { alt: 'Portrait', full: 'assets/photos/portrait-blue.webp', src: 'assets/photos/portrait-blue.webp', width: 2048, height: 2560 },
  { alt: 'Oldtimer', full: 'assets/optimized/assets-photos-oldtimer-stage-1920.webp', src: 'assets/optimized/assets-photos-oldtimer-stage-1920.webp', width: 1920, height: 1280 },
  { alt: 'Drucke', full: 'assets/optimized/assets-portfolio-20250605-dsc03978-1920.webp', src: 'assets/optimized/assets-portfolio-20250605-dsc03978-1920.webp', width: 1707, height: 2560 },
  { alt: 'Portfolio', full: 'assets/optimized/assets-portfolio-wettberwerb-foto10-wunder-der-natur-1920.webp', src: 'assets/optimized/assets-portfolio-wettberwerb-foto10-wunder-der-natur-1920.webp', width: 1920, height: 1194 },
], sectionImageOverrides)
const heroImages = visualSlots.slice(0, 5).map((slot) => slot.full).join(',')

const firstSectionTarget = isLocalHeroPage ? `${serviceLabel} ${scope.label}` : isKeywordPage ? serviceLabel : ''
const focusIntroHeadlineSource = cmsText(doc?.statement?.headline) || keywordFocusCopy?.pullHeadline || (isParentPage || isKeywordPage ? 'Bilder, die einen' : `Landschaft fuer ${scope.label}`)
const focusIntroEmphasisSource = cmsText(doc?.statement?.emphasis) || keywordFocusCopy?.pullEmphasis || (isParentPage || isKeywordPage ? 'Raum veraendern.' : 'als Raumwirkung.')
const focusIntroHeadline = firstSectionTarget || focusIntroHeadlineSource
const focusIntroEmphasis = firstSectionTarget ? '' : focusIntroEmphasisSource
const focusIntroTitle = splitTrailingEmphasis(focusIntroHeadline, focusIntroEmphasis)
const focusIntroSourceTitle = splitTrailingEmphasis(focusIntroHeadlineSource, focusIntroEmphasisSource)
const focusIntroSupportLine = firstSectionTarget ? [focusIntroSourceTitle.headline, focusIntroSourceTitle.emphasis].filter(Boolean).join(' ') : ''
const focusIntroBaseParagraphs = cmsStatementBody.length
  ? cmsStatementBody
  : keywordFocusCopy?.statementBody?.length
    ? keywordFocusCopy.statementBody
    : isParentPage || isKeywordPage
      ? [
      'Landschaft entsteht aus Geduld - aus der Entscheidung, was im Bild bleiben darf und was nicht. Aus Wetter, das man nicht herstellen kann, und aus dem richtigen Moment, in dem alles zusammenkommt.',
      'Jede Aufnahme ist als grossformatiger Print gedacht - fuer Wand, Wohnraum, Praxis, Hotel oder Sammlung. Alle Motive werden farbecht auf Fine-Art-Papier, Aluminium-Dibond oder hinter Acrylglas gefertigt und gedruckt.',
    ]
      : [
      `Landschaftsfotografie fuer ${scope.label} wird nicht als Termin vor Ort verkauft, sondern als kuratierte Bild- und Printauswahl fuer Raeume, Marken und private Sammlungen verstanden.`,
      `Der lokale Bezug macht die Anfrage konkreter: Menschen in ${scope.label} suchen Wandbilder, Fine-Art-Prints oder ruhige Bildraeume, die zu Wohnung, Praxis, Hotel oder Buero passen.`,
    ]
const landscapeLocalDepthParagraphs = isPriorityLocalPage
  ? [
      `${localScopePhrase(scope)} Bei Landschaftsfotografie fuer ${scope.label} geht es deshalb weniger um eine beliebige Ortsseite als um die Auswahl passender Motive fuer konkrete Raeume: ruhige Wandbilder fuer Wohnbereiche, reduzierte Naturbilder fuer Praxen, grossformatige Prints fuer Buero, Kanzlei, Hotel oder Sammlung.`,
      `Vor der Produktion werden Raumgroesse, Licht an der Wand, Betrachtungsabstand, Material und Wirkung geklaert. Ein Motiv fuer einen hellen Empfangsbereich braucht eine andere Dichte als ein ruhiges Schlafzimmerbild, ein Acrylglas-Print andere Kontraste als Hahnemuehle-Papier. So trennt sich Landschaftsfotografie ${scope.label} klar von einer reinen Galerie-Uebersicht.`,
    ]
  : []
const focusIntroParagraphs = focusIntroSupportLine
  ? [focusIntroSupportLine, ...focusIntroBaseParagraphs, ...landscapeLocalDepthParagraphs]
  : [...focusIntroBaseParagraphs, ...landscapeLocalDepthParagraphs]
const focusModuleHeadline = isLocalHeroPage ? `${serviceLabel} ${scope.label}.` : isKeywordPage ? `${serviceLabel}.` : cmsText(doc?.focusSection?.headline) || keywordFocusCopy?.sectionHeadline || (isParentPage ? 'Vier Ausfuehrungen.' : `Ausfuehrungen fuer ${scope.label}.`)
const focusModuleEmphasis = !isLocalHeroPage && !isKeywordPage ? cmsText(doc?.focusSection?.emphasis) : ''
const focusModuleTitle = splitTrailingEmphasis(focusModuleHeadline, focusModuleEmphasis)
const focusModuleLead = isParentPage || isKeywordPage
  ? cmsText(doc?.focusSection?.lead) || keywordFocusCopy?.sectionLead || 'Jedes Motiv ist als Print erhaeltlich.'
  : cmsText(doc?.focusSection?.lead) || `Jedes Motiv kann fuer Raeume in ${scope.label} nach Format, Material und Wirkung abgestimmt werden.`
const defaultModuleCards = [
  { visualIndex: 5, title: 'Fine-Art', text: 'Papier, Tonwert und Motiv werden passend zum Raum abgestimmt.' },
  { visualIndex: 6, title: 'Aluminium', text: 'Ruhige Wandbilder auf stabilem Traeger fuer klare Raeume und Praxen.' },
  { visualIndex: 7, title: 'Acrylglas', text: 'Tiefe, Glanz und klare Kanten fuer Motive mit Licht und Struktur.' },
  { visualIndex: 8, title: 'Edition', text: 'Kuratierte Motive als Einzelabzug oder kleine Edition nach Umfang.' },
]
const moduleCards = defaultModuleCards.map((card, index) => {
  const cmsCard = doc?.shootingStyles?.[index] || doc?.audienceCards?.[index]
  return cmsCard
    ? {
        ...card,
        title: cmsText(cmsCard.title) || card.title,
        text: cmsText(cmsCard.text) || card.text,
      }
    : card
})
const focusGalleryHeadline = isLocalHeroPage ? `${serviceLabel} ${scope.label}: Bildauswahl.` : isKeywordPage ? `${serviceLabel}: Bildauswahl.` : cmsText(doc?.gallerySection?.headline) || keywordFocusCopy?.galleryHeadline || (isParentPage ? 'Ausgewaehlte Landschaften.' : `Auswahl fuer ${scope.label}.`)
const focusGalleryLead = cmsText(doc?.gallerySection?.lead)
const focusProcessHeadline = isLocalHeroPage ? `Ablauf ${scope.label}` : isKeywordPage ? `Ablauf ${serviceLabel}` : cmsText(doc?.processSection?.headline) || keywordFocusCopy?.processHeadline || (isParentPage ? 'So entsteht' : `So entsteht dein Druck`)
const focusProcessEmphasis = isLocalHeroPage ? 'und Lieferung.' : isKeywordPage ? 'und Lieferung.' : cmsText(doc?.processSection?.emphasis) || keywordFocusCopy?.sectionEmphasis || (isParentPage ? 'Ihr Druck.' : `fuer ${scope.label}.`)
const focusProcessLead = isParentPage || isKeywordPage
  ? cmsText(doc?.processSection?.lead) || keywordFocusCopy?.processLead || 'Jedes Bild aus dem Portfolio, in jedem Format, mit oder ohne Rahmen - auf Anfrage gefertigt und zu Ihnen geliefert.'
  : cmsText(doc?.processSection?.lead) || `Motiv, Format, Material und Lieferziel werden fuer ${scope.label} abgestimmt, damit der Print im Raum ruhig und hochwertig wirkt. Geplant wird nicht nur das Bild, sondern auch Abstand, Wandlicht, Oberflaeche und die Frage, ob der Raum Ruhe, Weite oder einen starken visuellen Anker braucht.`
const defaultProcessSteps = [
  {
    visualIndex: 18,
    imageLabel: 'Anfrage',
    title: 'Anfrage',
    text: isLocalHeroPage
      ? `Motivwunsch, Raum, Format, Wandmass und gewuenschte Wirkung in ${scope.label} werden kurz eingeordnet. Fotos der Wandsituation helfen, Groesse und Material realistisch abzuschaetzen.`
      : 'Motiv, Raum, Format und gewuenschte Wirkung werden kurz eingeordnet.',
  },
  {
    visualIndex: 19,
    imageLabel: 'Beratung',
    title: 'Beratung',
    text: isLocalHeroPage
      ? `Material, Groesse, Oberflaeche, Rahmen und Haengung werden passend zum Ort geplant. Dabei zaehlen Licht im Raum, Betrachtungsabstand und ob das Bild beruhigen oder als Hauptmotiv wirken soll.`
      : 'Material, Groesse, Oberflaeche und Haengung werden passend zum Ort geplant.',
  },
  {
    visualIndex: 20,
    imageLabel: 'Produktion',
    title: 'Produktion',
    text: isLocalHeroPage
      ? 'Der Print wird farbverbindlich vorbereitet, auf das gewaehlte Material ausgegeben und vor Auslieferung auf Tonwert, Schaerfe, Kanten und Oberflaeche kontrolliert.'
      : 'Der Print wird farbverbindlich vorbereitet und auf das gewaehlte Material ausgegeben.',
  },
  {
    visualIndex: 21,
    imageLabel: 'Lieferung',
    title: 'Lieferung',
    text: isLocalHeroPage
      ? `Das fertige Bild wird sicher verpackt und mit Angaben zu Material, Pflege und Haengung uebergeben. Fuer ${scope.label} lassen sich Lieferung und Timing passend zum Raumprojekt abstimmen.`
      : 'Das fertige Bild wird sicher verpackt und mit den benoetigten Angaben uebergeben.',
  },
]
const processSteps = defaultProcessSteps.map((step, index) => {
  const cmsStep = doc?.processSteps?.[index]
  return cmsStep
    ? {
        ...step,
        imageLabel: cmsText(cmsStep.imageLabel) || cmsText(cmsStep.title) || step.imageLabel,
        title: cmsText(cmsStep.title) || step.title,
        text: cmsText(cmsStep.text) || step.text,
      }
    : step
})
const focusRelatedLead = isParentPage || isKeywordPage
  ? cmsText(doc?.relatedSection?.lead) || keywordFocusCopy?.relatedLead || 'Fahrzeug, Mensch und Raum bleiben eigene Bildbereiche. Die Links fuehren schnell zu der Seite, die zum Motiv, zur Nutzung und zum geplanten Projekt passt.'
  : cmsText(doc?.relatedSection?.lead) || `Landschaftsfotografie ${scope.label} fuehrt zu Portrait, Oldtimer, Druck und Portfolio, ohne den Fokus auf Raum, Print und Motiv zu verwischen.`
const relatedTitle = splitTrailingEmphasis(cmsText(doc?.relatedSection?.headline) || 'Verwandte', cmsText(doc?.relatedSection?.emphasis) || 'Bereiche.')
const defaultRelatedCards = [
  { href: 'portraitfotografie.html', title: 'Portrait', visualIndex: 22 },
  { href: 'oldtimer-fotografie.html', title: 'Oldtimer', visualIndex: 23 },
  { href: 'drucke-sonderanfertigungen-duesseldorf.html', title: 'Drucke', visualIndex: 24 },
  { href: '/portfolio/portfolio-auswahl-landschaft', title: 'Landschaft-Auswahl', visualIndex: 25 },
]
const relatedCards = defaultRelatedCards.map((card, index) => {
  const item = doc?.relatedSection?.items?.[index]
  return {
    ...card,
    href: cmsText(item?.href) || card.href,
    title: cmsText(item?.title) || card.title,
    alt: cmsText(item?.alt) || cmsText(item?.title) || card.title,
  }
})
const allCityLinks = [
  ['landschaftsfotografie-duesseldorf.html', 'Düsseldorf'],
  ['landschaftsfotografie-erkrath.html', 'Erkrath'],
  ['landschaftsfotografie-ratingen.html', 'Ratingen'],
  ['landschaftsfotografie-koeln.html', 'Köln'],
  ['landschaftsfotografie-essen.html', 'Essen'],
  ['landschaftsfotografie-dortmund.html', 'Dortmund'],
  ['landschaftsfotografie-duisburg.html', 'Duisburg'],
  ['landschaftsfotografie-bochum.html', 'Bochum'],
  ['landschaftsfotografie-wuppertal.html', 'Wuppertal'],
  ['landschaftsfotografie-leverkusen.html', 'Leverkusen'],
  ['landschaftsfotografie-oberhausen.html', 'Oberhausen'],
  ['landschaftsfotografie-krefeld.html', 'Krefeld'],
  ['landschaftsfotografie-moenchengladbach.html', 'Mönchengladbach'],
  ['landschaftsfotografie-moers.html', 'Moers'],
  ['landschaftsfotografie-gelsenkirchen.html', 'Gelsenkirchen'],
  ['landschaftsfotografie-bergisch-gladbach.html', 'Bergisch Gladbach'],
  ['landschaftsfotografie-solingen.html', 'Solingen'],
  ['landschaftsfotografie-remscheid.html', 'Remscheid'],
  ['landschaftsfotografie-mettmann.html', 'Mettmann'],
  ['landschaftsfotografie-hilden.html', 'Hilden'],
  ['landschaftsfotografie-dormagen.html', 'Dormagen'],
  ['landschaftsfotografie-neuss.html', 'Neuss'],
  ['landschaftsfotografie-nrw.html', 'NRW'],
  ['landschaftsfotografie-deutschland.html', 'Deutschland'],
] as const

const intentLinks = [
  { key: 'landschaftsbilder', label: 'Landschaftsbilder kaufen', genericHref: 'landschaftsbilder-kaufen.html', duesseldorfHref: 'landschaftsbilder-kaufen.html' },
  { key: 'fine-art', label: 'Fine Art Prints Landschaft', genericHref: 'fine-art-prints-landschaft.html', duesseldorfHref: 'fine-art-prints-landschaft.html' },
  { key: 'wandbilder', label: 'Wandbilder Landschaftsfotografie', genericHref: 'wandbilder-landschaftsfotografie.html', duesseldorfHref: 'wandbilder-landschaftsfotografie.html' },
  { key: 'naturfotografie', label: 'Naturfotografie Prints', genericHref: 'naturfotografie-prints.html', duesseldorfHref: 'naturfotografie-prints.html' },
  { key: 'print-deutschland', label: 'Landschaftsfotografie Print Deutschland', genericHref: 'landschaftsfotografie-print-deutschland.html', duesseldorfHref: 'landschaftsfotografie-print-deutschland.html' },
] as const
const clusterCuration = curateFamilyClusterLinks({
  allCityLinks,
  currentPage: legacyFile,
  defaultLegacyFile,
  familyLabel: 'Landschaftsfotografie',
  intentLinks,
  intentNeighbors: {
    landschaftsbilder: ['fine-art', 'wandbilder', 'naturfotografie'],
    'fine-art': ['landschaftsbilder', 'wandbilder', 'naturfotografie'],
    wandbilder: ['landschaftsbilder', 'fine-art', 'naturfotografie'],
    naturfotografie: ['landschaftsbilder', 'fine-art', 'wandbilder'],
    'print-deutschland': ['landschaftsbilder', 'fine-art', 'wandbilder'],
  },
  isParentPage,
  primaryIntentKeys: ['landschaftsbilder', 'fine-art', 'wandbilder', 'naturfotografie'],
  scopeSlug: scope.slug,
})
const {
  cityHeading,
  cityLinks,
  intentHeading,
  searchLinks,
  showCrossFamilyCluster,
} = clusterCuration
const contactSubjectFinal = cmsText(doc?.contactSection?.emailSubject) || contactSubject
const contactHeadlineBase = cmsText(doc?.contactSection?.headline)
const contactHeadlineEmphasis = cmsText(doc?.contactSection?.emphasis)
const contactHeadlineFinal = contactHeadlineBase
  ? `${contactHeadlineBase}${contactHeadlineEmphasis ? ` <em>${contactHeadlineEmphasis}</em>` : ''}`
  : contactHeadline
const contactLeadFinal = cmsText(doc?.contactSection?.lead) || contactLead
const heroPanelSource = (index: number) => doc?.heroPanels?.[index] || doc?.heroSlides?.[index] || visualDoc?.heroPanels?.[index] || visualDoc?.heroSlides?.[index]
const heroTextSource = doc?.heroSlides?.[0] || doc
const heroTitleField = (index: number) =>
  heroTextSource === doc?.heroSlides?.[0]
    ? index === 0
      ? 'headlineLine1'
      : 'headlineLine2'
    : shouldUseCmsHeroTitle
      ? 'title'
      : index === 0
      ? 'title'
      : 'heroLine2'
const heroLeadField = heroTextSource === doc?.heroSlides?.[0] ? 'lead' : 'intro'
---
<AdoptedPageLayout
  legacyFile={legacyFile}
  current="fotografie"
  doc={doc}
  noIndex={Boolean(preview)}
  title={metaTitle}
  description={metaDescription}
  ogImage={doc?.seo?.ogImage || visualSlots[0].full}
  preloadImages={[visualSlots[0].full]}
>
  {preview && (
    <PreviewToolbar
      collection={preview.collection}
      slug={preview.slug}
      status={preview.status}
      publishedHref={publishedHref}
    />
  )}
  <main>
    <section
      class="hero-ls"
      data-header-theme="dark"
      aria-label={heroLabel}
      data-images={heroImages}
      {...tinaAttrs(heroPanelSource(0), 'image')}
    >
      <div class="hero-ls__paper" aria-hidden="true"></div>

      <svg class="hero-ls__stage" viewBox="0 0 1920 1080" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <defs>
          <filter id="liquidEdge" x="-20%" y="-20%" width="140%" height="140%" filterUnits="objectBoundingBox" primitiveUnits="userSpaceOnUse">
            <feTurbulence type="fractalNoise" baseFrequency="0.0055 0.0042" numOctaves="3" seed="11" result="noise" />
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="180" xChannelSelector="R" yChannelSelector="G" result="displaced" />
            <feGaussianBlur in="displaced" stdDeviation="6" />
          </filter>
          <mask id="maskA" maskUnits="userSpaceOnUse" x="0" y="0" width="1920" height="1080">
            <rect width="1920" height="1080" fill="black" />
            <g id="blobsA" filter="url(#liquidEdge)"></g>
          </mask>
          <mask id="maskB" maskUnits="userSpaceOnUse" x="0" y="0" width="1920" height="1080">
            <rect width="1920" height="1080" fill="black" />
            <g id="blobsB" filter="url(#liquidEdge)"></g>
          </mask>
        </defs>

        <image id="lsImgBottom" width="1920" height="1080" x="0" y="0" preserveAspectRatio="xMidYMid slice" mask="url(#maskA)" href="" />
        <image id="lsImgTop" width="1920" height="1080" x="0" y="0" preserveAspectRatio="xMidYMid slice" mask="url(#maskB)" href="" />
      </svg>

      <svg class="hero-ls__ripple" viewBox="0 0 1920 1080" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <circle id="lsRipple" cx="960" cy="540" r="0"></circle>
      </svg>

      <div class="hero-ls__grain" aria-hidden="true"></div>
      <div class="hero-ls__chrome-wash" aria-hidden="true"></div>
      <div class="hero-ls__bottom-wash" aria-hidden="true"></div>
      <div class="hero-ls__text-scrim" aria-hidden="true"></div>

      <div class="hero-ls__inner">
        <h1 class="hero-ls__title" style={heroTitleFitStyle} aria-label={heroLabel}>
          {heroCopy.titleLines.map((line, index) => (
            <>
              {index > 0 && ' '}
              <span class="l" {...tinaAttrs(heroTextSource, heroTitleField(index))}><span class="w">{line}</span></span>
            </>
          ))}
        </h1>
        {heroLocalNote && <p class="hero-ls__local-note" {...tinaAttrs(doc, 'heroLine2')}>{heroLocalNote}</p>}
        <p class="hero-ls__sub" {...tinaAttrs(heroTextSource, heroLeadField)}>{heroCopy.lead}</p>
        <div class="hero-ls__actions">
          <a class="btn primary" href={heroCopy.primaryHref} {...tinaAttrs(heroTextSource, 'primaryLabel')}>{heroCopy.primaryLabel}</a>
          <a class="btn" href={heroCopy.secondaryHref} {...tinaAttrs(heroTextSource, 'secondaryLabel')}>{heroCopy.secondaryLabel}</a>
        </div>
      </div>

      <div class="hero-ls__counter" id="lsCounter" aria-hidden="true"></div>
    </section>

    <section class="st-ls" data-header-theme="light">
      <div class="st-ls__inner">
        <h2 class="st-ls__title">
          <span {...tinaAttrs(doc?.statement, 'headline')}>{focusIntroTitle.headline}</span>
          {focusIntroTitle.headline && focusIntroTitle.emphasis ? ' ' : ''}
          {focusIntroTitle.emphasis && <em {...tinaAttrs(doc?.statement, 'emphasis')}>{focusIntroTitle.emphasis}</em>}
        </h2>
        <div class="st-ls__body">
          {focusIntroParagraphs.map((paragraph, index) => <p {...tinaAttrs(doc?.statement?.body?.[index], 'text')}>{paragraph}</p>)}
          <a class="st-ls__cta" href="#anfrage">Projekt anfragen →</a>
        </div>
      </div>
    </section>

    <section class="mod-ls" data-header-theme="dark">
      <div class="mod-ls__head">
        <h2 class="mod-ls__title">
          <span {...tinaAttrs(doc?.focusSection, 'headline')}>{focusModuleTitle.headline}</span>
          {focusModuleTitle.headline && focusModuleTitle.emphasis ? ' ' : ''}
          {focusModuleTitle.emphasis && <em {...tinaAttrs(doc?.focusSection, 'emphasis')}>{focusModuleTitle.emphasis}</em>}
        </h2>
        <p class="mod-ls__lead" {...tinaAttrs(doc?.focusSection, 'lead')}>{focusModuleLead}</p>
      </div>
      <div class="mod-ls__grid">
        {moduleCards.map((card, index) => (
          <article class="mod-ls__card">
            <div class="mod-ls__img" style={`background-image:url('${visualSlots[card.visualIndex].cssFull}')`} {...tinaAttrs(doc?.shootingStyles?.[index] || doc?.audienceCards?.[index], 'image')}></div>
            <div class="mod-ls__body">
              <h3 class="mod-ls__name" {...tinaAttrs(doc?.shootingStyles?.[index] || doc?.audienceCards?.[index], 'title')}>{card.title}</h3>
              <p {...tinaAttrs(doc?.shootingStyles?.[index] || doc?.audienceCards?.[index], 'text')}>{card.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="bg-ls" data-header-theme="dark" aria-label="Ausgewählte Landschaftsarbeiten">
      <div class="bg-ls__head">
        <h2 class="bg-ls__title" {...tinaAttrs(doc?.gallerySection, 'headline')}>{focusGalleryHeadline}</h2>
        {focusGalleryLead && <p class="bg-ls__lead" {...tinaAttrs(doc?.gallerySection, 'lead')}>{focusGalleryLead}</p>}
        <a class="bg-ls__link" href="/portfolio/portfolio-auswahl-landschaft">Landschaft-Auswahl ansehen →</a>
      </div>
      <div class="bg-ls__grid">
        <button class="bg-ls__tile t-hero" data-full={visualSlots[9].full}><img loading="lazy" src={visualSlots[9].src} alt={visualSlots[9].alt} width={visualSlots[9].width} height={visualSlots[9].height} decoding="async" {...tinaAttrs(doc?.portfolioTiles?.[0], 'image')} /></button>
        <button class="bg-ls__tile t-a" data-full={visualSlots[10].full}><img loading="lazy" src={visualSlots[10].src} alt={visualSlots[10].alt} width={visualSlots[10].width} height={visualSlots[10].height} decoding="async" {...tinaAttrs(doc?.portfolioTiles?.[1], 'image')} /></button>
        <button class="bg-ls__tile t-b" data-full={visualSlots[11].full}><img loading="lazy" src={visualSlots[11].src} alt={visualSlots[11].alt} width={visualSlots[11].width} height={visualSlots[11].height} decoding="async" {...tinaAttrs(doc?.portfolioTiles?.[2], 'image')} /></button>
        <button class="bg-ls__tile t-c" data-full={visualSlots[12].full}><img loading="lazy" src={visualSlots[12].src} alt={visualSlots[12].alt} width={visualSlots[12].width} height={visualSlots[12].height} decoding="async" {...tinaAttrs(doc?.portfolioTiles?.[3], 'image')} /></button>
        <button class="bg-ls__tile t-d" data-full={visualSlots[13].full}><img loading="lazy" src={visualSlots[13].src} alt={visualSlots[13].alt} width={visualSlots[13].width} height={visualSlots[13].height} decoding="async" /></button>
        <button class="bg-ls__tile t-e" data-full={visualSlots[14].full}><img loading="lazy" src={visualSlots[14].src} alt={visualSlots[14].alt} width={visualSlots[14].width} height={visualSlots[14].height} decoding="async" /></button>
        <button class="bg-ls__tile t-f" data-full={visualSlots[15].full}><img loading="lazy" src={visualSlots[15].src} alt={visualSlots[15].alt} width={visualSlots[15].width} height={visualSlots[15].height} decoding="async" /></button>
        <button class="bg-ls__tile t-g" data-full={visualSlots[16].full}><img loading="lazy" src={visualSlots[16].src} alt={visualSlots[16].alt} width={visualSlots[16].width} height={visualSlots[16].height} decoding="async" /></button>
        <button class="bg-ls__tile t-h" data-full={visualSlots[17].full}><img loading="lazy" src={visualSlots[17].src} alt={visualSlots[17].alt} width={visualSlots[17].width} height={visualSlots[17].height} decoding="async" /></button>
      </div>
    </section>

    <section class="fw-ls" data-header-theme="light">
      <div class="fw-ls__inner">
        <div class="fw-ls__head">
          <h2 class="fw-ls__title">{focusProcessHeadline} <em>{focusProcessEmphasis}</em></h2>
          <p class="fw-ls__lead">{focusProcessLead}</p>
        </div>

        <div class="fw-ls__flow">
          {processSteps.map((step, index) => (
            <article class="fw-ls__step">
              <div class="fw-ls__step-img" style={`background-image:url('${visualSlots[step.visualIndex].cssSrc}')`} role="img" aria-label={step.imageLabel}></div>
              <span class="fw-ls__step-num">{String(index + 1).padStart(2, '0')}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))}
        </div>

        <div class="fw-ls__cta">
          <a href="contact.html">Projekt anfragen →</a>
        </div>
      </div>
    </section>

    <section class="rl-ls" data-header-theme="dark" aria-label="Landschaftsfotografie">
      <div class="rl-ls__inner">
        <h2 class="rl-ls__title">
          {relatedTitle.headline}
          {relatedTitle.headline && relatedTitle.emphasis ? ' ' : ''}
          {relatedTitle.emphasis && <em>{relatedTitle.emphasis}</em>}
        </h2>
        <p class="rl-ls__intro">{focusRelatedLead}</p>
        <div class="rl-ls__grid">
          {relatedCards.map((card) => (
            <a class="rl-ls__card" href={card.href}>
              <div class="rl-ls__card-img" style={`background-image:url('${visualSlots[card.visualIndex].cssSrc}')`} role="img" aria-label={card.alt}></div>
              <div class="rl-ls__card-body"><strong>{card.title}</strong><span>→</span></div>
            </a>
          ))}
        </div>
      </div>
    </section>

    {showCrossFamilyCluster && (
      <NativeFamilyClusterLinks
        clusterHeading={clusterHeading}
        clusterLinks={clusterLinks}
        overviewHref={overviewHref}
        scopeLabel={scope.label}
      />
    )}

    <section class="mr-cities" data-header-theme="light" data-theme="light" aria-label="Landschaftsfotografie in NRW">
      <div class="mr-cities__inner">
        <div class="mr-cities__head">
          <h2 class="mr-cities__title" set:html={cityHeading}></h2>
        </div>
        <nav class="mr-cities__grid" aria-label="Städte">
          {cityLinks.map(([href, label]) => <a class="mr-cities__cell" href={href}>{label}</a>)}
        </nav>
      </div>
    </section>

    <section class="mr-cities" data-header-theme="light" data-theme="light" aria-label="Landschaftsfotografie Suchbegriffe">
      <div class="mr-cities__inner">
        <div class="mr-cities__head">
          <h2 set:html={intentHeading}></h2>
        </div>
        <nav class="mr-cities__grid" aria-label="Suchvarianten">
          {searchLinks.map(([href, label]) => <a class="mr-cities__cell" href={href}>{label}</a>)}
        </nav>
      </div>
    </section>

    <NativeFamilyFaq faq={faqItems} pageUrl={`https://matthiasramahi.de/${legacyFile}`} theme="dark" />

    <NativeReviews theme="light" />

    <section
      id="anfrage"
      data-contact-section
      data-header-theme="light"
      data-contact-subject={contactSubjectFinal}
      data-contact-headline={contactHeadlineFinal}
      data-contact-lead={contactLeadFinal}
    ></section>
  </main>
</AdoptedPageLayout>
