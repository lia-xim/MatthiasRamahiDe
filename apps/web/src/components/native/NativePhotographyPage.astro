---
import AdoptedPageLayout from '../../layouts/AdoptedPageLayout.astro'
import { splitCmsHeroTitleLines } from '../../lib/heroTitleLines'
import { blockParagraphs, homeHeroSlidesFor, photographyTopics as fallbackTopics } from '../../lib/nativeContent'
import { tinaAttrs } from '../../lib/tinaFieldAttrs'
import {
  getSitePageByType,
  imageAlt,
  imageDimensions,
  imageDisplayUrl,
  liveCmsFetchOptions,
  toRootRelativeHref,
  type PayloadDoc,
} from '../../lib/payload'

type Props = {
  doc?: PayloadDoc
  legacyFile?: string
}

const overviewMeta: Record<string, { description: string; heroLines: [string, string]; intro: string; title: string }> = {
  'fotografie.html': {
    description:
      'Fotografie als klare Übersicht: Automobil, Sportwagen, Oldtimer, Motorrad, Portrait und Landschaft - sechs spezialisierte Bereiche mit eigenem Einstieg.',
    heroLines: ['Fotografie-', 'Bereiche.'],
    intro:
      'Sechs Fotografie-Bereiche - Automobil, Sportwagen, Oldtimer und Motorrad, Portrait und Fine-Art-Landschaft. Jede Kategorie mit eigener Bildsprache und eigenem Einstieg.',
    title: 'Fotografie | Übersicht der Bereiche | Matthias Ramahi',
  },
  'fotografie-duesseldorf.html': {
    description:
      'Fotografie Düsseldorf als klare Übersicht: Automobil, Sportwagen, Oldtimer, Motorrad, Portrait und Landschaft - sechs spezialisierte Bereiche mit eigenem Einstieg.',
    heroLines: ['Fotografie', 'Düsseldorf.'],
    intro:
      'Fotografie in Düsseldorf als strukturierter Einstieg: Automobil, Sportwagen, Oldtimer, Motorrad, Portrait und Landschaft führen in sechs spezialisierte Bereiche.',
    title: 'Fotografie Düsseldorf | Übersicht | Matthias Ramahi',
  },
  'fotografie-nrw.html': {
    description:
      'Fotografie NRW als klare Übersicht: Automobil, Sportwagen, Oldtimer, Motorrad, Portrait und Landschaft - sechs spezialisierte Bereiche für Rheinland, Ruhrgebiet und Deutschland.',
    heroLines: ['Fotografie', 'NRW.'],
    intro:
      'Fotografie in NRW als klare Übersicht für Rheinland, Ruhrgebiet und angrenzende Regionen - mit sechs Bereichen und direkten Einstiegen in lokale Seiten.',
    title: 'Fotografie NRW | Übersicht | Matthias Ramahi',
  },
  'fotografie-deutschland.html': {
    description:
      'Fotografie Deutschland als klare Übersicht: Automobil, Sportwagen, Oldtimer, Motorrad, Portrait und Landschaft - sechs spezialisierte Bereiche für hochwertige Bildserien.',
    heroLines: ['Fotografie', 'Deutschland.'],
    intro:
      'Fotografie deutschlandweit gedacht, aber in klaren Bereichen geführt: Fahrzeuge, Menschen und Landschaften bleiben eigenständige Bildbereiche.',
    title: 'Fotografie Deutschland | Übersicht | Matthias Ramahi',
  },
}

const { legacyFile = 'fotografie.html' } = Astro.props as Props
const meta = overviewMeta[legacyFile] || overviewMeta['fotografie.html']
const canonicalPath = `/${legacyFile}`
const providedDoc = (Astro.props as Props).doc
const doc = providedDoc || (await getSitePageByType('photography-index', liveCmsFetchOptions({ depth: 2 })))
const pageMetaTitle = doc?.seo?.title || meta.title
const pageMetaDescription = doc?.seo?.description || meta.description
const pageCanonicalUrl = doc?.seo?.canonicalUrl || canonicalPath
// Übersichts-Hero: Titel = Bereichs-Lockup der jeweiligen Übersicht (z. B.
// „Fotografie-Bereiche.“), die Slides zeigen die angebotenen Fotografie-Bereiche mit
// eigenem Bild + Kurztext. Bewusst NICHT der Auto-/Düsseldorf-lastige Startseiten-Hero —
// hier geht es um die Bandbreite der Bereiche, nicht um ein einzelnes Motiv oder eine Stadt.
// (Bewusst code-definiert statt CMS-heroSlides: die Prod-CMS-Slides der Übersicht trugen
// den Auto-/Düsseldorf-Startseiten-Hero und sollen die Übersicht nicht mehr überschreiben.)
const hasText = (value?: string): value is string => typeof value === 'string' && value.trim().length > 0
const editableSource = (item: unknown) => (item as { source?: unknown } | null | undefined)?.source
const topicSlug = (value = '') =>
  value.toLowerCase().normalize('NFKD').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '')

// Themen-Bereiche: CMS bevorzugt, sonst eingebaute Defaults. Theme-Wechsel + CSS-Klasse + Maße abgeleitet.
const cmsTopics = (doc?.photographyIndex?.topics || [])
  .filter((topic) => topic?.image && hasText(topic?.title))
  .map((topic, index) => {
    const id = topicSlug(topic.title) || `bereich-${index + 1}`
    const dimensions = imageDimensions(topic.image, 'card')
    return {
      source: topic,
      id,
      theme: index % 2 === 0 ? 'dark' : 'light',
      className: `topic--${id}`,
      title: topic.title || '',
      emphasis: topic.emphasis || '',
      text: topic.text || '',
      href: toRootRelativeHref(topic.href) || '#',
      linkLabel: topic.linkLabel || '',
      image: imageDisplayUrl(topic.image, 'card', { allowOriginal: true }),
      alt: imageAlt(topic.image, topic.title || ''),
      width: dimensions.width || 960,
      height: dimensions.height || 640,
    }
  })
const topics = cmsTopics.length ? cmsTopics : fallbackTopics
const isRootPhotographyOverview = legacyFile === 'fotografie.html'
const overviewTitleLines = isRootPhotographyOverview
  ? [...meta.heroLines]
  : splitCmsHeroTitleLines(doc?.targetKeyword || doc?.title || doc?.seo?.focusKeyword, [...meta.heroLines])

const overviewHeroSlides = topics.map((topic, index) => ({
  image: topic.image,
  titleLines: overviewTitleLines,
  lead: index === 0 ? doc?.intro || meta.intro : topic.text,
  primaryHref: '#anfrage',
  primaryLabel: 'Projekt anfragen',
  secondaryHref: '/portfolio.html',
  secondaryLabel: 'Portfolio ansehen',
}))
const cmsHeroSlides = (doc?.heroSlides || []).length > 0 ? homeHeroSlidesFor(doc) : []
const heroSlides = cmsHeroSlides.length ? cmsHeroSlides : overviewHeroSlides
const firstHeroSlide = heroSlides[0]
const usesCmsOverviewTitle = !cmsHeroSlides.length && !isRootPhotographyOverview
const heroImages = heroSlides.map((slide) => slide.image)
const heroSlidesJson = JSON.stringify(heroSlides)
const clusterIntroCms = (doc?.photographyIndex?.clusterIntro || []).map((paragraph) => paragraph?.text).filter(hasText)
const clusterParagraphs = clusterIntroCms.length
  ? clusterIntroCms
  : blockParagraphs(doc, 'Ein Einstieg', [
      'Die Übersicht ist der Einstiegspunkt. Von hier aus führen die sechs Bereiche auf eigene Hauptseiten — und von dort weiter in lokale Varianten, NRW- und Deutschland-Hubs sowie die jeweiligen Keyword-Seiten.',
      'Nutzer wählen nicht aus einem generischen Portfolio, sondern steigen direkt in Automobil, Sportwagen, Oldtimer, Motorrad, Portrait oder Landschaft ein. Jede Kategorie zeigt auf ihrer Hauptseite die zugehörigen Städte und Regionen.',
    ])
---
<AdoptedPageLayout legacyFile={legacyFile} current="fotografie" doc={doc} title={pageMetaTitle} description={pageMetaDescription} canonicalUrl={pageCanonicalUrl} ctaHref="#anfrage" preloadImages={[firstHeroSlide.image]} liveCms>
  <main>
    <section class="hero" data-theme="dark" aria-label="Intro" style={`background-image:url('${firstHeroSlide.image}')`} {...tinaAttrs(doc?.heroSlides?.[0] || editableSource(topics[0]), doc?.heroSlides?.[0] ? 'image' : 'image')}>
      <canvas id="hero-shader" aria-hidden="true" data-imgs={heroImages.join(',')} data-slides={heroSlidesJson} {...tinaAttrs(doc?.heroSlides?.[0] || editableSource(topics[0]), 'image')}></canvas>
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-aperture" aria-hidden="true"></div>
      <div class="hero-grid">
        <div class="hero-stage">
          <h1 class="hero-title" id="hero-title" data-text-idx="0">
            {firstHeroSlide.titleLines.map((line, index) => (
              <>
                {index > 0 && ' '}
                <span class="line" {...(usesCmsOverviewTitle ? tinaAttrs(doc, 'title') : tinaAttrs(doc?.heroSlides?.[0], index === 0 ? 'headlineLine1' : 'headlineLine2'))}><span class="word">{line}</span></span>
              </>
            ))}
          </h1>
          <p class="hero-lead" id="hero-lead" {...tinaAttrs(doc?.heroSlides?.[0] || doc, doc?.heroSlides?.[0] ? 'lead' : 'intro')}>{firstHeroSlide.lead}</p>
          <div class="hero-actions" aria-label="Direkte Aktionen">
            <a class="btn dark" href={firstHeroSlide.primaryHref} data-hero-primary hidden={!firstHeroSlide.primaryHref || !firstHeroSlide.primaryLabel}>{firstHeroSlide.primaryLabel}</a>
            <a class="btn" href={firstHeroSlide.secondaryHref} data-hero-secondary hidden={!firstHeroSlide.secondaryHref || !firstHeroSlide.secondaryLabel}>{firstHeroSlide.secondaryLabel}</a>
          </div>
        </div>
      </div>
      <div class="hero-cursor" id="hero-cursor" aria-hidden="true"><span class="ring"></span></div>
    </section>

    {topics.map((topic) => (
      <section class={`topic ${topic.theme} ${topic.className}`} id={topic.id} data-theme={topic.theme}>
        <div class="topic-grid">
          <div class="topic-copy">
            <h2><span {...tinaAttrs(editableSource(topic), 'title')}>{topic.title}</span><em {...tinaAttrs(editableSource(topic), 'emphasis')}>{topic.emphasis}</em></h2>
            <p {...tinaAttrs(editableSource(topic), 'text')}>{topic.text}</p>
            <a class="topic-link" href={topic.href} {...tinaAttrs(editableSource(topic), 'linkLabel')}>{topic.linkLabel}</a>
          </div>
          <div class="topic-media" aria-hidden="true">
            <figure class="topic-frame" style={`--topic-ar:${topic.width}/${topic.height}`}>
              <img src={topic.image} alt={topic.alt} loading="lazy" width={topic.width} height={topic.height} decoding="async" {...tinaAttrs(editableSource(topic), 'image')} />
            </figure>
          </div>
        </div>
      </section>
    ))}

    <section class="cluster" data-theme="light" aria-label="Fotografie-Bereiche">
      <div class="section-inner cluster-grid">
        <div><p class="kicker dark">Bereiche</p><h2>Ein Einstieg, <em>sechs Bereiche.</em></h2></div>
        <div class="cluster-copy">
          {clusterParagraphs.map((paragraph, index) => <p {...tinaAttrs(doc?.photographyIndex?.clusterIntro?.[index], 'text')}>{paragraph}</p>)}
          <div class="cluster-links">
            {topics.map((topic) => <a href={topic.href}>{topic.title.replace('.', '')}</a>)}
          </div>
        </div>
      </div>
    </section>

    <section
      id="anfrage"
      data-contact-section
      data-theme="light"
      data-contact-subject="Fotografie Anfrage"
      data-contact-headline="Fotografie <em>anfragen.</em>"
      data-contact-lead="Beschreibe kurz, welcher Bereich passt — Automobil, Sportwagen, Oldtimer, Motorrad, Portrait oder Landschaft — und wofür die Bilder genutzt werden sollen. Dann klären wir Stil, Umfang, Ort, Rechte und Ausgabeformat sauber vor der Produktion."
    />
  </main>
</AdoptedPageLayout>
