---
import ContactSlot from '../ContactSlot.astro'
import AdoptedPageLayout from '../../layouts/AdoptedPageLayout.astro'
import NativeShaderHero from './NativeShaderHero.astro'
import { homeHeroSlidesFor, servicesHeroSlides, servicesIndexItems as fallbackServices } from '../../lib/nativeContent'
import { tinaAttrs } from '../../lib/tinaFieldAttrs'
import {
  getSitePageByType,
  imageAlt,
  imageDimensions,
  imageDisplayUrl,
  liveCmsFetchOptions,
  toRootRelativeHref,
  type PayloadDoc,
  type PayloadMedia,
} from '../../lib/payload'

const providedDoc = Astro.props.doc as PayloadDoc | undefined
// force:true (liveCmsFetchOptions) keeps the services index aligned with authored Tina content.
// und nicht-erzwungene Fetches sonst null liefern -> Fallback statt CMS-Inhalt.
const doc = providedDoc || (await getSitePageByType('services-index', liveCmsFetchOptions({ depth: 2 })))

const fallbackHeroSlides = servicesHeroSlides.map((slide, index) =>
  index === 0 && doc?.intro ? { ...slide, lead: doc.intro } : slide,
)
const cmsHeroSlides = (doc?.heroSlides || []).length > 0 ? homeHeroSlidesFor(doc) : []
const heroSlides = cmsHeroSlides.length ? cmsHeroSlides : fallbackHeroSlides
const firstHeroSlide = heroSlides[0]

const hasText = (value?: string): value is string => typeof value === 'string' && value.trim().length > 0
const editableSource = (item: unknown) => (item as { source?: unknown } | null | undefined)?.source
const imageFieldName = (item: unknown) => (item as { fieldName?: string } | null | undefined)?.fieldName
const imageCaptionFieldName = (item: unknown) => (item as { captionFieldName?: string } | null | undefined)?.captionFieldName
const stripHtml = (value = '') => value.replace(/<[^>]+>/g, '')
// Hebt das Emphasis-Wort als Substring kursiv hervor (funktioniert auch mitten im Wort).
const emphasize = (headline = '', emphasis = '') =>
  hasText(emphasis) && headline.includes(emphasis) ? headline.replace(emphasis, `<em>${emphasis}</em>`) : headline

const cms = doc?.servicesIndex
const cmsItems = cms?.items || []

type ServiceImage = { src: string; alt: string; caption: string; className?: string; fieldName?: string; captionFieldName?: string; source?: unknown; width?: number; height?: number }
type FallbackService = (typeof fallbackServices)[number]

const buildCmsImages = (item: NonNullable<typeof cmsItems>[number], fb?: FallbackService): ServiceImage[] => {
  const slots = [
    { image: item.image1, caption: item.caption1 },
    { image: item.image2, caption: item.caption2 },
  ].filter((slot): slot is { image: PayloadMedia | string; caption: string | undefined } => Boolean(slot.image))
  if (!slots.length) return fb?.images ?? []
  return slots.map((slot, idx) => {
    const dimensions = imageDimensions(slot.image, 'card')
    return {
      src: imageDisplayUrl(slot.image, 'card', { allowOriginal: true }),
      alt: imageAlt(slot.image, stripHtml(fb?.headline ?? '')),
      caption: slot.caption || fb?.images[idx]?.caption || '',
      className: fb?.images[idx]?.className ?? (idx === 1 ? 'small' : ''),
      source: item,
      fieldName: idx === 0 ? 'image1' : 'image2',
      captionFieldName: idx === 0 ? 'caption1' : 'caption2',
      width: dimensions.width || fb?.images[idx]?.width,
      height: dimensions.height || fb?.images[idx]?.height,
    }
  })
}

const mergeService = (fb: FallbackService | undefined, item: NonNullable<typeof cmsItems>[number] | undefined, index: number) => {
  const id = fb?.id || `leistung-${index + 1}`
  const headline = item && hasText(item.headline) ? emphasize(item.headline, item.emphasis) : fb?.headline ?? ''
  return {
    source: item,
    id,
    theme: fb?.theme ?? (index % 2 === 0 ? 'light' : 'dark'),
    href: item && hasText(item.href) ? toRootRelativeHref(item.href) : fb?.href ?? '#',
    headline,
    overviewLabel: item && hasText(item.overviewLabel) ? item.overviewLabel! : stripHtml(headline).replace(/\.$/, ''),
    text: item && hasText(item.text) ? item.text! : fb?.text ?? '',
    images: item ? buildCmsImages(item, fb) : fb?.images ?? [],
  }
}

// Code-Defaults sind die Basis; CMS-Einträge werden über ihren Link der passenden
// Vorlage zugeordnet, damit Reihenfolge und Anzahl im CMS frei bleiben.
// Großformat und Sonderanfertigungen leiten auf das Fotolabor um und erscheinen
// deshalb nicht mehr als eigene Einträge.
const mergedIntoFotolabor = new Set(['grossformat', 'sonder'])
const fallbackForHref = (href: string) =>
  fallbackServices.find((service) => service.href === href) ?? fallbackServices.find((service) => href.includes(`/${service.id}`))
const items = (
  cmsItems.length
    ? cmsItems.map((item, index) => mergeService(hasText(item.href) ? fallbackForHref(toRootRelativeHref(item.href)) : undefined, item, index))
    : fallbackServices.filter((service) => !mergedIntoFotolabor.has(service.id)).map((service, index) => mergeService(service, undefined, index))
).filter((service) => hasText(stripHtml(service.headline)) && !mergedIntoFotolabor.has(service.id))

// Ramahi Webdesign und Crawl Foundry sind eigene, grosse Sektionen (siehe
// unten) und tauchen deshalb nicht noch einmal in Übersicht und Liste auf.
const isWebdesign = (service: (typeof items)[number]) => service.id === 'webdesign' || service.href.includes('/webdesign-seo-duesseldorf.html')
const isCrawlFoundry = (service: (typeof items)[number]) => service.id === 'keyword-datenbank' || service.href.includes('/keyword-datenbank-seo.html')
const webdesignService = items.find(isWebdesign)
const crawlFoundryService = items.find(isCrawlFoundry)
const listItems = items
  .filter((service) => !isWebdesign(service) && !isCrawlFoundry(service))
  .map((service, index) => ({ ...service, theme: index % 2 === 0 ? 'light' : 'dark' }))
const webdesignImages = webdesignService?.images ?? []
const crawlFoundryImages = crawlFoundryService?.images ?? []
const overviewItems = listItems

const overviewHead = {
  headline: cms && hasText(cms.overviewHeadline) ? stripHtml(cms.overviewHeadline) : 'Außerdem.',
  intro: hasText(cms?.overviewIntro)
    ? cms!.overviewIntro!
    : 'Ergänzend zur Fotografie: Fotolabor, Werbetechnik, Videografie und Live-Musik, umgesetzt mit Partnern aus Düsseldorf und NRW.',
}

---
<AdoptedPageLayout
  legacyFile="leistungen.html"
  current="leistungen"
  doc={doc}
  ctaHref="#anfrage"
  preloadImages={[firstHeroSlide.image]}
>
  <main>
    <NativeShaderHero
      id="top"
      label="Weitere Dienstleistungen"
      semanticHeading="Weitere Dienstleistungen"
      slides={heroSlides}
      sourceSlides={doc?.heroSlides || []}
      headerTheme="dark"
    />

    <section class="studio" id="webdesign" data-header-theme="light" aria-labelledby="studio-title">
      <div class="studio-inner">
        <div class="studio-copy">
          <p class="studio-label">ramahi-webdesign.de</p>
          <h2 id="studio-title">Ramahi <em>Webdesign.</em></h2>
          <p class="studio-lead">Websites für kleine Unternehmen, Selbstständige und Privatpersonen in Düsseldorf und NRW. Gestaltet und programmiert ohne Baukasten, von der Struktur bis zum Eintrag bei Google. Auch diese Website ist dort entstanden.</p>
          <dl class="studio-facts">
            <div><dt>Website</dt><dd><span>ab 399 €</span></dd></div>
            <div><dt>Hosting &amp; Wartung</dt><dd><span>50 € / Monat</span></dd></div>
            <div><dt>SEO</dt><dd><span>ab 19,99 €</span></dd></div>
            <div><dt>Erstgespräch</dt><dd><span>kostenlos</span></dd></div>
          </dl>
          <div class="studio-actions">
            <a class="studio-btn is-primary" href="https://ramahi-webdesign.de/" target="_blank" rel="noopener">Zu Ramahi Webdesign</a>
            <a class="studio-btn" href="/webdesign-seo-duesseldorf.html">Webdesign in Düsseldorf</a>
          </div>
        </div>
        <a class="studio-media" href="https://ramahi-webdesign.de/" target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
          {webdesignImages[0] && <img class="studio-shot" src={webdesignImages[0].src} alt="" loading="lazy" width={webdesignImages[0].width} height={webdesignImages[0].height} decoding="async" />}
          {webdesignImages[1] && <img class="studio-detail" src={webdesignImages[1].src} alt="" loading="lazy" width={webdesignImages[1].width} height={webdesignImages[1].height} decoding="async" />}
        </a>
      </div>
    </section>

    <section class="foundry" id="crawl-foundry" data-header-theme="dark" aria-labelledby="foundry-title">
      <div class="foundry-inner">
        <div class="foundry-copy">
          <p class="studio-label">crawlfoundry.com</p>
          <h2 id="foundry-title">Crawl <em>Foundry.</em></h2>
          <p class="studio-lead">Eigene SEO-Software für Keyword-Recherche, technische Site Audits, Priorisierung und Ranking-Tracking. Sie läuft auch für die Suchmaschinenoptimierung dieser Website.</p>
          <ul class="foundry-list">
            <li><span>Keyword-Recherche</span></li>
            <li><span>Site Audits</span></li>
            <li><span>Priorisierung</span></li>
            <li><span>Ranking-Tracking</span></li>
          </ul>
          <div class="studio-actions">
            <a class="studio-btn is-primary" href="https://crawlfoundry.com/" target="_blank" rel="noopener">Zu Crawl Foundry</a>
            <a class="studio-btn" href="/keyword-datenbank-seo.html">Fallstudie lesen</a>
          </div>
        </div>
        <figure class="foundry-media">
          {crawlFoundryImages[0] && <img src={crawlFoundryImages[0].src} alt={crawlFoundryImages[0].alt || 'Keyword-Datenbank in Crawl Foundry'} loading="lazy" width={crawlFoundryImages[0].width} height={crawlFoundryImages[0].height} decoding="async" />}
        </figure>
      </div>
    </section>

    <section class="more" id="weitere" data-header-theme="light" aria-labelledby="more-title">
      <div class="more__inner">
        <div class="more__head">
          <h2 id="more-title" {...tinaAttrs(cms, 'overviewHeadline')}>{overviewHead.headline}</h2>
          <p {...tinaAttrs(cms, 'overviewIntro')}>{overviewHead.intro}</p>
        </div>
        <ul class="more__list">
          {overviewItems.map((service) => {
            const image = service.images[0]
            return (
              <li>
                <a class="more__item" id={service.id} href={service.href}>
                  {image && (
                    <span class="more__visual">
                      <img src={image.src} alt={image.alt} loading="lazy" width={image.width} height={image.height} decoding="async" {...tinaAttrs(editableSource(image), imageFieldName(image))} />
                    </span>
                  )}
                  <span class="more__title" {...tinaAttrs(service.source, 'overviewLabel')}>{service.overviewLabel.replace(/\.$/, '')}</span>
                  <span class="more__text" {...tinaAttrs(service.source, 'text')}>{service.text}</span>
                </a>
              </li>
            )
          })}
        </ul>
      </div>
    </section>

    <ContactSlot
      id="anfrage"
      data-contact-section
      data-header-theme="light"
      data-theme="light"
      data-contact-subject="Anfrage weitere Dienstleistungen"
      data-contact-headline="Projekt <em>anfragen.</em>"
      data-contact-lead="Beschreibe kurz, welche Leistung du brauchst: Druck, Webdesign, Video, Werbetechnik, Musik oder eine Kombination. Ich sortiere den Ablauf und die passenden Partner."
    />
  </main>
</AdoptedPageLayout>

<style>
  .more {
    background: #eef0ea;
    color: #0a0c11;
    padding: clamp(72px, 8vw, 128px) 0;
  }

  .more__inner {
    margin: 0 auto;
    max-width: 1640px;
    padding: 0 clamp(20px, 4vw, 84px);
  }

  .more__head {
    align-items: end;
    display: grid;
    gap: 16px clamp(32px, 6vw, 120px);
    grid-template-columns: minmax(0, 1fr) minmax(0, 34rem);
    margin-bottom: clamp(36px, 4vw, 64px);
  }

  .more__head h2 {
    color: #0a0c11;
    font-size: clamp(40px, 5.2vw, 88px);
    margin: 0;
  }

  .more__head p {
    color: rgb(10 12 17 / 66%);
    font-size: clamp(15px, 1.1vw, 18px);
    line-height: 1.6;
    margin: 0;
  }

  .more__list {
    display: grid;
    gap: clamp(36px, 4vw, 64px) clamp(24px, 3vw, 48px);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .more__list li {
    margin: 0;
  }

  .more__item,
  .more__item:visited {
    color: inherit;
    display: grid;
    gap: 10px;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    column-gap: clamp(20px, 2.4vw, 36px);
    text-decoration: none;
  }

  .more__visual {
    aspect-ratio: 4 / 5;
    background: #d9dcd5;
    display: block;
    grid-row: span 2;
    overflow: hidden;
  }

  .more__visual img {
    display: block;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease;
    width: 100%;
  }

  .more__item:hover .more__visual img {
    opacity: 0.85;
  }

  .more__title {
    align-self: start;
    font-size: clamp(22px, 1.9vw, 32px);
    font-stretch: 87.5%;
    font-weight: 700;
    line-height: 1.08;
    padding-top: 4px;
  }

  .more__item:hover .more__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .more__text {
    color: rgb(10 12 17 / 68%);
    font-size: clamp(15px, 1.02vw, 16.5px);
    line-height: 1.6;
    max-width: 44ch;
  }

  .more__item:focus-visible {
    outline: 2px solid #0a0c11;
    outline-offset: 6px;
  }

  @media (max-width: 1100px) {
    .more__list {
      grid-template-columns: 1fr;
    }

    .more__item {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr);
    }
  }

  @media (max-width: 900px) {
    .more__head {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .more__item {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }

    .more__visual {
      aspect-ratio: 3 / 2;
      grid-row: auto;
      margin-bottom: 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .more__visual img {
      transition: none;
    }
  }
</style>
