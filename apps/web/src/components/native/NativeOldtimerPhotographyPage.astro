---
import AdoptedPageLayout from '../../layouts/AdoptedPageLayout.astro'
import NativeFamilyClusterLinks from './NativeFamilyClusterLinks.astro'
import NativeFamilyFaq from './NativeFamilyFaq.astro'
import NativeReviews from './NativeReviews.astro'
import PreviewToolbar from '../PreviewToolbar.astro'
import {
  localScopePhrase,
  nativeFamilyPageContext,
  type NativeFamilyPreviewState,
} from '../../lib/nativeFamilyPageContext'
import { mergeAuthoredLocalSeoContent } from '../../lib/authoredSeoContent'
import { splitHeroTitleLines } from '../../lib/heroTitleLines'
import { familyHeroCopy, familyVisualSlots, getFamilyVisualSourceDoc } from '../../lib/localSeoFamilyVisuals'
import { getLegacyBackedDoc, type PayloadDoc } from '../../lib/payload'
import { keywordFocusCopyForSlug } from '../../lib/localSeoFamilyContent'
import { splitTrailingEmphasis } from '../../lib/splitTrailingEmphasis'
import { tinaAttrs } from '../../lib/tinaFieldAttrs'

type Props = {
  doc?: PayloadDoc | null
  legacyFile?: string
  preview?: NativeFamilyPreviewState
  visualDoc?: PayloadDoc | null
}

const defaultLegacyFile = 'oldtimer-fotografie.html'
const props = Astro.props as Props
const { doc: providedDoc = undefined, legacyFile: providedLegacyFile, preview, visualDoc: providedVisualDoc = undefined } = props
const legacyFile = providedLegacyFile || defaultLegacyFile
const fetchedDoc = providedDoc || (await getLegacyBackedDoc(legacyFile, { depth: 2 }))
const doc = preview ? fetchedDoc : mergeAuthoredLocalSeoContent(legacyFile, fetchedDoc)
const shouldUseCmsVisualDoc = import.meta.env.ASTRO_DISABLE_CMS_VISUAL_OVERRIDES !== 'true'
const visualDoc = Object.hasOwn(props, 'visualDoc')
  ? providedVisualDoc
  : shouldUseCmsVisualDoc
    ? await getFamilyVisualSourceDoc('oldtimer', doc, legacyFile, defaultLegacyFile)
    : null
const pageContext = nativeFamilyPageContext({
  defaultLegacyFile,
  doc,
  family: 'oldtimer',
  legacyFile,
  preview,
})
const { clusterHeading, clusterLinks, isKeywordPage, isParentPage, overviewHref, publishedHref, scope, serviceLabel } = pageContext
const keywordFocusCopy = keywordFocusCopyForSlug(legacyFile)
const cmsFaqSource = (doc?.localFaq?.length ? doc.localFaq : doc?.faq) || []
const cmsFaqItems = cmsFaqSource.map((entry) => ({ q: entry.question || '', a: entry.answer || '' })).filter((entry) => entry.q && entry.a)
const faqItems = cmsFaqItems.length ? cmsFaqItems : keywordFocusCopy?.faq
const cmsText = (value: unknown) => (typeof value === 'string' ? value.trim() : '')
const cmsHeroLine2 = cmsText(doc?.heroLine2)
const cmsStatementBody = doc?.statement?.body?.map((entry) => cmsText(entry.text)).filter(Boolean) || []
const heroLabel = isParentPage ? 'Oldtimer-Fotografie' : isKeywordPage ? serviceLabel : `Oldtimer-Fotografie ${scope.label}`
const isLocalHeroPage = !isParentPage && !isKeywordPage
const heroTitlePrefix = isParentPage ? 'Oldtimerfotografie' : serviceLabel
const heroTitleSuffix = isLocalHeroPage ? scope.label : ''
const heroTitleLines = [...splitHeroTitleLines(heroTitlePrefix), ...splitHeroTitleLines(heroTitleSuffix)]
const heroLocalNote = isLocalHeroPage ? cmsHeroLine2 || keywordFocusCopy?.heroEmphasis || 'Charakter vor Ort.' : isKeywordPage ? cmsHeroLine2 || keywordFocusCopy?.heroEmphasis || '' : ''
const defaultHeroLead = isParentPage
  ? 'Oldtimer-Fotografie: Herkunft, Material, Lack, Chrom, Leder und Patina werden ruhig dokumentiert — für Sammlung, Verkauf, Auktion, Ausstellung und Fahrzeuge mit Geschichte. Produktionen werden über Motiv, Nutzung, Reise, Lichtfenster und Output geplant — in ganz NRW.'
  : isKeywordPage
    ? `${serviceLabel}: eigenständiger Einstieg in die Oldtimer-Fotografie. Herkunft, Material, Lack, Chrom, Leder und Patina werden ruhig dokumentiert - für Sammlung, Verkauf, Auktion, Ausstellung und Fahrzeuge mit Geschichte. Die Seite bleibt bewusst im Layout der übergeordneten Kategorie, ist aber klar auf dieses Motiv und diese Nutzung formuliert.`
    : `Oldtimer-Fotografie in ${scope.label}: Herkunft, Material, Lack, Chrom, Leder und Patina werden ruhig dokumentiert - für Sammlung, Verkauf, Auktion, Ausstellung und Fahrzeuge mit Geschichte. ${localScopePhrase(scope)}`
const fallbackMetaTitle = isParentPage
  ? 'Oldtimer-Fotografie - Matthias Ramahi'
  : isKeywordPage
    ? `${serviceLabel} | Matthias Ramahi`
    : `${serviceLabel} ${scope.label} | Matthias Ramahi`
const metaTitle = doc?.seo?.title || fallbackMetaTitle
const heroLead = keywordFocusCopy?.heroLead
  ? `${keywordFocusCopy.heroLead}${!isParentPage && !isKeywordPage ? ` ${localScopePhrase(scope)}` : ''}`
  : defaultHeroLead
const defaultMetaDescription = isParentPage
  ? 'Oldtimer-Fotografie: Bildserien für Sammlung, Verkauf, Auktion und Ausstellung - Karosserie, Lack, Chrom, Leder, Patina und Herkunft.'
  : isKeywordPage
    ? `${serviceLabel}: Bildserien für Sammlung, Verkauf, Auktion und Ausstellung.`
    : `${serviceLabel} ${scope.label}: Bildserien für Sammlung, Verkauf, Auktion und Ausstellung.`
const contactSubject = isParentPage ? 'Oldtimer Fotografie Anfrage' : `${serviceLabel}${isKeywordPage ? '' : ` ${scope.label}`} Anfrage`
const metaDescription = doc?.seo?.description || keywordFocusCopy?.metaDescription || defaultMetaDescription
const contactHeadline = isParentPage
  ? 'Oldtimer <em>anfragen.</em>'
  : isKeywordPage
    ? `${serviceLabel} <em>anfragen.</em>`
    : `Oldtimer ${scope.label} <em>anfragen.</em>`
const defaultContactLead = isParentPage
  ? 'Schreibe kurz, welcher Oldtimer fotografiert werden soll — Modell, Baujahr, Standort und ob die Bilder für Sammlung, Auktion, Verkauf oder privat genutzt werden. Wir klären Raum, Licht und Ablauf gemeinsam.'
  : isKeywordPage
    ? `Schreibe kurz, wofür ${serviceLabel} gebraucht wird, welches Motiv im Mittelpunkt steht und welche Nutzung geplant ist. Wir klären Stil, Ort, Umfang und Ausgabe gemeinsam.`
    : `Schreibe kurz, welcher Oldtimer in ${scope.label} fotografiert werden soll - Modell, Baujahr, Standort und ob die Bilder für Sammlung, Auktion, Verkauf oder privat genutzt werden. Wir klären Raum, Licht und Ablauf gemeinsam.`

const contactLead = keywordFocusCopy?.contactLead || defaultContactLead

const heroSlides = [
  ['assets/optimized/assets-photos-oldtimer-stage-1280.webp', 'assets/optimized/assets-photos-oldtimer-stage-960.webp'],
  ['assets/portfolio/_DSC0470-Enhanced-NR.webp', 'assets/portfolio/_DSC0470-Enhanced-NR.webp'],
  ['assets/optimized/assets-portfolio-dsc3892-1920.webp', 'assets/optimized/assets-portfolio-dsc3892-1920.webp'],
]

const storyCards = [
  {
    image: 'assets/portfolio/thumbs/_DSC0470-Enhanced-NR.webp',
    alt: 'Oldtimer Exponat — Hauptmotiv',
    width: 720,
    height: 1152,
    title: 'Exponat',
    text: 'Hauptmotiv wie eine Ausstellung — ruhige Proportionen, gesetztes Licht, sauberer Hintergrund. Bereit für Katalog, Sammlungsdokumentation oder Wandbild.',
  },
  {
    image: 'assets/portfolio/thumbs/_DSC3892.webp',
    alt: 'Oldtimer Patina und Material',
    width: 720,
    height: 480,
    title: 'Patina',
    text: 'Material, Chrom, Leder, Lackalterung. Detailaufnahmen, die Zustand und Geschichte ehrlich erzählen — ohne Glättung, ohne falsche Politur.',
  },
  {
    image: 'assets/portfolio/thumbs/_DSC2986.webp',
    alt: 'Oldtimer Innenraum und Cockpit',
    width: 720,
    height: 1080,
    title: 'Innenraum',
    text: 'Cockpit, Sitze, Armaturen, Holzfurnier. Mit mobilem Licht inszeniert, damit Materialcharakter und Bedienelemente die gleiche Sprache sprechen wie die Außenansicht.',
  },
  {
    image: 'assets/portfolio/thumbs/_DSC9321-Enhanced-NR.webp',
    alt: 'Oldtimer Sammlungs- und Auktionsbild',
    width: 720,
    height: 1080,
    title: 'Provenance',
    text: 'Embleme, Schriftzüge, Schlüssel, Dokumente. Belege, die einen Oldtimer für Auktion, Versicherung oder seriösen Verkauf nachvollziehbar machen.',
  },
]

const portfolioTiles = [
  ['t1', 'assets/portfolio/thumbs/_DSC0470-Enhanced-NR.webp', 'Oldtimer Exponat', 720, 1152, 'assets/portfolio/_DSC0470-Enhanced-NR.webp'],
  ['t2', 'assets/portfolio/thumbs/_DSC9321-Enhanced-NR.webp', 'Oldtimer Cockpit', 720, 1080, 'assets/portfolio/_DSC9321-Enhanced-NR.webp'],
  ['t3', 'assets/portfolio/thumbs/_DSC3892.webp', 'Oldtimer Material', 720, 480, 'assets/optimized/assets-portfolio-dsc3892-1920.webp'],
  ['t4', 'assets/portfolio/thumbs/_DSC2986.webp', 'Oldtimer Innenraum', 720, 1080, 'assets/optimized/assets-portfolio-dsc2986-1920.webp'],
  ['t5', 'assets/portfolio/thumbs/_DSC9301-Enhanced-NR.webp', 'Oldtimer Profil', 720, 900, 'assets/portfolio/_DSC9301-Enhanced-NR.webp'],
  ['t6', 'assets/optimized/assets-photos-oldtimer-stage-960.webp', 'Oldtimer Bühne', 960, 640, 'assets/optimized/assets-photos-oldtimer-stage-1920.webp'],
] as const

const audiences = [
  ['Sammler', 'Liebhaber · Garage'],
  ['Auktionshäuser', 'Katalog · Bestandsdoku'],
  ['Verkäufer', 'Inserat · Portale'],
  ['Redaktion', 'Magazin · Strecke'],
  ['Privat', 'Geschenk · Wandbild'],
]

const relatedAreas = [
  {
    href: 'automobil-fotografie.html',
    image: 'assets/optimized/assets-photos-automobil-neon-960.webp',
    alt: 'Automobilfotografie',
    width: 960,
    height: 640,
    title: 'Automobil',
  },
  {
    href: 'sportwagen-fotografie.html',
    image: 'assets/portfolio/thumbs/_DSC3032_genErase (1).webp',
    alt: 'Sportwagenfotografie',
    width: 720,
    height: 480,
    title: 'Sportwagen',
  },
  {
    href: 'drucke-sonderanfertigungen-duesseldorf.html',
    image: 'assets/portfolio/thumbs/_DSC8032.webp',
    alt: 'Drucke und Sonderanfertigungen',
    width: 720,
    height: 900,
    title: 'Drucke',
  },
  {
    href: 'portfolio.html',
    image: 'assets/portfolio/thumbs/_DSC0470-Enhanced-NR.webp',
    alt: 'Vollständiges Portfolio',
    width: 720,
    height: 1152,
    title: 'Portfolio',
  },
]

// CMS-Bild-Overrides pro Sektion (Tab „Themen-Sektionen"): Story-Karten aus
// shootingStyles[i].image, Galerie aus portfolioTiles[i].image. Leer → Fallback.
const sectionImageOverrides = [
  ...heroSlides.map(() => undefined),
  ...storyCards.map((_, index) => index === 0 ? doc?.statement?.image || doc?.shootingStyles?.[index]?.image : doc?.shootingStyles?.[index]?.image),
  ...portfolioTiles.map((_, index) => doc?.portfolioTiles?.[index]?.image),
  ...relatedAreas.map(() => undefined),
]
const visualSlots = familyVisualSlots(
  visualDoc,
  [
    ...heroSlides.map(([src, mobile]) => ({ alt: 'Oldtimer Hero', mobile, src })),
    ...storyCards.map(({ alt, height, image, width }) => ({ alt, height, src: image, width })),
    ...portfolioTiles.map(([, src, alt, width, height, full]) => ({ alt, full, height, src, width })),
    ...relatedAreas.map(({ alt, height, image, width }) => ({ alt, height, src: image, width })),
  ],
  sectionImageOverrides,
)
const inheritedStoryCards = storyCards.map((card, index) => {
  const visual = visualSlots[index + heroSlides.length]
  return { ...card, alt: visual.alt, height: visual.height, image: visual.src, width: visual.width }
})
const inheritedPortfolioTiles = portfolioTiles.map(([className], index) => {
  const visual = visualSlots[index + heroSlides.length + storyCards.length]
  return [className, visual.src, visual.alt, visual.width, visual.height, visual.full] as const
})
const inheritedRelatedAreas = relatedAreas.map((area, index) => {
  const visual = visualSlots[index + heroSlides.length + storyCards.length + portfolioTiles.length]
  return { ...area, alt: visual.alt, height: visual.height, image: visual.src, width: visual.width }
})

const focusStoryCards = inheritedStoryCards.map((card, index) => {
  const cmsCard = doc?.shootingStyles?.[index]
  const override = cmsCard
    ? { title: cmsText(cmsCard.title), text: cmsText(cmsCard.text) }
    : keywordFocusCopy?.cards?.[index]

  return override ? { ...card, title: override.title || card.title, text: override.text || card.text } : card
})

const firstSectionTarget = isLocalHeroPage ? `${serviceLabel} ${scope.label}` : isKeywordPage ? serviceLabel : ''
const focusIntroHeadlineSource = cmsText(doc?.statement?.headline) || keywordFocusCopy?.pullHeadline || (isParentPage || isKeywordPage ? 'Charakter' : `Oldtimer in ${scope.label}`)
const focusIntroEmphasisSource = cmsText(doc?.statement?.emphasis) || keywordFocusCopy?.pullEmphasis || (isParentPage || isKeywordPage ? 'mit Nostalgie.' : 'mit Herkunft.')
const focusIntroHeadline = firstSectionTarget || focusIntroHeadlineSource
const focusIntroEmphasis = firstSectionTarget ? '' : focusIntroEmphasisSource
const focusIntroTitle = splitTrailingEmphasis(focusIntroHeadline, focusIntroEmphasis)
const focusIntroSourceTitle = splitTrailingEmphasis(focusIntroHeadlineSource, focusIntroEmphasisSource)
const focusIntroSupportLine = firstSectionTarget ? [focusIntroSourceTitle.headline, focusIntroSourceTitle.emphasis].filter(Boolean).join(' ') : ''
const focusIntroBaseParagraphs = cmsStatementBody.length
  ? cmsStatementBody
  : keywordFocusCopy?.statementBody?.length
    ? keywordFocusCopy.statementBody
    : isParentPage || isKeywordPage
      ? [
          'Oldtimer brauchen Ruhe und Abstand. Ich arbeite mit mobilem Licht, sauberer Komposition und einem klaren Plan - Chrom, Leder, Lack und Patina werden bewusst gefuehrt, ohne Effekt-Pose.',
          'Ziel ist nicht Nostalgie-Kitsch, sondern eine Bildserie, die Sammlung, Auktion oder Verkaufsinserat traegt. Sie erhalten Dateien fuer Web, Katalog und Print - bereit fuer die naechste Ausgabe.',
        ]
      : [
          `Oldtimer-Fotografie in ${scope.label} wird als ruhige Dokumentation geplant: Modell, Baujahr, Standort, Material, Patina und Nutzung bestimmen den Ablauf.`,
          `Der lokale Bezug hilft bei Treffpunkt, Lichtfenster und Logistik. So entsteht in ${scope.label} eine Serie fuer Sammlung, Verkauf, Auktion oder privates Archiv, ohne die Hauptkategorie zu verlassen.`,
        ]
const focusIntroParagraphs = focusIntroSupportLine ? [focusIntroSupportLine, ...focusIntroBaseParagraphs] : focusIntroBaseParagraphs
const focusStoryHeadline = isLocalHeroPage || isKeywordPage ? serviceLabel : keywordFocusCopy?.sectionHeadline || (isParentPage ? 'Vier Spuren' : `Vier Spuren in ${scope.label}`)
const focusStoryEmphasis = isLocalHeroPage ? `${scope.label}.` : isKeywordPage ? 'klar geplant.' : keywordFocusCopy?.sectionEmphasis || (isParentPage ? 'einer Geschichte.' : 'eines Fahrzeugs.')
const focusStoryLead = isParentPage || isKeywordPage
  ? keywordFocusCopy?.sectionLead || 'Jeder Oldtimer traegt seine Provenienz in den Details. Material, Patina, Embleme und Innenraum greifen ineinander - ein Bildsatz, der Herkunft und Zustand vollstaendig dokumentiert.'
  : `In ${scope.label} wird der Bildsatz auf das konkrete Fahrzeug zugeschnitten: ruhige Totalen, Patina, Innenraum und Details, die Zustand und Geschichte nachvollziehbar machen.`
const focusPortfolioHeadline = isLocalHeroPage ? `${serviceLabel} ${scope.label}: Bildserie.` : isKeywordPage ? `${serviceLabel}: Bildserie.` : cmsText(doc?.portfolioTiles?.[0]?.label) || keywordFocusCopy?.galleryHeadline || (isParentPage ? 'Aktuelle Arbeiten.' : `Oldtimer-Arbeiten ${scope.label}.`)
const focusPortfolioLead = isParentPage || isKeywordPage
  ? keywordFocusCopy?.galleryLead || 'Sechs kuratierte Oldtimer-Bilder aus juengeren Serien. Klicken zum Vergroessern.'
  : `Beispiele fuer Bildtypen, die auch bei einem Oldtimer-Shooting in ${scope.label} sinnvoll sind: Exponat, Cockpit, Material, Profil und Detail.`
const focusAudienceHeadline = isLocalHeroPage ? `${serviceLabel} ${scope.label}: passende Anfragen.` : isKeywordPage ? `${serviceLabel}: passende Anfragen.` : keywordFocusCopy?.audienceHeadline || (isParentPage ? 'Fuer wen ich arbeite.' : `Fuer Oldtimer in ${scope.label}.`)
const focusAudienceLead = isParentPage || isKeywordPage
  ? keywordFocusCopy?.audienceLead || 'Vom privaten Liebhaberstueck bis zum Auktionskatalog - jede Serie wird auf Nutzung und Zielpublikum zugeschnitten.'
  : `Geeignet fuer Besitzer, Sammler und Verkaufer in ${scope.label}, die ein Fahrzeug hochwertig, aber nicht kuenstlich zeigen moechten.`
const focusAudiences = doc?.audienceCards?.length
  ? doc.audienceCards.map((card, index) => [cmsText(card.title) || `Zielgruppe ${index + 1}`, cmsText(card.text) || 'CMS'])
  : keywordFocusCopy?.cards?.length
    ? keywordFocusCopy.cards.map((card) => [card.title, card.label || 'Oldtimer'])
    : audiences
const focusRelatedLead = isParentPage || isKeywordPage
  ? keywordFocusCopy?.relatedLead || 'Oldtimer ist Teil einer groesseren automotive Welt. Schau dir die anderen Disziplinen an - gleicher Anspruch, anderer Bildfokus. Die Links fuehren schnell zu der Bildwelt, die zum Fahrzeug, zur Nutzung und zum geplanten Shooting passt.'
  : `Oldtimer-Fotografie ${scope.label} fuehrt zu Automobil, Sportwagen, Druck und Portfolio, damit Nutzer schnell den passenden Bildbereich finden.`

// Hero = der Landing-Page-Shader-Hero. Das Bild kommt aus dem gemeinsamen
// Visual-Slot-System, damit Hero-Slider/Service-Hero im CMS den sichtbaren
// Oldtimer-Hero steuern koennen.
const hasAuthoredHeroVisual =
  Boolean(doc?.heroSlides?.length) ||
  Boolean(doc?.heroPanels?.length) ||
  Boolean(visualDoc?.heroSlides?.length) ||
  Boolean(visualDoc?.heroPanels?.length)
const heroBgDesktop = hasAuthoredHeroVisual ? visualSlots[0].full : '/assets/optimized/assets-photos-oldtimer-stage-1920.webp'
const heroBgMobile = hasAuthoredHeroVisual ? visualSlots[0].mobile : '/assets/optimized/assets-photos-oldtimer-stage-1280.webp'
const heroCopy = familyHeroCopy(doc, visualDoc, {
  lead: heroLead,
  primaryHref: '#anfrage',
  primaryLabel: 'Shooting buchen',
  secondaryHref: 'portfolio.html',
  secondaryLabel: 'Portfolio',
  titleLines: heroTitleLines,
})
const heroSlidesJson = JSON.stringify([
  { image: heroBgDesktop, titleLines: heroCopy.titleLines, lead: heroCopy.lead },
])
const heroVisualSource = doc?.heroPanels?.[0] || doc?.heroSlides?.[0] || visualDoc?.heroPanels?.[0] || visualDoc?.heroSlides?.[0]
const heroTextSource = doc?.heroSlides?.[0] || visualDoc?.heroSlides?.[0] || doc
const heroTitleField = (index: number) =>
  heroTextSource === doc?.heroSlides?.[0] || heroTextSource === visualDoc?.heroSlides?.[0]
    ? index === 0
      ? 'headlineLine1'
      : 'headlineLine2'
    : index === 0
      ? 'title'
      : 'heroLine2'
const heroLeadField = heroTextSource === doc?.heroSlides?.[0] || heroTextSource === visualDoc?.heroSlides?.[0] ? 'lead' : 'intro'

const cityLinks = [
  ['oldtimer-fotografie-duesseldorf.html', 'Düsseldorf'],
  ['oldtimer-fotografie-erkrath.html', 'Erkrath'],
  ['oldtimer-fotografie-ratingen.html', 'Ratingen'],
  ['oldtimer-fotografie-koeln.html', 'Köln'],
  ['oldtimer-fotografie-essen.html', 'Essen'],
  ['oldtimer-fotografie-dortmund.html', 'Dortmund'],
  ['oldtimer-fotografie-duisburg.html', 'Duisburg'],
  ['oldtimer-fotografie-bochum.html', 'Bochum'],
  ['oldtimer-fotografie-wuppertal.html', 'Wuppertal'],
  ['oldtimer-fotografie-leverkusen.html', 'Leverkusen'],
  ['oldtimer-fotografie-oberhausen.html', 'Oberhausen'],
  ['oldtimer-fotografie-krefeld.html', 'Krefeld'],
  ['oldtimer-fotografie-moenchengladbach.html', 'Mönchengladbach'],
  ['oldtimer-fotografie-moers.html', 'Moers'],
  ['oldtimer-fotografie-gelsenkirchen.html', 'Gelsenkirchen'],
  ['oldtimer-fotografie-bergisch-gladbach.html', 'Bergisch Gladbach'],
  ['oldtimer-fotografie-solingen.html', 'Solingen'],
  ['oldtimer-fotografie-remscheid.html', 'Remscheid'],
  ['oldtimer-fotografie-mettmann.html', 'Mettmann'],
  ['oldtimer-fotografie-hilden.html', 'Hilden'],
  ['oldtimer-fotografie-dormagen.html', 'Dormagen'],
  ['oldtimer-fotografie-neuss.html', 'Neuss'],
  ['oldtimer-fotografie-nrw.html', 'NRW'],
  ['oldtimer-fotografie-deutschland.html', 'Deutschland'],
]

const localSearchHref = (duesseldorfHref: string, fallbackHref?: string) =>
  scope.slug === 'duesseldorf' ? duesseldorfHref : fallbackHref || duesseldorfHref
const searchLinks = [
  [localSearchHref('classic-car-fotografie-duesseldorf.html', 'classic-car-fotografie.html'), 'Classic Car Fotografie'],
  ['oldtimer-shooting-duesseldorf.html', 'Oldtimer Shooting'],
  [localSearchHref('youngtimer-fotografie-duesseldorf.html', 'youngtimer-fotografie.html'), 'Youngtimer Fotografie'],
  [localSearchHref('sammlerfahrzeug-fotografie-duesseldorf.html', 'sammlerfahrzeug-fotografie.html'), 'Sammlerfahrzeug Fotografie'],
  ['oldtimer-verkaufsfotos-duesseldorf.html', 'Oldtimer Verkaufsfotos'],
]
---
<AdoptedPageLayout
  legacyFile={legacyFile}
  current="fotografie"
  doc={doc}
  noIndex={Boolean(preview)}
  title={metaTitle}
  description={metaDescription}
  ogImage={doc?.seo?.ogImage || heroBgDesktop}
  preloadImages={[
    { href: heroBgMobile, media: '(max-width: 900px)' },
    { href: heroBgDesktop, media: '(min-width: 901px)' },
  ]}
>
  {preview && (
    <PreviewToolbar
      collection={preview.collection}
      slug={preview.slug}
      status={preview.status}
      publishedHref={publishedHref}
    />
  )}
  <main>
    <section
      class="hero"
      id="top"
      data-theme="dark"
      data-header-theme="dark"
      aria-label={heroLabel}
      style={`--hero-bg-desktop:url('${heroBgDesktop}');--hero-bg-mobile:url('${heroBgMobile}')`}
      {...tinaAttrs(heroVisualSource, 'image')}
    >
      <div class="hero-bg" aria-hidden="true" {...tinaAttrs(heroVisualSource, 'image')}></div>
      <canvas id="hero-shader" aria-hidden="true" data-imgs={heroBgDesktop} data-slides={heroSlidesJson} {...tinaAttrs(heroVisualSource, 'image')}></canvas>
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-aperture" aria-hidden="true"></div>
      <div class="hero-grid">
        <div class="hero-stage">
          <h1 class="hero-title" id="hero-title" data-text-idx="0" aria-label={heroLabel}>
            {heroCopy.titleLines.map((line, index) => (
              <span class="line" {...tinaAttrs(heroTextSource, heroTitleField(index))}><span class="word">{line}</span></span>
            ))}
          </h1>
          {heroLocalNote && <p class="hero-local-note" {...tinaAttrs(doc, 'heroLine2')}>{heroLocalNote}</p>}
          <p class="hero-lead" id="hero-lead" {...tinaAttrs(heroTextSource, heroLeadField)}>{heroCopy.lead}</p>
          <div class="hero-actions" aria-label="Direkte Aktionen">
            <a class="btn dark" href={heroCopy.primaryHref} data-hero-primary {...tinaAttrs(heroTextSource, 'primaryLabel')}>{heroCopy.primaryLabel}</a>
            <a class="btn" href={heroCopy.secondaryHref} data-hero-secondary {...tinaAttrs(heroTextSource, 'secondaryLabel')}>{heroCopy.secondaryLabel}</a>
          </div>
        </div>
      </div>
      <div class="hero-cursor" id="hero-cursor" aria-hidden="true"><span class="ring"></span></div>
    </section>

    <section class="st" data-header-theme="light">
      <div class="section-inner">
        <div>
          <h2>
            <span {...tinaAttrs(doc?.statement, 'headline')}>{focusIntroTitle.headline}</span>
            {focusIntroTitle.headline && focusIntroTitle.emphasis ? ' ' : ''}
            {focusIntroTitle.emphasis && <em {...tinaAttrs(doc?.statement, 'emphasis')}>{focusIntroTitle.emphasis}</em>}
          </h2>
        </div>
        <div class="st-body">
          {focusIntroParagraphs.map((paragraph, index) => <p {...tinaAttrs(doc?.statement?.body?.[index], 'text')}>{paragraph}</p>)}
          <a class="st-cta" href="#anfrage">Shooting buchen →</a>
        </div>
      </div>
    </section>

    <section class="pv" data-header-theme="dark">
      <div class="section-inner">
        <div class="pv-head">
          <h2><span {...tinaAttrs(doc?.focusSection, 'headline')}>{focusStoryHeadline}</span> <em {...tinaAttrs(doc?.focusSection, 'emphasis')}>{focusStoryEmphasis}</em></h2>
          <p {...tinaAttrs(doc?.focusSection, 'lead')}>{focusStoryLead}</p>
        </div>
        <div class="pv-grid">
          {focusStoryCards.map((card, index) => (
            <article class="pv-card">
              <figure class="pv-img"><img loading="lazy" src={card.image} alt={card.alt} width={card.width} height={card.height} decoding="async" {...tinaAttrs(doc?.shootingStyles?.[index], 'image')} /></figure>
              <h3 {...tinaAttrs(doc?.shootingStyles?.[index], 'title')}>{card.title}</h3>
              <p {...tinaAttrs(doc?.shootingStyles?.[index], 'text')}>{card.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="po" data-header-theme="dark" aria-label="Ausgewählte Oldtimer-Arbeiten">
      <div class="po-grid" id="poGrid">
        <header class="po-head">
          <h2 {...tinaAttrs(doc?.gallerySection, 'headline')}>{focusPortfolioHeadline}</h2>
          <p {...tinaAttrs(doc?.gallerySection, 'lead')}>{focusPortfolioLead}</p>
        </header>
        {inheritedPortfolioTiles.map(([className, image, alt, width, height, full], index) => (
          <button type="button" class={`po-tile ${className}`} data-i={index} data-full={full} aria-label={`Bild ${index + 1} vergrößern`}>
            <img data-src={image} src={image} data-full={full} loading="lazy" alt={alt} width={width} height={height} decoding="async" {...tinaAttrs(doc?.portfolioTiles?.[index], 'image')} />
            <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
          </button>
        ))}
      </div>
    </section>

    <section class="fw" data-header-theme="light">
      <div class="section-inner">
        <div class="fw-head">
          <h2 {...tinaAttrs(doc?.audienceSection, 'headline')}>{focusAudienceHeadline}</h2>
          <p class="lead" {...tinaAttrs(doc?.audienceSection, 'lead')}>{focusAudienceLead}</p>
        </div>
        <div class="fw-grid">
          {focusAudiences.map(([title, label], index) => (
            <a class="fw-card" href="#anfrage"><strong {...tinaAttrs(doc?.audienceCards?.[index], 'title')}>{title}</strong><span class="lbl" {...tinaAttrs(doc?.audienceCards?.[index], 'text')}>{label}</span><span class="arrow" aria-hidden="true">→</span></a>
          ))}
        </div>
        <div class="fw-foot">
          <p>Du erkennst dein Anliegen wieder? <em>Lass uns sprechen.</em></p>
          <a href="#anfrage">Projekt anfragen →</a>
        </div>
      </div>
    </section>

    <section class="rl" data-header-theme="dark">
      <div class="section-inner">
        <div class="rl-head">
          <h2>Verwandte <em>Bereiche</em>.</h2>
          <p {...tinaAttrs(doc?.relatedSection, 'lead')}>{focusRelatedLead}</p>
        </div>
        <div class="rl-grid">
          {inheritedRelatedAreas.map((area, index) => (
            <a class="rl-card" href={area.href}>
              <img data-src={area.image} src={area.image} loading="lazy" alt={area.alt} width={area.width} height={area.height} decoding="async" {...tinaAttrs(doc?.relatedSection?.items?.[index], 'image')} />
              <div class="overlay"></div>
              <div class="content"><div><strong {...tinaAttrs(doc?.relatedSection?.items?.[index], 'title')}>{area.title}</strong></div><span class="arrow">→</span></div>
            </a>
          ))}
        </div>
      </div>
    </section>

    {!isParentPage && (
      <NativeFamilyClusterLinks
        clusterHeading={clusterHeading}
        clusterLinks={clusterLinks}
        overviewHref={overviewHref}
        scopeLabel={scope.label}
      />
    )}

    <section class="mr-cities" data-header-theme="light" data-theme="light" aria-label="Oldtimer Fotografie in NRW">
      <div class="mr-cities__inner">
        <div class="mr-cities__head">
          <h2>Oldtimer Fotografie <em>vor Ort.</em></h2>
        </div>
        <nav class="mr-cities__grid" aria-label="Städte">
          {cityLinks.map(([href, label], index) => <a class="mr-cities__cell" href={href} {...tinaAttrs(doc?.locationLinksSection?.items?.[index], 'label')}>{label}</a>)}
        </nav>
      </div>
    </section>

    <section class="mr-cities" data-header-theme="light" data-theme="light" aria-label="Oldtimer Fotografie Suchbegriffe">
      <div class="mr-cities__inner">
        <div class="mr-cities__head">
          <h2>Oldtimer Fotografie <em>Suchbegriffe.</em></h2>
        </div>
        <nav class="mr-cities__grid" aria-label="Suchvarianten">
          {searchLinks.map(([href, label], index) => <a class="mr-cities__cell" href={href} {...tinaAttrs(doc?.searchLinksSection?.items?.[index], 'label')}>{label}</a>)}
        </nav>
      </div>
    </section>

    <NativeFamilyFaq faq={faqItems} pageUrl={`https://matthiasramahi.de/${legacyFile}`} theme="dark" />

    <NativeReviews theme="light" />

    <section
      id="anfrage"
      data-contact-section
      data-header-theme="light"
      data-contact-subject={contactSubject}
      data-contact-headline={contactHeadline}
      data-contact-lead={contactLead}
    />
  </main>
</AdoptedPageLayout>
