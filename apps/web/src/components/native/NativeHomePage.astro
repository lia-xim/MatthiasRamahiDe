---
import ContactSlot from '../ContactSlot.astro'
import AdoptedPageLayout from '../../layouts/AdoptedPageLayout.astro'
import PreviewToolbar from '../PreviewToolbar.astro'
import NativeShaderHero from './NativeShaderHero.astro'
import NativeReviews from './NativeReviews.astro'
import {
  blockParagraphs,
  homeChapters as fallbackChapters,
  homeHeroSlidesFor,
  homeServices as fallbackServices,
} from '../../lib/nativeContent'
import {
  getBySlug,
  getSitePageByType,
  imageAlt,
  imageDimensions,
  imageDisplayUrl,
  imageSrcset,
  liveCmsFetchOptions,
  toRootRelativeHref,
  type PayloadDoc,
  type PayloadMedia,
} from '../../lib/payload'
import { resolveTinaMediaRef } from '../../lib/tinaMedia'
import { journalCards } from '../../lib/journalIndexContent'
import {
  buildContactStrip,
  contactSheetJsonLd,
  contactSheetSeries,
  homeFaq,
  homeFaqJsonLd,
  homeIntents,
  homeProcess,
  localVariantImage,
  type ContactStrip,
} from '../../lib/homeLandingContent'
import { tinaAttrs } from '../../lib/tinaFieldAttrs'

type PreviewState = {
  collection: string
  publishedHref: string
  slug: string
  status?: string
}

type Props = {
  doc?: PayloadDoc
  preview?: PreviewState
}

const { doc: providedDoc, preview } = Astro.props as Props
const doc = providedDoc || (await getSitePageByType('home', liveCmsFetchOptions({ depth: 2 })))

const heroSlides = homeHeroSlidesFor(doc)
const firstHeroSlide = heroSlides[0]

const hasText = (value?: string): value is string => typeof value === 'string' && value.trim().length > 0
const editableSource = (item: unknown) => (item as { source?: unknown } | null | undefined)?.source
const pad = (value: number) => String(value).padStart(2, '0')

// Bildgroessen (technische Moeblierung, bleibt Code — wird nicht im CMS gepflegt)
const chapterSizes = '(max-width: 780px) calc((100vw - 52px) / 2), (max-width: 1180px) calc((100vw - 112px) / 2), 440px'
const journalSizes = '(max-width: 780px) calc(100vw - 44px), (max-width: 1180px) calc(100vw - 112px), 460px'
const aboutSizes = '(max-width: 780px) calc(100vw - 44px), (max-width: 1180px) calc(100vw - 112px), 680px'
const defaultAboutImage = '/assets/optimized/mpissxxj-portrait-960.webp'
const defaultAboutImageSrcset =
  '/assets/optimized/mpissxxj-portrait-480.webp 480w, /assets/optimized/mpissxxj-portrait-720.webp 720w, /assets/optimized/mpissxxj-portrait-960.webp 960w, /assets/optimized/mpissxxj-portrait-1280.webp 1280w'

const cmsSrcset = (image?: PayloadMedia | string) =>
  image && typeof image !== 'string' ? imageSrcset(image, ['mobile', 'card', 'hero']) || undefined : undefined

// --- Statement: „Bilder, die einen Raum verändern." ---
const statement = doc?.homeStatement
const statementHeadline = hasText(statement?.headline) ? statement!.headline! : ''
const statementEmphasis = statement?.headlineEmphasis || ''
const statementBody = (statement?.body || []).map((paragraph) => paragraph?.text).filter(hasText)
const statementParagraphs = statementBody.length
  ? statementBody
  : blockParagraphs(doc, 'Bilder', [
      'Meine Bilder entstehen rund um Automobile, Oldtimer, Sportwagen, Motorräder, Portraits und Landschaften. Jede Arbeit folgt derselben ruhigen Logik: Licht, Komposition, Material, Zeit.',
      'Auftraggeber sind Marken, Sammler, Manufakturen und private Eigentümer aus Düsseldorf, Köln, Essen, Dortmund und dem gesamten Rheinland.',
    ])

// --- „Sechs Bereiche. Eine Linse." ---
const chaptersGroup = doc?.homeChapters
const chaptersHeadline = hasText(chaptersGroup?.headline) ? chaptersGroup!.headline! : ''
const chaptersEmphasis = chaptersGroup?.headlineEmphasis || ''
const chaptersIntro = hasText(chaptersGroup?.intro)
  ? chaptersGroup!.intro!
  : blockParagraphs(doc, 'Sechs Bereiche', [
      'Jeder Bereich hat eine eigene visuelle Logik: Bewegung, Material, Mensch, Raum.',
    ])[0]
const cmsChapters = (chaptersGroup?.items || [])
  .filter((item) => item?.image)
  .map((item) => {
    const local = typeof item.image === 'string' ? localVariantImage(item.image) : null
    return {
      source: item,
      href: toRootRelativeHref(item.href) || '#',
      image: local?.src || imageDisplayUrl(item.image, 'card', { allowOriginal: true }),
      srcset: local?.srcset || cmsSrcset(item.image),
      sizes: chapterSizes,
      alt: imageAlt(item.image, item.title || ''),
      title: item.title || '',
      meta: item.meta || '',
      ...(local ? { width: local.width, height: local.height } : imageDimensions(item.image, 'card')),
    }
  })
const chapters = (cmsChapters.length ? cmsChapters : fallbackChapters).map((chapter) => {
  const genericAlt = !chapter.alt || /^(_?dsc|img|\d)/i.test(chapter.alt) || chapter.alt === chapter.title
  return {
    ...chapter,
    sizes: chapterSizes,
    alt: genericAlt ? `${chapter.title}fotografie von Matthias Ramahi` : chapter.alt,
  }
})

// --- Kontaktbogen (ersetzt den JS-Marquee: Bilder jetzt serverseitig im HTML, mit Alt-Texten) ---
const selectedWorks = doc?.homeSelectedWorks
const selectedWorksHeadline = hasText(selectedWorks?.headline) ? selectedWorks!.headline! : ''
const selectedWorksEmphasis = selectedWorks?.headlineEmphasis || ''
const portfolioIntro = hasText(selectedWorks?.intro)
  ? selectedWorks!.intro!
  : 'Aktuelle Serien aus allen sechs Bereichen. Ein Klick auf ein Bild öffnet die Großansicht.'
const seriesDocs = await Promise.all(
  contactSheetSeries.map((series) => getBySlug('portfolio-projects', series.slug, liveCmsFetchOptions({ depth: 2 }))),
)
const strips = contactSheetSeries
  .map((series, index) => buildContactStrip(series, seriesDocs[index]))
  .filter((strip): strip is ContactStrip => Boolean(strip))
const stripRatio = (strip: ContactStrip) => strip.frames.reduce((sum, frame) => sum + frame.ratio, 0)
const frameSizes = (ratio: number, total: number) =>
  `(max-width: 780px) ${Math.round(200 * ratio)}px, (max-width: 1180px) ${Math.round((820 * ratio) / total)}px, ${Math.round((1080 * ratio) / total)}px`

// --- „Hinter der Kamera" ---
const about = doc?.homeAbout
const aboutKicker = hasText(about?.kicker) ? about!.kicker! : 'Über mich'
const aboutHeadline = hasText(about?.headline) ? about!.headline! : ''
const aboutEmphasis = about?.headlineEmphasis || ''
const aboutBody = (about?.body || []).map((paragraph) => paragraph?.text).filter(hasText)
const aboutParagraphs = aboutBody.length
  ? aboutBody
  : blockParagraphs(doc, 'Hinter der Kamera', [
      'Ich arbeite ruhig, präzise und im engen Dialog mit dem Auftraggeber, vom ersten Briefing bis zum finalen Druck.',
      'Meine Basis ist Düsseldorf, mein Netzwerk reicht durch das gesamte Rheinland.',
    ])
const aboutImage = about?.image
  ? imageDisplayUrl(about.image, 'card', { allowOriginal: true })
  : defaultAboutImage
const aboutImageSrcset = about?.image ? cmsSrcset(about.image) : defaultAboutImageSrcset
const resolvedAboutImageSrcset = aboutImage.includes('mpissxxj-portrait') ? defaultAboutImageSrcset : aboutImageSrcset
const aboutImageAlt = about?.image ? imageAlt(about.image, 'Matthias Ramahi') : 'Matthias Ramahi'
const aboutImageDimensions = aboutImage.includes('mpissxxj-portrait')
  ? { width: 960, height: 1132 }
  : about?.image
    ? imageDimensions(about.image, 'card')
    : { width: 960, height: 1132 }

// --- Zusatzleistungen (kompakt im Journal-Block) ---
const servicesGroup = doc?.homeServices
const servicesIntro = hasText(servicesGroup?.intro)
  ? servicesGroup!.intro!
  : 'Druck, Großformat, Werbetechnik, Webdesign, Video und mehr über ein kuratiertes Netzwerk, mit einem Ansprechpartner.'
const cmsServices = (servicesGroup?.items || [])
  .filter((item) => hasText(item?.title))
  .map((item) => ({
    source: item,
    href: toRootRelativeHref(item.href) || '#',
    title: item.title || '',
    text: item.text || '',
  }))
const services = cmsServices.length ? cmsServices : fallbackServices

// --- Journal: CMS-Auswahl nur, wenn sie auf echte Artikel zeigt; sonst die drei neuesten Beiträge ---
const journalGroup = doc?.homeJournal
const journalHeadline = hasText(journalGroup?.headline) ? journalGroup!.headline! : ''
const journalEmphasis = journalGroup?.headlineEmphasis || ''
const journalIntro = hasText(journalGroup?.intro)
  ? journalGroup!.intro!
  : 'Workflow, Material, Auftragsgeschichten. Lange Form, ruhig zum Lesen zwischendurch.'
const monthFormat = new Intl.DateTimeFormat('de-DE', { month: 'long', year: 'numeric' })
const journalByHref = new Map(journalCards.map((card) => [card.href, card]))
const cmsJournalItems = (journalGroup?.items || []).filter((item) => {
  const href = toRootRelativeHref(item?.href)
  return Boolean(item?.image && href && journalByHref.has(href))
})
const journalPosts = (cmsJournalItems.length === 3
  ? cmsJournalItems.map((item) => {
      const card = journalByHref.get(toRootRelativeHref(item.href) || '')!
      return { ...card, title: item.title || card.title, text: item.text || card.text, image: item.image as PayloadMedia | string, source: item }
    })
  : journalCards.slice(0, 3).map((card) => ({ ...card, image: card.image as PayloadMedia | string, source: undefined }))
).map((post) => {
  const media = typeof post.image === 'string' ? resolveTinaMediaRef(post.image) || post.image : post.image
  return {
    ...post,
    src: imageDisplayUrl(media, 'card', { allowOriginal: true }),
    srcset: typeof media === 'string' ? undefined : imageSrcset(media, ['mobile', 'card']) || undefined,
    date: post.dateTime ? monthFormat.format(new Date(post.dateTime)) : '',
    ...(typeof media === 'string' ? {} : imageDimensions(media, 'card')),
  }
})
---
<AdoptedPageLayout
  legacyFile="index.html"
  current="home"
  doc={doc}
  ctaHref="#anfrage"
  preloadImages={[{ href: firstHeroSlide.image, fetchpriority: 'high' }]}
  noIndex={Boolean(preview)}
  jsonLd={[homeFaqJsonLd, contactSheetJsonLd(strips)].filter((item): item is NonNullable<typeof item> => Boolean(item))}
  liveCms
>
  {preview && (
    <PreviewToolbar
      collection={preview.collection}
      slug={preview.slug}
      status={preview.status}
      publishedHref={preview.publishedHref}
    />
  )}
  <main class="lp">
    <NativeShaderHero label="Intro" slides={heroSlides} sourceSlides={doc?.heroSlides || []} />

    {/* 01 · Statement (light) — gleiches Muster wie „Über mich“ */}
    <section class="statement sec-light" data-theme="light" aria-labelledby="lp-statement-title">
      <div class="section-inner">
        <div>
          {statementHeadline
            ? <h2 id="lp-statement-title" {...tinaAttrs(statement, 'headline')}>{statementHeadline}{statementEmphasis ? <Fragment><br /> <em {...tinaAttrs(statement, 'headlineEmphasis')}>{statementEmphasis}</em></Fragment> : null}</h2>
            : <h2 id="lp-statement-title">Bilder, die einen Raum<br /> <em>verändern</em>.</h2>}
        </div>
        <div class="body">
          <p class="lead" {...tinaAttrs(statement?.body?.[0], 'text')}>{statementParagraphs[0]}</p>
          {statementParagraphs[1] && <p {...tinaAttrs(statement?.body?.[1], 'text')}>{statementParagraphs[1]}</p>}
          <div class="actions">
            <a class="btn dark" href="#arbeiten">Serien ansehen</a>
            <a class="btn" href="#chapters" style="color:var(--ink);border-color:var(--ink)">Bereiche ansehen</a>
          </div>
        </div>
      </div>
    </section>

    {/* 02 · Sechs Bereiche (dark) — gleiches Muster wie „Über mich“ */}
    <section class="chapters sec-dark" id="chapters" data-theme="dark" aria-labelledby="lp-chapters-title">
      <div class="section-inner">
        <div class="chapters-head">
          {chaptersHeadline
            ? <h2 id="lp-chapters-title" {...tinaAttrs(chaptersGroup, 'headline')}>{chaptersHeadline}{chaptersEmphasis ? <Fragment><br /> <em {...tinaAttrs(chaptersGroup, 'headlineEmphasis')}>{chaptersEmphasis}</em></Fragment> : null}</h2>
            : <h2 id="lp-chapters-title">Sechs Bereiche.<br /> Eine <em>Linse</em>.</h2>}
          <p class="lead" {...tinaAttrs(chaptersGroup, 'intro')}>{chaptersIntro}</p>
        </div>
        <div class="chapter-grid">
          {chapters.map((chapter) => (
            <a class="chapter" href={chapter.href}>
              <div class="img">
                <img src={chapter.image} srcset={chapter.srcset} sizes={chapter.sizes} alt={chapter.alt} loading="lazy" width={chapter.width} height={chapter.height} decoding="async" {...tinaAttrs(editableSource(chapter), 'image')} />
              </div>
              <div class="head"><h3 {...tinaAttrs(editableSource(chapter), 'title')}>{chapter.title}</h3></div>
              <span class="meta"><span class="arr">Bereich ansehen&nbsp;→</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    {/* 03 · Kontaktbogen (light) */}
    <section class="lp-sheet sec-light" id="arbeiten" data-theme="light" aria-labelledby="lp-sheet-title">
      <div class="section-inner">
        <div class="lp-head">
          {selectedWorksHeadline
            ? <h2 id="lp-sheet-title" class="lp-display" {...tinaAttrs(selectedWorks, 'headline')}>{selectedWorksHeadline}{selectedWorksEmphasis ? <Fragment> <em {...tinaAttrs(selectedWorks, 'headlineEmphasis')}>{selectedWorksEmphasis}</em></Fragment> : null}</h2>
            : <h2 id="lp-sheet-title" class="lp-display">Ausgewählte <em>Arbeiten.</em></h2>}
          <p class="lead" {...tinaAttrs(selectedWorks, 'intro')}>{portfolioIntro}</p>
        </div>
        <div class="lp-sheet__board" data-site-lightbox-gallery>
          {strips.map((strip, stripIndex) => {
            const total = stripRatio(strip)
            return (
              <article class="lp-strip" aria-labelledby={`lp-strip-${strip.topic}`}>
                <header class="lp-strip__label">
                  <h3 id={`lp-strip-${strip.topic}`}>{strip.label}</h3>
                  {strip.excerpt && <p>{strip.excerpt}</p>}
                  <a class="lp-link" href={strip.href}>Serie ansehen<span class="sr-only"> {strip.label}</span> <span>· {pad(strip.count)} Bilder</span></a>
                </header>
                <div class="lp-strip__frames" style={`--total:${total.toFixed(3)}`}>
                  {strip.frames.map((frame, frameIndex) => (
                    <figure class="lp-frame" style={`--r:${frame.ratio.toFixed(4)}`}>
                      <div class="lp-frame__img">
                        <img
                          src={frame.src}
                          srcset={frame.srcset}
                          sizes={frameSizes(frame.ratio, total)}
                          alt={frame.alt}
                          data-full={frame.full}
                          loading="lazy"
                          decoding="async"
                          width={frame.width}
                          height={frame.height}
                        />
                      </div>
                      {frame.caption && <figcaption>{frame.caption}</figcaption>}
                    </figure>
                  ))}
                </div>
              </article>
            )
          })}
        </div>
        <div class="lp-sheet__foot">
          <a class="btn dark" href="/portfolio.html">Vollständiges Portfolio →</a>
        </div>
      </div>
    </section>

    {/* 04 · Wofür brauchst du Bilder? (dark) */}
    <section class="lp-intents sec-dark" data-theme="dark" aria-labelledby="lp-intents-title">
      <div class="section-inner">
        <div class="lp-head">
          <h2 id="lp-intents-title" class="lp-display">Wofür brauchst du <em>Bilder?</em></h2>
          <p class="lead">Sieben typische Anlässe, jeder mit eigener Seite, Ablauf und Beispielen. Wähle den, der passt.</p>
        </div>
        <ol class="lp-intent-list">
          {homeIntents.map((intent, index) => (
            <li>
              <a class="lp-intent" href={intent.href}>
                <span class="lp-intent__title">{intent.title}</span>
                <span class="lp-intent__text">{intent.text}</span>
                <span class="lp-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* 05 · Ablauf (light) */}
    <section class="lp-process sec-light" data-theme="light" aria-labelledby="lp-process-title">
      <div class="section-inner">
        <div class="lp-head">
          <h2 id="lp-process-title" class="lp-display">Vom Briefing <em>bis zum Print.</em></h2>
          <p class="lead">Fünf Schritte, ein Ansprechpartner. So läuft ein Auftrag ab.</p>
        </div>
        <ol class="lp-steps">
          {homeProcess.map((step, index) => (
            <li class="lp-step">
              <h3><span class="lp-step__no">{pad(index + 1)}</span> {step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* 06 · Hinter der Kamera (dark) */}
    <section class="about lp-about sec-dark" data-theme="dark" aria-labelledby="lp-about-title">
      <div class="section-inner">
        <div class="about-img" data-site-lightbox-single>
          <img src={aboutImage} srcset={resolvedAboutImageSrcset} sizes={aboutSizes} alt={aboutImageAlt} loading="lazy" width={aboutImageDimensions.width} height={aboutImageDimensions.height} decoding="async" {...tinaAttrs(about, 'image')} />
        </div>
        <div class="about-copy">
          <p class="lp-eyebrow" {...tinaAttrs(about, 'kicker')}>{aboutKicker}</p>
          {aboutHeadline
            ? <h2 id="lp-about-title" class="lp-display" {...tinaAttrs(about, 'headline')}>{aboutHeadline}{aboutEmphasis ? <Fragment> <em {...tinaAttrs(about, 'headlineEmphasis')}>{aboutEmphasis}</em></Fragment> : null}</h2>
            : <h2 id="lp-about-title" class="lp-display">Hinter der <em>Kamera.</em></h2>}
          <p class="lead" {...tinaAttrs(about?.body?.[0], 'text')}>{aboutParagraphs[0]}</p>
          {aboutParagraphs[1] && <p {...tinaAttrs(about?.body?.[1], 'text')}>{aboutParagraphs[1]}</p>}
          <div class="actions">
            <a class="btn primary" href="/ueber-mich.html">Mehr über mich</a>
            <a class="btn lp-btn-ghost-paper" href="#anfrage">Projekt anfragen</a>
          </div>
        </div>
      </div>
    </section>

    {/* 07 · FAQ (light) */}
    <section class="lp-faq sec-light" data-theme="light" aria-labelledby="lp-faq-title">
      <div class="section-inner">
        <div class="lp-faq__intro">
          <h2 id="lp-faq-title" class="lp-display">Häufige <em>Fragen.</em></h2>
          <p class="lead">Kurz beantwortet. Alles Weitere klären wir im Briefing.</p>
          <a class="btn dark" href="#anfrage">Frage stellen</a>
        </div>
        <div class="lp-faq__list">
          {homeFaq.map((item, index) => (
            <details class="lp-q" open={index === 0}>
              <summary>
                <h3>{item.question}</h3>
                <span class="lp-q__icon" aria-hidden="true"></span>
              </summary>
              <div class="lp-q__a">
                <p>{item.answer}</p>
                {item.link && <a class="lp-link" href={item.link.href}>{item.link.label} →</a>}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    {/* 08 · Journal + Zusatzleistungen (dark) */}
    <section class="blog-sec lp-journal sec-dark" data-theme="dark" aria-labelledby="lp-journal-title">
      <div class="section-inner">
        <div class="lp-head">
          {journalHeadline
            ? <h2 id="lp-journal-title" class="lp-display" {...tinaAttrs(journalGroup, 'headline')}>{journalHeadline}{journalEmphasis ? <Fragment> <em {...tinaAttrs(journalGroup, 'headlineEmphasis')}>{journalEmphasis}</em></Fragment> : null}</h2>
            : <h2 id="lp-journal-title" class="lp-display">Journal.</h2>}
          <p class="lead" {...tinaAttrs(journalGroup, 'intro')}>{journalIntro}</p>
        </div>
        <div class="lp-journal__grid">
          {journalPosts.map((post) => (
            <a class="lp-post" href={post.href}>
              <div class="lp-post__img">
                <img src={post.src} srcset={post.srcset} sizes={journalSizes} alt={post.imageAlt} loading="lazy" decoding="async" width={post.width} height={post.height} {...tinaAttrs(post.source, 'image')} />
              </div>
              <p class="lp-post__meta">
                {post.date && <time datetime={post.dateTime}>{post.date}</time>}
                <span>{post.readTime} Lesezeit</span>
              </p>
              <h3 {...tinaAttrs(post.source, 'title')}>{post.title}</h3>
              <p class="lp-post__text" {...tinaAttrs(post.source, 'text')}>{post.text}</p>
              <span class="lp-post__read">Lesen →</span>
            </a>
          ))}
        </div>
        <div class="lp-journal__all">
          <a class="btn lp-btn-ghost-paper" href="/blog.html">Alle Beiträge</a>
        </div>

        <div class="lp-extras" aria-labelledby="lp-extras-title">
          <div class="lp-extras__head">
            <h3 id="lp-extras-title">Zusatzleistungen</h3>
            <p {...tinaAttrs(servicesGroup, 'intro')}>{servicesIntro}</p>
            <a class="lp-link" href="/leistungen.html">Alle Leistungen →</a>
          </div>
          <ul class="lp-extras__list">
            {services.map((service) => (
              <li>
                <a href={service.href}>
                  <span class="lp-extras__title" {...tinaAttrs(editableSource(service), 'title')}>{service.title}</span>
                  <span class="lp-extras__text" {...tinaAttrs(editableSource(service), 'text')}>{service.text}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <NativeReviews theme="light" />

    <ContactSlot
      id="anfrage"
      data-contact-section
      data-theme="light"
      data-contact-subject="Projektanfrage"
      data-contact-headline="Projekt <em>anfragen.</em>"
      data-contact-lead="Erzähl kurz, worum es geht: Motiv, Ort, Zeitrahmen, Nutzung. Ich antworte persönlich und sortiere mit dir den nächsten sinnvollen Schritt."
    />
  </main>
</AdoptedPageLayout>
