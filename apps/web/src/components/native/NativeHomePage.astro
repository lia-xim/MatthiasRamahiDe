---
import AdoptedPageLayout from '../../layouts/AdoptedPageLayout.astro'
import PreviewToolbar from '../PreviewToolbar.astro'
import NativeShaderHero from './NativeShaderHero.astro'
import NativeReviews from './NativeReviews.astro'
import {
  blockParagraphs,
  homeChapters as fallbackChapters,
  homeHeroSlidesFor,
  homeJournalCards as fallbackJournalCards,
  homeServices as fallbackServices,
} from '../../lib/nativeContent'
import {
  getSitePageByType,
  imageAlt,
  imageDimensions,
  imageDisplayUrl,
  imageSrcset,
  liveCmsFetchOptions,
  toRootRelativeHref,
  type PayloadDoc,
  type PayloadMedia,
} from '../../lib/payload'
import { tinaAttrs } from '../../lib/tinaFieldAttrs'

type PreviewState = {
  collection: string
  publishedHref: string
  slug: string
  status?: string
}

type Props = {
  doc?: PayloadDoc
  preview?: PreviewState
}

const { doc: providedDoc, preview } = Astro.props as Props
const doc = providedDoc || (await getSitePageByType('home', liveCmsFetchOptions({ depth: 2 })))

const heroSlides = homeHeroSlidesFor(doc)
const firstHeroSlide = heroSlides[0]

const hasText = (value?: string): value is string => typeof value === 'string' && value.trim().length > 0
const editableSource = (item: unknown) => (item as { source?: unknown } | null | undefined)?.source

// Bildgroessen (technische Moeblierung, bleibt Code — wird nicht im CMS gepflegt)
const chapterSizes = '(max-width: 780px) calc((100vw - 52px) / 2), (max-width: 1180px) calc((100vw - 112px) / 2), 437px'
const journalSizes = '(max-width: 780px) calc(100vw - 44px), (max-width: 1180px) calc((100vw - 112px) / 2), 437px'
const aboutSizes = '(max-width: 780px) calc(100vw - 44px), (max-width: 1180px) calc(100vw - 112px), 560px'
const defaultAboutImage = '/assets/optimized/mpissxxj-portrait-960.webp'
const defaultAboutImageSrcset =
  '/assets/optimized/mpissxxj-portrait-480.webp 480w, /assets/optimized/mpissxxj-portrait-720.webp 720w, /assets/optimized/mpissxxj-portrait-960.webp 960w, /assets/optimized/mpissxxj-portrait-1280.webp 1280w'

const cmsSrcset = (image?: PayloadMedia | string) =>
  image && typeof image !== 'string' ? imageSrcset(image, ['mobile', 'card', 'hero']) || undefined : undefined

// --- Statement: „Bilder, die einen Raum verändern." ---
const statement = doc?.homeStatement
const statementHeadline = hasText(statement?.headline) ? statement!.headline! : ''
const statementEmphasis = statement?.headlineEmphasis || ''
const statementBody = (statement?.body || []).map((paragraph) => paragraph?.text).filter(hasText)
const statementParagraphs = statementBody.length
  ? statementBody
  : blockParagraphs(doc, 'Bilder', [
      'Seit über zehn Jahren entstehen meine Serien im Spannungsfeld von Präzision und Atmosphäre - Automobile, Oldtimer, Sportwagen, Motorräder, Portraits und Landschaften. Jede Arbeit folgt einer ruhigen redaktionellen Logik: Licht, Komposition, Material, Zeit.',
      'Auftraggeber sind Marken, Sammler, Manufakturen und private Eigentümer aus Düsseldorf, Köln, Essen, Dortmund und dem gesamten Rheinland - überall dort, wo Bilder über Auflage, Sammlung oder Markenwert mitentscheiden.',
    ])

// --- „Sechs Bereiche. Eine Linse." ---
const chaptersGroup = doc?.homeChapters
const chaptersHeadline = hasText(chaptersGroup?.headline) ? chaptersGroup!.headline! : ''
const chaptersEmphasis = chaptersGroup?.headlineEmphasis || ''
const chaptersIntro = hasText(chaptersGroup?.intro)
  ? chaptersGroup!.intro!
  : blockParagraphs(doc, 'Sechs Bereiche', [
      'Jeder Bereich hat eine eigene visuelle Logik - Bewegung, Material, Mensch, Raum. Auswählen, weiterlesen, eine Serie sehen.',
    ])[0]
const cmsChapters = (chaptersGroup?.items || [])
  .filter((item) => item?.image)
  .map((item) => ({
    source: item,
    href: toRootRelativeHref(item.href) || '#',
    image: imageDisplayUrl(item.image, 'card', { allowOriginal: true }),
    srcset: cmsSrcset(item.image),
    sizes: chapterSizes,
    alt: imageAlt(item.image, item.title || ''),
    title: item.title || '',
    meta: item.meta || '',
    ...imageDimensions(item.image, 'card'),
  }))
const chapters = cmsChapters.length ? cmsChapters : fallbackChapters

// --- „Ausgewählte Arbeiten" (Portfolio-Teaser, Bilder laufen automatisch) ---
const selectedWorks = doc?.homeSelectedWorks
const selectedWorksHeadline = hasText(selectedWorks?.headline) ? selectedWorks!.headline! : ''
const selectedWorksEmphasis = selectedWorks?.headlineEmphasis || ''
const portfolioIntro = hasText(selectedWorks?.intro)
  ? selectedWorks!.intro!
  : blockParagraphs(doc, 'Ausgewählte', [
      'Ein Strom aus aktuellen Serien - kontinuierlich in Bewegung. Klick auf ein Bild öffnet die Vorschau.',
    ])[0]

// --- „Hinter der Kamera" ---
const about = doc?.homeAbout
const aboutKicker = hasText(about?.kicker) ? about!.kicker! : 'Über mich'
const aboutHeadline = hasText(about?.headline) ? about!.headline! : ''
const aboutEmphasis = about?.headlineEmphasis || ''
const aboutBody = (about?.body || []).map((paragraph) => paragraph?.text).filter(hasText)
const aboutParagraphs = aboutBody.length
  ? aboutBody
  : blockParagraphs(doc, 'Hinter der Kamera', [
      'Ausgebildet im Handwerk, denkend wie ein Editor - ich arbeite ruhig, präzise und in engem Dialog mit dem Auftraggeber. Vom ersten Briefing bis zum finalen Druck.',
      'Meine Location steht in Düsseldorf, mein Netzwerk im gesamten Rheinland. Ich begleite Marken, Manufakturen, Sammler und private Eigentümer dort, wo ein Bild über Auflage, Sammlung oder Markenwert mitentscheidet.',
    ])
const aboutImage = about?.image
  ? imageDisplayUrl(about.image, 'card', { allowOriginal: true })
  : defaultAboutImage
const aboutImageSrcset = about?.image ? cmsSrcset(about.image) : defaultAboutImageSrcset
const resolvedAboutImageSrcset = aboutImage.includes('mpissxxj-portrait') ? defaultAboutImageSrcset : aboutImageSrcset
const aboutImageAlt = about?.image ? imageAlt(about.image, 'Matthias Ramahi') : 'Matthias Ramahi'
const aboutImageDimensions = aboutImage.includes('mpissxxj-portrait')
  ? { width: 960, height: 1132 }
  : about?.image
    ? imageDimensions(about.image, 'card')
    : { width: 960, height: 1132 }

// --- „Weitere Leistungen" ---
const servicesGroup = doc?.homeServices
const servicesHeadline = hasText(servicesGroup?.headline) ? servicesGroup!.headline! : ''
const servicesEmphasis = servicesGroup?.headlineEmphasis || ''
const servicesIntro = hasText(servicesGroup?.intro)
  ? servicesGroup!.intro!
  : blockParagraphs(doc, 'Weitere Leistungen', [
      'Für Projekte, die über die Fotografie hinausgehen - Druck, Großformat, Werbetechnik, Webdesign, Video, Sonderanfertigungen und Musik. Kuratiert, koordiniert, ein Ansprechpartner.',
    ])[0]
const cmsServices = (servicesGroup?.items || [])
  .filter((item) => hasText(item?.title))
  .map((item) => ({
    source: item,
    href: toRootRelativeHref(item.href) || '#',
    title: item.title || '',
    text: item.text || '',
  }))
const services = cmsServices.length ? cmsServices : fallbackServices

// --- „Journal" ---
const journalGroup = doc?.homeJournal
const journalHeadline = hasText(journalGroup?.headline) ? journalGroup!.headline! : ''
const journalEmphasis = journalGroup?.headlineEmphasis || ''
const journalIntro = hasText(journalGroup?.intro)
  ? journalGroup!.intro!
  : 'Notizen aus dem Netzwerk - Workflow, Material, Auftragsgeschichten. Lange Form, ruhig kuratiert.'
const cmsJournalCards = (journalGroup?.items || [])
  .filter((item) => item?.image)
  .map((item) => ({
    source: item,
    href: toRootRelativeHref(item.href) || '#',
    image: imageDisplayUrl(item.image, 'card', { allowOriginal: true }),
    dataSrcset: cmsSrcset(item.image),
    sizes: journalSizes,
    alt: imageAlt(item.image, item.title || ''),
    title: item.title || '',
    text: item.text || '',
    ...imageDimensions(item.image, 'card'),
  }))
const journalCards = cmsJournalCards.length ? cmsJournalCards : fallbackJournalCards
---
<AdoptedPageLayout
  legacyFile="index.html"
  current="home"
  doc={doc}
  ctaHref="#anfrage"
  preloadImages={[{ href: firstHeroSlide.image, fetchpriority: 'high' }]}
  noIndex={Boolean(preview)}
  liveCms
>
  {preview && (
    <PreviewToolbar
      collection={preview.collection}
      slug={preview.slug}
      status={preview.status}
      publishedHref={preview.publishedHref}
    />
  )}
  <main>
    <NativeShaderHero label="Intro" slides={heroSlides} sourceSlides={doc?.heroSlides || []} />

    <section class="statement sec-light" data-theme="light" aria-label="Haltung">
      <div class="section-inner">
        <div>
          {statementHeadline
            ? <h2 {...tinaAttrs(statement, 'headline')}>{statementHeadline}{statementEmphasis ? <Fragment> <em {...tinaAttrs(statement, 'headlineEmphasis')}>{statementEmphasis}</em></Fragment> : null}</h2>
            : <h2>Bilder, die einen Raum<br /><em>verändern</em>.</h2>}
        </div>
        <div class="body">
          <p class="lead" {...tinaAttrs(statement?.body?.[0], 'text')}>{statementParagraphs[0]}</p>
          {statementParagraphs[1] && <p {...tinaAttrs(statement?.body?.[1], 'text')}>{statementParagraphs[1]}</p>}
          <div class="actions">
            <a class="btn dark" href="/ueber-mich.html">Mehr über mich</a>
            <a class="btn" href="#chapters" style="color:var(--ink);border-color:var(--ink)">Bereiche ansehen</a>
          </div>
        </div>
      </div>
    </section>

    <section class="chapters sec-dark" id="chapters" data-theme="dark" aria-label="Fotografie">
      <div class="section-inner">
        <div class="chapters-head">
          {chaptersHeadline
            ? <h2 {...tinaAttrs(chaptersGroup, 'headline')}>{chaptersHeadline}{chaptersEmphasis ? <Fragment> <em {...tinaAttrs(chaptersGroup, 'headlineEmphasis')}>{chaptersEmphasis}</em></Fragment> : null}</h2>
            : <h2>Sechs Bereiche.<br />Eine <em>Linse</em>.</h2>}
          <p class="lead" {...tinaAttrs(chaptersGroup, 'intro')}>{chaptersIntro}</p>
        </div>
        <div class="chapter-grid">
          {chapters.map((chapter) => (
            <a class="chapter" href={chapter.href}>
              <div class="img">
                <img src={chapter.image} srcset={chapter.srcset} sizes={chapter.sizes} alt={chapter.alt} loading="lazy" width={chapter.width} height={chapter.height} decoding="async" {...tinaAttrs(editableSource(chapter), 'image')} />
              </div>
              <div class="head"><h3 {...tinaAttrs(editableSource(chapter), 'title')}>{chapter.title}</h3></div>
              <span class="meta"><span class="arr">Bereich ansehen →</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="pf-teaser sec-light" data-theme="light" aria-label="Portfolio">
      <div class="section-inner">
        <div class="pf-head">
          {selectedWorksHeadline
            ? <h2 {...tinaAttrs(selectedWorks, 'headline')}>{selectedWorksHeadline}{selectedWorksEmphasis ? <Fragment> <em {...tinaAttrs(selectedWorks, 'headlineEmphasis')}>{selectedWorksEmphasis}</em></Fragment> : null}</h2>
            : <h2>Ausgewählte<br /><em>Arbeiten</em>.</h2>}
          <p class="lead" {...tinaAttrs(selectedWorks, 'intro')}>{portfolioIntro}</p>
        </div>
        <div class="pf-marquee" id="pfMarquee">
          <div class="pf-row row-1">
            <div class="pf-track" id="pfTrack1"></div>
          </div>
          <div class="pf-row row-2">
            <div class="pf-track" id="pfTrack2"></div>
          </div>
        </div>
        <div class="pf-foot">
          <a class="btn dark" href="/portfolio.html">Vollständiges Portfolio →</a>
        </div>
      </div>
    </section>

    <section class="about sec-dark" data-theme="dark" aria-label="Über mich">
      <div class="section-inner">
        <div class="about-img">
          <img src={aboutImage} srcset={resolvedAboutImageSrcset} sizes={aboutSizes} alt={aboutImageAlt} loading="lazy" width={aboutImageDimensions.width} height={aboutImageDimensions.height} decoding="async" {...tinaAttrs(about, 'image')} />
        </div>
        <div class="about-copy">
          <p class="kicker" {...tinaAttrs(about, 'kicker')}>{aboutKicker}</p>
          {aboutHeadline
            ? <h2 {...tinaAttrs(about, 'headline')}>{aboutHeadline}{aboutEmphasis ? <Fragment> <em {...tinaAttrs(about, 'headlineEmphasis')}>{aboutEmphasis}</em></Fragment> : null}</h2>
            : <h2>Hinter der<br /><em>Kamera</em>.</h2>}
          <p class="lead" {...tinaAttrs(about?.body?.[0], 'text')}>{aboutParagraphs[0]}</p>
          {aboutParagraphs[1] && <p {...tinaAttrs(about?.body?.[1], 'text')}>{aboutParagraphs[1]}</p>}
          <div class="actions">
            <a class="btn primary" href="/ueber-mich.html">Mehr über mich</a>
            <a class="btn" href="#anfrage" style="color:#f3f5ef;border-color:rgba(243,245,239,.4)">Projekt anfragen</a>
          </div>
        </div>
      </div>
    </section>

    <section class="services-sec sec-light" data-theme="light" aria-label="Weitere Dienstleistungen">
      <div class="section-inner">
        <div class="services-head">
          {servicesHeadline
            ? <h2 {...tinaAttrs(servicesGroup, 'headline')}>{servicesHeadline}{servicesEmphasis ? <Fragment> <em {...tinaAttrs(servicesGroup, 'headlineEmphasis')}>{servicesEmphasis}</em></Fragment> : null}</h2>
            : <h2>Weitere Leistungen<br /><em>im&nbsp;Überblick</em>.</h2>}
          <p class="lead" {...tinaAttrs(servicesGroup, 'intro')}>{servicesIntro}</p>
        </div>
        <div class="services-list">
          {services.map((service) => (
            <a class="service-row" href={service.href}>
              <h3 {...tinaAttrs(editableSource(service), 'title')}>{service.title}</h3><p {...tinaAttrs(editableSource(service), 'text')}>{service.text}</p><span class="arr">Detail →</span>
            </a>
          ))}
        </div>
        <div style="margin-top:32px;display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap;align-items:center">
          <a class="btn dark" href="/leistungen.html">Alle Leistungen</a>
        </div>
      </div>
    </section>

    <section class="blog-sec sec-dark" data-theme="dark" aria-label="Journal">
      <div class="section-inner">
        <div class="blog-head">
          {journalHeadline
            ? <h2 {...tinaAttrs(journalGroup, 'headline')}>{journalHeadline}{journalEmphasis ? <Fragment> <em {...tinaAttrs(journalGroup, 'headlineEmphasis')}>{journalEmphasis}</em></Fragment> : null}</h2>
            : <h2>Journal.</h2>}
          <p class="lead" {...tinaAttrs(journalGroup, 'intro')}>{journalIntro}</p>
        </div>
        <div class="blog-grid">
          {journalCards.map((post) => (
            <a class="post" href={post.href}>
              <div class="pimg">
                <img
                  src={post.image}
                  srcset={post.dataSrcset}
                  sizes={post.sizes}
                  alt={post.alt}
                  loading="lazy"
                  width={post.width}
                  height={post.height}
                  decoding="async"
                  {...tinaAttrs(editableSource(post), 'image')}
                />
              </div>
              <h3 {...tinaAttrs(editableSource(post), 'title')}>{post.title}</h3>
              <p {...tinaAttrs(editableSource(post), 'text')}>{post.text}</p>
              <span class="read">Lesen →</span>
            </a>
          ))}
        </div>
        <div style="margin-top:36px;display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap;align-items:center">
          <a class="btn" style="color:#f3f5ef;border-color:rgba(243,245,239,.4)" href="/blog.html">Alle Beiträge</a>
        </div>
      </div>
    </section>

    <NativeReviews theme="light" />

    <section
      id="anfrage"
      data-contact-section
      data-theme="light"
      data-contact-subject="Projektanfrage"
      data-contact-headline="Projekt <em>anfragen.</em>"
      data-contact-lead="Erzähl kurz, worum es geht: Motiv, Ort, Zeitrahmen, Nutzung. Ich antworte persönlich und sortiere mit dir den nächsten sinnvollen Schritt."
    />
  </main>

  <div class="lb" id="lightbox" role="dialog" aria-modal="true" aria-label="Bildvorschau" aria-hidden="true">
    <div class="lb-stage">
      <button class="lb-close" id="lbClose" type="button" aria-label="Schließen">×</button>
      <button class="lb-prev" id="lbPrev" type="button" aria-label="Vorheriges Bild">‹</button>
      <img class="lb-img" id="lbImg" alt="Vergrößerte Portfolioansicht" decoding="async" />
      <button class="lb-next" id="lbNext" type="button" aria-label="Nächstes Bild">›</button>
      <span class="lb-counter" id="lbCounter"></span>
    </div>
  </div>
</AdoptedPageLayout>
