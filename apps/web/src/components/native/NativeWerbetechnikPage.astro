---
import AdoptedPageLayout from '../../layouts/AdoptedPageLayout.astro'
import { getBySlug, type PayloadDoc } from '../../lib/payload'

const legacyFile = 'werbetechnik-duesseldorf.html'
const providedDoc = Astro.props.doc as PayloadDoc | undefined
const doc = providedDoc || (await getBySlug('service-pages', 'werbetechnik-duesseldorf', { depth: 2 }))

// Meta-Description explizit setzen: die Prod-CMS-doc.seo.description trägt noch die alte
// Auto-/Schilder-Beschreibung und hätte sonst Vorrang vor der Chrome-Description.
const metaDescription =
  'Werbetechnik in Düsseldorf: Schaufenster, Pop-ups, Brand-Booths, Promotionflächen und LED-Lichtwerbung — Markenerlebnisse seit 35 Jahren, mit erfahrenen Partnerwerkstätten.'

// Markenerlebnisse — kuratierte Arbeits-Galerie. 6 Bilder => sauberer Abschluss in
// 2 Spalten (mobil) wie in 3 Spalten (desktop), kein Einzelbild als Rest. Caption = N°-Index.
const works = [
  { image: '/assets/services/werbetechnik/dior.webp', alt: 'Schaufenster-Installation für eine Premium-Marke', w: 400, h: 271 },
  { image: '/assets/services/werbetechnik/byredo.webp', alt: 'Schaufenster mit Skulptur-Display', w: 400, h: 271 },
  { image: '/assets/services/werbetechnik/montblanc-booth.webp', alt: 'Brand-Booth mit beleuchteter Struktur', w: 400, h: 271 },
  { image: '/assets/services/werbetechnik/diptyque.webp', alt: 'Pop-up Display mit Produktinszenierung', w: 400, h: 271 },
  { image: '/assets/services/werbetechnik/riani.webp', alt: 'Brand Space mit großformatigem Schriftzug', w: 400, h: 258 },
  { image: '/assets/services/werbetechnik/pedestals.webp', alt: 'Brand-Booth mit Podest-Landschaft', w: 400, h: 258 },
]

// Ablauf — drei verbundene Stationen vom Entwurf bis zum fertigen Aufbau.
const flowSteps = [
  { number: '01', title: 'Vorlauf.', body: 'Visualisierung am Foto der Fläche, des Schaufensters oder des Standorts — entschieden wird am Bild, nicht erst am fertigen Aufbau.' },
  { number: '02', title: 'Material.', body: 'Folien, aber genauso dreidimensionale Aufbauten, Displays und Sonderanfertigungen — Materialwahl und -check passend zu Auftritt und Standort.' },
  { number: '03', title: 'Montage.', body: 'Aufbau und Vor-Ort-Montage im Rheinland und darüber hinaus — sauber abgestimmt, mit Endabnahme an der fertigen Fläche.' },
]

// Hero = der Landing-Page-Shader-Hero (WebGL/Ken-Burns/Lens-Cursor), aber mit
// Werbetechnik-Bild, -Texten und dem oxidierten Werbetechnik-Rot. Die Optik kommt
// aus assets/native-werbetechnik.css (Hero-Block), die Bewegung aus
// assets/native-home.js (gated nur auf #hero-shader).
const heroImage = '/assets/services/Catoir_Ramahi-1-32-768x512-1.webp'
const heroSlides = [
  {
    image: heroImage,
    titleLines: ['Werbe', 'technik'],
    lead: 'Schaufenster, Pop-ups, Brand-Booths und Promotionflächen — physische Markenerlebnisse, die im Stadtraum auffallen. Seit 35 Jahren, in Düsseldorf und weit darüber hinaus.',
    primaryHref: '#anfrage',
    primaryLabel: 'Werbetechnik anfragen',
    secondaryHref: '#arbeiten',
    secondaryLabel: 'Arbeiten ansehen',
  },
]
const heroSlidesJson = JSON.stringify(heroSlides)
---
<AdoptedPageLayout legacyFile={legacyFile} current="leistungen" doc={doc} description={metaDescription}>
  <main>
    <section class="hero" data-theme="dark" data-header-theme="dark" aria-label="Werbetechnik Düsseldorf" style={`background-image:url('${heroImage}')`}>
      <canvas id="hero-shader" aria-hidden="true" data-imgs={heroImage} data-slides={heroSlidesJson}></canvas>
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-aperture" aria-hidden="true"></div>
      <div class="hero-grid">
        <div class="hero-stage">
          <h1 class="hero-title" id="hero-title" data-text-idx="0">
            <span class="line"><span class="word">Werbe</span></span>
            <span class="line"><span class="word">technik.</span></span>
          </h1>
          <p class="hero-lead" id="hero-lead">Schaufenster, Pop-ups, Brand-Booths und Promotionflächen — physische Markenerlebnisse, die im Stadtraum auffallen. Seit 35 Jahren, in Düsseldorf und weit darüber hinaus.</p>
          <div class="hero-actions" aria-label="Direkte Aktionen">
            <a class="btn dark" href="#anfrage" data-hero-primary>Werbetechnik anfragen</a>
            <a class="btn" href="#arbeiten" data-hero-secondary>Arbeiten ansehen</a>
          </div>
        </div>
      </div>
      <div class="hero-cursor" id="hero-cursor" aria-hidden="true"><span class="ring"></span></div>
    </section>

    <section class="wt-work" id="arbeiten" data-header-theme="dark" aria-label="Markenerlebnisse">
      <div class="wt-work__inner">
        <div class="wt-work__head">
          <div>
            <p class="sp-eyebrow">Markenerlebnisse · seit 35 Jahren</p>
            <h2 class="wt-work__title">Keine Bühne. <em>Echte Wirkung.</em></h2>
          </div>
          <p class="wt-work__lead">
            Seit 35 Jahren erwecken wir Schaufenster, Pop-ups, Brand-Booths und Promotionflächen zum Leben — mit Gespür für die
            <b>DNA jeder Marke</b> und das Tempo der Branche. Aus klugen Ideen, einem Blick fürs Detail und erprobtem Handwerk
            entstehen Markenerlebnisse, die echt wirken und im Kopf bleiben. Es geht um die Optik — genauso um Funktion, Machbarkeit
            und die Wirkung beim Kunden.
          </p>
        </div>
        <div class="wt-work__grid">
          {works.map((work, i) => (
            <figure class="wt-figure">
              <div class="wt-figure__img">
                <img
                  src={work.image}
                  alt={work.alt}
                  width={work.w}
                  height={work.h}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <figcaption class="wt-figure__cap"><b>N° {String(i + 1).padStart(2, '0')}</b></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="wt-flow" data-header-theme="light" aria-label="Ablauf">
      <div class="wt-flow__inner">
        <div class="wt-flow__head">
          <div>
            <p class="sp-eyebrow">Ablauf</p>
            <h2 class="wt-flow__title">Vom Foto auf die <em>Fläche.</em></h2>
          </div>
          <p class="wt-flow__lead">
            Ein Markenauftritt wirkt nur, wenn alles sitzt. Vom ersten Entwurf bis zum Aufbau vor Ort: Visualisierung, Materialwahl und
            präzise Montage — Folie genauso wie dreidimensionale Sonderanfertigungen.
          </p>
        </div>
        <ol class="wt-flow__track" role="list">
          {flowSteps.map((step) => (
            <li class="wt-flow__step">
              <p class="wt-flow__step-num">Schritt {step.number}</p>
              <h3 class="wt-flow__step-title">{step.title}</h3>
              <p class="wt-flow__step-body">{step.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="sp-cta" data-header-theme="light" aria-label="Anfrage">
      <div class="sp-cta__inner">
        <h2 class="sp-cta__head">Bereit für ein <em>Werbetechnik-Briefing.</em></h2>
        <a class="sp-cta__btn" href="#anfrage">Projekt anfragen →</a>
      </div>
    </section>

    <section
      id="anfrage"
      data-contact-section
      data-contact-subject="Werbetechnik-Anfrage — Matthias Ramahi"
      data-contact-headline="Werbetechnik anfragen."
      data-contact-lead="Schreibe kurz, welche Fläche, welcher Auftritt oder welches Pop-up geplant ist. Hilfreich: Foto der Fläche, Marke oder Motiv und ein grober Zeitraum."
      data-header-theme="dark"
      aria-label="Anfrage"
    />
  </main>
</AdoptedPageLayout>
