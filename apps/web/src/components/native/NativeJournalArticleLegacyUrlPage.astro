---
import AdoptedPageLayout from '../../layouts/AdoptedPageLayout.astro'
import ContactSlot from '../ContactSlot.astro'
import GooglePreferredSource from './GooglePreferredSource.astro'
import { localResponsiveImage } from '../../data/localResponsiveThumbs'
import {
  getRelatedJournalArticles,
  isJournalArticlePublic,
  journalClusterProfiles,
  type JournalArticleBlock,
  journalArticleByLegacyFile,
} from '../../lib/journalArticleContent'
import { getLegacyRedirectTarget } from '../../lib/adoptedRoutes'
import { versionStaticAssetUrl } from '../../lib/cache'
import { renderJournalBodyHtml } from '../../lib/journalMarkdown'
import { imageDimensions, imageDisplayUrl, toAbsoluteSiteUrl, toDisplayAssetUrl, toRootRelativeHref } from '../../lib/payload'
import { breadcrumbJsonLd, faqJsonLd, type JsonLd } from '../../lib/seo'
import { journalIndexPath, journalTopics } from '../../lib/journalIndexRoutes'
import { journalStageImage } from '../../lib/journalStageImage'

type Props = { legacyFile: string }

const { legacyFile } = Astro.props as Props
const article = journalArticleByLegacyFile[legacyFile]

if (!article || !isJournalArticlePublic(article)) return new Response('Not found', { status: 404 })

const resolveCanonicalHref = (href?: string) => {
  const rootHref = toRootRelativeHref(href || 'blog.html')
  if (!rootHref || rootHref === '/' || rootHref.startsWith('#') || /^(?:https?:|mailto:|tel:)/i.test(rootHref)) {
    return rootHref || '/blog.html'
  }
  const [pathAndQuery, hash = ''] = rootHref.split('#')
  const [rawPath, query = ''] = pathAndQuery.split('?')
  let current = rawPath.replace(/^\/+/, '').toLowerCase()
  let pathname = rawPath
  const seen = new Set<string>([current])
  for (let hop = 0; hop < 4; hop += 1) {
    if (!current || current.includes('/')) break
    const target = getLegacyRedirectTarget(current)
    if (target === null) break
    if (target === '') {
      pathname = '/'
      break
    }
    const next = target.replace(/^\/+/, '')
    pathname = `/${next}`
    const nextLower = next.toLowerCase()
    if (seen.has(nextLower)) break
    seen.add(nextLower)
    current = nextLower
  }
  return `${pathname || '/'}${query ? `?${query}` : ''}${hash ? `#${hash}` : ''}`
}

const articleHref = (href?: string) => resolveCanonicalHref(href || 'blog.html')
const relatedArticles = getRelatedJournalArticles(article, 3)
const plainTitle = article.title.replace(/<[^>]+>/g, '')
const canonicalUrl = `/${article.legacyFile}`
const textBlocks = article.blocks.filter(
  (block): block is Extract<JournalArticleBlock, { _template: 'textBlock' }> => block._template === 'textBlock',
)
const isQuickAnswerBlock = (block: Extract<JournalArticleBlock, { _template: 'textBlock' }>) =>
  block.style === 'summary' ||
  (block.style === 'bridge' && /^(kurzantwort|auf einen blick)\b/i.test((block.headline || '').trim()))
const slugifyBlockHeading = (headline: string, index: number) =>
  headline
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '') || `abschnitt-${index + 1}`

const usedSectionIds = new Set<string>()
const sectionIdByBlockIndex = new Map<number, string>()
const tocEntries: Array<{ id: string; label: string }> = []
article.blocks.forEach((block, index) => {
  if (block._template !== 'textBlock' || !block.headline || block.style === 'bridge' || isQuickAnswerBlock(block)) return
  const baseId = slugifyBlockHeading(block.headline, index)
  let uniqueId = baseId
  let suffix = 2
  while (usedSectionIds.has(uniqueId)) {
    uniqueId = `${baseId}-${suffix}`
    suffix += 1
  }
  usedSectionIds.add(uniqueId)
  sectionIdByBlockIndex.set(index, uniqueId)
  tocEntries.push({ id: uniqueId, label: block.headline })
})

const sidebarLinks = (() => {
  const seenHrefs = new Set<string>()
  const resolved: Array<{ href: string; label: string }> = []
  for (const link of article.links) {
    const href = articleHref(link.href)
    if (!href || seenHrefs.has(href)) continue
    seenHrefs.add(href)
    resolved.push({ href, label: link.label })
  }
  const commercialTarget = articleHref(article.commercialHref)
  if (commercialTarget && !seenHrefs.has(commercialTarget)) {
    resolved.unshift({ href: commercialTarget, label: `${article.category}-Fotografie` })
  }
  return resolved.slice(0, 3)
})()
const renderMarkdownBody = (body?: string) =>
  renderJournalBodyHtml(body, { resolveRedirectTarget: getLegacyRedirectTarget })
const faqBlocks = article.blocks.filter(
  (block): block is Extract<JournalArticleBlock, { _template: 'faqBlock' }> => block._template === 'faqBlock',
)
const faqItems = faqBlocks.flatMap((block) => block.items || [])
const breadcrumbTopicEntry = journalTopics.find((topic) => topic.filter === journalClusterProfiles[article.cluster].filter)
const breadcrumbTopic = breadcrumbTopicEntry ? [{ name: breadcrumbTopicEntry.label, url: journalIndexPath(breadcrumbTopicEntry) }] : []
const mergedFaq = [
  ...(article.faq || []),
  ...faqItems.filter((item) => !(article.faq || []).some((existing) => existing.question === item.question)),
]
const articleWordCount = [
  plainTitle,
  article.description,
  ...textBlocks.flatMap((block) => [block.headline || '', block.body || '']),
  ...faqItems.flatMap((item) => [item.question || '', item.answer || '']),
]
  .join(' ')
  .replace(/\s+/g, ' ')
  .trim()
  .split(' ')
  .filter(Boolean).length

const previewMap: Record<string, { height: number; image: string; width: number }> = {
  'assets/optimized/assets-photos-automobil-neon-1920.webp': { image: 'assets/optimized/assets-photos-automobil-neon-960.webp', width: 960, height: 640 },
  'assets/optimized/assets-photos-automobil-sunset-1920.webp': { image: 'assets/optimized/assets-photos-automobil-sunset-960.webp', width: 960, height: 640 },
  'assets/optimized/assets-photos-landschaft-1920.webp': { image: 'assets/optimized/assets-photos-landschaft-720.webp', width: 720, height: 1080 },
  'assets/optimized/assets-photos-motorrad-1920.webp': { image: 'assets/optimized/assets-photos-motorrad-720.webp', width: 720, height: 1080 },
  'assets/optimized/assets-photos-oldtimer-stage-1920.webp': { image: 'assets/optimized/assets-photos-oldtimer-stage-960.webp', width: 960, height: 640 },
  'assets/photos/portrait-warm.webp': { image: 'assets/optimized/assets-photos-portrait-warm-720.webp', width: 720, height: 1152 },
}

function imagePreview(image?: string) {
  const normalized = (image || '').replace(/^\//, '')
  const preview = previewMap[normalized]
  const raw = preview ? `/${preview.image}` : `/${normalized}`
  const resolvedUrl = imageDisplayUrl(raw, 'card', { allowOriginal: true })
  const dims = imageDimensions(`/${normalized}`, 'card')
  const portrait = /portrait|khan|levi|dsc6968|dsc9301|landschaft/i.test(normalized)
  const width = preview?.width || dims.width || (portrait ? 1200 : 1600)
  const height = preview?.height || dims.height || (portrait ? 1600 : 1067)
  const local = !/^https?:\/\//i.test(normalized) ? localResponsiveImage(`/${normalized}`, width, height) : null
  return {
    image: normalized,
    url: local?.srcset ? local.src : resolvedUrl,
    mobile: local?.srcset ? local.mobile : resolvedUrl,
    srcset: local?.srcset || '',
    full: local?.full || imageDisplayUrl(`/${normalized}`, 'wide', { allowOriginal: true }),
    width,
    height,
  }
}

const displayHero = imagePreview(article.heroImage)
// Das Titelbild läuft jetzt randlos und scharf über die volle Breite, daher
// die grosse Variante statt der Karten-Vorschau.
const heroWideUrl = imageDisplayUrl(article.heroImage, 'wide', { allowOriginal: true }) || displayHero.url
const heroLocalResponsive = article.heroImage && !/^https?:\/\//i.test(article.heroImage) ? localResponsiveImage(article.heroImage, displayHero.width, displayHero.height) : null
const heroSrcset = heroLocalResponsive?.srcset ? `${heroLocalResponsive.srcset}, ${versionStaticAssetUrl(heroWideUrl)} 1920w` : ''
const heroWideDims = imageDimensions(article.heroImage, 'wide')
// Bühnenbild bis 1920 px; Format bestimmt das Layout (Quer: volle Breite unter
// dem Titel, Hoch: Bild rechts neben dem Titel statt hartem 16:9-Beschnitt).
const heroStage = journalStageImage(article.heroImage)
const heroSrc = heroStage?.src || versionStaticAssetUrl(heroWideUrl)
const heroStageSrcset = heroStage?.srcset || heroSrcset
const heroWidth = heroStage?.width || displayHero.width
const heroHeight = heroStage?.height || displayHero.height
const heroSizes = heroHeight > heroWidth ? '(max-width: 959px) calc(100vw - 32px), 40vw' : '(max-width: 1260px) calc(100vw - 32px), 1180px'
const heroPreload = heroStageSrcset
  ? { href: heroSrc, imagesrcset: heroStageSrcset, imagesizes: heroSizes, fetchpriority: 'high' as const }
  : { href: heroSrc, fetchpriority: 'high' as const }
const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Startseite', url: '/' },
    { name: 'Journal', url: '/blog.html' },
    ...breadcrumbTopic,
    { name: plainTitle, url: canonicalUrl },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${toAbsoluteSiteUrl(canonicalUrl)}#article`,
    mainEntityOfPage: { '@type': 'WebPage', '@id': toAbsoluteSiteUrl(canonicalUrl) },
    headline: plainTitle,
    description: article.seoDescription,
    image: {
      '@type': 'ImageObject',
      url: toAbsoluteSiteUrl(heroWideUrl),
      ...(heroWideDims.width ? { width: heroWideDims.width } : {}),
      ...(heroWideDims.height ? { height: heroWideDims.height } : {}),
    },
    datePublished: article.publishedAt || `${article.dateTime}T09:00:00+02:00`,
    dateModified: article.updatedAt || article.publishedAt || `${article.dateTime}T09:00:00+02:00`,
    inLanguage: 'de-DE',
    wordCount: articleWordCount,
    articleSection: article.category,
    keywords: article.tags,
    author: { '@id': `${toAbsoluteSiteUrl('/')}#person` },
    publisher: { '@id': `${toAbsoluteSiteUrl('/')}#local-business` },
  },
  faqJsonLd(mergedFaq),
].filter(Boolean) as JsonLd[]
const authorImage = toDisplayAssetUrl('/uploads/payload/mpissxxj-portfolio_webp_full_063-2-360x360.webp')
const isPortraitHero = heroHeight > heroWidth
const clusterProfile = journalClusterProfiles[article.cluster]
// Kategorie verlinkt auf die crawlbare Themen-Uebersicht statt auf einen
// JS-Filter mit Query-Parameter.
const articleTopic = journalTopics.find((topic) => topic.filter === clusterProfile.filter)
const topicHref = journalIndexPath(articleTopic)
const topicLabel = articleTopic?.label || article.category
const contactSubjectByCluster: Record<string, string> = {
  automotive: 'Automobil Fotografie Anfrage',
  'sports-car': 'Sportwagen Fotografie Anfrage',
  'classic-car': 'Oldtimer Fotografie Anfrage',
  motorcycle: 'Motorrad Fotografie Anfrage',
  portrait: 'Portrait Fotografie Anfrage',
  'landscape-print': 'Fine-Art-Print Anfrage',
  process: 'Shooting Anfrage',
}
const articleContactSubject = contactSubjectByCluster[article.cluster] || 'Shooting Anfrage'
const articleContactHeadline = `${topicLabel} <em>anfragen.</em>`
const articleContactLead = `Du planst ein Shooting oder Projekt im Bereich ${topicLabel}? Schreibe kurz Motiv, Ort und gewünschten Zeitraum. Dann klären wir Licht, Ablauf und Ausgabe direkt.`
const dedupeBlockLinks = (links?: Array<{ href?: string; label?: string }>) => {
  const deduped: Array<{ href: string; label: string }> = []
  const seen = new Set<string>()
  for (const link of links || []) {
    if (!link.href || !link.label) continue
    const resolved = articleHref(link.href)
    if (!resolved || seen.has(resolved)) continue
    seen.add(resolved)
    deduped.push({ href: resolved, label: link.label })
  }
  return deduped
}
const normalizeText = (value = '') => value.replace(/\s+/g, ' ').trim()
const paragraphs = (body?: string) => (body || '').split(/\n\s*\n/).map((value) => value.trim()).filter(Boolean)

Astro.response.headers.set('x-cms-page-kind', 'journal-tina-source')
---
<AdoptedPageLayout
  legacyFile={legacyFile}
  title={article.seoTitle || `${plainTitle} | Matthias Ramahi`}
  description={article.seoDescription}
  canonicalUrl={canonicalUrl}
  current="blog"
  ogImage={displayHero.url}
  ogType="article"
  preloadImages={[heroPreload]}
  stylesheets={['/assets/journal-support.css']}
  jsonLd={jsonLd}
  bodyClass="has-mr-footer journal-article-page"
  mobileCta={{
    secondaryHref: sidebarLinks[0]?.href || articleHref(article.commercialHref || '/autofotografie.html'),
    secondaryLabel: 'Leistung',
    href: '#anfrage',
    label: 'Shooting anfragen',
  }}
>
  <main>
    <article class="journal-support journal-editorial">
      <header class:list={['ahero', { 'ahero--portrait': isPortraitHero }]} data-header-theme="dark">
        <div class="ahero__inner">
          <div class="ahero__copy">
            <div class="ahero__top">
              <nav class="ahero__crumbs" aria-label="Breadcrumb">
                <a href="/">Startseite</a>
                <span aria-hidden="true">/</span>
                <a href="/blog.html">Journal</a>
                <span aria-hidden="true">/</span>
                <a href={topicHref}>{topicLabel}</a>
              </nav>
            </div>

            <h1 class="ahero__title">{plainTitle}</h1>
            <p class="ahero__lead">{article.description}</p>

            <div class="ahero__meta">
              <a class="ahero__author" href="/ueber-mich.html">
                <img src={authorImage} alt="" width="40" height="40" loading="eager" decoding="async" />
                <span>Matthias Ramahi</span>
              </a>
              <span class="ahero__facts">
                <time datetime={article.dateTime}>{article.dateLabel}</time>
                <span aria-hidden="true">·</span>
                <span>{article.minutes} Lesezeit</span>
              </span>
            </div>
          </div>

          <figure class="ahero__frame">
            <img
              src={heroSrc}
              srcset={heroStageSrcset || undefined}
              sizes={heroStageSrcset ? heroSizes : undefined}
              alt={article.heroImageAlt}
              width={heroWidth}
              height={heroHeight}
              fetchpriority="high"
              loading="eager"
              decoding="async"
            />
          </figure>
        </div>
      </header>

      <div class="article-body" data-header-theme="light">
        <div class="article-grid">
          <aside class="article-toc" aria-label="Artikelübersicht">
            {tocEntries.length > 0 && (
              <div class="article-toc__group">
                <strong>Im Beitrag</strong>
                <nav class="article-toc__links" aria-label="Inhaltsverzeichnis">
                  {tocEntries.map((entry) => (
                    <a href={`#${entry.id}`}>{entry.label}</a>
                  ))}
                </nav>
              </div>
            )}
            {sidebarLinks.length > 0 && (
              <div class="article-toc__group">
                <strong class="article-aside__label">Passende Leistung</strong>
                <nav class="article-toc__links" aria-label="Passende Leistungen">
                  {sidebarLinks.map((link) => <a href={link.href}>{link.label}</a>)}
                </nav>
              </div>
            )}
          </aside>

          <div class="journal-prose">
            {article.blocks.map((block, index) => {
              if (block._template === 'textBlock') {
                if (isQuickAnswerBlock(block)) {
                  const quickLabel = block.headline || block.eyebrow || 'Kurzantwort'
                  return (
                    <aside class="journal-quick-answer" aria-label={quickLabel}>
                      <p class="kicker">{block.eyebrow || 'Kurzantwort'}</p>
                      {block.headline && <h2>{block.headline}</h2>}
                      <div class="journal-quick-answer__body" set:html={renderMarkdownBody(block.body)} />
                    </aside>
                  )
                }
                const body = paragraphs(block.body)
                if (!block.headline) {
                  // Der Lead steht bereits im Hero; wortgleiche Absätze nicht doppeln.
                  const opening = body.filter((paragraph) => normalizeText(paragraph) !== normalizeText(article.description))
                  if (opening.length === 0) return null
                  return <div class="journal-prose__opening" set:html={renderMarkdownBody(opening.join('\n\n'))} />
                }
                if (block.style === 'bridge') {
                  return (
                    <section class="journal-bridge">
                      <h3>{block.headline}</h3>
                      <Fragment set:html={renderMarkdownBody(block.body)} />
                    </section>
                  )
                }
                return (
                  <section id={sectionIdByBlockIndex.get(index) || slugifyBlockHeading(block.headline, index)} class="journal-section">
                    {block.eyebrow && <p class="kicker">{block.eyebrow}</p>}
                    <h2>{block.headline}</h2>
                    <Fragment set:html={renderMarkdownBody(block.body)} />
                  </section>
                )
              }

              if (block._template === 'imageSequence') {
                const images = (block.items || []).filter((item) => Boolean(item.image))
                if (images.length === 0) return null
                return (
                  <figure class={`journal-image-sequence journal-image-sequence--${block.layout || 'editorial'}`} data-site-lightbox-gallery>
                    <div class="journal-image-sequence__grid">
                      {images.map((item) => {
                        const preview = imagePreview(item.image)
                        return (
                          <button type="button" data-full={preview.full}>
                            <img src={preview.mobile} srcset={preview.srcset || undefined} sizes={preview.srcset ? '(max-width: 900px) 94vw, 45vw' : undefined} alt={item.caption || article.heroImageAlt} width={preview.width} height={preview.height} loading="lazy" decoding="async" />
                          </button>
                        )
                      })}
                    </div>
                    {block.headline && <figcaption>{block.headline}</figcaption>}
                  </figure>
                )
              }

              if (block._template === 'quoteBlock') {
                return (
                  <blockquote class="journal-quote">
                    <p>{block.quote}</p>
                    {block.attribution && <cite>{block.attribution}</cite>}
                  </blockquote>
                )
              }

              if (block._template === 'linkList') {
                const dedupedLinks = dedupeBlockLinks(block.links)
                if (dedupedLinks.length === 0) return null
                return (
                  <nav class="journal-link-list" aria-label={block.headline || 'Weiterlesen'}>
                    {block.headline && <strong>{block.headline}</strong>}
                    {dedupedLinks.map((link) => <a href={link.href}>{link.label}</a>)}
                  </nav>
                )
              }

              if (block._template === 'ctaBlock') {
                return (
                  <aside class="journal-inline-cta">
                    <h2>{block.headline}</h2>
                    {block.text && <p>{block.text}</p>}
                    <a href="#anfrage">{block.buttonLabel || 'Projekt anfragen'}</a>
                  </aside>
                )
              }

              return null
            })}
          </div>
        </div>
      </div>

      {faqBlocks.length > 0 && (
        <section class="faq" aria-label="Häufige Fragen" data-header-theme="light">
          <h2>{faqBlocks[0]?.headline || 'Kurze Fragen.'}</h2>
          <div class="faq-grid">
            {faqItems.map((item, index) => (
              <details class="faq-item" open={index === 0}>
                <summary>
                  <span class="faq-item__question">{item.question}</span>
                  <span class="faq-item__icon" aria-hidden="true"></span>
                </summary>
                <div class="faq-item__answer"><p>{item.answer}</p></div>
              </details>
            ))}
          </div>
        </section>
      )}

      <GooglePreferredSource theme="light" />

      <aside class="journal-author" aria-label="Über den Autor" data-header-theme="light">
        <img src={authorImage} alt="Matthias Ramahi" width="96" height="96" loading="lazy" decoding="async" />
        <div>
          <p class="journal-author__name">Matthias Ramahi</p>
          <p class="journal-author__text">Fotograf aus Erkrath bei Düsseldorf für Automobil, Sportwagen, Oldtimer, Motorrad, Portrait und Landschaft. Die Beiträge im Journal entstehen aus eigenen Produktionen.</p>
          <p class="journal-author__links">
            <a href="/ueber-mich.html">Über mich</a>
            <a href={topicHref}>Mehr zu {topicLabel}</a>
            {sidebarLinks[0] && <a href={sidebarLinks[0].href}>{sidebarLinks[0].label}</a>}
          </p>
        </div>
      </aside>

      {relatedArticles.length > 0 && (
        <section class="related journal-related" aria-label="Verwandte Beiträge" data-header-theme="light">
          <h2>Passend zum{' '}<em>Thema.</em></h2>
          <div class="journal-related__grid">
            {relatedArticles.map((related) => {
              const preview = imagePreview(related.heroImage)
              return (
                <a href={articleHref(related.legacyFile)}>
                  <img src={preview.mobile} srcset={preview.srcset || undefined} sizes={preview.srcset ? '(max-width: 900px) 94vw, 32vw' : undefined} alt={related.heroImageAlt} width={preview.width} height={preview.height} loading="lazy" decoding="async" />
                  <span>{related.category} · {related.minutes}</span>
                  <strong>{related.title.replace(/<[^>]+>/g, '')}</strong>
                </a>
              )
            })}
          </div>
        </section>
      )}
    </article>

    <ContactSlot
      id="anfrage"
      data-contact-section
      data-theme="light"
      data-contact-subject={articleContactSubject}
      data-contact-headline={articleContactHeadline}
      data-contact-lead={articleContactLead}
    />
  </main>
</AdoptedPageLayout>

<style is:global>
  /* Artikel-Kopf: gleiche Sprache wie der Journal-Index (.jhero).
     Querformat: Titel oben, Bild in voller Breite darunter (16:9).
     Hochformat: Bild rechts neben dem Titel (4:5), mobil darunter. */
  /* Kein Browser-Standardrand: Kopf und Header sitzen bündig am Rand. */
  body.journal-article-page {
    margin: 0;
  }
  body .journal-editorial .ahero {
    background: #020306;
    color: #f3f5ef;
    padding: clamp(112px, 10vw, 156px) clamp(16px, 5vw, 84px) clamp(48px, 5vw, 80px);
  }
  body .journal-editorial .ahero__inner {
    width: min(1180px, 100%);
    margin: 0 auto;
    display: grid;
    gap: clamp(28px, 3.4vw, 48px);
  }
  body .journal-editorial .ahero__copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
  }
  body .journal-editorial .ahero__crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    margin: 0;
    font: 500 12px/1.3 var(--mono) !important;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: rgba(243, 245, 239, .62);
  }
  body .journal-editorial .ahero__crumbs::before {
    content: "";
    flex: 0 0 auto;
    width: 22px;
    height: 1px;
    background: var(--red, #cf392e);
  }
  body .journal-editorial .ahero__crumbs a {
    transition: color .25s ease;
  }
  body .journal-editorial .ahero__crumbs a:hover,
  body .journal-editorial .ahero__crumbs a:focus-visible {
    color: #f3f5ef;
  }
  body .journal-editorial .ahero__crumbs a:last-of-type {
    color: #f3f5ef;
  }
  body .journal-editorial .ahero__title {
    margin: 0;
    max-width: 22ch;
    font-size: clamp(36px, 4.6vw, 72px);
    line-height: .96;
    color: #f3f5ef;
  }
  body .journal-editorial .ahero__lead {
    margin: 0;
    max-width: 62ch;
    color: rgba(243, 245, 239, .72);
    font-size: clamp(1.03125rem, .96rem + .24vw, 1.25rem) !important;
    line-height: 1.55;
  }
  body .journal-editorial .ahero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-top: 4px;
    padding-top: 18px;
    border-top: 1px solid rgba(243, 245, 239, .14);
  }
  body .journal-editorial .ahero__author {
    display: inline-flex;
