---
import AdoptedPageLayout from '../../layouts/AdoptedPageLayout.astro'
import {
  getRelatedJournalArticles,
  type JournalArticleBlock,
  journalArticleByLegacyFile,
} from '../../lib/journalArticleContent'
import { toAbsoluteSiteUrl, toRootRelativeHref } from '../../lib/payload'
import { breadcrumbJsonLd, faqJsonLd, type JsonLd } from '../../lib/seo'

type Props = { legacyFile: string }

const { legacyFile } = Astro.props as Props
const article = journalArticleByLegacyFile[legacyFile]

if (!article) return new Response('Not found', { status: 404 })

const articleHref = (href?: string) => toRootRelativeHref(href || 'blog.html')
const relatedArticles = getRelatedJournalArticles(article, 3)
const plainTitle = article.title.replace(/<[^>]+>/g, '')
const canonicalUrl = `/${article.legacyFile}`
const textBlocks = article.blocks.filter(
  (block): block is Extract<JournalArticleBlock, { _template: 'textBlock' }> => block._template === 'textBlock',
)
const faqBlocks = article.blocks.filter(
  (block): block is Extract<JournalArticleBlock, { _template: 'faqBlock' }> => block._template === 'faqBlock',
)
const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', url: '/' },
    { name: 'Journal', url: '/blog.html' },
    { name: plainTitle, url: canonicalUrl },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${toAbsoluteSiteUrl(canonicalUrl)}#article`,
    mainEntityOfPage: { '@type': 'WebPage', '@id': toAbsoluteSiteUrl(canonicalUrl) },
    headline: plainTitle,
    description: article.description,
    image: [toAbsoluteSiteUrl(article.heroImage)],
    datePublished: `${article.dateTime}T09:00:00+02:00`,
    dateModified: `${article.dateTime}T09:00:00+02:00`,
    inLanguage: 'de-DE',
    articleSection: article.category,
    keywords: article.tags,
    author: { '@id': `${toAbsoluteSiteUrl('/')}#person` },
    publisher: { '@id': `${toAbsoluteSiteUrl('/')}#local-business` },
  },
  faqJsonLd(article.faq),
].filter(Boolean) as JsonLd[]

const previewMap: Record<string, { height: number; image: string; width: number }> = {
  'assets/optimized/assets-photos-automobil-neon-1920.webp': { image: 'assets/optimized/assets-photos-automobil-neon-960.webp', width: 960, height: 640 },
  'assets/optimized/assets-photos-automobil-sunset-1920.webp': { image: 'assets/optimized/assets-photos-automobil-sunset-960.webp', width: 960, height: 640 },
  'assets/optimized/assets-photos-landschaft-1920.webp': { image: 'assets/optimized/assets-photos-landschaft-720.webp', width: 720, height: 1080 },
  'assets/optimized/assets-photos-motorrad-1920.webp': { image: 'assets/optimized/assets-photos-motorrad-720.webp', width: 720, height: 1080 },
  'assets/optimized/assets-photos-oldtimer-stage-1920.webp': { image: 'assets/optimized/assets-photos-oldtimer-stage-960.webp', width: 960, height: 640 },
  'assets/photos/portrait-warm.webp': { image: 'assets/optimized/assets-photos-portrait-warm-720.webp', width: 720, height: 1152 },
}

function imagePreview(image?: string) {
  const normalized = (image || '').replace(/^\//, '')
  if (previewMap[normalized]) return previewMap[normalized]
  const portrait = /portrait|khan|levi|dsc6968|dsc9301|landschaft/i.test(normalized)
  return { image: normalized, width: portrait ? 1200 : 1600, height: portrait ? 1600 : 1067 }
}

const displayHero = imagePreview(article.heroImage)
const heroStyle = `background-image:linear-gradient(180deg,rgba(2,3,6,.24),rgba(2,3,6,.91)),url('/${displayHero.image}')`
const paragraphs = (body?: string) => (body || '').split(/\n\s*\n/).map((value) => value.trim()).filter(Boolean)
const blockId = (headline: string, index: number) =>
  headline
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '') || `abschnitt-${index + 1}`

Astro.response.headers.set('x-cms-page-kind', 'journal-tina-source')
---
<AdoptedPageLayout
  legacyFile={legacyFile}
  title={article.seoTitle || `${plainTitle} | Matthias Ramahi`}
  description={article.description}
  canonicalUrl={canonicalUrl}
  current="blog"
  ogImage={article.heroImage}
  ogType="article"
  preloadImages={[`/${displayHero.image}`]}
  stylesheets={['/assets/journal-support.css']}
  jsonLd={jsonLd}
  bodyClass="has-mr-footer"
>
  <main>
    <article class="journal-support journal-editorial">
      <header class="article-hero" style={heroStyle} data-header-theme="dark">
        <div class="article-hero__inner">
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a><span>/</span><a href="/blog.html">Journal</a><span>/</span><span>{article.category}</span>
          </nav>
          <p class="kicker">{article.category} · {article.minutes}</p>
          <h1>{article.title}</h1>
          <p class="lead">{article.description}</p>
          <div class="meta">
            <a href="/ueber-mich.html">Matthias Ramahi</a>
            <time datetime={article.dateTime}>{article.dateLabel}</time>
          </div>
          {article.tags.length > 0 && (
            <ul class="journal-tags" aria-label="Beitragsthemen">
              {article.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          )}
        </div>
      </header>

      <div class="article-body" data-header-theme="light">
        <div class="article-grid">
          <aside aria-label="Artikelübersicht">
            {textBlocks.some((block) => block.headline && block.style !== 'bridge') && (
              <>
                <strong>Im Beitrag</strong>
                {textBlocks.filter((block) => block.headline && block.style !== 'bridge').map((block, index) => (
                  <a href={`#${blockId(block.headline || '', index)}`}>{block.headline}</a>
                ))}
              </>
            )}
            <strong class="article-aside__label">Passende Leistung</strong>
            {article.links.slice(0, 3).map((link) => <a href={articleHref(link.href)}>{link.label}</a>)}
          </aside>

          <div class="journal-prose">
            {article.blocks.map((block, index) => {
              if (block._template === 'textBlock') {
                const body = paragraphs(block.body)
                if (!block.headline) {
                  return <div class="journal-prose__opening">{body.map((paragraph) => <p>{paragraph}</p>)}</div>
                }
                if (block.style === 'bridge') {
                  return (
                    <section class="journal-bridge">
                      <h3>{block.headline}</h3>
                      {body.map((paragraph) => <p>{paragraph}</p>)}
                    </section>
                  )
                }
                return (
                  <section id={blockId(block.headline, index)} class={`journal-section journal-section--${index % 3}`}>
                    {block.eyebrow && <p class="kicker">{block.eyebrow}</p>}
                    <h2>{block.headline}</h2>
                    {body.map((paragraph) => <p>{paragraph}</p>)}
                  </section>
                )
              }

              if (block._template === 'imageSequence') {
                const images = block.items || []
                return (
                  <figure class={`journal-image-sequence journal-image-sequence--${block.layout || 'editorial'}`} data-site-lightbox-gallery>
                    <div class="journal-image-sequence__grid">
                      {images.map((item) => {
                        const preview = imagePreview(item.image)
                        return (
                          <button type="button" data-full={`/${(item.image || preview.image).replace(/^\//, '')}`}>
                            <img src={`/${preview.image}`} alt={item.caption || article.heroImageAlt} width={preview.width} height={preview.height} loading="lazy" decoding="async" />
                          </button>
                        )
                      })}
                    </div>
                    {block.headline && <figcaption>{block.headline}</figcaption>}
                  </figure>
                )
              }

              if (block._template === 'quoteBlock') {
                return (
                  <blockquote class="journal-quote">
                    <p>{block.quote}</p>
                    {block.attribution && <cite>{block.attribution}</cite>}
                  </blockquote>
                )
              }

              if (block._template === 'linkList') {
                return (
                  <nav class="journal-link-list" aria-label={block.headline || 'Weiterlesen'}>
                    {block.headline && <strong>{block.headline}</strong>}
                    {(block.links || []).map((link) => link.href && <a href={articleHref(link.href)}>{link.label}</a>)}
                  </nav>
                )
              }

              if (block._template === 'ctaBlock') {
                return (
                  <aside class="journal-inline-cta">
                    <h2>{block.headline}</h2>
                    {block.text && <p>{block.text}</p>}
                    <a href="/contact.html#anfrage">{block.buttonLabel || 'Projekt anfragen'}</a>
                  </aside>
                )
              }

              return null
            })}
          </div>
        </div>
      </div>

      {faqBlocks.length > 0 && (
        <section class="faq" aria-label="Häufige Fragen" data-header-theme="light">
          <h2>{faqBlocks[0]?.headline || 'Kurze Fragen.'}</h2>
          <div class="faq-grid">
            {faqBlocks.flatMap((block) => block.items || []).map((item) => (
              <article><h3>{item.question}</h3><p>{item.answer}</p></article>
            ))}
          </div>
        </section>
      )}

      <section class="related journal-related" aria-label="Verwandte Beiträge" data-header-theme="light">
        <h2>Passend zum Thema.</h2>
        <div class="journal-related__grid">
          {relatedArticles.map((related) => {
            const preview = imagePreview(related.heroImage)
            return (
              <a href={articleHref(related.legacyFile)}>
                <img src={`/${preview.image}`} alt={related.heroImageAlt} width={preview.width} height={preview.height} loading="lazy" decoding="async" />
                <span>{related.category}</span>
                <strong>{related.title}</strong>
              </a>
            )
          })}
        </div>
      </section>
    </article>
  </main>
</AdoptedPageLayout>
