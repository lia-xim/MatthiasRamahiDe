---
import AdoptedPageLayout from '../../layouts/AdoptedPageLayout.astro'
import NativeFamilyClusterLinks from './NativeFamilyClusterLinks.astro'
import NativeFamilyFaq from './NativeFamilyFaq.astro'
import PreviewToolbar from '../PreviewToolbar.astro'
import {
  localScopePhrase,
  nativeFamilyPageContext,
  type NativeFamilyPreviewState,
} from '../../lib/nativeFamilyPageContext'
import { keywordFocusCopyForSlug } from '../../lib/localSeoFamilyContent'
import { familyVisualSlots, getFamilyVisualSourceDoc } from '../../lib/localSeoFamilyVisuals'
import { getLegacyBackedDoc, type PayloadDoc } from '../../lib/payload'

type Props = {
  doc?: PayloadDoc | null
  legacyFile?: string
  preview?: NativeFamilyPreviewState
  visualDoc?: PayloadDoc | null
}

const defaultLegacyFile = 'motorrad-fotografie.html'
const props = Astro.props as Props
const { doc: providedDoc = undefined, legacyFile: providedLegacyFile, preview, visualDoc: providedVisualDoc = undefined } = props
const legacyFile = providedLegacyFile || defaultLegacyFile
const doc = providedDoc || (await getLegacyBackedDoc(legacyFile, { depth: 2 }))
const shouldUseCmsVisualDoc = import.meta.env.ASTRO_DISABLE_CMS_VISUAL_OVERRIDES !== 'true'
const visualDoc = Object.hasOwn(props, 'visualDoc')
  ? providedVisualDoc
  : shouldUseCmsVisualDoc
    ? await getFamilyVisualSourceDoc('motorrad', doc, legacyFile, defaultLegacyFile)
    : null
const pageContext = nativeFamilyPageContext({
  defaultLegacyFile,
  doc,
  family: 'motorrad',
  legacyFile,
  preview,
})
const { clusterHeading, clusterLinks, isKeywordPage, isParentPage, overviewHref, publishedHref, scope, serviceLabel } = pageContext
const keywordFocusCopy = keywordFocusCopyForSlug(legacyFile)
const faqItems = doc?.localFaq?.length
  ? doc.localFaq.map((entry) => ({ q: entry.question || '', a: entry.answer || '' })).filter((entry) => entry.q && entry.a)
  : keywordFocusCopy?.faq
const cmsText = (value: unknown) => (typeof value === 'string' ? value.trim() : '')
const cmsHeroLine2 = cmsText(doc?.heroLine2)
const cmsStatementBody = doc?.statement?.body?.map((entry) => cmsText(entry.text)).filter(Boolean) || []
const heroTitle = keywordFocusCopy?.heroTitle || 'Motorrad'
const heroSecondLine = cmsHeroLine2 || keywordFocusCopy?.heroEmphasis || (isParentPage || isKeywordPage ? 'Fotografie.' : `Fotografie ${scope.label}`)
const heroLabel = isParentPage || isKeywordPage ? 'Motorradfotografie' : `Motorradfotografie ${scope.label}`
const defaultHeroLead = isParentPage
  ? 'Motorradfotografie: Silhouette, Mechanik, Haltung, Detail und Fahrerbezug werden als kraftvolle Serie geplant — für Custom Bikes, Händler, Werkstätten und private Maschinen. Produktionen werden über Motiv, Nutzung, Reise, Lichtfenster und Output geplant; Düsseldorf bleibt der organisatorische Ausgangspunkt.'
  : isKeywordPage
    ? `${serviceLabel}: eigenständiger Einstieg in den Motorrad Fotografie-Cluster. Silhouette, Mechanik, Haltung, Detail und Fahrerbezug werden als kraftvolle Serie geplant - für Custom Bikes, Händler, Werkstätten und private Maschinen. Die Seite bleibt bewusst im Layout der übergeordneten Kategorie, setzt den Text aber auf diese konkrete Suchintention.`
    : `Motorradfotografie in ${scope.label}: Silhouette, Mechanik, Haltung, Detail und Fahrerbezug werden als kraftvolle Serie geplant - für Custom Bikes, Händler, Werkstätten und private Maschinen. ${localScopePhrase(scope)}`
const metaTitle = isParentPage
  ? 'Motorradfotografie - Matthias Ramahi'
  : isKeywordPage
    ? `${serviceLabel} | Matthias Ramahi`
    : `${serviceLabel} ${scope.label} | Matthias Ramahi`
const heroLead = keywordFocusCopy?.heroLead
  ? `${keywordFocusCopy.heroLead}${!isParentPage && !isKeywordPage ? ` ${localScopePhrase(scope)}` : ''}`
  : defaultHeroLead
const defaultMetaDescription = isParentPage
  ? 'Motorradfotografie: Bildserien für Custom Bikes, Werkstätten, Händler und private Maschinen - Silhouette, Mechanik, Haltung und Detail.'
  : isKeywordPage
    ? `${serviceLabel}: Bildserien für Custom Bikes, Werkstätten, Händler und private Maschinen.`
    : `${serviceLabel} ${scope.label}: Bildserien für Custom Bikes, Werkstätten, Händler und private Maschinen.`
const metaDescription = keywordFocusCopy?.metaDescription || defaultMetaDescription
const contactSubject = isParentPage ? 'Motorrad Fotografie Anfrage' : `${serviceLabel}${isKeywordPage ? '' : ` ${scope.label}`} Anfrage`
const contactHeadline = isParentPage
  ? 'Motorrad <em>anfragen.</em>'
  : isKeywordPage
    ? `${serviceLabel} <em>anfragen.</em>`
    : `Motorrad ${scope.label} <em>anfragen.</em>`
const defaultContactLead = isParentPage
  ? 'Schreibe kurz, welches Bike fotografiert werden soll — Modell, Standort, ob Fahrerbilder gewünscht sind und wofür die Bilder genutzt werden. Wir klären Licht, Location und Ablauf gemeinsam.'
  : isKeywordPage
    ? `Schreibe kurz, wofür ${serviceLabel} gebraucht wird, welches Motiv im Mittelpunkt steht und welche Nutzung geplant ist. Wir klären Stil, Ort, Umfang und Ausgabe gemeinsam.`
    : `Schreibe kurz, welches Bike in ${scope.label} fotografiert werden soll - Modell, Standort, ob Fahrerbilder gewünscht sind und wofür die Bilder genutzt werden. Wir klären Licht, Location und Ablauf gemeinsam.`

const contactLead = keywordFocusCopy?.contactLead || defaultContactLead

const visualSlots = familyVisualSlots(visualDoc, [
  { alt: 'Motorrad Stand und Silhouette', full: 'assets/optimized/assets-photos-motorrad-ninja-road-1920.webp', mobile: 'assets/optimized/assets-photos-motorrad-ninja-road-720.webp', src: 'assets/optimized/assets-photos-motorrad-ninja-road-960.webp', width: 960, height: 1440 },
  { alt: 'Motorrad mit Fahrer', full: 'assets/optimized/assets-photos-motorrad-duke-1920.webp', mobile: 'assets/optimized/assets-photos-motorrad-duke-720.webp', src: 'assets/optimized/assets-photos-motorrad-duke-960.webp', width: 960, height: 1706 },
  { alt: 'Motorrad Strasse', full: 'assets/optimized/assets-photos-motorrad-ninja-road-1920.webp', mobile: 'assets/optimized/assets-photos-motorrad-ninja-road-720.webp', src: 'assets/optimized/assets-photos-motorrad-ninja-road-960.webp', width: 960, height: 1440 },
  { alt: 'Motorrad Stand & Silhouette', full: 'assets/optimized/assets-photos-motorrad-ninja-road-1920.webp', src: 'assets/optimized/assets-photos-motorrad-ninja-road-720.webp', width: 720, height: 1080 },
  { alt: 'Motorrad Detail', full: 'assets/optimized/assets-portfolio-dsc3892-1920.webp', src: 'assets/portfolio/thumbs/_DSC3892.webp', width: 720, height: 480 },
  { alt: 'Motorrad mit Fahrer', full: 'assets/optimized/assets-photos-motorrad-duke-1920.webp', src: 'assets/optimized/assets-photos-motorrad-duke-720.webp', width: 720, height: 1280 },
  { alt: 'Motorrad Schraeglage und Kurve', full: 'assets/optimized/assets-photos-motorrad-ninja-road-1920.webp', src: 'assets/optimized/assets-photos-motorrad-ninja-road-720.webp', width: 720, height: 1080 },
  { alt: 'Motorrad Cinematic', full: 'assets/optimized/assets-portfolio-dsc2986-1920.webp', src: 'assets/portfolio/thumbs/_DSC2986.webp', width: 720, height: 1080 },
  { alt: 'Motorrad Social & Vertical', full: 'assets/portfolio/_DSC9301-Enhanced-NR.webp', src: 'assets/portfolio/thumbs/_DSC9301-Enhanced-NR.webp', width: 720, height: 900 },
  { alt: 'Motorrad Hero-Motiv', full: 'assets/optimized/assets-photos-motorrad-1920.webp', src: 'assets/optimized/assets-photos-motorrad-720.webp', width: 720, height: 1080 },
  { alt: 'Motorrad Detail', full: 'assets/optimized/assets-portfolio-dsc3892-1920.webp', src: 'assets/portfolio/thumbs/_DSC3892.webp', width: 720, height: 480 },
  { alt: 'Motorrad in Werkstatt', full: 'assets/optimized/assets-portfolio-dsc2986-1920.webp', src: 'assets/portfolio/thumbs/_DSC2986.webp', width: 720, height: 1080 },
  { alt: 'Motorrad Vertical', full: 'assets/portfolio/_DSC9301-Enhanced-NR.webp', src: 'assets/portfolio/thumbs/_DSC9301-Enhanced-NR.webp', width: 720, height: 900 },
  { alt: 'Motorrad Profil', full: 'assets/portfolio/_DSC9321-Enhanced-NR.webp', src: 'assets/portfolio/thumbs/_DSC9321-Enhanced-NR.webp', width: 720, height: 1080 },
  { alt: 'Motorrad Cinematic', full: 'assets/optimized/assets-portfolio-dsc3878-1920.webp', src: 'assets/portfolio/thumbs/_DSC3878.webp', width: 720, height: 480 },
])

// Hero slides — the brand signature has to stay razor-sharp on retina phones.
// A full-bleed 100vw hero on a DPR 2-3 screen needs ~1200-2600 device px wide,
// so a 720/960 source gets upscaled and looks mushy. We serve the local optimized
// ladder by default and only defer to a CMS hero when it already ships a >=1280px
// candidate, so neither path can fall back to a soft low-res image.
const heroLadder = (base: string, widths: number[]) =>
  widths.map((w) => `assets/optimized/${base}-${w}.webp ${w}w`).join(', ')
const heroHasHiRes = (srcset: string) => /(?:1280|1440|1600|1920|2048|2560)w/.test(srcset)
const heroSlide = (slot: (typeof visualSlots)[number], base: string, widths: number[], fallbackWidth = 1280) =>
  heroHasHiRes(slot.srcset)
    ? { src: slot.src, srcset: slot.srcset }
    : { src: `assets/optimized/${base}-${fallbackWidth}.webp`, srcset: heroLadder(base, widths) }
const heroSlides = [
  heroSlide(visualSlots[0], 'assets-photos-motorrad-ninja-road', [768, 1024, 1280, 1600, 1920, 2560]),
  heroSlide(visualSlots[1], 'assets-photos-motorrad-duke', [720, 960, 1280, 1920]),
  heroSlide(visualSlots[2], 'assets-photos-motorrad-ninja-road', [768, 1024, 1280, 1600, 1920, 2560]),
]

// Module/gallery images carried no srcset/sizes before, so they always loaded the
// single (often thumbnail) `src` and went soft when scaled up. Emit the CMS srcset
// when present, otherwise synthesise one from the large `full` source.
const slotSrcset = (slot: (typeof visualSlots)[number]) => slot.srcset || `${slot.full} 1920w`

const focusIntroHeadline = cmsText(doc?.statement?.headline) || keywordFocusCopy?.pullHeadline || (isParentPage || isKeywordPage ? 'Geschwindigkeit und Leidenschaft' : `Motorrad in ${scope.label}`)
const focusIntroEmphasis = cmsText(doc?.statement?.emphasis) || keywordFocusCopy?.pullEmphasis || (isParentPage || isKeywordPage ? 'auf Bildern.' : 'mit Haltung.')
const focusIntroParagraphs = cmsStatementBody.length
  ? cmsStatementBody
  : keywordFocusCopy?.statementBody?.length
    ? keywordFocusCopy.statementBody
    : isParentPage || isKeywordPage
      ? [
      'Ein Motorrad muss auch im Stand Spannung tragen. Ich arbeite mit gesetzten Winkeln, kontrolliertem Licht und einer ruhigen Bildsprache - Mechanik, Material und Haltung wirken sofort, ohne Effektpose.',
      'Einsatz: Social, Website, Verkauf, Werkstatt, Kampagne. Sie erhalten Dateien fuer Web und Druck - bereit fuer Reels, Story, Magazin und Print, im einheitlichen Bild-Look.',
    ]
      : [
      `Motorradfotografie in ${scope.label} wird auf Maschine, Fahrerbezug, Standort und Nutzung geplant. Das Bike soll kraftvoll wirken, ohne dass die Serie nach Zufall oder Parkplatzbild aussieht.`,
      `Fuer ${scope.label} werden Treffpunkt, Lichtfenster und Bildtypen vorab geklaert: Standbild, Detail, Fahrerportrait, Social-Crop oder Verkaufsserie.`,
    ]
const focusModuleHeadline = keywordFocusCopy?.sectionHeadline || (isParentPage || isKeywordPage ? 'Vom Detail' : `Vom Detail in ${scope.label}`)
const focusModuleEmphasis = keywordFocusCopy?.sectionEmphasis || (isParentPage || isKeywordPage ? 'bis zur Kurve.' : 'bis zum Fahrerbild.')
const focusModuleLead = isParentPage || isKeywordPage
  ? keywordFocusCopy?.sectionLead || 'Sechs Bildtypen, die ich anbiete - vom ruhigen Standschuss bis zum Pan-Shot in der Schraeglage. Jede Serie wird aus diesen Modulen zusammengestellt, je nach Bike, Anlass und Verwendung.'
  : `Die Serie fuer ${scope.label} kann ruhig oder dynamisch gebaut werden: Silhouette, Mechanik, Fahrerbezug, Detail und Hochformat werden nach Nutzung kombiniert.`
const focusPortfolioHeadline = cmsText(doc?.portfolioTiles?.[0]?.label) || keywordFocusCopy?.galleryHeadline || (isParentPage || isKeywordPage ? 'Aktuelle Arbeiten.' : `Motorrad-Arbeiten ${scope.label}.`)
const focusPortfolioLead = isParentPage || isKeywordPage
  ? keywordFocusCopy?.galleryLead || 'Sechs kuratierte Motorrad-Bilder aus juengeren Serien. Klicken zum Vergroessern.'
  : `Beispielhafte Bildtypen fuer ein Motorrad-Shooting in ${scope.label}: Standmotiv, Detail, Werkstatt, Vertical und Profil.`
const focusAudienceHeadline = keywordFocusCopy?.audienceHeadline || (isParentPage || isKeywordPage ? 'Fuer wen ich arbeite.' : `Fuer Bikes in ${scope.label}.`)
const focusAudienceLead = isParentPage || isKeywordPage
  ? keywordFocusCopy?.audienceLead || 'Vom ersten eigenen Bike bis zur Kampagne - jede Serie wird auf Maschine, Marke und Nutzung zugeschnitten.'
  : `Fuer Besitzer, Custom-Bikes, Werkstaetten und Haendler in ${scope.label}, die mehr brauchen als schnelle Handyfotos.`
const focusRelatedLead = isParentPage || isKeywordPage
  ? keywordFocusCopy?.relatedLead || 'Motorrad steht selten allein. Schau dir die anderen Disziplinen an - gleicher Anspruch, anderer Bildfokus. Diese Kategorie ist Teil eines bewusst getrennten Fotografie-Clusters: Fahrzeug, Mensch und Raum bleiben eigenstaendige Suchintentionen, sind aber intern so verbunden, dass Nutzer schnell in den passenden Bildbereich wechseln koennen.'
  : `Motorradfotografie ${scope.label} bleibt im Fahrzeug-Cluster und verlinkt bewusst zu Automobil, Sportwagen, Oldtimer und Portfolio, damit die Suchintention sauber weitergefuehrt wird.`

const cleanDefaultModuleCards = [
  { visualIndex: 3, label: '01 / Stand & Silhouette', title: 'Die ruhige Bildbuehne', text: 'Bike pur: Proportionen, Linienfuehrung und Haltung. Gesetztes Licht, klare Winkel, bereit fuer Header, Print und Werkstatt-Wand.' },
  { visualIndex: 4, label: '02 / Detail', title: 'Tank, Motor, Felge, Lenker', text: 'Nahaufnahmen, die Material, Verarbeitung und Charakter ehrlich zeigen - fuer Custom-Doku, Haendlerseiten und redaktionelle Strecken.' },
  { visualIndex: 5, label: '03 / Mit Fahrer', title: 'Mensch + Maschine, Haltung', text: 'Fahrer und Bike zusammen: Haltung, Helm, Haende am Lenker. Portrait-Logik trifft Maschine, gerne vor Ort oder am Werkstatttor.' },
  { visualIndex: 6, label: '04 / Schraeglage & Kurve', title: 'On-the-go, Pan-Shots', text: 'Mitziehaufnahmen aus der Kurve, sauber gezogene Pan-Shots - Geschwindigkeit als Bild, nicht als Behauptung. Strecke nach Absprache.' },
  { visualIndex: 7, label: '05 / Cinematic', title: 'Atmosphaere, Licht, Editorial', text: 'Bildserien mit Stimmung: Gegenlicht, Daemmerung, Werkhalle, Asphalt nach Regen. Editorial-Look fuer Magazin und Marken-Kampagne.' },
  { visualIndex: 8, label: '06 / Social & Vertical', title: 'Reels, Story, 9:16-Cuts', text: 'Hochformat wird von Anfang an mitgeplant - eine Aufnahme, zwei Formate. Reels-, Story- und 9:16-Cuts direkt aus dem Set.' },
]
const moduleCards = cleanDefaultModuleCards.map((cleanCard, index) => {
  const cmsCard = doc?.shootingStyles?.[index]
  const override = cmsCard
    ? { title: cmsText(cmsCard.title), text: cmsText(cmsCard.text), label: cleanCard.label }
    : keywordFocusCopy?.cards?.[index]

  return override ? { ...cleanCard, label: override.label || cleanCard.label, title: override.title || cleanCard.title, text: override.text || cleanCard.text } : cleanCard
})

const cityLinks = [
  ['motorrad-fotografie.html', 'Düsseldorf'],
  ['motorrad-fotografie-erkrath.html', 'Erkrath'],
  ['motorrad-fotografie-ratingen.html', 'Ratingen'],
  ['motorrad-fotografie-koeln.html', 'Köln'],
  ['motorrad-fotografie-essen.html', 'Essen'],
  ['motorrad-fotografie-dortmund.html', 'Dortmund'],
  ['motorrad-fotografie-duisburg.html', 'Duisburg'],
  ['motorrad-fotografie-bochum.html', 'Bochum'],
  ['motorrad-fotografie-wuppertal.html', 'Wuppertal'],
  ['motorrad-fotografie-leverkusen.html', 'Leverkusen'],
  ['motorrad-fotografie-oberhausen.html', 'Oberhausen'],
  ['motorrad-fotografie-krefeld.html', 'Krefeld'],
  ['motorrad-fotografie-moenchengladbach.html', 'Mönchengladbach'],
  ['motorrad-fotografie-moers.html', 'Moers'],
  ['motorrad-fotografie-gelsenkirchen.html', 'Gelsenkirchen'],
  ['motorrad-fotografie-bergisch-gladbach.html', 'Bergisch Gladbach'],
  ['motorrad-fotografie-solingen.html', 'Solingen'],
  ['motorrad-fotografie-remscheid.html', 'Remscheid'],
  ['motorrad-fotografie-mettmann.html', 'Mettmann'],
  ['motorrad-fotografie-hilden.html', 'Hilden'],
  ['motorrad-fotografie-dormagen.html', 'Dormagen'],
  ['motorrad-fotografie-neuss.html', 'Neuss'],
  ['motorrad-fotografie-nrw.html', 'NRW'],
  ['motorrad-fotografie-deutschland.html', 'Deutschland'],
] as const

const searchLinks = [
  ['motorrad-shooting-duesseldorf.html', 'Motorrad Shooting'],
  ['bike-fotografie.html', 'Bike Fotografie'],
  ['custom-bike-fotografie.html', 'Custom Bike Fotografie'],
  ['motorrad-verkaufsfotos-duesseldorf.html', 'Motorrad Verkaufsfotos'],
  ['biker-portrait-duesseldorf.html', 'Biker Portrait'],
] as const
---
<AdoptedPageLayout
  legacyFile={legacyFile}
  current="fotografie"
  doc={doc}
  noIndex={Boolean(preview)}
  title={metaTitle}
  description={metaDescription}
  ogImage={visualSlots[0].full}
  preloadImages={[visualSlots[0].full]}
>
  {preview && (
    <PreviewToolbar
      collection={preview.collection}
      slug={preview.slug}
      status={preview.status}
      publishedHref={publishedHref}
    />
  )}
  <main>
    <section class="hero-mr" id="top" data-header-theme="dark" aria-label={heroLabel}>
      <div class="hero-mr__stage" aria-hidden="true">
        <div class="hero-mr__slides">
          <div class="hero-mr__slide is-active" data-slide="0" style="--pos:50% 52%">
            <div class="hero-mr__zoom">
              <img class="hero-mr__image" src={heroSlides[0].src} srcset={heroSlides[0].srcset} sizes="100vw" alt="" loading="eager" fetchpriority="high" decoding="async" width={visualSlots[0].width} height={visualSlots[0].height} />
            </div>
          </div>
          <div class="hero-mr__slide" data-slide="1" style="--pos:50% 48%">
            <div class="hero-mr__zoom">
              <img class="hero-mr__image" src={heroSlides[1].src} srcset={heroSlides[1].srcset} sizes="100vw" alt="" decoding="async" loading="lazy" width={visualSlots[1].width} height={visualSlots[1].height} />
            </div>
          </div>
          <div class="hero-mr__slide" data-slide="2" style="--pos:50% 50%">
            <div class="hero-mr__zoom">
              <img class="hero-mr__image" src={heroSlides[2].src} srcset={heroSlides[2].srcset} sizes="100vw" alt="" decoding="async" loading="lazy" width={visualSlots[2].width} height={visualSlots[2].height} />
            </div>
          </div>
        </div>
        <span class="hero-mr__edge" id="heroMrEdge"></span>
        <span class="hero-mr__vignette"></span>
      </div>

      <div class="hero-mr__grid">
        <h1 class="hero-mr__title" id="heroMrTitle">
          <span class="line"><span class="word">{heroTitle}</span></span>
          <span class="line"><span class="word">{heroSecondLine}</span></span>
        </h1>
        <div class="hero-mr__lede-block">
          <p class="hero-mr__lede">{heroLead}</p>
          <div class="hero-mr__actions">
            <a href="#anfrage">Shooting buchen →</a>
            <a class="ghost" href="portfolio.html">Portfolio</a>
          </div>
        </div>
      </div>

      <aside class="hero-mr__rail" aria-label="Bildauswahl">
        <nav class="hero-mr__rail-dots" id="heroMrDots" aria-label="Bildauswahl">
          <button type="button" data-slide="0" aria-current="true" aria-label="Bild 1"><span></span></button>
          <button type="button" data-slide="1" aria-label="Bild 2"><span></span></button>
          <button type="button" data-slide="2" aria-label="Bild 3"><span></span></button>
        </nav>
      </aside>
    </section>

    <section class="st" data-header-theme="light">
      <div class="section-inner">
        <div>
          <h2>{focusIntroHeadline} <em>{focusIntroEmphasis}</em></h2>
        </div>
        <div class="st-body">
          {focusIntroParagraphs.map((paragraph) => <p>{paragraph}</p>)}
          <a class="st-cta" href="#anfrage">Shooting anfragen →</a>
        </div>
      </div>
    </section>

    <section class="mk" data-header-theme="dark">
      <div class="section-inner">
        <div class="mk-head">
          <h2>{focusModuleHeadline} <em>{focusModuleEmphasis}</em></h2>
          <p>{focusModuleLead}</p>
        </div>
        <div class="mk-grid">
          <article class="mk-card">
            <figure class="mk-img"><img src={visualSlots[3].src} srcset={slotSrcset(visualSlots[3])} sizes="(max-width:720px) 92vw, (max-width:1180px) 47vw, 31vw" data-src={visualSlots[3].src} loading="lazy" alt={visualSlots[3].alt} width={visualSlots[3].width} height={visualSlots[3].height} decoding="async" /></figure>
            <div class="mk-text">
              <span class="no">{moduleCards[0].label}</span>
              <h3>{moduleCards[0].title}</h3>
              <p>{moduleCards[0].text}</p>
            </div>
          </article>
          <article class="mk-card">
            <figure class="mk-img"><img loading="lazy" src={visualSlots[4].src} srcset={slotSrcset(visualSlots[4])} sizes="(max-width:720px) 92vw, (max-width:1180px) 47vw, 31vw" alt={visualSlots[4].alt} width={visualSlots[4].width} height={visualSlots[4].height} decoding="async" /></figure>
            <div class="mk-text">
              <span class="no">{moduleCards[1].label}</span>
              <h3>{moduleCards[1].title}</h3>
              <p>{moduleCards[1].text}</p>
            </div>
          </article>
          <article class="mk-card">
            <figure class="mk-img"><img src={visualSlots[5].src} srcset={slotSrcset(visualSlots[5])} sizes="(max-width:720px) 92vw, (max-width:1180px) 47vw, 31vw" data-src={visualSlots[5].src} loading="lazy" alt={visualSlots[5].alt} width={visualSlots[5].width} height={visualSlots[5].height} decoding="async" /></figure>
            <div class="mk-text">
              <span class="no">{moduleCards[2].label}</span>
              <h3>{moduleCards[2].title}</h3>
              <p>{moduleCards[2].text}</p>
            </div>
          </article>
          <article class="mk-card">
            <figure class="mk-img"><img src={visualSlots[6].src} srcset={slotSrcset(visualSlots[6])} sizes="(max-width:720px) 92vw, (max-width:1180px) 47vw, 31vw" data-src={visualSlots[6].src} loading="lazy" alt={visualSlots[6].alt} width={visualSlots[6].width} height={visualSlots[6].height} decoding="async" /></figure>
            <div class="mk-text">
              <span class="no">{moduleCards[3].label}</span>
              <h3>{moduleCards[3].title}</h3>
              <p>{moduleCards[3].text}</p>
            </div>
          </article>
          <article class="mk-card">
