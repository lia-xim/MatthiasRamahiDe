---
import AdoptedPageLayout from '../../layouts/AdoptedPageLayout.astro'
import NativeFamilyClusterLinks from './NativeFamilyClusterLinks.astro'
import NativeFamilyFaq from './NativeFamilyFaq.astro'
import PreviewToolbar from '../PreviewToolbar.astro'
import {
  cityScopePhrase,
  keywordFocusCopyForSlug,
  localSeoFamilyContent,
  scopeFromSlug,
  serviceLabelFromSlug,
  siblingFamilyLinks,
} from '../../lib/localSeoFamilyContent'
import { mergeAuthoredLocalSeoContent } from '../../lib/authoredSeoContent'
import { splitHeroTitleLines } from '../../lib/heroTitleLines'
import { familyVisualSlots, getFamilyVisualSourceDoc } from '../../lib/localSeoFamilyVisuals'
import { getLegacyBackedDoc, routeForDoc, type PayloadDoc } from '../../lib/payload'

type PreviewState = {
  collection: string
  publishedHref: string
  slug: string
  status?: string
}

type Props = {
  doc?: PayloadDoc | null
  legacyFile?: string
  preview?: PreviewState
  visualDoc?: PayloadDoc | null
}

const defaultLegacyFile = 'automobil-fotografie.html'
const props = Astro.props as Props
const { doc: providedDoc = undefined, legacyFile: providedLegacyFile, preview, visualDoc: providedVisualDoc = undefined } = props
const legacyFile = providedLegacyFile || defaultLegacyFile
const fetchedDoc = providedDoc || (await getLegacyBackedDoc(legacyFile, { depth: 2 }))
const doc = preview ? fetchedDoc : mergeAuthoredLocalSeoContent(legacyFile, fetchedDoc)
const shouldUseCmsVisualDoc = import.meta.env.ASTRO_DISABLE_CMS_VISUAL_OVERRIDES !== 'true'
const visualDoc = Object.hasOwn(props, 'visualDoc')
  ? providedVisualDoc
  : shouldUseCmsVisualDoc
    ? await getFamilyVisualSourceDoc('automobil', doc, legacyFile, defaultLegacyFile)
    : null
const familyContent = localSeoFamilyContent.automobil
const scope = scopeFromSlug(legacyFile)
const isParentPage = legacyFile === defaultLegacyFile
const isKeywordPage = scope.generic
const isLocalCityPage = !isParentPage && !isKeywordPage
const serviceLabel = serviceLabelFromSlug(legacyFile, familyContent)
const keywordFocusCopy = keywordFocusCopyForSlug(legacyFile)
const cmsFaqSource = (doc?.localFaq?.length ? doc.localFaq : doc?.faq) || []
const cmsFaqItems = cmsFaqSource.map((entry) => ({ q: entry.question || '', a: entry.answer || '' })).filter((entry) => entry.q && entry.a)
const faqItems = cmsFaqItems.length ? cmsFaqItems : keywordFocusCopy?.faq
const cmsText = (value: unknown) => (typeof value === 'string' ? value.trim() : '')
const teaserText = (value: unknown, maxLength = 180) => {
  const text = cmsText(value).replace(/\s+/g, ' ')
  if (text.length <= maxLength) return text
  const softCut = text.slice(0, maxLength)
  const sentenceEnd = Math.max(softCut.lastIndexOf('.'), softCut.lastIndexOf('!'), softCut.lastIndexOf('?'))
  if (sentenceEnd > 70) return softCut.slice(0, sentenceEnd + 1)
  const wordCut = softCut.lastIndexOf(' ')
  return `${softCut.slice(0, wordCut > 70 ? wordCut : maxLength).trimEnd()}...`
}
const normalizeCopyToken = (value: string) =>
  value
    .normalize('NFKC')
    .replace(/<[^>]+>/g, ' ')
    .replace(/[.,!?;:]+$/g, '')
    .replace(/\s+/g, ' ')
    .trim()
    .toLocaleLowerCase('de-DE')
const splitTrailingEmphasis = (headline: string, emphasis: string) => {
  const headlineWords = headline.split(/\s+/).filter(Boolean)
  const emphasisWords = emphasis.split(/\s+/).filter(Boolean)
  if (!headlineWords.length || !emphasisWords.length || headlineWords.length < emphasisWords.length) {
    return { headline, emphasis }
  }

  const tail = headlineWords.slice(-emphasisWords.length).join(' ')
  if (normalizeCopyToken(tail) !== normalizeCopyToken(emphasis)) return { headline, emphasis }

  return {
    headline: headlineWords.slice(0, -emphasisWords.length).join(' '),
    emphasis,
  }
}
const cmsHeroLine2 = cmsText(doc?.heroLine2)
const cmsStatementBody = doc?.statement?.body?.map((entry) => cmsText(entry.text)).filter(Boolean) || []
const localSuffix = !isParentPage && !isKeywordPage ? ` ${scope.label}` : ''
const heroTitle = isParentPage ? 'Automobil' : serviceLabel
const heroSecondLine = isParentPage ? 'Fotografie' : isLocalCityPage ? scope.label : ''
const heroTitleLines = [...splitHeroTitleLines(heroTitle), ...splitHeroTitleLines(heroSecondLine)]
const heroLocalNote = isLocalCityPage ? cmsHeroLine2 : isKeywordPage ? cmsHeroLine2 || keywordFocusCopy?.heroEmphasis || '' : ''
const heroLabel = isParentPage ? 'Automobilfotografie' : isKeywordPage ? serviceLabel : `Automobilfotografie${localSuffix}`
const defaultHeroLead = isParentPage
  ? 'Automobilfotografie: Exterieur, Interieur, Details und Cinematic werden als kuratierte Bildserie geplant - für Marke, Showroom, Verkauf, Kampagne und hochwertige private Fahrzeuge. Produktionen werden über Motiv, Nutzung, Reise, Lichtfenster und Output geplant; Düsseldorf bleibt der organisatorische Ausgangspunkt.'
  : isKeywordPage
    ? `${serviceLabel}: eigenständiger Einstieg in die Automobilfotografie. Exterieur, Interieur, Details und Cinematic werden als kuratierte Serie geplant - für Marke, Showroom, Verkauf, Kampagne und hochwertige private Fahrzeuge. Die Seite bleibt bewusst im Layout der übergeordneten Kategorie, ist aber klar auf dieses Motiv und diese Nutzung formuliert.`
    : `Automobilfotografie in ${scope.label}: Exterieur, Interieur, Details und Cinematic werden als kuratierte Bildserie geplant - für Marke, Showroom, Verkauf, Kampagne und hochwertige private Fahrzeuge. ${cityScopePhrase(scope)}`
const keywordLocalContext = keywordFocusCopy && !isParentPage && !isKeywordPage ? ` ${cityScopePhrase(scope)}` : ''
const heroLead = keywordFocusCopy?.heroLead ? `${keywordFocusCopy.heroLead}${keywordLocalContext}` : defaultHeroLead
const fallbackMetaTitle = isParentPage
  ? 'Automobilfotografie | Matthias Ramahi'
  : isKeywordPage
    ? `${serviceLabel} | Matthias Ramahi`
    : `${serviceLabel} ${scope.label} | Matthias Ramahi`
const metaTitle = doc?.seo?.title || fallbackMetaTitle
const defaultMetaDescription = isParentPage
  ? 'Automobilfotografie fuer Exterieur, Interieur, Details und Kampagne in Duesseldorf und NRW. Bildserien fuer Verkauf, Marke, Showroom und hochwertige private Fahrzeuge.'
  : isKeywordPage
    ? `${serviceLabel} fuer Fahrzeuge, Marken, Showrooms und Verkauf. Exterieur, Interieur, Details und Cinematic werden als nutzbare Bildserie geplant.`
    : `${serviceLabel} in ${scope.label}: Exterieur, Interieur, Details und Cinematic als kuratierte Bildserie fuer Verkauf, Marke, Showroom und Kampagne.`
const metaDescription = doc?.seo?.description || keywordFocusCopy?.metaDescription || defaultMetaDescription
const contactSubject = isParentPage ? 'Automobil Fotografie Anfrage' : `${serviceLabel}${isKeywordPage ? '' : ` ${scope.label}`} Anfrage`
const contactHeadline = isParentPage
  ? 'Automobil <em>anfragen.</em>'
  : isKeywordPage
    ? `${serviceLabel} <em>anfragen.</em>`
    : `Automobil ${scope.label} <em>anfragen.</em>`
const defaultContactLead = isParentPage
  ? 'Schreibe kurz, welches Fahrzeug fotografiert werden soll, wo es steht, welche Wirkung die Bilder tragen sollen und ob die Serie privat, kommerziell oder als Kampagne genutzt wird. Wir klären Location, Licht und Ablauf gemeinsam vor dem ersten Klick.'
  : isKeywordPage
    ? `Schreibe kurz, wofür ${serviceLabel} gebraucht wird, welches Motiv im Mittelpunkt steht und welche Nutzung geplant ist. Wir klären Stil, Ort, Umfang und Ausgabe gemeinsam.`
    : `Schreibe kurz, welches Fahrzeug in ${scope.label} fotografiert werden soll, wo es steht, welche Wirkung die Bilder tragen sollen und ob die Serie privat, kommerziell oder als Kampagne genutzt wird. Wir klären Location, Licht und Ablauf gemeinsam vor dem ersten Klick.`
const contactLead = keywordFocusCopy?.contactLead || defaultContactLead
const cityHeading = isParentPage || isKeywordPage ? 'Automobil Fotografie <em>vor Ort.</em>' : `Automobilfotografie <em>vor Ort in ${scope.label}.</em>`
const clusterHeading = isKeywordPage ? 'Weitere Fotografie-Bereiche.' : `Weitere Fotografie-Bereiche <em>${scope.label}.</em>`
const clusterLinks = siblingFamilyLinks(scope, 'automobil')
const overviewHref = 'fotografie-duesseldorf.html'
const publishedHref = preview?.publishedHref || (doc ? routeForDoc('local-seo-pages', doc) : `/${legacyFile}`)
const heroDevelopInitial = 'assets/optimized/mpjpgo2b-dsc3032-generase-1-1920.webp'
const heroDevelopInitialMobile = 'assets/optimized/mpjpgo2b-dsc3032-generase-1-1280.webp'

const switchFrames = [
  {
    image: 'assets/optimized/assets-portfolio-dsc3879-1920.webp',
    label: 'Exterieur',
  },
  {
    image: 'assets/optimized/assets-portfolio-dsc2986-1920.webp',
    label: 'Interieur',
  },
  {
    image: 'assets/optimized/assets-portfolio-dsc3892-1920.webp',
    label: 'Details',
  },
  {
    image: 'assets/optimized/assets-portfolio-dsc3032-generase-1-1920.webp',
    label: 'Cinematic',
  },
]

const galleryTiles = [
