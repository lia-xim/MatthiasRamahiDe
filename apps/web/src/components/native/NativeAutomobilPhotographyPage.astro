    label: frame.label,
    title: localCard?.title || cmsText(doc?.shootingStyles?.[index]?.title) || keywordFocusCopy?.cards?.[index]?.title || fallback.title,
    body: teaserText(localCard?.text || cmsText(doc?.shootingStyles?.[index]?.text) || keywordFocusCopy?.cards?.[index]?.text || fallback.body, 190),
  }
})

const focusPullKicker = isLocalCityPage ? `${serviceLabel} ${scope.label}` : keywordFocusCopy?.pullKicker || (isParentPage ? 'Automobilfotografie' : serviceLabel)
const focusPullHeadline = cmsText(doc?.statement?.headline) || keywordFocusCopy?.pullHeadline || (isParentPage ? 'Vom Inserat bis zur' : `${serviceLabel}:`)
const focusPullEmphasis = cmsText(doc?.statement?.emphasis) || keywordFocusCopy?.pullEmphasis || (isParentPage ? 'Kampagne.' : 'als Bildserie.')
const focusPullTitle = splitTrailingEmphasis(focusPullHeadline, focusPullEmphasis)
const focusPullLead =
  cmsStatementBody[0] ||
  keywordFocusCopy?.pullLead ||
  (isParentPage
    ? 'Vom ehrlichen Verkaufsbild bis zur inszenierten Kampagne - eine konsistente Bildserie, sauber belichtet und sofort einsatzbereit fuer Inserat, Magazin, Social und Print.'
    : `${serviceLabel} bekommt eine eigene Seite in der Automobil-Struktur: Fahrzeug, Licht, Nutzung und Ausgabe werden vor dem Shooting sauber geplant.`)
const focusPullRest = cmsStatementBody.slice(1)
const focusSectionHeadline = isLocalCityPage ? `${serviceLabel} in ${scope.label},` : isKeywordPage ? serviceLabel : keywordFocusCopy?.sectionHeadline || (isParentPage ? 'Ein Bildsatz,' : `${serviceLabel},`)
const focusSectionEmphasis = isLocalCityPage ? 'lokal geplant.' : isKeywordPage ? 'klar geplant.' : keywordFocusCopy?.sectionEmphasis || (isParentPage ? 'vier Blickwinkel.' : 'klar fokussiert.')
const focusFeatureTitle = focusSwitchFrames[0]?.title || keywordFocusCopy?.featureTitle || defaultSwitchCopy[0].title
const focusFeatureBody = focusSwitchFrames[0]?.body || keywordFocusCopy?.featureBody || defaultSwitchCopy[0].body
const focusGalleryHeadline = isLocalCityPage ? `${serviceLabel} ${scope.label}: Bildtypen.` : isKeywordPage ? `${serviceLabel}: Bildtypen.` : cmsText(doc?.portfolioTiles?.[0]?.label) || keywordFocusCopy?.galleryHeadline || 'Automobilfotografie als Bildserie.'
const focusAudienceHeadline = isLocalCityPage ? `${serviceLabel} ${scope.label}: passende Anfragen.` : isKeywordPage ? `${serviceLabel}: passende Anfragen.` : keywordFocusCopy?.audienceHeadline || 'Automobilfotografie: passende Anfragen.'
const focusAudienceLead = keywordFocusCopy?.audienceLead || (!isParentPage && !isKeywordPage
  ? `Ob Showroom, privates Fahrzeug oder Kampagne: in ${scope.label} wird die Bildserie nach Nutzung, Standort und Ausgabe geplant.`
  : 'Du erkennst dich wieder?')
const focusAudiences = localAudienceCards.length
  ? localAudienceCards.map((card, index) => [card.title || `Zielgruppe ${index + 1}`, teaserText(card.text || 'Anfrage mit konkretem Fahrzeugbezug.', 130)])
  : keywordFocusCopy?.cards?.length
  ? keywordFocusCopy.cards.map((card) => [card.title, card.label || 'Shooting'])
  : audiences
const focusRelatedLead =
  isLocalCityPage
    ? `Automobil Fotografie ${scope.label} bleibt der Einstieg fuer Fahrzeugbilder vor Ort. Sportwagen, Oldtimer, Motorrad und Auto-Fotoshooting werden als eigene Bereiche verlinkt, damit Nutzer schneller zum passenden Angebot finden.`
    : keywordFocusCopy?.relatedLead ||
      'Automobil ist die Klammer. Schau dir die spezialisierten Disziplinen an - gleicher Anspruch, anderer Bildfokus. Die Links fuehren schnell zu der Bildwelt, die zum Fahrzeug, zur Nutzung und zum geplanten Shooting passt.'

type LinkTuple = readonly [href: string, label: string]

const allCityLinks: LinkTuple[] = [
  ['automobil-fotografie-duesseldorf.html', 'Düsseldorf'],
  ['automobil-fotografie-erkrath.html', 'Erkrath'],
  ['automobil-fotografie-ratingen.html', 'Ratingen'],
  ['automobil-fotografie-koeln.html', 'Köln'],
  ['automobil-fotografie-essen.html', 'Essen'],
  ['automobil-fotografie-dortmund.html', 'Dortmund'],
  ['automobil-fotografie-duisburg.html', 'Duisburg'],
  ['automobil-fotografie-bochum.html', 'Bochum'],
  ['automobil-fotografie-wuppertal.html', 'Wuppertal'],
  ['automobil-fotografie-leverkusen.html', 'Leverkusen'],
  ['automobil-fotografie-oberhausen.html', 'Oberhausen'],
  ['automobil-fotografie-krefeld.html', 'Krefeld'],
  ['automobil-fotografie-moenchengladbach.html', 'Mönchengladbach'],
  ['automobil-fotografie-moers.html', 'Moers'],
  ['automobil-fotografie-gelsenkirchen.html', 'Gelsenkirchen'],
  ['automobil-fotografie-bergisch-gladbach.html', 'Bergisch Gladbach'],
  ['automobil-fotografie-solingen.html', 'Solingen'],
  ['automobil-fotografie-remscheid.html', 'Remscheid'],
  ['automobil-fotografie-mettmann.html', 'Mettmann'],
  ['automobil-fotografie-hilden.html', 'Hilden'],
  ['automobil-fotografie-dormagen.html', 'Dormagen'],
  ['automobil-fotografie-neuss.html', 'Neuss'],
  ['automobil-fotografie-nrw.html', 'NRW'],
]

const parentLink: LinkTuple = [defaultLegacyFile, 'Automobilfotografie Übersicht']
const allLocationLinks = [parentLink, ...allCityLinks]
const locationLinkByHref = new Map(allLocationLinks.map((link) => [link[0], link]))
const pickLocationLinks = (hrefs: string[]) =>
  hrefs.flatMap((href) => {
    const link = locationLinkByHref.get(href)
    return link ? [link] : []
  })
const isFamilyLocationPage = isParentPage || allCityLinks.some(([href]) => isCurrentPageHref(href, legacyFile))
const isDuesseldorfFamilyPage = legacyFile === 'automobil-fotografie-duesseldorf.html'
const isNrwFamilyPage = legacyFile === 'automobil-fotografie-nrw.html'
const priorityLocationHrefs = [
  'automobil-fotografie-duesseldorf.html',
  'automobil-fotografie-nrw.html',
  'automobil-fotografie-erkrath.html',
  'automobil-fotografie-mettmann.html',
  'automobil-fotografie-ratingen.html',
  'automobil-fotografie-neuss.html',
]
const cityLinks = (
  isNrwFamilyPage
    ? allLocationLinks
    : isParentPage
      ? pickLocationLinks(priorityLocationHrefs)
      : isDuesseldorfFamilyPage
        ? pickLocationLinks([
            defaultLegacyFile,
            'automobil-fotografie-nrw.html',
            'automobil-fotografie-erkrath.html',
            'automobil-fotografie-mettmann.html',
            'automobil-fotografie-ratingen.html',
            'automobil-fotografie-neuss.html',
          ])
        : pickLocationLinks([
            defaultLegacyFile,
            'automobil-fotografie-duesseldorf.html',
            'automobil-fotografie-nrw.html',
          ])
).filter(([href]) => !isCurrentPageHref(href, legacyFile))

const intentLinks = [
  {
    key: 'auto-fotoshooting',
    label: 'Auto-Fotoshooting',
    genericHref: 'auto-fotoshooting.html',
    duesseldorfHref: 'auto-fotoshooting-duesseldorf.html',
  },
  {
    key: 'bilder-mit-auto',
    label: 'Bilder mit Auto',
    genericHref: 'bilder-mit-auto.html',
    duesseldorfHref: 'bilder-mit-auto-duesseldorf.html',
  },
  {
    key: 'fotoshooting-mit-auto',
    label: 'Fotoshooting mit Auto',
    genericHref: 'fotoshooting-mit-auto.html',
    duesseldorfHref: 'fotoshooting-mit-auto-duesseldorf.html',
  },
  {
    key: 'automotive-fotografie',
    label: 'Automotive Fotografie',
    genericHref: 'automotive-fotografie.html',
    duesseldorfHref: 'automotive-fotografie-duesseldorf.html',
  },
  {
    key: 'autofotografie',
    label: 'Autofotografie',
    genericHref: 'autofotografie.html',
    duesseldorfHref: 'autofotografie-duesseldorf.html',
  },
  {
    key: 'fahrzeugfotografie',
    label: 'Fahrzeugfotografie',
    genericHref: 'fahrzeugfotografie.html',
    duesseldorfHref: 'fahrzeugfotografie-duesseldorf.html',
  },
  {
    key: 'auto-fotografieren-tipps',
    label: 'Auto fotografieren Tipps',
    genericHref: 'auto-fotografieren-tipps.html',
    duesseldorfHref: 'auto-fotografieren-tipps-duesseldorf.html',
  },
  {
    key: 'autohaus-fotografie',
    label: 'Autohaus Fotografie',
    genericHref: 'autohaus-fotografie.html',
    duesseldorfHref: 'autohaus-fotografie-duesseldorf.html',
  },
  {
    key: 'autoverkauf-fotos',
    label: 'Autoverkauf Fotos',
    genericHref: 'autoverkauf-fotos-duesseldorf.html',
    duesseldorfHref: 'autoverkauf-fotos-duesseldorf.html',
  },
] as const
type IntentKey = (typeof intentLinks)[number]['key']
const intentLinkByKey = new Map(intentLinks.map((link) => [link.key, link]))
const primaryIntentKeys: IntentKey[] = [
  'auto-fotoshooting',
  'automotive-fotografie',
  'autohaus-fotografie',
  'autoverkauf-fotos',
  'bilder-mit-auto',
  'auto-fotografieren-tipps',
]
const intentNeighbors: Partial<Record<IntentKey, IntentKey[]>> = {
  'auto-fotoshooting': ['bilder-mit-auto', 'fotoshooting-mit-auto', 'auto-fotografieren-tipps'],
  'bilder-mit-auto': ['auto-fotoshooting', 'fotoshooting-mit-auto', 'automotive-fotografie'],
  'fotoshooting-mit-auto': ['auto-fotoshooting', 'bilder-mit-auto', 'autofotografie'],
  'automotive-fotografie': ['autohaus-fotografie', 'autoverkauf-fotos', 'fahrzeugfotografie'],
  autofotografie: ['fahrzeugfotografie', 'automotive-fotografie', 'auto-fotoshooting'],
  fahrzeugfotografie: ['autofotografie', 'automotive-fotografie', 'autoverkauf-fotos'],
  'auto-fotografieren-tipps': ['auto-fotoshooting', 'autofotografie', 'automotive-fotografie'],
  'autohaus-fotografie': ['autoverkauf-fotos', 'automotive-fotografie', 'fahrzeugfotografie'],
  'autoverkauf-fotos': ['autohaus-fotografie', 'fahrzeugfotografie', 'auto-fotoshooting'],
}
const currentIntentKey = legacyFile
  .replace(/\.html$/, '')
  .replace(/-duesseldorf$/, '') as IntentKey
const selectedIntentKeys = isParentPage
  ? intentLinks.map((link) => link.key)
  : isDuesseldorfFamilyPage || isNrwFamilyPage
    ? primaryIntentKeys
    : !isFamilyLocationPage && intentNeighbors[currentIntentKey]
      ? intentNeighbors[currentIntentKey]!
      : primaryIntentKeys.slice(0, 3)
const searchLinks: LinkTuple[] = selectedIntentKeys
  .flatMap((key) => {
    const link = intentLinkByKey.get(key)
    if (!link) return []
    const href = !isParentPage && scope.slug === 'duesseldorf' ? link.duesseldorfHref : link.genericHref
    return [[href, link.label] as LinkTuple]
  })
  .filter(([href]) => !isCurrentPageHref(href, legacyFile))
const showCrossFamilyCluster = isDuesseldorfFamilyPage || isNrwFamilyPage
const curatedCityHeading =
  isParentPage || isNrwFamilyPage ? cityHeading : 'Automobilfotografie <em>im Cluster.</em>'
const curatedIntentHeading = isParentPage
  ? 'Automobilfotografie <em>nach Anliegen.</em>'
  : 'Passende Automobilfotografie <em>nach Anliegen.</em>'
---
<AdoptedPageLayout
  legacyFile={legacyFile}
  current="fotografie"
  doc={doc}
  noIndex={Boolean(preview)}
  title={metaTitle}
  description={metaDescription}
  jsonLd={guideJsonLd}
  ogImage={doc?.seo?.ogImage || visualSlots[0].full}
  preloadImages={[
    { href: inheritedHeroDevelopInitialMobile, media: '(max-width: 900px)' },
    { href: inheritedHeroDevelopInitial, media: '(min-width: 901px)' },
  ]}
>
  {preview && (
    <PreviewToolbar
      collection={preview.collection}
      slug={preview.slug}
      status={preview.status}
      publishedHref={publishedHref}
    />
  )}
  <main>
    <section
      class="hero-pd"
      id="top"
      data-header-theme="dark"
      data-hero-images-desktop={visualSlots.slice(0, 5).map((slot) => slot.full).join('|')}
      data-hero-images-mobile={visualSlots.slice(0, 5).map((slot) => slot.mobile).join('|')}
      aria-label={heroLabel}
      {...tinaAttrs(heroImageSource, 'image')}
    >
      <div class="pd-stage" aria-hidden="true">
        <div class="pd-frame is-in" id="pdFrameA" style="--cx:50%;--cy:50%">
          <div
            class="pd-frame-inner"
            style={`--pd-bg-mobile:url('${inheritedHeroDevelopInitialMobile}');--pd-bg-desktop:url('${inheritedHeroDevelopInitial}')`}
            {...tinaAttrs(heroImageSource, 'image')}
          ></div>
        </div>
        <div class="pd-frame" id="pdFrameB"><div class="pd-frame-inner"></div></div>
      </div>
      <div class="pd-paper" aria-hidden="true"></div>
      <div class="pd-glow" aria-hidden="true"></div>
      <div class="pd-streak" aria-hidden="true"></div>
      <div class="pd-flare pd-flare-2" aria-hidden="true"></div>
      <div class="pd-vignette" aria-hidden="true"></div>
      <div class="pd-grain" aria-hidden="true"></div>
      <div class="pd-overlay">
        <div class="pd-bottom">
          <h1 class={`pd-title${isLocalCityPage ? ' pd-title--local' : ''}`} style={heroTitleFitStyle} aria-label={heroLabel}>
            {heroCopy.titleLines.map((line, index) => (
              <>
                {index > 0 && ' '}
                <span class="line" {...tinaAttrs(heroTitleSource, heroTitleField(index))}><span class="word">{line}</span></span>
              </>
            ))}
          </h1>
          {heroLocalNote && <p class="pd-local-note" {...tinaAttrs(doc, 'heroLine2')}>{heroLocalNote}</p>}
          <p class="pd-sub" {...tinaAttrs(heroLeadSource, heroLeadField)}>{heroCopy.lead}</p>
          <div class="pd-actions">
            <a href={heroCopy.primaryHref} {...tinaAttrs(heroSourceSlide, 'primaryLabel')}>{heroCopy.primaryLabel}</a>
            <a class="ghost" href={heroCopy.secondaryHref} {...tinaAttrs(heroSourceSlide, 'secondaryLabel')}>{heroCopy.secondaryLabel}</a>
          </div>
        </div>
      </div>
    </section>

    <section class="st-pull" data-header-theme="light">
      <div class="st-pull-inner">
        <span class="st-pull-kicker">{focusPullKicker}</span>
        <blockquote class="st-pull-quote" {...tinaAttrs(doc?.statement, 'headline')}>
          <strong>
            {focusPullTitle.headline}
            {focusPullTitle.headline && focusPullTitle.emphasis ? ' ' : ''}
            {focusPullTitle.emphasis && <span class="accent" {...tinaAttrs(doc?.statement, 'emphasis')}>{focusPullTitle.emphasis}</span>}
          </strong>
        </blockquote>
        <div class="st-pull-copy">
          <p class="st-pull-lead" {...tinaAttrs(doc?.statement?.body?.[0], 'text')}>{focusPullLead}</p>
          {focusPullRest.map((paragraph, index) => <p class="st-pull-lead" {...tinaAttrs(doc?.statement?.body?.[index + 1], 'text')}>{paragraph}</p>)}
        </div>
        <div class="st-pull-cta">
          <a href="#anfrage">Shooting buchen <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    {isPracticalGuide && (
      <NativePracticalGuide
        eyebrow="Praxisleitfaden"
        title="Auto fotografieren: die Reihenfolge vor Ort."
        intro="Die Checkliste ordnet die wichtigsten Entscheidungen so, wie sie bei einer Fahrzeugserie tatsächlich anfallen. Sie ergänzt die Bildbeispiele und führt bei höherem Qualitäts- oder Nutzungsanspruch direkt zur passenden Leistung."
        items={practicalGuideItems}
        links={[
          { href: '/automobil-fotografie-duesseldorf.html', label: 'Automobilfotografie Düsseldorf' },
          { href: '/portfolio/portfolio-auswahl-automobil', label: 'Automobil-Projektbeleg' },
        ]}
      />
    )}

    <section class="sw" id="sichten" data-header-theme="dark">
      <header class="sw-head">
        <div class="ttl">
          <h2>{focusSectionHeadline} <em>{focusSectionEmphasis}</em></h2>
        </div>
      </header>

      <div class="sw-body">
        <nav class="sw-tabs" role="tablist" aria-label="Bildkategorien">
          {focusSwitchFrames.map((frame, index) => (
            <button class="sw-tab" role="tab" aria-selected={index === 0 ? 'true' : 'false'} data-cat={index} data-title={frame.title} data-body={frame.body}>
              <span class="lbl">{frame.label}</span>
            </button>
          ))}
        </nav>

        <div class="sw-stage" id="swStage" role="region" aria-live="polite">
          {focusSwitchFrames.map((frame, index) => (
            <div
              class={`frame${index === 0 ? ' is-active' : ''}`}
              data-frame={index}
              style={`background-image:url('${frame.image}')`}
              {...tinaAttrs(switchImageSource(index), 'image')}
            />
          ))}
          <div class="vignette"></div>
          <div class="grain"></div>
        </div>

        <aside class="sw-desc" id="swDesc">
          <div class="group g2 is-in"><h3 class="d-title" id="swTitle" {...tinaAttrs(doc?.shootingStyles?.[0] || doc?.audienceCards?.[0], 'title')}>{focusFeatureTitle}</h3></div>
          <div class="group g3 is-in"><p class="d-body" id="swBody" {...tinaAttrs(doc?.shootingStyles?.[0] || doc?.audienceCards?.[0], 'text')}>{focusFeatureBody}</p></div>
          <div class="group g4 is-in"><a class="d-cta" href="#anfrage">Bildsatz anfragen</a></div>
        </aside>
      </div>

      <div class="sw-progress" id="swProgress"><div class="rail"><div class="fill" id="swFill"></div></div></div>
    </section>

    <section class="bg" data-header-theme="dark" aria-label="Ausgewählte Automobil-Arbeiten" id="bgSec">
      <div class="bg-head">
        <div class="ttl">
          <h2 {...tinaAttrs(doc?.portfolioTiles?.[0], 'label')}>{focusGalleryHeadline}</h2>
        </div>
        <div class="meta">
          <a href="/portfolio/portfolio-auswahl-automobil">Automobil-Auswahl ansehen →</a>
        </div>
      </div>

      <div class="bg-grid" id="bgGrid">
        {inheritedGalleryTiles.map((tile, index) => (
          <button type="button" class={`bg-tile ${tile.className}`} data-i={index} data-full={tile.full} aria-label={`Frame ${index + 1} vergrößern`}>
            <img loading="lazy" src={tile.src} alt={tile.alt} width={tile.width} height={tile.height} decoding="async" {...tinaAttrs(galleryImageSource(index), 'image')} />
          </button>
        ))}
      </div>
    </section>

    {isParentPage && (
      <section class="auto-archive" data-header-theme="dark" aria-labelledby="auto-archive-title">
        <div class="auto-archive__inner">
          <header class="auto-archive__head">
            <div>
              <span class="auto-archive__kicker">Mehr als eine Serie</span>
              <h2 id="auto-archive-title">Verschiedene Fahrzeuge. <em>Verschiedene Bildwelten.</em></h2>
            </div>
            <p>
              Diese Auswahl verbindet Location-Shootings, Messebilder, Interieur und Details aus mehreren Produktionen.
              So wird auf einen Blick sichtbar, wie unterschiedlich Fahrzeug, Umgebung und späterer Einsatz die Bildsprache prägen.
            </p>
          </header>
          <div class="auto-archive__grid" data-site-lightbox-gallery>
            {automotiveArchiveImages.map((image) => (
              <figure class={`auto-archive-card ${image.className}`}>
                <button type="button" data-full={image.src} aria-label={`${image.label} vergrößern`}>
                  <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
                </button>
                <figcaption>{image.label}</figcaption>
              </figure>
            ))}
          </div>
          <div class="auto-archive__footer">
            <p>Ein Shooting wird als zusammenhängender Bildsatz geplant – die Seite zeigt bewusst mehr als nur ein einzelnes Projekt.</p>
            <a href="#anfrage">Eigenes Fahrzeug anfragen <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>
    )}

    <section class="ki" data-header-theme="light" aria-label="Für wen ich arbeite">
      <div class="section-inner">
        <div class="ki-head">
          <h2>{focusAudienceHeadline}</h2>
        </div>

        <div class="ki-grid">
          {focusAudiences.map(([title, label]) => (
            <a href="#anfrage" class="ki-card">
              <h3>{title}</h3>
              <span class="lbl">{label}</span>
              <span class="arrow">→</span>
            </a>
          ))}
        </div>
        <div class="ki-cta">
          <p>{focusAudienceLead} <a href="#anfrage">Lass uns sprechen <span aria-hidden="true">→</span></a></p>
        </div>
      </div>
    </section>

    <section class="rl" data-header-theme="dark">
      <div class="section-inner">
        <div class="rl-head">
          <h2>Verwandte <em>Bereiche</em>.</h2>
          <p>{focusRelatedLead}</p>
        </div>
        <div class="rl-grid">
          {inheritedRelatedAreas.map((area) => (
            <a class="rl-card" href={area.href}>
              <img loading="lazy" src={area.image} alt={area.alt} width={area.width} height={area.height} decoding="async" />
              <div class="overlay"></div>
              <div class="content"><div><strong>{area.title}</strong></div><span class="arrow">→</span></div>
            </a>
          ))}
        </div>
      </div>
    </section>

    {showCrossFamilyCluster && (
      <NativeFamilyClusterLinks
        clusterHeading={clusterHeading}
        clusterLinks={clusterLinks}
        overviewHref={overviewHref}
        scopeLabel={scope.label}
      />
    )}

    <section class="mr-cities" data-header-theme="light" data-theme="light" aria-label="Automobil Fotografie in NRW">
      <div class="mr-cities__inner">
        <div class="mr-cities__head">
          <h2 set:html={curatedCityHeading}></h2>
        </div>
        <nav class="mr-cities__grid" aria-label="Städte">
          {cityLinks.map(([href, label]) => <a class="mr-cities__cell" href={href}>{label}</a>)}
        </nav>
      </div>
    </section>

    <section class="mr-cities" data-header-theme="light" data-theme="light" aria-label="Automobil Fotografie Suchbegriffe">
      <div class="mr-cities__inner">
        <div class="mr-cities__head">
          <h2 set:html={curatedIntentHeading}></h2>
        </div>
        <nav class="mr-cities__grid" aria-label="Suchvarianten">
          {searchLinks.map(([href, label]) => <a class="mr-cities__cell" href={href}>{label}</a>)}
        </nav>
      </div>
    </section>

    <NativeFamilyFaq faq={faqItems} pageUrl={`https://matthiasramahi.de/${legacyFile}`} theme="dark" />

    <NativeReviews theme="light" />

    <section
      id="anfrage"
      data-contact-section
      data-header-theme="light"
      data-contact-subject={contactSubject}
      data-contact-headline={contactHeadline}
      data-contact-lead={contactLead}
    />
  </main>
</AdoptedPageLayout>
