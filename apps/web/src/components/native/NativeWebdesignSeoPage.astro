---
import AdoptedPageLayout from '../../layouts/AdoptedPageLayout.astro'
import { getBySlug, imageUrl, type PayloadDoc } from '../../lib/payload'

const legacyFile = 'webdesign-seo-duesseldorf.html'
const providedDoc = Astro.props.doc as PayloadDoc | undefined
const doc = providedDoc || (await getBySlug('service-pages', 'webdesign-seo-duesseldorf', { depth: 2 }))

// Vier Disziplinen — kompaktes editoriales Raster (Hairlines, kein Card-Chrome).
// Bewusst knappe Bodies, keine Meta-Zeilen: schnell scanbar, auch auf Mobile kurz.
const services = [
  { n: '01', title: 'Neue Websites', body: 'Handgebaut, schnell, schlank — ohne Page-Builder-Aufblähung.' },
  { n: '02', title: 'Lokale Sichtbarkeit', body: 'Stadtseiten, GBP und Schema für echte Local-Pack-Sichtbarkeit.' },
  { n: '03', title: 'Inhalte & Bildsprache', body: 'Eigene Fotos und editoriale Texte statt Stock — aus einer Hand.' },
  { n: '04', title: 'Performance & Wartung', body: 'Core-Web-Vitals im grünen Bereich, Pflege ohne CMS-Stress.' },
]

// "Nicht eine Seite — ein System": die vier Ebenen, knapp gehalten.
const systemLayers = [
  { n: '01', tag: 'Struktur', line: 'Sitemap, URLs und interne Links — vor dem ersten Pixel.' },
  { n: '02', tag: 'Design', line: 'Editorial, mit echtem Bild und ruhiger Typografie.' },
  { n: '03', tag: 'Tech', line: 'Astro, Next.js oder reines HTML — nach Bedarf.' },
  { n: '04', tag: 'SEO', line: 'On-Page, Local, Schema und Sitemap im Standard.' },
]

const buildStats = [
  { value: '< 2 s', label: 'LCP-Ziel' },
  { value: '~ 0', label: 'CLS-Ziel' },
  { value: '< 200 KB', label: 'Initial' },
]

// Hero-Bild kommt aus dem CMS (service-pages.heroImage). Bis dort ein echtes,
// web-/SEO-taugliches Motiv hinterlegt ist, greift ein dunkler, cineastischer
// Platzhalter. Der gr-knospe-Website-Screenshot wird NIE als Hero-Background
// genutzt — er erscheint unten als inszeniertes Browser-Mockup.
const heroFallback = '/assets/optimized/assets-photos-automobil-sunset-1920.webp'
const cmsHero = imageUrl(doc?.heroImage, 'hero', { allowOriginal: true })
const isScreenshot = typeof cmsHero === 'string' && /screencapture|gr-knospe/i.test(cmsHero)
const heroImage = cmsHero && !isScreenshot ? cmsHero : heroFallback

const caseImage = '/assets/services/screencapture-gr-knospe-de-2025-10-02-23_10_04-720.webp'
---
<AdoptedPageLayout
  legacyFile={legacyFile}
  current="leistungen"
  doc={doc}
  ctaHref="#anfrage"
  ogImage={heroImage}
  preloadImages={[heroImage]}
>
  <main>
    {/* ===== HERO (dark) — Ken-Burns static, image-led ===== */}
    <section class="ws-hero" data-theme="dark" data-header-theme="dark" aria-label="Webdesign & SEO Düsseldorf">
      <div class="ws-hero__media" aria-hidden="true">
        <img src={heroImage} alt="" fetchpriority="high" decoding="async" />
      </div>
      <div class="ws-hero__veil" aria-hidden="true"></div>
      <div class="ws-hero__beam" aria-hidden="true"></div>
      <div class="ws-hero__inner">
        <p class="ws-kicker">Webdesign &amp; SEO · Düsseldorf · NRW</p>
        <h1 class="ws-hero__title">
          <span class="line">Webdesign</span>
          <span class="line"><em>&amp; SEO.</em></span>
        </h1>
        <p class="ws-hero__lead">Moderne Websites mit klarer Struktur, schneller Performance und lokaler Suchmaschinen-Sichtbarkeit — handgebaut für Marken und Mittelstand im Rheinland.</p>
        <div class="ws-hero__actions">
          <a class="ws-btn ws-btn--solid" href="#anfrage">Website anfragen</a>
          <a class="ws-btn ws-btn--ghost" href="#leistungen">Leistungen ansehen</a>
        </div>
        <dl class="ws-hero__meta" aria-label="Eckdaten">
          <div><dt>Standort</dt><dd>Düsseldorf · NRW</dd></div>
          <div><dt>Bereich</dt><dd>Web &amp; SEO</dd></div>
          <div><dt>Antwort</dt><dd>≤ 24 h</dd></div>
        </dl>
      </div>
    </section>

    {/* ===== STATEMENT (light) — editorial pause ===== */}
    <section class="ws-statement" data-theme="light" data-header-theme="light" aria-label="Gefunden werden und überzeugen">
      <div class="ws-inner ws-statement__grid">
        <div>
          <h2>Gefunden werden,<br /><em>und überzeugen.</em></h2>
        </div>
        <div class="ws-statement__body">
          <p class="ws-lead">Eine Website muss zwei Dinge gleichzeitig können: in der Suche auftauchen und danach überzeugen. Beides entsteht hier aus einer Hand — Struktur, Text, Bild und Technik.</p>
          <p>Kein Page-Builder-Wust, keine Stockbilder, kein Template von der Stange. Stattdessen handgebaute Seiten mit eigener Bildsprache und einem schlanken Code-Stand, der schnell lädt und sauber rankt — und sich später ohne CMS-Stress erweitern lässt.</p>
          <div class="ws-actions">
            <a class="ws-btn ws-btn--ink" href="#leistungen">Leistungen ansehen</a>
            <a class="ws-btn ws-btn--ghost-ink" href="#anfrage">Projekt anfragen</a>
          </div>
        </div>
      </div>
    </section>

    {/* ===== LEISTUNGEN (dark) — kompaktes editorial grid, no card chrome ===== */}
    <section class="ws-services" id="leistungen" data-theme="dark" data-header-theme="dark" aria-label="Webleistungen">
      <div class="ws-inner">
        <div class="ws-services__head">
          <h2>Web<em>leistungen.</em></h2>
          <p class="ws-lead">Webdesign und SEO als eine Sache — vier Disziplinen, ein Auftritt.</p>
        </div>
        <ol class="ws-services__grid">
          {services.map((s) => (
            <li class="ws-service">
              <span class="ws-service__num">{s.n}</span>
              <div class="ws-service__main">
                <h3 class="ws-service__title">{s.title}</h3>
                <p class="ws-service__body">{s.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* ===== CASE (light) — real work in a browser frame ===== */}
    <section class="ws-case" data-theme="light" data-header-theme="light" aria-label="Aus der Praxis">
      <div class="ws-inner ws-case__grid">
        <div class="ws-case__frame">
          <div class="ws-case__bar" aria-hidden="true">
            <span class="ws-case__dot"></span><span class="ws-case__dot"></span><span class="ws-case__dot"></span>
            <span class="ws-case__url">gr-knospe.de</span>
          </div>
          <div class="ws-case__shot">
            <img src={caseImage} alt="Website-Beispiel — Startseite einer von Matthias Ramahi gebauten Website" loading="lazy" decoding="async" width="720" height="1017" />
          </div>
        </div>
        <div class="ws-case__copy">
          <p class="ws-eyebrow ws-eyebrow--ink">Aus der Praxis</p>
          <h2>Eine Seite,<br /><em>die trägt.</em></h2>
          <p class="ws-lead">Handgebaut statt Baukasten: klare Struktur, eigene Bildsprache und ein schlanker Code-Stand, der auch nach Jahren noch schnell lädt.</p>
          <dl class="ws-case__stats">
            {buildStats.map((s) => (
              <div class="ws-case__stat"><dd>{s.value}</dd><dt>{s.label}</dt></div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    {/* ===== SYSTEM (dark) — "ein System": kompakte nummerierte Liste ===== */}
    <section class="ws-system" data-theme="dark" data-header-theme="dark" aria-label="System">
      <div class="ws-inner">
        <div class="ws-system__head">
          <p class="ws-eyebrow">System</p>
          <h2>Nicht eine Seite —<br /><em>ein System.</em></h2>
          <p class="ws-lead">Eine Website ist kein Layout, sondern ein System aus Inhalten, Struktur und Verbindungen. Stimmt das System, wachsen einzelne Seiten organisch dazu.</p>
        </div>
        <ol class="ws-system__list">
          {systemLayers.map((l) => (
            <li class="ws-system__item">
              <span class="ws-system__num">{l.n}</span>
              <div class="ws-system__text">
                <p class="ws-system__tag">{l.tag}</p>
                <p class="ws-system__line">{l.line}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* ===== CONTACT (light) ===== */}
    <section
      id="anfrage"
      data-contact-section
      data-theme="light"
      data-header-theme="light"
      data-contact-subject="Webdesign-Anfrage — Matthias Ramahi"
      data-contact-headline="Website anfragen."
      data-contact-lead="Beschreibe kurz, ob es um eine neue Website, einen Relaunch, lokale SEO-Seiten oder eine Beratung geht. Hilfreich: vorhandene Website, Branche, Zielregion und ob Texte oder Bilder schon vorhanden sind."
      aria-label="Anfrage"
    />
  </main>
</AdoptedPageLayout>
