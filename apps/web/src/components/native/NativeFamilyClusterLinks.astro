---
type ClusterLink = {
  href: string
  label: string
}

type Props = {
  clusterHeading: string
  clusterLinks: ClusterLink[]
  overviewHref: string
  scopeLabel: string
}

const { clusterHeading, clusterLinks, overviewHref, scopeLabel } = Astro.props as Props
---

<section
  class="mr-cities mr-photo-cluster"
  data-header-theme="light"
  data-theme="light"
  aria-label={`Verwandte Fotografie-Bereiche ${scopeLabel}`}
>
  <div class="mr-cities__inner">
    <div class="mr-cities__head">
      <h2 set:html={clusterHeading}></h2>
      <p class="mr-cities__copy">
        Fahrzeug, Mensch und Raum bleiben eigene Bildbereiche. Die Links führen schnell zu der Seite, die zum Motiv,
        zur Nutzung und zum geplanten Shooting passt.
      </p>
    </div>
    <nav class="mr-cities__grid" aria-label="Verwandte Fotografie-Bereiche">
      <a class="mr-cities__cell" href={overviewHref}>Fotografie Übersicht</a>
      {clusterLinks.map((link) => <a class="mr-cities__cell" href={link.href}>{link.label}</a>)}
    </nav>
  </div>
</section>
