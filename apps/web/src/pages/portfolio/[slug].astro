---
import ContentBlocks from '../../components/ContentBlocks.astro'
import ContactCta from '../../components/ContactCta.astro'
import LoadMoreGallery from '../../components/LoadMoreGallery.astro'
import NativeShaderHero from '../../components/native/NativeShaderHero.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { versionStaticAssetUrl } from '../../lib/cache'
import { homeHeroSlidesFor } from '../../lib/nativeContent'
import { tinaAttrs } from '../../lib/tinaFieldAttrs'
import {
  getBySlug,
  imageDimensions,
  imageDisplayUrl,
  liveCmsFetchOptions,
  routeForDoc,
  toAbsoluteSiteUrl,
  type PayloadDoc,
} from '../../lib/payload'
import { breadcrumbJsonLd, imageGalleryJsonLd, type JsonLd } from '../../lib/seo'
import { getTinaVisualDocumentBySlug, isTinaEditRequest } from '../../lib/tinaVisual'

export const prerender = false

const { slug } = Astro.params
const tinaDoc = slug && isTinaEditRequest(Astro.request) ? await getTinaVisualDocumentBySlug('portfolioProjects', slug) : null
const doc = (tinaDoc ?? Astro.props.doc ?? (slug ? await getBySlug('portfolio-projects', slug, liveCmsFetchOptions({ depth: 2, cacheMs: 0 })) : null)) as PayloadDoc | null

if (!doc) {
  return Astro.redirect('/portfolio.html', 308)
}

Astro.response.headers.set('cache-control', 'no-store, max-age=0')

const portfolioImageOptions = { allowOriginal: true, mapCachedAssets: false } as const
const hero = imageDisplayUrl(doc.coverImage, 'wide', portfolioImageOptions)
const gallery = doc.gallery ?? []
const hasText = (value?: string): value is string => typeof value === 'string' && value.trim().length > 0
const cmsHeroSlides = (doc.heroSlides || []).length > 0 ? homeHeroSlidesFor(doc, { preferCmsMedia: true }) : []
const fallbackHeroImage =
  hero ||
  imageDisplayUrl(doc.coverImage, 'hero', portfolioImageOptions) ||
  imageDisplayUrl(doc.gallery?.[0]?.image, 'wide', portfolioImageOptions)
const fallbackHeroSlides = fallbackHeroImage
  ? [
      {
        image: fallbackHeroImage,
        titleLines: [doc.title || 'Portfolio', doc.presentationMode || 'Serie'].filter(hasText),
        lead: doc.excerpt || '',
        primaryHref: '#bilder',
        primaryLabel: 'Bilder ansehen',
        secondaryHref: '#anfrage',
        secondaryLabel: 'Projekt anfragen',
        durationSec: 7,
      },
    ]
  : []
const heroSlides = cmsHeroSlides.length ? cmsHeroSlides : fallbackHeroSlides
const firstHeroSlide = heroSlides[0]
const projectPage = doc.projectPage || {}
const galleryEyebrow = hasText(projectPage.galleryEyebrow) ? projectPage.galleryEyebrow! : 'Bildstrecke'
const statement = projectPage.statement || {}
const statementStats = (statement.stats || []).filter((item) => hasText(item.label) || hasText(item.text))
const context = projectPage.context || {}
const contextKicker = hasText(context.kicker) ? context.kicker! : 'Einordnung'
const contextHeadline = hasText(context.headline) ? context.headline! : 'Serie, Einsatz und Bildsprache'
const contextBody = (context.body || []).map((paragraph) => paragraph.text).filter(hasText)
const categoryLabel = (value: unknown): string => {
  if (typeof value === 'string') return value
  if (!value || typeof value !== 'object') return ''
  const record = value as Record<string, unknown>
  for (const key of ['title', 'name', 'label', 'slug']) {
    const candidate = record[key]
    if (typeof candidate === 'string' && candidate.trim()) return candidate
  }
  return ''
}
const portfolioFocus = categoryLabel(doc.category) || doc.presentationMode || doc.title || 'Portfolio-Serie'
const defaultContextBody = [
  `Diese Auswahl ist als kuratierter Einstieg in ${portfolioFocus} gedacht: nicht als endlose Galerie, sondern als verdichtete Serie mit Hauptmotiv, Varianten, Details und ruhigen Uebergaengen. Fuer SEO und Nutzerfuehrung bleibt die Seite bewusst eigenstaendig, waehrend sie auf die passenden Leistungs- und Standortseiten verweist.`,
  'Entscheidend ist die Lesbarkeit der Bildstrecke. Farbe, Abstand, Perspektive und Reihenfolge sollen schnell zeigen, ob eine aehnliche Produktion fuer Marke, Verkauf, Portfolio, Print oder digitale Praesentation funktioniert. So bekommt jedes Portfolio-Motiv einen klaren Kontext statt nur einen isolierten Galerieplatz.',
]
const resolvedContextBody = contextBody.length ? contextBody : defaultContextBody
const perspectives = (projectPage.perspectives || []).filter((item) => hasText(item.title) || hasText(item.text))
const firstPerspective = perspectives.find((item) => hasText(imageDisplayUrl(item.image, 'wide', portfolioImageOptions)))
const firstPerspectiveImage = firstPerspective ? imageDisplayUrl(firstPerspective.image, 'wide', portfolioImageOptions) : ''
const firstPerspectiveDimensions = imageDimensions(firstPerspective?.image, 'wide')
const infoCards = (projectPage.infoCards || []).filter((item) => hasText(item.title))
const relatedCards = (projectPage.relatedCards || []).filter((item) => hasText(item.title) && hasText(item.href))
const projectCta = projectPage.contact || doc.cta
const rawDescription = doc.seo?.description || doc.excerpt || ''
const description =
  rawDescription.length >= 70
    ? rawDescription
    : `${doc.title || 'Portfolio-Serie'}: kuratierte Bildstrecke von Matthias Ramahi mit ausgewaehlten Motiven, Details und visueller Produktion aus Duesseldorf / NRW.`
const seoCanonicalUrl = doc.seo?.canonicalUrl ? toAbsoluteSiteUrl(doc.seo.canonicalUrl) : ''
const canonicalUrl =
  seoCanonicalUrl && new URL(seoCanonicalUrl).pathname !== '/portfolio.html'
    ? seoCanonicalUrl
    : toAbsoluteSiteUrl(routeForDoc('portfolio-projects', doc))
const gallerySchema = imageGalleryJsonLd(gallery, { name: doc.title || 'Portfolio', url: canonicalUrl })
const jsonLdItems: JsonLd[] = [
  breadcrumbJsonLd([
    { name: 'Startseite', url: '/' },
    { name: 'Portfolio', url: '/portfolio.html' },
    { name: doc.title || 'Projekt', url: canonicalUrl },
  ]),
]
if (gallerySchema) jsonLdItems.push(gallerySchema)
---
<BaseLayout
  title={doc.seo?.title || `${doc.title} | Matthias Ramahi`}
  description={description}
  canonicalUrl={canonicalUrl}
  noIndex={doc.seo?.noIndex}
  ogImage={doc.seo?.ogImage || doc.coverImage}
  jsonLd={jsonLdItems}
  stylesheets={['/assets/native-home.css', '/assets/native-portfolio-project.css']}
  preloadImages={firstHeroSlide ? [firstHeroSlide.image] : []}
>
  {heroSlides.length > 0 && <NativeShaderHero id="top" label={doc.title || 'Portfolio'} slides={heroSlides} sourceSlides={doc.heroSlides || []} headerTheme="dark" />}

  {(hasText(statement.quote) || statementStats.length > 0) && (
    <section class="project-statement" data-header-theme="light">
      <div class="project-statement__inner">
        {hasText(statement.quote) && (
          <blockquote class="project-statement__quote" {...tinaAttrs(statement, 'quote')}>
            <strong>
              {statement.quote}
              {hasText(statement.accent) && <> <em {...tinaAttrs(statement, 'accent')}>{statement.accent}</em></>}
            </strong>
          </blockquote>
        )}
        <div class="project-statement__foot">
          {statementStats.map((item) => (
            <div class="project-stat">
              {hasText(item.label) && <span {...tinaAttrs(item, 'label')}>{item.label}</span>}
              {hasText(item.text) && <strong {...tinaAttrs(item, 'text')}>{item.text}</strong>}
            </div>
          ))}
          {hasText(statement.buttonLabel) && (
            <a class="project-btn" href={statement.buttonHref || '#anfrage'} {...tinaAttrs(statement, 'buttonLabel')}>{statement.buttonLabel}</a>
          )}
        </div>
      </div>
    </section>
  )}

  {(perspectives.length > 0 || resolvedContextBody.length > 0) && (
    <section class="project-system" data-header-theme="dark">
      <div class="project-system__inner">
        <div class="project-system__head">
          <div>
            <span class="project-system__kicker" {...tinaAttrs(context, 'kicker')}>{contextKicker}</span>
            <h2 {...tinaAttrs(context, 'headline')}>{contextHeadline}</h2>
          </div>
          <div class="project-context">
            {resolvedContextBody.map((paragraph, index) => <p {...tinaAttrs(context.body?.[index], 'text')}>{paragraph}</p>)}
          </div>
        </div>
        {perspectives.length > 0 && (
          <div class="project-system__grid">
            {firstPerspectiveImage && (
              <figure class="project-system__visual">
                <img
                  src={firstPerspectiveImage}
                  alt={firstPerspective?.title || `${doc.title || 'Portfolio'} – ausgewählte Perspektive`}
                  loading="lazy"
                  decoding="async"
                  width={firstPerspectiveDimensions.width}
                  height={firstPerspectiveDimensions.height}
                  {...tinaAttrs(firstPerspective, 'image')}
                />
              </figure>
            )}
            <div class="project-system__list">
              {perspectives.map((item, index) => (
                <article class="project-perspective">
                  <span {...tinaAttrs(item, 'label')}>{item.label || String(index + 1).padStart(2, '0')}</span>
                  <h3 {...tinaAttrs(item, 'title')}>{item.title}</h3>
                  {hasText(item.text) && <p {...tinaAttrs(item, 'text')}>{item.text}</p>}
                  {(item.bullets || []).length > 0 && (
                    <ul>
                      {(item.bullets || []).filter((bullet) => hasText(bullet.text)).map((bullet) => (
                        <li {...tinaAttrs(bullet, 'text')}>{bullet.text}</li>
                      ))}
                    </ul>
                  )}
                </article>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  <section class="project-gallery" data-header-theme="light">
    <div class="project-statement__inner project-gallery__head">
      <div>
        <span class="project-gallery__kicker" {...tinaAttrs(projectPage, 'galleryEyebrow')}>{galleryEyebrow}</span>
        <h2>Aktuelle <em>Arbeiten.</em></h2>
      </div>
    </div>
    <LoadMoreGallery id="bilder" items={gallery} eyebrow="" fallback="Portfolio-Bild" mapCachedAssets={false} />
  </section>

  {infoCards.length > 0 && (
    <section class="project-audience" data-header-theme="light">
      <div class="project-audience__inner">
        <div class="project-audience__head">
          <div>
            <span class="project-audience__kicker">Zielgruppen</span>
            <h2>Fuer <em>wen</em> ich arbeite.</h2>
          </div>
        </div>
        <div class="project-audience__grid">
          {infoCards.map((card, index) => (
            <a class="project-info-card" href={card.href || '#anfrage'}>
              <span {...tinaAttrs(card, 'number')}>{card.number || String(index + 1).padStart(2, '0')}</span>
              <h3 {...tinaAttrs(card, 'title')}>{card.title}</h3>
              {hasText(card.label) && <span {...tinaAttrs(card, 'label')}>{card.label}</span>}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {relatedCards.length > 0 && (
    <section class="project-related" data-header-theme="dark">
      <div class="project-related__inner">
        <div class="project-related__head">
          <div>
            <span class="project-related__kicker">Navigation</span>
            <h2>Verwandte <em>Bereiche</em>.</h2>
          </div>
        </div>
        <div class="project-related__grid">
          {relatedCards.map((card) => {
            const cardImage = imageDisplayUrl(card.image, 'card', portfolioImageOptions)
            const cardDimensions = imageDimensions(card.image, 'card')
            return (
              <a class="project-related-card" href={card.href}>
                {cardImage && <img src={cardImage} alt="" aria-hidden="true" loading="lazy" decoding="async" width={cardDimensions.width} height={cardDimensions.height} {...tinaAttrs(card, 'image')} />}
                <div class="project-related-card__content">
                  <div>
                    {hasText(card.label) && <span {...tinaAttrs(card, 'label')}>{card.label}</span>}
                    <strong {...tinaAttrs(card, 'title')}>{card.title}</strong>
                  </div>
                  <span>-></span>
                </div>
              </a>
            )
          })}
        </div>
      </div>
    </section>
  )}

  <ContentBlocks blocks={doc.blocks} />
  <ContactCta cta={projectCta} />
  <script is:inline src={versionStaticAssetUrl('/assets/native-home.js')} defer></script>
</BaseLayout>
