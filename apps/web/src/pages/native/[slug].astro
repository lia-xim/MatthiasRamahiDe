---
import NativeAdoptedPage from '../../components/native/NativeAdoptedPage.astro'
import {
  getLegacyRedirectTarget,
  getNativeHtmlFileForPath,
  isCmsAdoptedLegacyFile,
} from '../../lib/adoptedRoutes'
import { livePageCacheControl } from '../../lib/liveCache'
import { getTinaVisualDocumentForLegacyRoute, isTinaEditRequest } from '../../lib/tinaVisual'

export const prerender = false

const slug = Astro.params.slug || ''
const legacyFile = getNativeHtmlFileForPath(`/${slug}.html`) || getNativeHtmlFileForPath(`/${slug}`)

if (!legacyFile || !isCmsAdoptedLegacyFile(legacyFile, { includeLocalSeo: true })) {
  return Astro.redirect('/')
}

const redirectTarget = getLegacyRedirectTarget(legacyFile)

if (redirectTarget) {
  return Astro.redirect(`/${redirectTarget}`, 308)
}

Astro.response.headers.set('cache-control', livePageCacheControl())
Astro.response.headers.set('x-migration-render', 'adopted-astro-payload')

const tinaVisualMatch = isTinaEditRequest(Astro.request)
  ? await getTinaVisualDocumentForLegacyRoute(legacyFile)
  : null
---
<NativeAdoptedPage
  legacyFile={legacyFile}
  doc={tinaVisualMatch?.doc}
  localSeoDoc={tinaVisualMatch?.collection === 'local-seo-pages' ? tinaVisualMatch.doc : undefined}
/>
