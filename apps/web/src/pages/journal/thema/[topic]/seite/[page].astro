---
// /journal/thema/<thema>/seite/N – weitere Seiten eines Journal-Themas.
import NativeJournalIndexPage from '../../../../../components/native/NativeJournalIndexPage.astro'
import { getJournalIndexPosts, sliceJournalPosts } from '../../../../../lib/journalIndexPosts'
import { journalIndexPath, journalTopicBySlug, parseJournalPage } from '../../../../../lib/journalIndexRoutes'

export const prerender = false

const topic = journalTopicBySlug(Astro.params.topic)
const page = parseJournalPage(Astro.params.page)
if (!topic || page === null) return new Response('Not found', { status: 404 })
if (page === 1) return Astro.redirect(journalIndexPath(topic), 301)

const { totalPages } = sliceJournalPosts(await getJournalIndexPosts(), topic, page)
if (page > totalPages) return new Response('Not found', { status: 404 })

Astro.response.headers.set('cache-control', 'no-store')
---
<NativeJournalIndexPage topicSlug={topic.slug} page={page} />
