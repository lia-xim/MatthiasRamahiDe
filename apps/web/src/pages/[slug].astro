---
import CmsRoutedPage from '../components/cms/CmsRoutedPage.astro'
import NativeLocalSeoFamilyPage from '../components/cms/NativeLocalSeoFamilyPage.astro'
import Native404Page from '../components/native/Native404Page.astro'
import { getLegacyPathRedirectTarget, getNativeHtmlFileForPath, isLegacyGonePath } from '../lib/adoptedRoutes'
import { envFlagNotFalse } from '../lib/envFlags'
import { livePageCacheControl } from '../lib/liveCache'
import { getBySlug, liveCmsFetchOptions, type PayloadDoc } from '../lib/payload'
import { getTinaVisualDocumentBySlug, isTinaEditRequest } from '../lib/tinaVisual'

export const prerender = false

const slug = Astro.params.slug || ''
const normalizedSlug = slug.replace(/\.html$/i, '')
const legacyFile = Astro.props.legacyFile || getNativeHtmlFileForPath(Astro.url.pathname)
const enableCmsDynamicRoutes = envFlagNotFalse('ASTRO_ENABLE_CMS_DYNAMIC_ROUTES')
let cmsDoc: PayloadDoc | null = null
let cmsCollection = ''

if (legacyFile) {
  return Astro.redirect(`/${legacyFile}`, 308)
}

const legacyRedirectTarget = getLegacyPathRedirectTarget(Astro.url.pathname)

if (legacyRedirectTarget !== null) {
  return Astro.redirect(`/${legacyRedirectTarget}${Astro.url.search}`, 308)
}

if (enableCmsDynamicRoutes && slug) {
  const dynamicCollections = [
    { payload: 'site-pages', visual: 'pages' },
    { payload: 'service-pages', visual: 'servicePages' },
    { payload: 'local-seo-pages', visual: 'localSeoPages' },
  ] as const
  const isEditing = isTinaEditRequest(Astro.request)

  for (const collection of dynamicCollections) {
    const doc = isEditing
      ? await getTinaVisualDocumentBySlug(collection.visual, normalizedSlug, { requireExisting: true })
      : await getBySlug(collection.payload, normalizedSlug, liveCmsFetchOptions({ depth: 2 }))
    if (doc) {
      cmsDoc = doc
      cmsCollection = collection.payload
      break
    }
  }

  if (!cmsDoc) {
    const portfolioDoc = await getBySlug('portfolio-projects', normalizedSlug, liveCmsFetchOptions({ depth: 1 }))
    if (portfolioDoc) {
      return Astro.redirect(`/portfolio/${portfolioDoc.slug}`, 308)
    }
  }
}

const isGone = !cmsDoc && isLegacyGonePath(Astro.url.pathname)

if (!cmsDoc) {
  Astro.response.status = isGone ? 410 : 404
  Astro.response.headers.set('cache-control', 'no-store')
  Astro.response.headers.set('x-robots-tag', 'noindex')
} else {
  Astro.response.headers.set('cache-control', livePageCacheControl())
  Astro.response.headers.set('x-migration-render', 'cms-dynamic-structured')
}
---
{
  !cmsDoc ? (
    <Native404Page statusCode={isGone ? 410 : 404} />
  ) : cmsCollection === 'local-seo-pages' ? (
    <NativeLocalSeoFamilyPage doc={cmsDoc as PayloadDoc} />
  ) : (
    <CmsRoutedPage collection={cmsCollection} doc={cmsDoc as PayloadDoc} />
  )
}
