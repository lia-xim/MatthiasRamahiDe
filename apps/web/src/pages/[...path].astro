---
import Native404Page from '../components/native/Native404Page.astro'
import { getLegacyPathRedirectTarget, isLegacyGonePath } from '../lib/adoptedRoutes'

export const prerender = false

const redirectTarget = getLegacyPathRedirectTarget(Astro.url.pathname)

if (redirectTarget !== null) {
  return Astro.redirect(`/${redirectTarget}${Astro.url.search}`, 308)
}

const isGone = isLegacyGonePath(Astro.url.pathname)

Astro.response.status = isGone ? 410 : 404
Astro.response.headers.set('cache-control', 'no-store')
Astro.response.headers.set('x-robots-tag', 'noindex')
---
<Native404Page statusCode={isGone ? 410 : 404} />
