---
import Native404Page from '../components/native/Native404Page.astro'
import { getLegacyPathRedirectTarget } from '../lib/adoptedRoutes'

export const prerender = false

const redirectTarget = getLegacyPathRedirectTarget(Astro.url.pathname)

if (redirectTarget) {
  return Astro.redirect(`/${redirectTarget}${Astro.url.search}`, 308)
}

Astro.response.status = 404
Astro.response.headers.set('cache-control', 'no-store')
---
<Native404Page />
