{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "corepack pnpm vercel:build",
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "framework": "astro",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.matthiasramahi.de" }],
      "destination": "https://matthiasramahi.de/:path*",
      "permanent": true
    },
    {
      "source": "/fotografie/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/fotografie",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/fotografie.html",
      "destination": "/",
      "permanent": true
    },
