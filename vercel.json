    },
    {
      "source": "/motorradfotografie/motorrad-fotografie-rechtliche-aspekte/:trailing*",
      "destination": "/blog-motorrad-fotografie-rechtliche-aspekte.html",
      "permanent": true
    },
    {
      "source": "/motorrad-fotografie-rechtliche-aspekte/:trailing*",
      "destination": "/blog-motorrad-fotografie-rechtliche-aspekte.html",
      "permanent": true
    },
    {
      "source": "/outdoor-portrait-fotografie/:trailing*",
      "destination": "/blog-outdoor-portrait-fotografie.html",
      "permanent": true
    },
    {
      "source": "/portfolio",
      "destination": "/portfolio.html",
      "permanent": true
    },
    {
      "source": "/portfolio/",
      "destination": "/portfolio.html",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/indexnow",
      "schedule": "0 5 * * *"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/uploads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/mpissxxj-portfolio_webp_full_063-1.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }]
    },
    {
      "source": "/favicon.svg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }]
    },
    {
      "source": "/favicon-16x16.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }]
    },
    {
      "source": "/favicon-32x32.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }]
    },
    {
      "source": "/apple-touch-icon.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }]
    },
    {
      "source": "/site.webmanifest",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "query", "key": "rwg_token" }],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self' https://cms.matthiasramahi.de; form-action 'self'; img-src 'self' data: https://cms.matthiasramahi.de; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://analytics.contextter.com https://analytics.crawlfoundry.com https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; connect-src 'self' https://cms.matthiasramahi.de https://app.crawlfoundry.com https://analytics.contextter.com https://analytics.crawlfoundry.com https://challenges.cloudflare.com; media-src 'self' https://cms.matthiasramahi.de; manifest-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        }
      ]
    }
  ]
}
