      "permanent": true
    },
    {
      "source": "/automotive-fotografie-duesseldorf.html",
      "destination": "/autofotografie-duesseldorf.html",
      "permanent": true
    },
    {
      "source": "/auto-fotoshooting-duesseldorf.html",
      "destination": "/autofotografie-duesseldorf.html",
      "permanent": true
    },
    {
      "source": "/fotoshooting-mit-auto-duesseldorf.html",
      "destination": "/autofotografie-duesseldorf.html",
      "permanent": true
    },
    {
      "source": "/fahrzeugfotografie-duesseldorf.html",
      "destination": "/autofotografie-duesseldorf.html",
      "permanent": true
    },
    {
      "source": "/automobil-fotografie.html",
      "destination": "/autofotografie.html",
      "permanent": true
    },
    {
      "source": "/automotive-fotografie.html",
      "destination": "/autofotografie.html",
      "permanent": true
    },
    {
      "source": "/fotoshooting-mit-auto.html",
      "destination": "/autofotografie.html",
      "permanent": true
    },
    {
      "source": "/auto-fotoshooting.html",
      "destination": "/autofotografie.html",
      "permanent": true
    },
    {
      "source": "/fahrzeugfotografie.html",
      "destination": "/autofotografie.html",
      "permanent": true
    },
    {
      "source": "/portrait-fotoshooting-duesseldorf.html",
      "destination": "/portraitfotografie-duesseldorf.html",
      "permanent": true
    },
    {
      "source": "/portrait-fotoshooting.html",
      "destination": "/portraitfotografie-duesseldorf.html",
      "permanent": true
    },
    {
      "source": "/business-portrait-duesseldorf.html",
      "destination": "/personal-branding-fotografie-duesseldorf.html",
      "permanent": true
    },
    {
      "source": "/headshot-fotograf-duesseldorf.html",
      "destination": "/personal-branding-fotografie-duesseldorf.html",
      "permanent": true
    },
    {
      "source": "/unternehmensportrait-duesseldorf.html",
      "destination": "/personal-branding-fotografie-duesseldorf.html",
      "permanent": true
    },
    {
      "source": "/dating-fotoshooting.html",
      "destination": "/dating-fotoshooting-duesseldorf.html",
