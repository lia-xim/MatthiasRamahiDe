    },
    {
      "source": "/drucke-sonderanfertigungen-duesseldorf.html",
      "destination": "/fotolabor-druck-duesseldorf.html",
      "permanent": true
    },
    {
      "source": "/portraitfotografie/retro-looks-in-der-digitalen-fotografie/:trailing*",
      "destination": "/blog-retro-looks-in-der-digitalen-fotografie.html",
      "permanent": true
    },
    {
      "source": "/retro-looks-in-der-digitalen-fotografie/:trailing*",
      "destination": "/blog-retro-looks-in-der-digitalen-fotografie.html",
      "permanent": true
    },
    {
      "source": "/portraitfotografie/mikrogesten-und-haende-im-charakterportraet-fuer-mehr-wirkung/:trailing*",
      "destination": "/blog-mikrogesten-und-haende-im-portrait.html",
      "permanent": true
