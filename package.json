{
  "name": "matthias-ramahi-astro-tina-stack",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "corepack pnpm web:build",
    "vercel:build": "node tools/run-vercel-build.mjs",
    "seo:audit": "node tools/seo-audit.mjs --target=apps/web/dist/client",
    "seo:audit:strict": "node tools/seo-audit.mjs --target=apps/web/dist/client --strict",
    "seo:audit:deep": "node tools/seo-deep-audit.mjs --target=apps/web/dist/client",
    "seo:audit:deep:strict": "node tools/seo-deep-audit.mjs --target=apps/web/dist/client --strict",
    "seo:audit:gsc-exports": "node tools/audit-gsc-indexing-exports.mjs",
    "seo:audit:gsc-fixtures": "node tools/audit-gsc-indexing-exports.mjs --not-found tools/fixtures/gsc-indexing-exports/not-found-2026-06-30.txt --crawled tools/fixtures/gsc-indexing-exports/crawled-not-indexed-2026-06-30.txt --found tools/fixtures/gsc-indexing-exports/found-not-indexed-2026-06-30.txt",
    "seo:audit:gsc-live": "node tools/audit-gsc-indexing-exports.mjs --origin https://matthiasramahi.de --not-found tools/fixtures/gsc-indexing-exports/not-found-2026-06-30.txt --crawled tools/fixtures/gsc-indexing-exports/crawled-not-indexed-2026-06-30.txt --found tools/fixtures/gsc-indexing-exports/found-not-indexed-2026-06-30.txt --report .tmp/seo-live/gsc-export-url-audit.md --strict",
    "seo:analyze:gsc-overlap": "node tools/analyze-gsc-page-query-overlap.mjs",
    "seo:audit:cluster-contract": "node tools/assert-seo-cluster-contract.mjs",
    "seo:audit:release-preview": "node tools/run-seo-release-preview-audit.mjs",
    "seo:audit:sitemap-live": "node tools/audit-sitemap-indexability.mjs --origin https://matthiasramahi.de --report .tmp/seo-live/sitemap-indexability.md --strict",
    "seo:audit:sitemap-indexability": "node tools/audit-sitemap-indexability.mjs",
    "seo:release-routing": "node tools/assert-seo-release-routing.mjs",
    "seo:fix": "node tools/print-native-seo-fix-guidance.mjs",
    "legacy:seo:fix": "node tools/print-legacy-reference-guidance.mjs",
    "legacy:freeze": "node tools/freeze-legacy-reference.mjs",
    "legacy:freeze:check": "node tools/freeze-legacy-reference.mjs --check",
    "native:coverage": "node tools/assert-native-route-coverage.mjs",
    "native:guard": "node tools/assert-native-production.mjs",
    "perf:audit": "node tools/performance-audit.mjs --target=apps/web/dist/client",
    "lighthouse:audit": "node tools/lighthouse-audit.mjs",
    "cache:warmup": "node tools/warmup-deployment-cache.mjs",
    "cache:warmup:production": "node tools/warmup-deployment-cache.mjs --origin=https://matthiasramahi.de --asset-mode=critical --concurrency=8",
    "indexnow:submit": "node tools/submit-indexnow.mjs",
    "quality:audit": "corepack pnpm web:build && corepack pnpm seo:audit:strict && corepack pnpm perf:audit && node tools/run-site-quality-audit.mjs",
    "quality:full": "corepack pnpm quality:audit && corepack pnpm lighthouse:audit",
    "production:check": "node tools/run-production-check.mjs",
    "node:check": "node tools/assert-node-22.mjs",
    "local:start": "node tools/assert-node-22.mjs --warn && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-local.ps1",
    "stack:dev": "corepack pnpm web:tina:dev",
    "tina:rescue-local-seo": "node tools/convert-local-seo-sql-dump.mjs",
    "tina:media-manifest": "node tools/build-tina-media-manifest.mjs",
    "tina:media-optimize": "node tools/optimize-tina-uploads.mjs && node tools/build-tina-media-manifest.mjs",
    "tina:media-sync": "node tools/sync-tina-media-files.mjs",
    "tina:content-import": "node tools/convert-payload-export-to-tina-content.mjs",
    "tina:preflight": "node tools/tina-preflight.mjs",
    "tina:preflight:live": "node tools/tina-preflight.mjs --base-url=http://127.0.0.1:4321",
    "images:optimize": "node tools/optimize-site-images.mjs",
    "web:dev": "corepack pnpm --filter @matthias-ramahi/web dev",
    "web:tina:dev": "corepack pnpm --filter @matthias-ramahi/web tina:dev",
    "web:tina:build": "corepack pnpm --filter @matthias-ramahi/web tina:build",
    "web:build": "corepack pnpm --filter @matthias-ramahi/web build",
    "web:preview": "corepack pnpm --filter @matthias-ramahi/web preview",
    "web:audit:tina-content": "corepack pnpm --filter @matthias-ramahi/web audit:tina-content",
    "web:audit:tina-seo": "corepack pnpm --filter @matthias-ramahi/web audit:tina-seo",
    "web:audit:tina-seo:live": "corepack pnpm --filter @matthias-ramahi/web audit:tina-seo:live",
    "web:test:cms-parity": "corepack pnpm --filter @matthias-ramahi/web test:cms-parity",
    "web:test:legacy-routes": "corepack pnpm --filter @matthias-ramahi/web test:legacy-routes",
    "web:test:site-quality": "corepack pnpm --filter @matthias-ramahi/web test:site-quality",
    "web:test:visual": "corepack pnpm --filter @matthias-ramahi/web test:visual"
  },
  "devDependencies": {
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.0"
  },
  "pnpm": {
    "overrides": {
      "@opentelemetry/core": "2.8.0",
      "@astrojs/vercel>esbuild": "0.28.1",
      "astro>esbuild": "0.28.1",
      "js-yaml@4.1.1": "4.2.0",
      "lodash": "4.18.1",
      "markdown-it@12.3.2": "14.2.0",
      "react-email>esbuild": "0.28.1",
      "tar": "7.5.16",
      "vite@7.3.5>esbuild": "0.28.1",
      "ws": "8.21.0",
      "yaml@2.7.1": "2.8.3"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "fs-extra": ">=9.0.1",
        "typescript": ">=4.6.0"
      }
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "core-js",
      "esbuild",
      "sharp"
    ]
  }
}
